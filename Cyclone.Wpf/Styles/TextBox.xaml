<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hp="clr-namespace:Cyclone.Wpf.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================================================  -->
    <!--  Clear 按钮样式  -->
    <!--  Width 24 提供足够命中区,整体 hover/pressed 浅底反馈  -->
    <!--  ============================================================  -->
    <Style x:Key="TextBox.ClearButton.Style" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="Transparent"
                        SnapsToDevicePixels="True">
                        <Path
                            x:Name="IconPath"
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M0,0 L10,10 M0,10 L10,0"
                            Stretch="None"
                            Stroke="{DynamicResource Icon.Foreground.Default}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Background.Hover}" />
                            <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource Icon.Foreground.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Background.Pressed}" />
                            <Setter TargetName="IconPath" Property="Stroke" Value="{DynamicResource Icon.Foreground.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  TextBox ControlTemplate  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="TextBox.ControlTemplate.Basic" TargetType="{x:Type TextBox}">
        <Border
            x:Name="RootBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Watermark — Text 为空且未获焦时显示  -->
                <TextBlock
                    x:Name="Watermark"
                    Grid.Column="0"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{DynamicResource Foreground.Placeholder}"
                    IsHitTestVisible="False"
                    Text="{Binding Path=(hp:TextBoxHelper.Watermark), RelativeSource={RelativeSource AncestorType=TextBox}}"
                    Visibility="Collapsed" />

                <!--  实际编辑区  -->
                <ScrollViewer
                    x:Name="PART_ContentHost"
                    Grid.Column="0"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden" />

                <!--
                    Clear 按钮 — 默认 Visible,通过下面多个 trigger 反向 Collapsed
                    Command 透过类级别 CommandBinding 路由到 TextBoxHelper.OnClear
                -->
                <Button
                    x:Name="ClearButton"
                    Grid.Column="1"
                    Command="{x:Static hp:TextBoxHelper.ClearCommand}"
                    Style="{StaticResource TextBox.ClearButton.Style}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>

            <!--  Watermark 显示条件:Text="" 且 未获焦  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Text" Value="" />
                    <Condition Property="IsKeyboardFocused" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
            </MultiTrigger>

            <!--  Clear 按钮隐藏条件:HasClearButton=False  -->
            <DataTrigger Binding="{Binding Path=(hp:TextBoxHelper.HasClearButton), RelativeSource={RelativeSource Mode=Self}}" Value="False">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>

            <!--  Clear 按钮隐藏条件:Text 为空  -->
            <Trigger Property="Text" Value="">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  Clear 按钮隐藏条件:IsReadOnly=True  -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Header}" />
            </Trigger>

            <!--  Hover (未获焦) — 边框蓝灰  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Border.Hover}" />
            </Trigger>

            <!--  Focused — 边框主色  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Border.Focused}" />
            </Trigger>

            <!--  Disabled — 边框+背景+前景全部用 Disabled token  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Disabled}" />
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Border.Disabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  TextBox 默认样式  -->
    <!--  ============================================================  -->
    <Style
        x:Key="TextBox.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Background.Selected}" />
        <Setter Property="Height" Value="{DynamicResource Height.Horizontal.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource ValidationError.ControlTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="hp:TextBoxHelper.HasClearButton" Value="True" />
        <Setter Property="Template" Value="{StaticResource TextBox.ControlTemplate.Basic}" />
        <Style.Triggers>
            <!--  失焦但保持选中文字高亮  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsInactiveSelectionHighlightEnabled" Value="True" />
                    <Condition Property="IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="SelectionBrush" Value="{DynamicResource Background.Selected}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource TextBox.Style.Basic}" TargetType="TextBox" />
</ResourceDictionary>