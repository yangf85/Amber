<!--
    ============================================================================
    Pagination 样式
    
    架构:
    - 页码区域: ItemsControl + Button (每个 PageItem 一个按钮)
    - 三段式命名: Pagination.Style.Basic / Pagination.Button.Style.Basic / Pagination.PageItem.Style.Basic
    - 删除旧版冗余:空 Style alias / 重复 ResourceDictionary 合并
    
    PageItem 样式逻辑:
    - 通过 DataTrigger 监听 IsEllipsis 切换"省略号"视觉(不再做字符串 "···" 比较)
    - 通过 MultiBinding 比较 PageNumber == 父 Pagination.PageIndex 决定是否高亮
    - 点击按钮触发 GotoCommand,CommandParameter 是当前 PageItem
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================================================  -->
    <!--  PageItem 按钮样式 — 单个页码按钮  -->
    <!--  ============================================================  -->
    <Style x:Key="Pagination.PageItem.Style.Basic" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Command" Value="{x:Static ctl:Pagination.GotoCommand}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding PageNumber}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Background.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  省略号:不可点击,显示 "···"  -->
            <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="14"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="···" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <!--  当前页:IsCurrent=True 时高亮  -->
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Background.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Background.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Foreground.Selected}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  ============================================================  -->
    <!--  导航按钮样式 (← → ⏮ ⏭) — 跟页码按钮视觉一致  -->
    <!--  ============================================================  -->
    <Style
        x:Key="Pagination.Nav.Style.Basic"
        BasedOn="{StaticResource Pagination.PageItem.Style.Basic}"
        TargetType="{x:Type Button}">
        <Setter Property="Command" Value="{x:Null}" />
        <Setter Property="CommandParameter" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Background.Hover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Border.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Background.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  Pagination 主模板  -->
    <!--  布局: [Info]  [SizeChanger]  | [Nav PageItems Nav] |  [Jumper]  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="Pagination.ControlTemplate.Basic" TargetType="{x:Type ctl:Pagination}">
        <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!--  Info  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  SizeChanger  -->
                    <ColumnDefinition Width="*" />
                    <!--  Pages (居中)  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Jumper  -->
                </Grid.ColumnDefinitions>

                <!--  ① 信息文本 "共 N 条"  -->
                <TextBlock
                    x:Name="InfoText"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="{Binding ItemCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat=共 {0} 条}" />

                <!--  ② 每页数量切换器  -->
                <StackPanel
                    x:Name="SizeChanger"
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="每页" />
                    <ComboBox
                        MinWidth="72"
                        ItemsSource="{TemplateBinding PageSizeOptions}"
                        SelectedValue="{Binding PageSize, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="条" />
                </StackPanel>

                <!--  ③ 页码区(居中)  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <!--  跳第一页 ⏮  -->
                    <Button
                        Command="{x:Static ctl:Pagination.FirstCommand}"
                        Style="{StaticResource Pagination.Nav.Style.Basic}"
                        ToolTip="第一页">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M2,0 L2,10 M9,0 L4,5 L9,10"
                            Stretch="None"
                            Stroke="{DynamicResource Icon.Foreground.Default}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>

                    <!--  上一页 ←  -->
                    <Button
                        Command="{x:Static ctl:Pagination.PrevCommand}"
                        Style="{StaticResource Pagination.Nav.Style.Basic}"
                        ToolTip="上一页">
                        <Path
                            Width="6"
                            Height="10"
                            Data="M6,0 L1,5 L6,10"
                            Stretch="None"
                            Stroke="{DynamicResource Icon.Foreground.Default}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>

                    <!--  页码按钮列表  -->
                    <ItemsControl ItemsSource="{TemplateBinding PageItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ctl:PageItem}">
                                <Button Style="{StaticResource Pagination.PageItem.Style.Basic}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  下一页 →  -->
                    <Button
                        Command="{x:Static ctl:Pagination.NextCommand}"
                        Style="{StaticResource Pagination.Nav.Style.Basic}"
                        ToolTip="下一页">
                        <Path
                            Width="6"
                            Height="10"
                            Data="M1,0 L6,5 L1,10"
                            Stretch="None"
                            Stroke="{DynamicResource Icon.Foreground.Default}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>

                    <!--  跳最后一页 ⏭  -->
                    <Button
                        Command="{x:Static ctl:Pagination.LastCommand}"
                        Style="{StaticResource Pagination.Nav.Style.Basic}"
                        ToolTip="最后一页">
                        <Path
                            Width="10"
                            Height="10"
                            Data="M1,0 L6,5 L1,10 M8,0 L8,10"
                            Stretch="None"
                            Stroke="{DynamicResource Icon.Foreground.Default}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>
                </StackPanel>

                <!--  ④ 跳转输入  -->
                <StackPanel
                    x:Name="Jumper"
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="前往" />
                    <ctl:NumberBox
                        x:Name="PART_GotoNumberBox"
                        MinWidth="64"
                        Maximum="{Binding PageCount, RelativeSource={RelativeSource TemplatedParent}}"
                        Minimum="1">
                        <ctl:NumberBox.InputBindings>
                            <KeyBinding
                                Key="Enter"
                                Command="{x:Static ctl:Pagination.GotoCommand}"
                                CommandParameter="{Binding Value, RelativeSource={RelativeSource AncestorType=ctl:NumberBox}}" />
                        </ctl:NumberBox.InputBindings>
                    </ctl:NumberBox>
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="页" />
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ShowInfo" Value="False">
                <Setter TargetName="InfoText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowSizeChanger" Value="False">
                <Setter TargetName="SizeChanger" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowJumper" Value="False">
                <Setter TargetName="Jumper" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  Pagination 默认样式  -->
    <!--  ============================================================  -->
    <Style
        x:Key="Pagination.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="{x:Type ctl:Pagination}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Pagination.ControlTemplate.Basic}" />
    </Style>

    <Style BasedOn="{StaticResource Pagination.Style.Basic}" TargetType="ctl:Pagination" />
</ResourceDictionary>
