<!--
    ============================================================================
    IconBox 样式 — 统一图标控件
    
    自动按 Content 类型分发渲染:
    - Geometry → Path (矢量,跟随 Foreground)
    - ImageSource → Image (位图)
    - string → 字体图标 Glyph (FontFamily + FontSize + Foreground)
    
    尺寸控制:
    - 默认 16×16 (在 IconBox.cs 静态构造函数里设)
    - Path / Image — Width/Height 撑满 IconBox,Viewbox 等比缩放内容
    - Glyph — FontSize 控制(默认跟随 Foreground 颜色 + 系统 FontFamily)
    
    修复(vs 原版):
    - Viewbox 不再绑 Width/Height (NaN 会塌缩),改用 Stretch 自然填充
    - FontTemplate 加 FontSize 绑定,字体图标可通过 FontSize 控制大小
    - 字符串歧义说明保留在 IconBox.cs 注释中:用户传 Path Data 字符串会被识别为 Glyph
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <!--  模板选择器单例  -->
    <ctl:IconTemplateSelector x:Key="IconBox.TemplateSelector">

        <!--  矢量 Path 模板  -->
        <ctl:IconTemplateSelector.PathTemplate>
            <DataTemplate>
                <!--
                    Viewbox 自动拉伸到父容器 (IconBox) 尺寸 — 不绑 Width/Height
                    Path Data 任意坐标系都会被等比缩放填充
                -->
                <Viewbox Stretch="Uniform">
                    <Path
                        Data="{Binding}"
                        Fill="{Binding RelativeSource={RelativeSource AncestorType=ctl:IconBox}, Path=Foreground}"
                        Stretch="None" />
                </Viewbox>
            </DataTemplate>
        </ctl:IconTemplateSelector.PathTemplate>

        <!--  位图 Image 模板  -->
        <ctl:IconTemplateSelector.ImageTemplate>
            <DataTemplate>
                <Image Source="{Binding}" Stretch="Uniform" />
            </DataTemplate>
        </ctl:IconTemplateSelector.ImageTemplate>

        <!--  字体图标 Glyph 模板  -->
        <ctl:IconTemplateSelector.FontTemplate>
            <DataTemplate>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{Binding RelativeSource={RelativeSource AncestorType=ctl:IconBox}, Path=FontFamily}"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=ctl:IconBox}, Path=FontSize}"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=ctl:IconBox}, Path=Foreground}"
                    Text="{Binding}"
                    TextAlignment="Center" />
            </DataTemplate>
        </ctl:IconTemplateSelector.FontTemplate>
    </ctl:IconTemplateSelector>

    <!--  ============================================================  -->
    <!--  IconBox 默认样式  -->
    <!--  ============================================================  -->
    <Style x:Key="IconBox.Style.Basic" TargetType="{x:Type ctl:IconBox}">
        <Setter Property="Foreground" Value="{DynamicResource Icon.Foreground.Default}" />
        <Setter Property="ContentTemplateSelector" Value="{StaticResource IconBox.TemplateSelector}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:IconBox}">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="{TemplateBinding Content}"
                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource IconBox.Style.Basic}" TargetType="{x:Type ctl:IconBox}" />
</ResourceDictionary>
