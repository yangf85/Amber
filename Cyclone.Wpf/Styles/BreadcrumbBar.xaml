<!--
    ============================================================================
    BreadcrumbBar 样式 (WinUI 3 风格 · 无圆角 · 扁平文本 + 分隔符)
    
    视觉:
    - 扁平文本项 (无背景,Hover/Selected 才显色)
    - 默认 > 分隔符 (最后一项隐藏)
    - Icon=null 时图标列彻底隐藏 (不占空间)
    - 三种状态视觉:
    · 默认  — Foreground.Caption (灰色)
    · Hover — Background.Hover + Foreground.Default 强调
    · Last  — Foreground.Default 自动强调最后一项(当前位置)
    · Selected — Background.Hover + Foreground.Default (键盘焦点 / 程序选中)
    
    Indicator (分隔符) 通过 DP 暴露,用户可自定义:
    - 默认 ">" (TextBlock)
    - 用户可设字符 "/" / "→"
    - 用户可通过 IndicatorTemplate 完全自定义 (Path、Image 等)
    
    溢出:横向 ScrollBar Hidden (滚轮可滚),长路径不被截断也不喧宾夺主。
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        默认 Indicator 模板 — ">" 字符
        用户可通过 BreadcrumbBarItem.IndicatorTemplate 覆盖,或直接给 Indicator 设其他对象 / 字符
    -->
    <DataTemplate x:Key="BreadcrumbBarItem.DefaultIndicatorTemplate">
        <TextBlock
            Margin="6,0"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{DynamicResource Foreground.Caption}"
            Text="{Binding}" />
    </DataTemplate>

    <!--  ============================================================  -->
    <!--  BreadcrumbBarItem 样式  -->
    <!--  ============================================================  -->
    <Style x:Key="BreadcrumbBarItem.Style.Basic" TargetType="ctl:BreadcrumbBarItem">
        <Setter Property="Height" Value="{DynamicResource Height.Horizontal.Control}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!--  默认 Indicator 值为 ">"——可在使用处覆盖  -->
        <Setter Property="Indicator" Value="&gt;" />
        <Setter Property="IndicatorTemplate" Value="{StaticResource BreadcrumbBarItem.DefaultIndicatorTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:BreadcrumbBarItem">
                    <StackPanel Orientation="Horizontal">
                        <!--  Item Body  -->
                        <Border
                            x:Name="ItemBody"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <!--  Icon — 默认 Visible,Icon=null 时通过 trigger Collapse  -->
                                <ContentPresenter
                                    x:Name="IconPresenter"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}" />
                                <!--  Header / Content  -->
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </StackPanel>
                        </Border>

                        <!--  Indicator (分隔符) — 最后一项隐藏  -->
                        <ContentPresenter
                            x:Name="IndicatorPresenter"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Indicator}"
                            ContentTemplate="{TemplateBinding IndicatorTemplate}" />
                    </StackPanel>

                    <ControlTemplate.Triggers>

                        <!--  Icon=null — 隐藏图标列  -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  最后一项 — 隐藏分隔符 + 文字强调为主色 (表示当前位置)  -->
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="IndicatorPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>

                        <!--  Hover (非最后一项) — 整块浅底 + 文字强调  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsLast" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBody" Property="Background" Value="{DynamicResource Background.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
                        </MultiTrigger>

                        <!--  Selected (非最后一项) — 程序化选中或键盘焦点  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsLast" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBody" Property="Background" Value="{DynamicResource Background.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
                        </MultiTrigger>

                        <!--  键盘焦点 — Tab 进入时给视觉反馈  -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ItemBody" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </Trigger>

                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BreadcrumbBarItem.Style.Basic}" TargetType="ctl:BreadcrumbBarItem" />

    <!--  ============================================================  -->
    <!--  BreadcrumbBar 样式  -->
    <!--  ============================================================  -->
    <Style
        x:Key="BreadcrumbBar.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="ctl:BreadcrumbBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:BreadcrumbBar">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <!--
                            横向 ScrollViewer — 滚动条 Hidden,但滚轮 / 触摸仍可滚。
                            长面包屑路径 (Home > 项目 > 2026 > Q1 > ...) 不会被裁掉。
                        -->
                        <ScrollViewer
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BreadcrumbBar.Style.Basic}" TargetType="ctl:BreadcrumbBar" />
</ResourceDictionary>
