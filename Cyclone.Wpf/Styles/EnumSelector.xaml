<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Themes/BasicTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        ListBoxItem 容器样式：去掉 ListBox 的视觉，由内部 RadioButton/CheckBox 自带。
        保留 padding 与 focus 反馈，避免无障碍信息丢失。
    -->
    <Style x:Key="EnumSelector.ItemContainer.Style.Basic" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Small}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RadioButton 模式的默认 ItemTemplate  -->
    <DataTemplate x:Key="EnumSelector.ItemTemplate.RadioButton">
        <RadioButton
            Content="{Binding DisplayText}"
            GroupName="{Binding RadioButtonGroupName, RelativeSource={RelativeSource AncestorType={x:Type ctl:EnumSelector}}}"
            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
    </DataTemplate>

    <!--  CheckBox 模式的默认 ItemTemplate  -->
    <DataTemplate x:Key="EnumSelector.ItemTemplate.CheckBox">
        <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
    </DataTemplate>

    <!--  EnumSelector 控件模板  -->
    <ControlTemplate x:Key="EnumSelector.ControlTemplate.Basic" TargetType="{x:Type ctl:EnumSelector}">
        <Border
            x:Name="PART_RootBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <ItemsPresenter />
        </Border>
    </ControlTemplate>

    <!--  EnumSelector 默认样式  -->
    <Style x:Key="EnumSelector.Style.Basic" TargetType="{x:Type ctl:EnumSelector}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.None}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EnumSelector.ItemContainer.Style.Basic}" />
        <Setter Property="ItemTemplate" Value="{StaticResource EnumSelector.ItemTemplate.RadioButton}" />
        <Setter Property="Template" Value="{StaticResource EnumSelector.ControlTemplate.Basic}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid
                        x:Name="PART_ItemsHost"
                        Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type ctl:EnumSelector}}}"
                        Rows="{Binding Rows, RelativeSource={RelativeSource AncestorType={x:Type ctl:EnumSelector}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--
                EffectiveDisplayMode=CheckBox 时切换到 CheckBox 模板。
                注意：用户在 XAML 上显式赋值 ItemTemplate 时，DataTrigger 仍会覆盖；
                如果用户想要"完全自定义"，应同时不依赖 DisplayMode（或在自定义模板里自己处理两种模式）。
            -->
            <Trigger Property="EffectiveDisplayMode" Value="CheckBox">
                <Setter Property="ItemTemplate" Value="{StaticResource EnumSelector.ItemTemplate.CheckBox}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource EnumSelector.Style.Basic}" TargetType="{x:Type ctl:EnumSelector}" />

</ResourceDictionary>
