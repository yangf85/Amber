<!--
    ============================================================================
    RotationEditor 样式 (XYZ 三轴角度编辑器)
    
    设计要点:
    - XYZ 三轴用 红/绿/蓝 经典色彩约定(Blender/Unity/3ds Max 通用),不用主题 token
    - 每条 Slider 视觉跟项目 Slider 一致 — 圆形 Thumb,4px Track,左段彩色填充
    - 轴标签 22×22 彩色方块 + 白字
    - IsSnapToTickEnabled=True + TickFrequency=Step,让 Step 控制鼠标拖动也按步长跳
    - Reset 命令通过类级 CommandBinding 处理 — 模板不需要写命令绑定
    
    修复 (vs 旧版):
    - Thumb 12×18 方形 → 14px 圆形,跟项目其他 Slider 一致
    - Background.Control / BorderThickness.Thin → Background.Container / BorderThickness=1
    - 命名三段式:RotationEditor.Slider.Style.X 等
    - 轴标签去掉冗余的 ContentPresenter Style (Border 已经定义了尺寸)
    - 加 IsSnapToTickEnabled — 让 Step 真正生效(原版 Step 只控制键盘,鼠标拖动是连续的)
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================================================  -->
    <!--  XYZ 标准色 (Blender / Unity / 3ds Max 通用约定)  -->
    <!--  这些是语义色,不放主题 token (主题切换也不应该变)  -->
    <!--  ============================================================  -->
    <SolidColorBrush x:Key="RotationEditor.Color.X" Color="#D44040" />
    <SolidColorBrush x:Key="RotationEditor.Color.Y" Color="#3AAA5C" />
    <SolidColorBrush x:Key="RotationEditor.Color.Z" Color="#3A7AD4" />

    <!--  ============================================================  -->
    <!--  RepeatButton — 轨道两侧,只承担 Background 渲染  -->
    <!--  ============================================================  -->
    <Style x:Key="RotationEditor.Slider.RepeatButton.Style.Basic" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        Height="4"
                        VerticalAlignment="Center"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  Thumb — 圆形,边框跟随 Slider.Foreground (= 轴色)  -->
    <!--  Hover 略放大,跟项目 Slider 视觉语言一致  -->
    <!--  ============================================================  -->
    <Style x:Key="RotationEditor.Slider.Thumb.Style.Basic" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse
                        x:Name="ThumbBody"
                        Fill="{DynamicResource Background.Container}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                        StrokeThickness="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Width" Value="16" />
                            <Setter TargetName="ThumbBody" Property="Height" Value="16" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  Slider 模板 — 4px 轨道,Foreground 作为左侧已通过段颜色 (轴色)  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="RotationEditor.Slider.ControlTemplate.Basic" TargetType="Slider">
        <Grid
            Height="22"
            VerticalAlignment="Center"
            Background="Transparent">
            <!--  轨道底色  -->
            <Border
                Height="4"
                VerticalAlignment="Center"
                Background="{DynamicResource Background.Inactive}"
                SnapsToDevicePixels="True" />
            <!--  实际 Track  -->
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton
                        Background="{TemplateBinding Foreground}"
                        Command="Slider.DecreaseLarge"
                        Style="{StaticResource RotationEditor.Slider.RepeatButton.Style.Basic}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton
                        Background="Transparent"
                        Command="Slider.IncreaseLarge"
                        Style="{StaticResource RotationEditor.Slider.RepeatButton.Style.Basic}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource RotationEditor.Slider.Thumb.Style.Basic}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  三轴 Slider 基础样式 + 三个变体  -->
    <!--  ============================================================  -->
    <Style x:Key="RotationEditor.Slider.Style.Basic" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="359.99" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource RotationEditor.Slider.ControlTemplate.Basic}" />
    </Style>

    <Style
        x:Key="RotationEditor.Slider.Style.X"
        BasedOn="{StaticResource RotationEditor.Slider.Style.Basic}"
        TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource RotationEditor.Color.X}" />
    </Style>

    <Style
        x:Key="RotationEditor.Slider.Style.Y"
        BasedOn="{StaticResource RotationEditor.Slider.Style.Basic}"
        TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource RotationEditor.Color.Y}" />
    </Style>

    <Style
        x:Key="RotationEditor.Slider.Style.Z"
        BasedOn="{StaticResource RotationEditor.Slider.Style.Basic}"
        TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource RotationEditor.Color.Z}" />
    </Style>

    <!--  ============================================================  -->
    <!--  轴标签 ContentPresenter 样式  -->
    <!--  Border 父容器负责尺寸和背景,ContentPresenter 只管文字居中和样式  -->
    <!--  ============================================================  -->
    <Style x:Key="RotationEditor.AxisLabel.Style.Basic" TargetType="ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="TextBlock.TextAlignment" Value="Center" />
    </Style>

    <!--  ============================================================  -->
    <!--  RotationEditor 主模板  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="RotationEditor.ControlTemplate.Basic" TargetType="ctl:RotationEditor">
        <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  X 轴标签 + Slider  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="22"
                    Height="22"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource RotationEditor.Color.X}">
                    <ContentPresenter Content="{TemplateBinding LabelX}" Style="{StaticResource RotationEditor.AxisLabel.Style.Basic}" />
                </Border>
                <Slider
                    x:Name="PART_XSlider"
                    Grid.Row="0"
                    Grid.Column="1"
                    AutoToolTipPlacement="{TemplateBinding AutoToolTipPlacement}"
                    AutoToolTipPrecision="{TemplateBinding AutoToolTipPrecision}"
                    IsSnapToTickEnabled="True"
                    LargeChange="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    SmallChange="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    Style="{StaticResource RotationEditor.Slider.Style.X}"
                    TickFrequency="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    Value="{Binding AngleX, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                <!--  Y 轴  -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="22"
                    Height="22"
                    Margin="0,8,10,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource RotationEditor.Color.Y}">
                    <ContentPresenter Content="{TemplateBinding LabelY}" Style="{StaticResource RotationEditor.AxisLabel.Style.Basic}" />
                </Border>
                <Slider
                    x:Name="PART_YSlider"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    AutoToolTipPlacement="{TemplateBinding AutoToolTipPlacement}"
                    AutoToolTipPrecision="{TemplateBinding AutoToolTipPrecision}"
                    IsSnapToTickEnabled="True"
                    LargeChange="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    SmallChange="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    Style="{StaticResource RotationEditor.Slider.Style.Y}"
                    TickFrequency="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    Value="{Binding AngleY, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                <!--  Z 轴  -->
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Width="22"
                    Height="22"
                    Margin="0,8,10,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource RotationEditor.Color.Z}">
                    <ContentPresenter Content="{TemplateBinding LabelZ}" Style="{StaticResource RotationEditor.AxisLabel.Style.Basic}" />
                </Border>
                <Slider
                    x:Name="PART_ZSlider"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    AutoToolTipPlacement="{TemplateBinding AutoToolTipPlacement}"
                    AutoToolTipPrecision="{TemplateBinding AutoToolTipPrecision}"
                    IsSnapToTickEnabled="True"
                    LargeChange="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    SmallChange="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    Style="{StaticResource RotationEditor.Slider.Style.Z}"
                    TickFrequency="{Binding Step, RelativeSource={RelativeSource TemplatedParent}}"
                    Value="{Binding AngleZ, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  RotationEditor 默认样式  -->
    <!--  ============================================================  -->
    <Style x:Key="RotationEditor.Style.Basic" TargetType="ctl:RotationEditor">
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource RotationEditor.ControlTemplate.Basic}" />
    </Style>

    <Style BasedOn="{StaticResource RotationEditor.Style.Basic}" TargetType="ctl:RotationEditor" />
</ResourceDictionary>
