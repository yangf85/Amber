<!--
    ============================================================================
    WinUI 3 风格 TabControl 样式 (v2 — pill 指示器 + 融入内容区 + 无圆角)

    破坏性变更说明（vs 旧版本）：
    - 视觉风格全面改版，与 ListBox / ListView / TreeView / DataGrid 视觉对齐：
    · 选中指示器从 2px 矩形 → 3px pill 圆头（横向是 4px 长条 / 纵向是 3px 竖条），
    带 ScaleX/ScaleY 弹性扩展动画
    · 默认 TabItem 背景透明（不再默认浅灰），Hover 才显 Background.Hover
    · 选中 TabItem 背景 = Background.Container（和内容区底色一致——视觉融合）
    · 选中态字重加粗 (Medium → SemiBold) + 颜色加深 (Foreground.Default → Link)
    · 失焦弱化：Selector.IsSelectionActive=False 时指示器变 Highlighted
    · 禁用态 + 自定义 FocusVisual（无障碍键盘聚焦提示）
    · 无圆角

    - 修复横向指示器的负 Margin hack：
    · 旧版 Indicator Margin=-15,0 用负值突破 Padding 边界——能 work 但脆弱
    · 新版指示器放 RootBorder 外层 Grid，自然贯穿整个 tab 宽度

    - 修复未选中和 hover 视觉同色问题：
    · 旧版默认背景 Background.Header (#F5F5F5)
    · 新版默认透明，hover 才显浅灰，反馈清晰

    保留行为：
    - TabStripPlacement 4 方向触发器切模板和 ItemContainerStyle
    - 内容区背景 Background.Container（白）
    - 选中态切换的视觉过渡走动画（150-180ms）
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Cyclone.Wpf.Converters"
    xmlns:hp="clr-namespace:Cyclone.Wpf.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Focus visual：键盘 Tab 聚焦时的虚线框  -->
    <Style x:Key="TabItem.FocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Margin="2"
                        SnapsToDevicePixels="True"
                        Stroke="{DynamicResource Foreground.Link}"
                        StrokeDashArray="1 2"
                        StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  TabItem 横向（Top / Bottom）  -->
    <!--  ============================================================  -->
    <Style x:Key="TabItem.Style.Horizontal" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Height" Value="{DynamicResource Height.Horizontal.Header}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Header}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TabItem.FocusVisualStyle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!--
                        外层 Grid 包含 RootBorder + 指示器
                        指示器放 Grid 顶/底层，绕过 RootBorder 的 Padding 自然贯穿整宽
                    -->
                    <Grid x:Name="OuterGrid" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="RootBorder"
                            Grid.Row="0"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                x:Name="ContentContainer"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                Focusable="False"
                                RecognizesAccessKey="True" />
                        </Border>

                        <!--  指示器：默认底部，Bottom placement 时切到顶部  -->
                        <Border
                            x:Name="Indicator"
                            Grid.Row="1"
                            Height="3"
                            Margin="20,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource Background.Selected}"
                            CornerRadius="2"
                            Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="IndicatorScale" ScaleX="0.4" />
                            </Border.RenderTransform>
                            <Border.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </Border.RenderTransformOrigin>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  Bottom 放置：指示器从底部翻到顶部  -->
                        <DataTrigger Binding="{Binding Path=TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TabControl}}" Value="Bottom">
                            <Setter TargetName="Indicator" Property="Grid.Row" Value="0" />
                            <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Top" />
                        </DataTrigger>

                        <!--  Hover (未选中)：浅底 + 颜色提示  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </MultiTrigger>

                        <!--  选中态：整 tab 底色 = 内容区底色 + 字重加粗 + 颜色加深 + 指示器淡入  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Indicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Indicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.10" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.4"
                                            Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Container}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
                        </Trigger>

                        <!--  选中 + 失焦：指示器弱化  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Background.Highlighted}" />
                        </MultiTrigger>

                        <!--  禁用态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  TabItem 纵向（Left / Right）  -->
    <!--  ============================================================  -->
    <Style x:Key="TabItem.Style.Vertical" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Height" Value="{DynamicResource Height.Horizontal.Header}" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Header}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TabItem.FocusVisualStyle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="OuterGrid" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  指示器：默认左侧（Left placement），Right placement 时翻到右侧  -->
                        <Border
                            x:Name="Indicator"
                            Grid.Column="0"
                            Width="3"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Background.Selected}"
                            CornerRadius="2"
                            Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="IndicatorScale" ScaleY="0.4" />
                            </Border.RenderTransform>
                            <Border.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </Border.RenderTransformOrigin>
                        </Border>

                        <Border
                            x:Name="RootBorder"
                            Grid.Column="1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                x:Name="ContentContainer"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                Focusable="False"
                                RecognizesAccessKey="True" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  Right 放置：调换列顺序 — 指示器到右侧 + 内容左对齐改右对齐  -->
                        <DataTrigger Binding="{Binding Path=TabStripPlacement, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TabControl}}" Value="Right">
                            <Setter TargetName="Indicator" Property="Grid.Column" Value="1" />
                            <Setter TargetName="RootBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentContainer" Property="HorizontalAlignment" Value="Right" />
                        </DataTrigger>

                        <!--  Hover  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </MultiTrigger>

                        <!--  选中态  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Indicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Indicator"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.10" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.4"
                                            Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Container}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
                        </Trigger>

                        <!--  选中 + 失焦  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Background.Highlighted}" />
                        </MultiTrigger>

                        <!--  禁用态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  TabControl 模板 - Top  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="TabControl.ControlTemplate.Top" TargetType="TabControl">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Tab 头条 + 底部分隔线  -->
                <Grid Grid.Row="0">
                    <ScrollViewer
                        CanContentScroll="False"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <TabPanel
                            x:Name="HeaderPanel"
                            IsItemsHost="True"
                            KeyboardNavigation.TabIndex="1" />
                    </ScrollViewer>
                    <Border
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Background.Container}">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  TabControl 模板 - Bottom  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="TabControl.ControlTemplate.Bottom" TargetType="TabControl">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Background.Container}">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer
                        CanContentScroll="False"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <TabPanel
                            x:Name="HeaderPanel"
                            IsItemsHost="True"
                            KeyboardNavigation.TabIndex="1" />
                    </ScrollViewer>
                    <Border
                        Height="1"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Border.Default}" />
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  TabControl 模板 - Left  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="TabControl.ControlTemplate.Left" TargetType="TabControl">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TabPanel
                        x:Name="HeaderPanel"
                        IsItemsHost="True"
                        KeyboardNavigation.TabIndex="1" />
                    <Border
                        Width="1"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource Border.Default}" />
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource Background.Container}">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  TabControl 模板 - Right  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="TabControl.ControlTemplate.Right" TargetType="TabControl">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Background.Container}">
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Border>

                <Grid Grid.Column="1">
                    <TabPanel
                        x:Name="HeaderPanel"
                        IsItemsHost="True"
                        KeyboardNavigation.TabIndex="1" />
                    <Border
                        Width="1"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Border.Default}" />
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  TabControl 主样式  -->
    <!--  ============================================================  -->
    <Style
        x:Key="TabControl.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="TabControl">
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="TabStripPlacement" Value="Top">
                <Setter Property="Template" Value="{StaticResource TabControl.ControlTemplate.Top}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource TabItem.Style.Horizontal}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Bottom">
                <Setter Property="Template" Value="{StaticResource TabControl.ControlTemplate.Bottom}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource TabItem.Style.Horizontal}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter Property="Template" Value="{StaticResource TabControl.ControlTemplate.Left}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource TabItem.Style.Vertical}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter Property="Template" Value="{StaticResource TabControl.ControlTemplate.Right}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource TabItem.Style.Vertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource TabControl.Style.Basic}" TargetType="TabControl" />
</ResourceDictionary>