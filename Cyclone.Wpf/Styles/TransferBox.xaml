<!--
    ============================================================================
    TransferBox 样式 (WinUI 3 风格 · 无圆角)
    
    核心改动:
    - 删掉重复实现的 TransferBox.ListBoxItemStyle / TransferBox.ListBoxStyle
      直接复用 ListBox.xaml 的默认样式——视觉、ScrollViewer、左 3px 竖条 indicator、
      整行浅底,全部白送
    - 两侧 ListBox 标准多选(单击 / Ctrl+Click / Shift+Click),无 CheckBox
    - BorderThickness=0 + Background=Transparent — 避免与外层 Border 重边框
    
    修复:
    - Header 行高用子元素 Border.Height 撑起 (Header 为 null 时不再塌缩,
      RowDefinition.Height 是 GridLength 不能直接绑 double 主题资源)
    - Button container 只占 Row 2 — Header 横向连贯,不被 button column 截断
    - RepeatButton 加 FocusVisualStyle=Null + IsKeyboardFocused 反馈
    
    标题字重 Medium + 主题前景色,跟正文区分。
    
    注:hp 命名空间已不再使用,可以删除——保留只是以防用户在 ItemsPanel/
       ItemContainerStyle 等自定义场景里需要。
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================================================  -->
    <!--  中间 RepeatButton 样式  -->
    <!--  ============================================================  -->
    <Style x:Key="TransferBox.TransferButtonStyle" TargetType="RepeatButton">
        <Setter Property="MinWidth" Value="{DynamicResource Width.Vertical.Item}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  TransferBox 主模板  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="TransferBox.ControlTemplate.Basic" TargetType="ctl:TransferBox">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <!--
                        Header 行 — Auto:由子元素 Border 的 Height 决定行高
                        (RowDefinition.Height 是 GridLength,而主题资源 Height.Horizontal.Header 是 double,
                         不能直接绑,所以放到 Border 上)
                    -->
                    <RowDefinition Height="Auto" />
                    <!--  横向分隔线  -->
                    <RowDefinition Height="Auto" />
                    <!--  内容区  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Header 背景 — 跨整个 Header 行,横向连贯
                    Height 固定到 Height.Horizontal.Header,即使 SourceHeader/TargetHeader 为 null 也不塌缩
                -->
                <Border
                    Grid.Row="0"
                    Grid.ColumnSpan="5"
                    Height="{DynamicResource Height.Horizontal.Header}"
                    Background="{DynamicResource Background.Header}" />

                <!--  Source / Target 标题 — Medium 字重 + 主题前景色,跟列表项区分  -->
                <ContentPresenter
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding SourceHeader}"
                    TextElement.FontWeight="Medium"
                    TextElement.Foreground="{DynamicResource Foreground.Default}" />
                <ContentPresenter
                    Grid.Row="0"
                    Grid.Column="4"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding TargetHeader}"
                    TextElement.FontWeight="Medium"
                    TextElement.Foreground="{DynamicResource Foreground.Default}" />

                <!--  横向分隔线 — Header 下方  -->
                <Rectangle
                    Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Height="1"
                    Fill="{TemplateBinding BorderBrush}" />

                <!--  竖向分隔线 — 贯穿整个高度,把内容区分成三个 column  -->
                <Rectangle
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="1"
                    Width="1"
                    Fill="{TemplateBinding BorderBrush}" />
                <Rectangle
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="3"
                    Width="1"
                    Fill="{TemplateBinding BorderBrush}" />

                <!--
                    Source ListBox — 直接用 ListBox 默认样式
                    Style 不设 → 命中 ListBox.xaml 里的 ListBox.Style.Basic
                    自动获得:左 3px 竖条 indicator、整行浅底、内置 ScrollViewer、无圆角
                    标准多选交互(单击 / Ctrl+Click / Shift+Click),无 CheckBox
                -->
                <ListBox
                    x:Name="PART_SourceListBox"
                    Grid.Row="2"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderThickness="0"
                    DisplayMemberPath="{TemplateBinding SourceDisplayMemberPath}"
                    ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                    ItemTemplate="{TemplateBinding ItemTemplate}"
                    ItemsPanel="{TemplateBinding ItemsPanel}"
                    ItemsSource="{TemplateBinding SourceItems}"
                    SelectionMode="Multiple" />

                <!--
                    中间 button container — 只占 Row 2,不再用 RowSpan 覆盖 Header
                    Header 行的背景由顶部的 Border 跨整个宽度负责,这里只贴 Row 2 的 Container 色
                -->
                <Grid
                    Grid.Row="2"
                    Grid.Column="2"
                    Background="{DynamicResource Background.Container}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  → 移到目标  -->
                    <RepeatButton
                        x:Name="PART_ToTargetRepeatButton"
                        Grid.Row="0"
                        Height="32"
                        VerticalAlignment="Bottom"
                        Command="{x:Static ctl:TransferBox.ToTargetCommand}"
                        Style="{StaticResource TransferBox.TransferButtonStyle}">
                        <RepeatButton.Content>
                            <Path
                                Width="14"
                                Height="14"
                                Data="M516.266667 494.933333l-192 192-29.866667-29.866666 162.133333-162.133334-162.133333-162.133333 29.866667-29.866667 192 192z m256 0l-192 192-29.866667-29.866666 162.133333-162.133334-162.133333-162.133333 29.866667-29.866667 192 192z"
                                Fill="{DynamicResource Icon.Foreground.Default}"
                                Stretch="Uniform" />
                        </RepeatButton.Content>
                    </RepeatButton>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{TemplateBinding BorderBrush}" />

                    <!--  ← 移回源  -->
                    <RepeatButton
                        x:Name="PART_ToSourceRepeatButton"
                        Grid.Row="2"
                        Height="32"
                        VerticalAlignment="Top"
                        Command="{x:Static ctl:TransferBox.ToSourceCommand}"
                        Style="{StaticResource TransferBox.TransferButtonStyle}">
                        <RepeatButton.Content>
                            <Path
                                Width="14"
                                Height="14"
                                Data="M550.4 494.933333l192 192 29.866667-29.866666-162.133334-162.133334 162.133334-162.133333-29.866667-29.866667-192 192z m-256 0l192 192 29.866667-29.866666-162.133334-162.133334 162.133334-162.133333-29.866667-29.866667-192 192z"
                                Fill="{DynamicResource Icon.Foreground.Default}"
                                Stretch="Uniform" />
                        </RepeatButton.Content>
                    </RepeatButton>
                </Grid>

                <!--  Target ListBox — 同 Source,默认 ListBox 样式  -->
                <ListBox
                    x:Name="PART_TargetListBox"
                    Grid.Row="2"
                    Grid.Column="4"
                    Background="Transparent"
                    BorderThickness="0"
                    DisplayMemberPath="{TemplateBinding TargetDisplayMemberPath}"
                    ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                    ItemTemplate="{TemplateBinding ItemTemplate}"
                    ItemsPanel="{TemplateBinding ItemsPanel}"
                    ItemsSource="{TemplateBinding TargetItems}"
                    SelectionMode="Multiple" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <!--  整体 Disabled — 半透明  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style
        x:Key="TransferBox.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="ctl:TransferBox">
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--
            ItemContainerStyle 不再默认绑定到自定义样式——保持 null,
            ListBox 自然走 ListBox.xaml 的 ListBoxItem.Style.Default
            (左 3px 竖条 + 整行浅底,标准多选,无 CheckBox)。
            用户仍可显式赋值 TransferBox.ItemContainerStyle 自定义渲染。
        -->
        <!--
            ItemsPanel 默认值——必须设,否则 TemplateBinding 写 null 给 ListBox.ItemsPanel 会让 items 不渲染。
            ListBoxItem 模板里 SharedSizeGroup 已删除,这里可以换成 VirtualizingStackPanel
            提升大数据集性能;暂用 StackPanel 保持默认行为不变。
        -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template" Value="{StaticResource TransferBox.ControlTemplate.Basic}" />
    </Style>

    <Style BasedOn="{StaticResource TransferBox.Style.Basic}" TargetType="ctl:TransferBox" />
</ResourceDictionary>
