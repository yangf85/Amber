<!--
    ============================================================================
    Stepper 样式 (WinUI 3 风格 · 无圆角 · 三态指示器 + 动画过渡)
    
    设计要点:
    
    指示器 (28×28 圆球):
    - Pending — 透明 Fill + Border.Default 1.5px outline + 灰色数字
    - Current — Background.Selected 实心 + 白色粗体数字 + 外圈光环 (ScaleY ring + Opacity 1)
    - Completed — Background.Success 实心 + 细 stroke ✓ (替换原 1000×1000 锯齿 Path)
    
    连接线: 2px 细线 (原 5px 太粗)。同样状态色:Pending=灰,Current/Completed=主题色。
    
    交互反馈:
    - CanNavigate=True (默认) — Cursor=Hand,Hover 时指示器 Opacity 0.85,Pressed 0.7
    - CanNavigate=False — Cursor=Arrow,无 hover 反馈
    
    状态切换: ColorAnimation 0.25s 平滑过渡(避免瞬间换色生硬)
    
    无圆角 (与项目规约对齐)
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Cyclone.Wpf.Converters"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================================================  -->
    <!--  StepperItem 水平模板  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="StepperItem.ControlTemplate.Basic.Horizontal" TargetType="{x:Type ctl:StepperItem}">
        <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ① 指示器行 — 连接线 + 圆球 + 连接线  -->
            <Grid Grid.Row="0" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle
                    x:Name="LeftConnector"
                    Grid.Column="0"
                    Height="2"
                    Fill="{DynamicResource Border.Default}"
                    SnapsToDevicePixels="True" />

                <!--  圆球 + Index 文本 + ✓ 完成图标 + 外圈光环  -->
                <Grid Grid.Column="1" Width="40">
                    <!--  外圈光环 (Current 状态时弹入,作 focus 强调)  -->
                    <Ellipse
                        x:Name="IndicatorRing"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        Stroke="{DynamicResource Background.Selected}"
                        StrokeThickness="2">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="IndicatorRingScale" ScaleX="0.7" ScaleY="0.7" />
                        </Ellipse.RenderTransform>
                        <Ellipse.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5" />
                        </Ellipse.RenderTransformOrigin>
                    </Ellipse>

                    <!--  圆球指示器  -->
                    <Ellipse
                        x:Name="IndicatorEllipse"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="Transparent"
                        Stroke="{DynamicResource Border.Default}"
                        StrokeThickness="1.5" />

                    <!--  Index 数字 (Pending / Current)  -->
                    <TextBlock
                        x:Name="IndexTextBlock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="{Binding Path=Index, Converter={x:Static conv:MathConverter.AddOne}, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ctl:StepperItem}}" />

                    <!--  ✓ 完成图标 (替换 1000×1000 实心 Path,改为细 stroke)  -->
                    <Path
                        x:Name="IndexIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M2,7 L6,11 L12,3"
                        Stretch="None"
                        Stroke="White"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2"
                        Visibility="Collapsed" />
                </Grid>

                <Rectangle
                    x:Name="RightConnector"
                    Grid.Column="2"
                    Height="2"
                    Fill="{DynamicResource Border.Default}"
                    SnapsToDevicePixels="True" />
            </Grid>

            <!--  ② 文本行 — 标题 + 描述  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,8,0,0"
                HorizontalAlignment="Center">
                <ContentPresenter
                    HorizontalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    TextElement.FontWeight="Medium"
                    TextElement.Foreground="{DynamicResource Foreground.Default}" />
                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="{TemplateBinding Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ControlTemplate.Triggers>

            <!--  首/末项隐藏对应连接线  -->
            <Trigger Property="IsFirst" Value="True">
                <Setter TargetName="LeftConnector" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsLast" Value="True">
                <Setter TargetName="RightConnector" Property="Visibility" Value="Hidden" />
            </Trigger>

            <!--  Pending 态 — 默认外观  -->
            <Trigger Property="Status" Value="Pending">
                <Setter TargetName="IndicatorEllipse" Property="Fill" Value="Transparent" />
                <Setter TargetName="IndicatorEllipse" Property="Stroke" Value="{DynamicResource Border.Default}" />
                <Setter TargetName="IndexTextBlock" Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            </Trigger>

            <!--  Current 态 — 实心 + 白字 + 外圈光环弹入  -->
            <Trigger Property="Status" Value="Current">
                <Setter TargetName="IndicatorEllipse" Property="Fill" Value="{DynamicResource Background.Selected}" />
                <Setter TargetName="IndicatorEllipse" Property="Stroke" Value="{DynamicResource Background.Selected}" />
                <Setter TargetName="IndexTextBlock" Property="Foreground" Value="White" />
                <Setter TargetName="IndexTextBlock" Property="FontWeight" Value="Bold" />
                <Setter TargetName="LeftConnector" Property="Fill" Value="{DynamicResource Background.Selected}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRing"
                                Storyboard.TargetProperty="Opacity"
                                To="0.4"
                                Duration="0:0:0.25" />
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRing"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.15" />
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.7"
                                Duration="0:0:0.15" />
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.7"
                                Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!--  Completed 态 — 实心 + ✓  -->
            <Trigger Property="Status" Value="Completed">
                <Setter TargetName="IndicatorEllipse" Property="Fill" Value="{DynamicResource Background.Success}" />
                <Setter TargetName="IndicatorEllipse" Property="Stroke" Value="{DynamicResource Background.Success}" />
                <Setter TargetName="IndexTextBlock" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IndexIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="LeftConnector" Property="Fill" Value="{DynamicResource Background.Success}" />
                <Setter TargetName="RightConnector" Property="Fill" Value="{DynamicResource Background.Success}" />
            </Trigger>

            <!--  Hover + 可导航 — 圆球微微弱化  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="CanNavigate" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="IndicatorEllipse" Property="Opacity" Value="0.85" />
            </MultiTrigger>

            <!--  Disabled  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  StepperItem 垂直模板  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="StepperItem.ControlTemplate.Basic.Vertical" TargetType="{x:Type ctl:StepperItem}">
        <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ① 指示器列 — 上连接线 + 圆球 + 下连接线  -->
            <Grid Grid.Column="0" Width="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Rectangle
                    x:Name="TopConnector"
                    Grid.Row="0"
                    Width="2"
                    HorizontalAlignment="Center"
                    Fill="{DynamicResource Border.Default}"
                    SnapsToDevicePixels="True" />

                <Grid Grid.Row="1">
                    <Ellipse
                        x:Name="IndicatorRing"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        Stroke="{DynamicResource Background.Selected}"
                        StrokeThickness="2">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="IndicatorRingScale" ScaleX="0.7" ScaleY="0.7" />
                        </Ellipse.RenderTransform>
                        <Ellipse.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5" />
                        </Ellipse.RenderTransformOrigin>
                    </Ellipse>

                    <Ellipse
                        x:Name="IndicatorEllipse"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="Transparent"
                        Stroke="{DynamicResource Border.Default}"
                        StrokeThickness="1.5" />

                    <TextBlock
                        x:Name="IndexTextBlock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="{Binding Path=Index, Converter={x:Static conv:MathConverter.AddOne}, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ctl:StepperItem}}" />

                    <Path
                        x:Name="IndexIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M2,7 L6,11 L12,3"
                        Stretch="None"
                        Stroke="White"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2"
                        Visibility="Collapsed" />
                </Grid>

                <Rectangle
                    x:Name="BottomConnector"
                    Grid.Row="2"
                    Width="2"
                    HorizontalAlignment="Center"
                    Fill="{DynamicResource Border.Default}"
                    SnapsToDevicePixels="True" />
            </Grid>

            <!--  ② 内容列 — 标题 + 描述  -->
            <StackPanel
                Grid.Column="1"
                Margin="12,4,0,4"
                VerticalAlignment="Center">
                <ContentPresenter
                    HorizontalAlignment="Left"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    TextElement.FontWeight="Medium"
                    TextElement.Foreground="{DynamicResource Foreground.Default}" />
                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="{TemplateBinding Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsFirst" Value="True">
                <Setter TargetName="TopConnector" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsLast" Value="True">
                <Setter TargetName="BottomConnector" Property="Visibility" Value="Hidden" />
            </Trigger>

            <Trigger Property="Status" Value="Pending">
                <Setter TargetName="IndicatorEllipse" Property="Fill" Value="Transparent" />
                <Setter TargetName="IndicatorEllipse" Property="Stroke" Value="{DynamicResource Border.Default}" />
                <Setter TargetName="IndexTextBlock" Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            </Trigger>

            <Trigger Property="Status" Value="Current">
                <Setter TargetName="IndicatorEllipse" Property="Fill" Value="{DynamicResource Background.Selected}" />
                <Setter TargetName="IndicatorEllipse" Property="Stroke" Value="{DynamicResource Background.Selected}" />
                <Setter TargetName="IndexTextBlock" Property="Foreground" Value="White" />
                <Setter TargetName="IndexTextBlock" Property="FontWeight" Value="Bold" />
                <Setter TargetName="TopConnector" Property="Fill" Value="{DynamicResource Background.Selected}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRing"
                                Storyboard.TargetProperty="Opacity"
                                To="0.4"
                                Duration="0:0:0.25" />
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRing"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.15" />
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.7"
                                Duration="0:0:0.15" />
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorRingScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.7"
                                Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="Status" Value="Completed">
                <Setter TargetName="IndicatorEllipse" Property="Fill" Value="{DynamicResource Background.Success}" />
                <Setter TargetName="IndicatorEllipse" Property="Stroke" Value="{DynamicResource Background.Success}" />
                <Setter TargetName="IndexTextBlock" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IndexIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="TopConnector" Property="Fill" Value="{DynamicResource Background.Success}" />
                <Setter TargetName="BottomConnector" Property="Fill" Value="{DynamicResource Background.Success}" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="CanNavigate" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="IndicatorEllipse" Property="Opacity" Value="0.85" />
            </MultiTrigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  StepperItem 默认样式  -->
    <!--  ============================================================  -->
    <Style x:Key="StepperItem.Style.Basic" TargetType="ctl:StepperItem">
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource StepperItem.ControlTemplate.Basic.Horizontal}" />
        <Style.Triggers>
            <!--  默认 Cursor=Hand (CanNavigate=true 时)  -->
            <Trigger Property="CanNavigate" Value="True">
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
            <Trigger Property="CanNavigate" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
            <!--  Orientation 切换模板  -->
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource AncestorType=ctl:Stepper}}" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource StepperItem.ControlTemplate.Basic.Vertical}" />
                <Setter Property="MinHeight" Value="80" />
                <Setter Property="MinWidth" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource StepperItem.Style.Basic}" TargetType="ctl:StepperItem" />

    <!--  ============================================================  -->
    <!--  Stepper 默认样式  -->
    <!--  ============================================================  -->
    <Style x:Key="Stepper.Style.Basic" TargetType="{x:Type ctl:Stepper}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:Stepper}">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ctl:Stepper}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Stepper.Style.Basic}" TargetType="ctl:Stepper" />
</ResourceDictionary>
