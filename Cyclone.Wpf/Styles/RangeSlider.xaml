<!--
    ============================================================================
    RangeSlider 样式 (跟 Slider 视觉完全一致)
    
    Thumb (复用 Slider 风格):
    - 圆形 18px,白底 + 2px 主色边
    - Hover — body 略大 (20px)
    - IsDragging — body 变主色实心 + 外圈 28px 光环 Storyboard 弹入
    - IsKeyboardFocused — 外圈光环弹入 (键盘可达性反馈)
    
    Track:
    - 4px 厚度
    - ActiveTrackBrush (中段) = Background.Selected 主色
    - InactiveTrackBrush (两端) = Background.Inactive 浅灰
    
    跟 Slider.xaml 的差异点 (RangeSlider 特有):
    - 双 Thumb 共用 PART_StartThumb / PART_EndThumb
    - RangeTrack 取代标准 Track (支持双 Thumb 动态布局)
    - 三段 RepeatButton: StartRegion / MiddleRegion / EndRegion
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================================================  -->
    <!--  Thumb 样式 — 跟 Slider.ThumbStyle 完全一致  -->
    <!--  ============================================================  -->
    <Style x:Key="RangeSlider.Thumb.Style.Basic" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <!--  外圈光环 — IsDragging / IsKeyboardFocused 时弹入  -->
                        <Ellipse
                            x:Name="FocusRing"
                            Width="28"
                            Height="28"
                            Fill="{DynamicResource Background.Selected}"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="FocusRingScale" ScaleX="0.7" ScaleY="0.7" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!--  Thumb 主体 — 圆形,白底主色边  -->
                        <Ellipse
                            x:Name="Body"
                            Width="18"
                            Height="18"
                            Fill="{DynamicResource Background.Container}"
                            Stroke="{DynamicResource Background.Selected}"
                            StrokeThickness="2" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  Hover — body 略大,提示可交互  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Width" Value="20" />
                            <Setter TargetName="Body" Property="Height" Value="20" />
                        </Trigger>

                        <!--  IsKeyboardFocused — 外圈光环弹入 (键盘可达性)  -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRing"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.3"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRing"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.7"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.7"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--  IsDragging — body 变主色实心 + 外圈光环弹入  -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Body" Property="Fill" Value="{DynamicResource Background.Selected}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRing"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.3"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRing"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.7"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusRingScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.7"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  RepeatButton 样式 — 横竖共用  -->
    <!--  ============================================================  -->
    <Style x:Key="RangeSlider.RepeatButton.Style.Basic" TargetType="{x:Type RepeatButton}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============================================================  -->
    <!--  水平模板  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="RangeSlider.ControlTemplate.Horizontal" TargetType="{x:Type ctl:RangeSlider}">
        <Grid ClipToBounds="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TickBar
                x:Name="TopTickBar"
                Grid.Row="0"
                Height="4"
                Margin="0,0,0,2"
                Fill="{DynamicResource Tick.Primary}"
                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Top"
                ReservedSpace="{TemplateBinding ThumbSize}"
                TickFrequency="{TemplateBinding TickFrequency}"
                Ticks="{TemplateBinding Ticks}"
                Visibility="Collapsed" />

            <ctl:RangeTrack
                Grid.Row="1"
                ClipToBounds="False"
                VerticalAlignment="Center"
                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                LowerValue="{TemplateBinding LowerValue}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Orientation="{TemplateBinding Orientation}"
                UpperValue="{TemplateBinding UpperValue}">
                <ctl:RangeTrack.StartRegion>
                    <RepeatButton
                        x:Name="PART_StartRegion"
                        Height="{TemplateBinding TrackThickness}"
                        Background="{TemplateBinding InactiveTrackBrush}"
                        Style="{StaticResource RangeSlider.RepeatButton.Style.Basic}" />
                </ctl:RangeTrack.StartRegion>
                <ctl:RangeTrack.StartThumb>
                    <Thumb
                        x:Name="PART_StartThumb"
                        Width="{TemplateBinding ThumbSize}"
                        Height="{TemplateBinding ThumbSize}"
                        Panel.ZIndex="99"
                        Style="{StaticResource RangeSlider.Thumb.Style.Basic}" />
                </ctl:RangeTrack.StartThumb>
                <ctl:RangeTrack.MiddleRegion>
                    <RepeatButton
                        x:Name="PART_MiddleRegion"
                        Height="{TemplateBinding TrackThickness}"
                        Background="{TemplateBinding ActiveTrackBrush}"
                        Style="{StaticResource RangeSlider.RepeatButton.Style.Basic}" />
                </ctl:RangeTrack.MiddleRegion>
                <ctl:RangeTrack.EndThumb>
                    <Thumb
                        x:Name="PART_EndThumb"
                        Width="{TemplateBinding ThumbSize}"
                        Height="{TemplateBinding ThumbSize}"
                        Panel.ZIndex="99"
                        Style="{StaticResource RangeSlider.Thumb.Style.Basic}" />
                </ctl:RangeTrack.EndThumb>
                <ctl:RangeTrack.EndRegion>
                    <RepeatButton
                        x:Name="PART_EndRegion"
                        Height="{TemplateBinding TrackThickness}"
                        Background="{TemplateBinding InactiveTrackBrush}"
                        Style="{StaticResource RangeSlider.RepeatButton.Style.Basic}" />
                </ctl:RangeTrack.EndRegion>
            </ctl:RangeTrack>

            <TickBar
                x:Name="BottomTickBar"
                Grid.Row="2"
                Height="4"
                Margin="0,2,0,0"
                Fill="{DynamicResource Tick.Primary}"
                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Bottom"
                ReservedSpace="{TemplateBinding ThumbSize}"
                TickFrequency="{TemplateBinding TickFrequency}"
                Ticks="{TemplateBinding Ticks}"
                Visibility="Collapsed" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTickBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTickBar" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  垂直模板  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="RangeSlider.ControlTemplate.Vertical" TargetType="{x:Type ctl:RangeSlider}">
        <Grid ClipToBounds="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TickBar
                x:Name="LeftTickBar"
                Grid.Column="0"
                Width="4"
                Margin="0,0,2,0"
                Fill="{DynamicResource Tick.Primary}"
                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Left"
                ReservedSpace="{TemplateBinding ThumbSize}"
                TickFrequency="{TemplateBinding TickFrequency}"
                Ticks="{TemplateBinding Ticks}"
                Visibility="Collapsed" />

            <ctl:RangeTrack
                Grid.Column="1"
                ClipToBounds="False"
                HorizontalAlignment="Center"
                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                LowerValue="{TemplateBinding LowerValue}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Orientation="{TemplateBinding Orientation}"
                UpperValue="{TemplateBinding UpperValue}">
                <ctl:RangeTrack.StartRegion>
                    <RepeatButton
                        x:Name="PART_StartRegion"
                        Width="{TemplateBinding TrackThickness}"
                        Background="{TemplateBinding InactiveTrackBrush}"
                        Style="{StaticResource RangeSlider.RepeatButton.Style.Basic}" />
                </ctl:RangeTrack.StartRegion>
                <ctl:RangeTrack.StartThumb>
                    <Thumb
                        x:Name="PART_StartThumb"
                        Width="{TemplateBinding ThumbSize}"
                        Height="{TemplateBinding ThumbSize}"
                        Panel.ZIndex="99"
                        Style="{StaticResource RangeSlider.Thumb.Style.Basic}" />
                </ctl:RangeTrack.StartThumb>
                <ctl:RangeTrack.MiddleRegion>
                    <RepeatButton
                        x:Name="PART_MiddleRegion"
                        Width="{TemplateBinding TrackThickness}"
                        Background="{TemplateBinding ActiveTrackBrush}"
                        Style="{StaticResource RangeSlider.RepeatButton.Style.Basic}" />
                </ctl:RangeTrack.MiddleRegion>
                <ctl:RangeTrack.EndThumb>
                    <Thumb
                        x:Name="PART_EndThumb"
                        Width="{TemplateBinding ThumbSize}"
                        Height="{TemplateBinding ThumbSize}"
                        Panel.ZIndex="99"
                        Style="{StaticResource RangeSlider.Thumb.Style.Basic}" />
                </ctl:RangeTrack.EndThumb>
                <ctl:RangeTrack.EndRegion>
                    <RepeatButton
                        x:Name="PART_EndRegion"
                        Width="{TemplateBinding TrackThickness}"
                        Background="{TemplateBinding InactiveTrackBrush}"
                        Style="{StaticResource RangeSlider.RepeatButton.Style.Basic}" />
                </ctl:RangeTrack.EndRegion>
            </ctl:RangeTrack>

            <TickBar
                x:Name="RightTickBar"
                Grid.Column="2"
                Width="4"
                Margin="2,0,0,0"
                Fill="{DynamicResource Tick.Primary}"
                IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                Maximum="{TemplateBinding Maximum}"
                Minimum="{TemplateBinding Minimum}"
                Placement="Right"
                ReservedSpace="{TemplateBinding ThumbSize}"
                TickFrequency="{TemplateBinding TickFrequency}"
                Ticks="{TemplateBinding Ticks}"
                Visibility="Collapsed" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="LeftTickBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="RightTickBar" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  基础样式  -->
    <!--  ============================================================  -->
    <Style
        x:Key="RangeSlider.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="{x:Type ctl:RangeSlider}">
        <Setter Property="Background" Value="Transparent" />
        <!--  关闭裁切：thumb 的 28px 光环/20px hover 体在轨道末端会越界，被裁成直角  -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="InactiveTrackBrush" Value="{DynamicResource Background.Inactive}" />
        <Setter Property="ActiveTrackBrush" Value="{DynamicResource Background.Selected}" />
        <Setter Property="TrackThickness" Value="4" />
        <!--  ThumbSize = thumb 的布局占位/命中区，须 ≥ 最大视觉尺寸(28px 光环)。
              可见 Body 仍是 18px(写死在 Thumb 模板)；这里设 28 让 RangeTrack 每端
              预留 14px，光环在轨道末端不再越界，TickBar.ReservedSpace 同步对齐  -->
        <Setter Property="ThumbSize" Value="28" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="AutoToolTipPrecision" Value="2" />
        <Setter Property="AutoToolTipPlacement" Value="TopLeft" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource RangeSlider.ControlTemplate.Horizontal}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="100" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource RangeSlider.ControlTemplate.Vertical}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="100" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource RangeSlider.Style.Basic}" TargetType="{x:Type ctl:RangeSlider}" />
</ResourceDictionary>
