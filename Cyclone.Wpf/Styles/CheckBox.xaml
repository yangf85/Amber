<!--
    ============================================================================
    CheckBox 样式 (跟项目其他控件视觉一致)
    
    设计:
    - Box 18×18,无圆角(跟项目其他控件统一)
    - Checked 态:Box 整个变主色实心 + 白色 ✓ stroke 折线
    - Indeterminate 态:同样主色实心 + 白色横线 stroke
    - Hover 态(unchecked):边框变 Border.Hover 主色淡边
    - Hover 态(checked):背景稍变深
    - Pressed 态:整体 Opacity 略降
    - IsKeyboardFocused:外圈 2px focus ring
    - Disabled:整体 Opacity 0.5
    
    改动 (vs 旧版):
    - ✓ 旧版 1024-grid 实心 SVG → 简洁 stroke 折线 (跟 Pagination 箭头风格统一)
    - Indeterminate 横线 Stretch=UniformToFill → 固定坐标
    - Checked 态加 Box 主色实心(旧版只换 ✓ 显示,视觉对比太弱)
    - 加 IsKeyboardFocused focus ring (旧版无焦点视觉)
    - 加 IsPressed 反馈
    - ContentPresenter 显式 TemplateBinding Content/VerticalContentAlignment
    - Height 写死 → MinHeight (适应多行 CheckBox 列表)
    ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        FocusVisual — 仅在键盘 Tab 进入时显示,鼠标点击不显示
        (WPF FocusVisualStyle 框架内置区分输入方式,不需要手写判断)
    -->
    <Style x:Key="CheckBox.FocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Border.Focused}"
                        BorderThickness="2"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="CheckBox.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="{x:Type CheckBox}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Horizontal.Control}" />
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource CheckBox.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator
                        Background="Transparent"
                        SnapsToDevicePixels="True">
                        <BulletDecorator.Bullet>
                            <Border
                                x:Name="BoxBorder"
                                Width="18"
                                Height="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <!--  ✓ stroke 折线 — Checked 态显示 (中心点 (7,7))  -->
                                    <Path
                                        x:Name="CheckMark"
                                        Width="14"
                                        Height="14"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 3 7 L 6 10 L 11 4"
                                        Stretch="None"
                                        Stroke="White"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2"
                                        Visibility="Collapsed" />

                                    <!--  横线 — Indeterminate 态显示 (中心 Y=7)  -->
                                    <Path
                                        x:Name="IndeterminateMark"
                                        Width="14"
                                        Height="14"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 3 7 L 11 7"
                                        Stretch="None"
                                        Stroke="White"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </BulletDecorator.Bullet>

                        <ContentPresenter
                            x:Name="ContentContainer"
                            Margin="6,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </BulletDecorator>

                    <ControlTemplate.Triggers>
                        <!--  没文字时不留左侧 margin  -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentContainer" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="">
                            <Setter TargetName="ContentContainer" Property="Margin" Value="0" />
                        </Trigger>

                        <!--  Hover (unchecked) — 边框变主色淡边  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Border.Hover}" />
                        </MultiTrigger>

                        <!--  Checked — Box 主色实心 + ✓ 显示  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Indeterminate — Box 主色实心 + 横线 显示  -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Pressed — 整体 Opacity 略降提示按下  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BoxBorder" Property="Opacity" Value="0.8" />
                        </Trigger>

                        <!--  Disabled — 整体 Opacity 0.5  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource CheckBox.Style.Basic}" TargetType="{x:Type CheckBox}" />
</ResourceDictionary>
