<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CheckBox.FocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Border.Focused}"
                        BorderThickness="2"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckBox.Style.Basic" TargetType="{x:Type CheckBox}">
        <Setter Property="MinHeight" Value="{DynamicResource Height.Horizontal.Control}" />
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource CheckBox.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <!--
                        用 Grid 替换 BulletDecorator: BulletDecorator 强制 baseline 对齐,
                        Box 底边会贴到文字基线, 导致 Box 比文字视觉中心高 ~5px;
                        改用 Grid + VerticalAlignment=Center, 严格几何居中
                    -->
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="BoxBorder"
                            Grid.Column="0"
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <!--  ✓ stroke 折线 — Checked 态显示 (中心点 (7,7))  -->
                                <Path
                                    x:Name="CheckMark"
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M 3 7 L 6 10 L 11 4"
                                    Stretch="None"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />

                                <!--  横线 — Indeterminate 态显示 (中心 Y=7)  -->
                                <Path
                                    x:Name="IndeterminateMark"
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M 3 7 L 11 7"
                                    Stretch="None"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ContentPresenter
                            x:Name="ContentContainer"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  没文字时不留左侧 margin  -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentContainer" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Content" Value="">
                            <Setter TargetName="ContentContainer" Property="Margin" Value="0" />
                        </Trigger>

                        <!--  Hover (unchecked) — 边框变主色淡边  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Border.Hover}" />
                        </MultiTrigger>

                        <!--  Checked — Box 主色实心 + ✓ 显示  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Indeterminate — Box 主色实心 + 横线 显示  -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource Background.Selected}" />
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Pressed — 整体 Opacity 略降提示按下  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BoxBorder" Property="Opacity" Value="0.8" />
                        </Trigger>

                        <!--  Disabled — 整体 Opacity 0.5  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource CheckBox.Style.Basic}" TargetType="{x:Type CheckBox}" />
</ResourceDictionary>
