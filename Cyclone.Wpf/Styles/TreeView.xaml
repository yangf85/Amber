<!--
    ============================================================================
    破坏性变更说明（vs 旧版本）：
        - 子节点 ItemsPresenter 增加 Margin="15,0,0,0"——深嵌套时层级清晰，
          但子节点视觉位置左移；如果有外部代码依赖原始无缩进布局，需要适配
        - PART_Header → PartHeader（项目规约 PartXxx PascalCase）；
          自定义模板时 x:Name 用新值
        - IsSelected=True 现在同时改 Foreground——确保对比度
        - VirtualizingPanel.IsVirtualizing trigger 已删除（与 CanContentScroll=False 矛盾）
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  展开/折叠 ToggleButton 样式（三角箭头）  -->
    <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Width="16"
                        Height="16"
                        Padding="5"
                        Background="Transparent"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                        <Path
                            x:Name="ExpandPath"
                            Data="M0,0 L0,6 L6,0 z"
                            Fill="Transparent"
                            Stroke="{DynamicResource Foreground.Default}">
                            <Path.RenderTransform>
                                <RotateTransform
                                    Angle="135"
                                    CenterX="3"
                                    CenterY="3" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ExpandPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform
                                        Angle="180"
                                        CenterX="3"
                                        CenterY="3" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ExpandPath" Property="Fill" Value="{DynamicResource Foreground.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TreeViewItem 样式  -->
    <Style BasedOn="{StaticResource Control.Style.Basic}" TargetType="TreeViewItem">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border
                            x:Name="RootBorder"
                            Height="{DynamicResource Height.Horizontal.Control}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="Expander"
                                    ClickMode="Press"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource ExpandCollapseToggleStyle}" />
                                <ContentPresenter
                                    x:Name="PartHeader"
                                    Grid.Column="1"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    ContentSource="Header" />
                            </Grid>
                        </Border>
                        <!--  子节点容器——左侧 Margin 让子树相对父项缩进，深嵌套时层级清晰  -->
                        <ItemsPresenter x:Name="ItemsHost" Margin="15,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>

                        <!--  鼠标 hover（未选中）  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="RootBorder" Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </MultiTrigger>

                        <!--  选中（active）——同时切换 Background + Foreground 保证对比度  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Invert}" />
                        </Trigger>

                        <!--
                            选中 + TreeView 失焦：
                            原版用 Background.Focused（资源不存在），改用 Background.Highlighted 弱化。
                            如果主题需要更专门的"失焦选中色"，建议在 BasicTheme/DarkTheme 中
                            添加 Background.Focused 资源 key 然后改回 DynamicResource Background.Focused。
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Highlighted}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TreeView 样式  -->
    <Style
        x:Key="TreeView.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="TreeView">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border
                        x:Name="RootBorder"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CanContentScroll="False"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--
            原版有两处 VirtualizingPanel.IsVirtualizing="True" 时切换 ItemsPanel 到
            VirtualizingStackPanel 的 trigger——已删除：
            外层 ScrollViewer.CanContentScroll=False 时 VirtualizingStackPanel 不生效，
            两个配置自相矛盾。
            
            如果将来确实需要虚拟化（数据量极大、TreeViewItem 渲染开销高），把
            CanContentScroll 改成 True 并恢复 trigger——代价是失去像素级平滑滚动。
            一般 TreeView 虚拟化收益不大，多数项目选择不虚拟化。
        -->
    </Style>

    <Style BasedOn="{StaticResource TreeView.Style.Basic}" TargetType="TreeView" />
</ResourceDictionary>
