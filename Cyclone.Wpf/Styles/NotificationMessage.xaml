<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Themes/BasicTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  五种级别图标的 Geometry（Material Design 风格，24x24 viewBox）  -->
    <Geometry x:Key="NotificationIcon.Default">M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z</Geometry>
    <Geometry x:Key="NotificationIcon.Information">M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM11 9h2V7h-2v2z</Geometry>
    <Geometry x:Key="NotificationIcon.Success">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>
    <Geometry x:Key="NotificationIcon.Warning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</Geometry>
    <Geometry x:Key="NotificationIcon.Error">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z</Geometry>

    <!--  ============ NotificationMessage 主样式 ============  -->
    <Style x:Key="NotificationMessage.Style.Basic" TargetType="{x:Type ctl:NotificationMessage}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Background.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:NotificationMessage}">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path
                                x:Name="Icon"
                                Grid.Column="0"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                Data="{StaticResource NotificationIcon.Default}"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform" />
                            <!--  TextBlock 直接绑 Message——它自己有 TextWrapping，避开 ContentPresenter + TextBlock.TextWrapping attached 写法的 XLS0415 错误  -->
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontSize="13"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}"
                                TextWrapping="WrapWithOverflow" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Level" Value="Default">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Default}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource NotificationIcon.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
                        </Trigger>
                        <Trigger Property="Level" Value="Information">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Info}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource NotificationIcon.Information}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Invert}" />
                        </Trigger>
                        <Trigger Property="Level" Value="Success">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Success}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource NotificationIcon.Success}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Invert}" />
                        </Trigger>
                        <Trigger Property="Level" Value="Warning">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Warning}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource NotificationIcon.Warning}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Invert}" />
                        </Trigger>
                        <Trigger Property="Level" Value="Error">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Error}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource NotificationIcon.Error}" />
                            <Setter Property="Foreground" Value="{DynamicResource Foreground.Invert}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource NotificationMessage.Style.Basic}" TargetType="{x:Type ctl:NotificationMessage}" />
</ResourceDictionary>