<!--
    ============================================================================
    FluidTabControl 样式 (WinUI 3 风格 · 无圆角 · 整行高亮 + 左竖条)

    视觉对齐 SideMenu / ListBox:
    - 左 3px 竖条 indicator (pill, Opacity 淡入 + ScaleY BackEase 弹入)
    - 整行 Hover / Selected 浅底
    - 文字色保持不变 (不再 invert)
    - 失焦弱化 — selected + IsKeyboardFocusWithin=false 时竖条降级为 Highlighted
    - IsKeyboardFocused 视觉反馈
    - 无圆角

    Right placement 时 Indicator 移到最右,整行视觉镜像。

    修复的 bug:
    - Icon 显示逻辑反了 — 默认 Visible,Icon=null 时才 Collapsed
    - Right placement 的 Column trigger 是 no-op — 默认值就是 trigger 要设的值
    ============================================================================
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ============================================================  -->
    <!--  FluidTabItem 模板 (左 3px 竖条 + 整行高亮 + 无圆角)  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="FluidTabItem.Template.Basic" TargetType="{x:Type ctl:FluidTabItem}">
        <Border
            x:Name="RootBorder"
            Height="{TemplateBinding Height}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--  ① 选中竖条指示器 (永远 6px 宽,Pill 居中)  -->
                    <ColumnDefinition x:Name="IndicatorColumn" Width="6" />
                    <!--  ② Icon (Auto)  -->
                    <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                    <!--  ③ Header (*)  -->
                    <ColumnDefinition x:Name="HeaderColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!--  选中指示器 — 3x16 pill,Opacity 淡入 + ScaleY 弹性  -->
                <Border
                    x:Name="Indicator"
                    Grid.Column="0"
                    Width="3"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Background.Selected}"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5"
                    SnapsToDevicePixels="True">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="IndicatorScale" ScaleY="0.4" />
                    </Border.RenderTransform>
                </Border>

                <!--  Icon — 默认 Visible,Icon=null 时通过 trigger Collapsed  -->
                <ContentPresenter
                    x:Name="IconPresenter"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Icon}"
                    ContentTemplate="{TemplateBinding IconTemplate}"
                    Focusable="False" />

                <!--  Header  -->
                <ContentPresenter
                    x:Name="HeaderPresenter"
                    Grid.Column="2"
                    Margin="8,0,12,0"
                    HorizontalAlignment="{Binding ItemHeaderHorizontalAlignment, RelativeSource={RelativeSource AncestorType=ctl:FluidTabControl}}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    ContentSource="Header"
                    Focusable="False"
                    RecognizesAccessKey="True" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>

            <!--  Icon=null 时隐藏 Icon 列  -->
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconPresenter" Property="Margin" Value="0" />
            </Trigger>

            <!--
                Right placement — 整行视觉镜像
                列重排:Header(*) → Icon(Auto) → Indicator(6px),Indicator 跑到最右
                Margin 也要 mirror,保持留白对称
            -->
            <DataTrigger Binding="{Binding FluidTabPlacement, RelativeSource={RelativeSource AncestorType=ctl:FluidTabControl}}" Value="Right">
                <Setter TargetName="IndicatorColumn" Property="Width" Value="*" />
                <Setter TargetName="IconColumn" Property="Width" Value="Auto" />
                <Setter TargetName="HeaderColumn" Property="Width" Value="6" />
                <Setter TargetName="HeaderPresenter" Property="Grid.Column" Value="0" />
                <Setter TargetName="HeaderPresenter" Property="Margin" Value="12,0,8,0" />
                <Setter TargetName="IconPresenter" Property="Grid.Column" Value="1" />
                <Setter TargetName="IconPresenter" Property="Margin" Value="0,0,8,0" />
                <Setter TargetName="Indicator" Property="Grid.Column" Value="2" />
            </DataTrigger>

            <!--  Hover (未选中)— 整行浅底,文字色保持不变  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
            </MultiTrigger>

            <!--  Selected — 整行浅底 + 左竖条弹入  -->
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Indicator"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Indicator"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.10" />
                            <DoubleAnimation
                                Storyboard.TargetName="IndicatorScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.4"
                                Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <!--  失焦弱化 — 整个 FluidTabControl 不在键盘焦点范围内 → 竖条降级  -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ctl:FluidTabControl}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Background.Highlighted}" />
            </MultiDataTrigger>

            <!--  键盘焦点反馈 — Tab 进入可见  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
            </Trigger>

            <!--  禁用态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
                <Setter TargetName="RootBorder" Property="Background" Value="Transparent" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FluidTabItem.Style.Basic" TargetType="{x:Type ctl:FluidTabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource Height.Horizontal.Header}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource FluidTabItem.Template.Basic}" />
    </Style>

    <Style BasedOn="{StaticResource FluidTabItem.Style.Basic}" TargetType="{x:Type ctl:FluidTabItem}" />

    <!--  ============================================================  -->
    <!--  FluidTabControl 模板  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="FluidTabControl.Template.Basic" TargetType="{x:Type ctl:FluidTabControl}">
        <Border
            x:Name="RootBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderColumn" Width="Auto" />
                    <ColumnDefinition x:Name="DividerColumn" Width="Auto" />
                    <ColumnDefinition x:Name="ContentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                    Header 列 — ItemsPresenter 渲染所有 FluidTabItem,
                    用 ScrollViewer 包起来支持长列表,滚动条 Hidden (滚轮/触摸仍可滚)
                -->
                <ScrollViewer
                    x:Name="HeaderScroll"
                    Grid.Column="0"
                    Panel.ZIndex="1"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    KeyboardNavigation.TabIndex="1"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsPresenter />
                </ScrollViewer>

                <!--  分隔线 — 始终在 Header 和 Content 之间(中间列)  -->
                <Rectangle
                    x:Name="Divider"
                    Grid.Column="1"
                    Width="1"
                    Fill="{TemplateBinding BorderBrush}" />

                <!--  内容列 — ScrollViewer 包内容面板,内容滚动会反向同步 Selection  -->
                <Grid
                    x:Name="ContentArea"
                    Grid.Column="2"
                    Background="{TemplateBinding Background}"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabIndex="2"
                    KeyboardNavigation.TabNavigation="Local">
                    <ScrollViewer
                        x:Name="PART_Container"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        IsDeferredScrollingEnabled="False"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PART_ContentPanel" Orientation="Vertical" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <!--
                Right placement — Header 移到 Column=2,Content 移到 Column=0,
                Divider 留在 Column=1 (始终是中间,无需移动)
            -->
            <Trigger Property="FluidTabPlacement" Value="Right">
                <Setter TargetName="HeaderScroll" Property="Grid.Column" Value="2" />
                <Setter TargetName="ContentArea" Property="Grid.Column" Value="0" />
                <Setter TargetName="HeaderColumn" Property="Width" Value="*" />
                <Setter TargetName="ContentColumn" Property="Width" Value="Auto" />
                <Setter TargetName="HeaderScroll" Property="KeyboardNavigation.TabIndex" Value="2" />
                <Setter TargetName="ContentArea" Property="KeyboardNavigation.TabIndex" Value="1" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style
        x:Key="FluidTabControl.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="{x:Type ctl:FluidTabControl}">
        <Setter Property="ItemHeaderHorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template" Value="{StaticResource FluidTabControl.Template.Basic}" />
    </Style>

    <Style BasedOn="{StaticResource FluidTabControl.Style.Basic}" TargetType="ctl:FluidTabControl" />
</ResourceDictionary>