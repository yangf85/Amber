<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Themes/BasicTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ================================================================  -->
    <!--  共享：6 种 Level 图标 Geometry（Material Design 24x24 viewBox）  -->
    <!--  AlertMessage 和 AlertWindow 标题栏共用同一组 Geometry。  -->
    <!--  ================================================================  -->

    <Geometry x:Key="AlertIconGeometry.Question">M11.07 12.85c.77-1.39 2.25-2.21 3.11-3.44.91-1.29.4-3.7-2.18-3.7-1.69 0-2.52 1.28-2.87 2.34L6.54 6.96C7.25 4.83 9.18 3 11.99 3c2.35 0 3.96 1.07 4.78 2.41.7 1.15 1.11 3.3.03 4.9-1.2 1.77-2.35 2.31-2.97 3.45-.25.46-.35.76-.35 2.24h-2.91c-.01-.78-.13-2.05.5-3.15zM14 20c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2z</Geometry>
    <Geometry x:Key="AlertIconGeometry.Information">M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM11 9h2V7h-2v2z</Geometry>
    <Geometry x:Key="AlertIconGeometry.Success">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</Geometry>
    <Geometry x:Key="AlertIconGeometry.Warning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</Geometry>
    <Geometry x:Key="AlertIconGeometry.Error">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z</Geometry>

    <!--  ================================================================  -->
    <!--  AlertMessage 控件样式  -->
    <!--  ================================================================  -->

    <Style x:Key="AlertMessage.Style.Basic" TargetType="{x:Type ctl:AlertMessage}">
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:AlertMessage}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path
                                x:Name="Icon"
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                VerticalAlignment="Top"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                            <!--  TextBlock 直接绑 Message——它自己有 TextWrapping，避开 ContentPresenter + TextBlock.TextWrapping 这种 attached 写法的 XLS0415 错误  -->
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Level" Value="Question">
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource AlertIconGeometry.Question}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Background.Info}" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Level" Value="Information">
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource AlertIconGeometry.Information}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Background.Info}" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Level" Value="Success">
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource AlertIconGeometry.Success}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Background.Success}" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Level" Value="Warning">
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource AlertIconGeometry.Warning}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Background.Warning}" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Level" Value="Error">
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource AlertIconGeometry.Error}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Background.Error}" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource AlertMessage.Style.Basic}" TargetType="{x:Type ctl:AlertMessage}" />

    <!--  ================================================================  -->
    <!--  AlertWindow 内部按钮样式（Caption X / 主按钮 / 次按钮）  -->
    <!--  ================================================================  -->

    <Style x:Key="AlertWindow.CloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="RootBorder" Background="{TemplateBinding Background}">
                        <Path
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M6 4.586 1.707.293.293 1.707 4.586 6 .293 10.293l1.414 1.414L6 7.414l4.293 4.293 1.414-1.414L7.414 6l4.293-4.293L10.293.293z"
                            Fill="{DynamicResource Foreground.Default}"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AlertWindow.PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource Background.Info}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Invert}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AlertWindow.SecondaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{DynamicResource Background.Global}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================================================================  -->
    <!--  AlertWindow 主样式  -->
    <!--  ================================================================  -->

    <Style x:Key="AlertWindow.Style.Basic" TargetType="{x:Type ctl:AlertWindow}">
        <Setter Property="Background" Value="{DynamicResource Background.Global}" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="MinWidth" Value="380" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome
                    CaptionHeight="36"
                    CornerRadius="0"
                    GlassFrameThickness="0,0,0,1"
                    ResizeBorderThickness="0"
                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:AlertWindow}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Caption  -->
                            <Grid Grid.Row="0" Background="{DynamicResource Background.Header}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Level 派生的图标（优先）+ HeaderIcon 自定义内容（次优先）  -->
                                <Path
                                    x:Name="LevelIcon"
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                                <ContentControl
                                    x:Name="HeaderIconHost"
                                    Grid.Column="0"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding HeaderIcon}"
                                    Focusable="False" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Default}"
                                    Text="{TemplateBinding Title}"
                                    TextTrimming="CharacterEllipsis" />

                                <Button
                                    Grid.Column="2"
                                    Command="{x:Static ctl:AlertWindow.CloseCommand}"
                                    Style="{StaticResource AlertWindow.CloseButtonStyle}" />
                            </Grid>

                            <!--  Content  -->
                            <ContentPresenter Grid.Row="1" />

                            <!--  Button group  -->
                            <Border
                                Grid.Row="2"
                                Padding="20,12"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="0,1,0,0">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        x:Name="CancelButton"
                                        Margin="0,0,8,0"
                                        Command="{x:Static ctl:AlertWindow.CancelCommand}"
                                        Content="{TemplateBinding CancelButtonText}"
                                        Style="{StaticResource AlertWindow.SecondaryButtonStyle}"
                                        Visibility="Collapsed" />
                                    <Button
                                        Command="{x:Static ctl:AlertWindow.OkCommand}"
                                        Content="{TemplateBinding OkButtonText}"
                                        IsDefault="True"
                                        Style="{StaticResource AlertWindow.PrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <!--  Loading 覆盖层（异步验证期间）  -->
                            <Border
                                x:Name="LoadingOverlay"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Background="{DynamicResource Overlay.Dark}"
                                Visibility="Collapsed">
                                <ctl:LoadingRing
                                    Width="60"
                                    Height="60"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsActive="True"
                                    RingColor="White"
                                    RingSize="60"
                                    RingThickness="4" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  Level → LevelIcon Data + Fill；Level≠None 时让位 HeaderIconHost  -->
                        <Trigger Property="Level" Value="Question">
                            <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource AlertIconGeometry.Question}" />
                            <Setter TargetName="LevelIcon" Property="Fill" Value="{DynamicResource Background.Info}" />
                            <Setter TargetName="LevelIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Level" Value="Information">
                            <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource AlertIconGeometry.Information}" />
                            <Setter TargetName="LevelIcon" Property="Fill" Value="{DynamicResource Background.Info}" />
                            <Setter TargetName="LevelIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Level" Value="Success">
                            <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource AlertIconGeometry.Success}" />
                            <Setter TargetName="LevelIcon" Property="Fill" Value="{DynamicResource Background.Success}" />
                            <Setter TargetName="LevelIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Level" Value="Warning">
                            <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource AlertIconGeometry.Warning}" />
                            <Setter TargetName="LevelIcon" Property="Fill" Value="{DynamicResource Background.Warning}" />
                            <Setter TargetName="LevelIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Level" Value="Error">
                            <Setter TargetName="LevelIcon" Property="Data" Value="{StaticResource AlertIconGeometry.Error}" />
                            <Setter TargetName="LevelIcon" Property="Fill" Value="{DynamicResource Background.Error}" />
                            <Setter TargetName="LevelIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  ButtonType OkCancel → 显示 Cancel 按钮  -->
                        <Trigger Property="ButtonType" Value="OkCancel">
                            <Setter TargetName="CancelButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  IsLoading → 显示加载覆盖层  -->
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="LoadingOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource AlertWindow.Style.Basic}" TargetType="{x:Type ctl:AlertWindow}" />

</ResourceDictionary>
