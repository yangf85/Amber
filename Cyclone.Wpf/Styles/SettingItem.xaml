<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Cyclone.Wpf.Converters"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Themes/BasicTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  SettingItem 模板  -->
    <ControlTemplate x:Key="SettingItem.ControlTemplate.Basic" TargetType="{x:Type ctl:SettingItem}">
        <Border
            x:Name="PART_RootBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--  Icon 列:内容自适应  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Label 列:受 LabelWidth 控制(默认 Auto,可被祖先 Inherits 下传覆盖)  -->
                    <ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                    <!--  Content 列:占据剩余空间,由 SettingItem.ContentAlignment 控制 Content 在该列内的对齐  -->
                    <ColumnDefinition Width="{Binding ContentSpacing, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  左侧图标,纵向跨两行居中  -->
                <ContentPresenter
                    x:Name="IconPresenter"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Margin="{DynamicResource Padding.Right}"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Icon}"
                    TextBlock.FontSize="{DynamicResource Icon.Medium}"
                    TextBlock.Foreground="{DynamicResource Icon.Foreground.Default}" />

                <!--  主标签  -->
                <ContentPresenter
                    x:Name="LabelPresenter"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Label}"
                    TextBlock.FontSize="{DynamicResource Font.Body}"
                    TextBlock.Foreground="{DynamicResource Foreground.Default}" />

                <!--  描述文本:跨 Label 列与弹性间距列  -->
                <TextBlock
                    x:Name="DescriptionTextBlock"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,4,0,0"
                    FontSize="{DynamicResource Font.Prompt}"
                    Foreground="{DynamicResource Text.Prompt}"
                    Text="{TemplateBinding Description}"
                    TextWrapping="Wrap" />

                <!--  右侧操作内容:纵向跨两行居中,HorizontalContentAlignment 由 ContentAlignment 附加属性的 PropertyChanged 回调同步维护  -->
                <ContentPresenter
                    x:Name="ContentPresenter"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="3"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <!--  Icon 为空:收起 Icon 列  -->
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  Description 为空:收起描述行,同时让 Label 跨两行整体居中  -->
            <Trigger Property="Description" Value="{x:Null}">
                <Setter TargetName="DescriptionTextBlock" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="LabelPresenter" Property="Grid.RowSpan" Value="2" />
            </Trigger>
            <Trigger Property="Description" Value="">
                <Setter TargetName="DescriptionTextBlock" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="LabelPresenter" Property="Grid.RowSpan" Value="2" />
            </Trigger>

            <!--  整行可点击 + 鼠标悬停:高亮背景  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClickable" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_RootBorder" Property="Background" Value="{DynamicResource Background.Hover}" />
            </MultiTrigger>

            <!--  禁用态  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_RootBorder" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  SettingItem 默认样式  -->
    <Style x:Key="SettingItem.Style.Basic" TargetType="{x:Type ctl:SettingItem}">
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.None}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.All}" />
        <Setter Property="MinHeight" Value="{DynamicResource Height.Horizontal.Caption}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource SettingItem.ControlTemplate.Basic}" />
        <Style.Triggers>
            <!--  整行可点击:鼠标变手型  -->
            <Trigger Property="IsClickable" Value="True">
                <Setter Property="Cursor" Value="Hand" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource SettingItem.Style.Basic}" TargetType="{x:Type ctl:SettingItem}" />

    <!--  SettingGroup 模板  -->
    <ControlTemplate x:Key="SettingGroup.ControlTemplate.Basic" TargetType="{x:Type ctl:SettingGroup}">
        <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <DockPanel LastChildFill="True">
                <!--  组标题(SettingGroup.Header,继承自 HeaderedItemsControl)  -->
                <ContentPresenter
                    x:Name="HeaderPresenter"
                    Margin="0,0,0,4"
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                    DockPanel.Dock="Top"
                    TextBlock.FontSize="{DynamicResource Font.Header}"
                    TextBlock.Foreground="{DynamicResource Text.Header}" />

                <!--  组描述  -->
                <TextBlock
                    x:Name="DescriptionTextBlock"
                    Margin="0,0,0,8"
                    DockPanel.Dock="Top"
                    FontSize="{DynamicResource Font.Prompt}"
                    Foreground="{DynamicResource Text.Prompt}"
                    Text="{TemplateBinding Description}"
                    TextWrapping="Wrap" />

                <!--  设置项列表  -->
                <ItemsPresenter />
            </DockPanel>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
                <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
                <Setter TargetName="DescriptionTextBlock" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="">
                <Setter TargetName="DescriptionTextBlock" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  SettingGroup 默认样式  -->
    <Style x:Key="SettingGroup.Style.Basic" TargetType="{x:Type ctl:SettingGroup}">
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.All}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource SettingGroup.ControlTemplate.Basic}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource SettingGroup.Style.Basic}" TargetType="{x:Type ctl:SettingGroup}" />
</ResourceDictionary>