<!--
    ============================================================================
    ToolTip 样式 (WinUI 3 风格 · 无圆角)
    
    设计要点:
    - 白底 + 1px 边框 + 柔和 drop shadow,跟项目卡片/弹出层视觉一致
    - 独立 FontSize 12(不继承父控件字号)
    - Padding 10,6 视觉舒展
    - 命名三段式 ToolTip.Style.Basic
    
    修复 (vs 旧版):
    - DefaultForegroundBrush (不存在) → Foreground.Default
    - Background.Global (页面背景) → Background.Container (白底,跟边框配合明显)
    - HasDropShadow (系统弱阴影) → 显式 DropShadowEffect
    - Padding 写死 5 → TemplateBinding,默认 10,6
    - 添加 FontSize Setter (12,不继承)
    - 隐式样式加 x:Key 支持 BasedOn 扩展
    ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ToolTip.Style.Basic" TargetType="{x:Type ToolTip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!--  外层 Grid 留 margin 给阴影渲染空间  -->
                    <Grid Margin="6">
                        <Border
                            x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="10"
                                    Opacity="0.15"
                                    ShadowDepth="2"
                                    Color="Black" />
                            </Border.Effect>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource ToolTip.Style.Basic}" TargetType="{x:Type ToolTip}" />
</ResourceDictionary>