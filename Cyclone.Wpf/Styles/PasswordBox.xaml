    </Style>

    <!--  ============================================================  -->
    <!--  PasswordBox ControlTemplate  -->
    <!--  ============================================================  -->
    <ControlTemplate x:Key="PasswordBox.ControlTemplate.Basic" TargetType="{x:Type PasswordBox}">
        <Border
            x:Name="RootBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Watermark — Password 为空且未获焦时显示  -->
                <TextBlock
                    x:Name="Watermark"
                    Grid.Column="0"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="{TemplateBinding FontSize}"
                    Foreground="{DynamicResource Foreground.Placeholder}"
                    IsHitTestVisible="False"
                    Text="{Binding Path=(hp:PasswordBoxHelper.Watermark), RelativeSource={RelativeSource AncestorType=PasswordBox}}"
                    Visibility="Collapsed" />

                <!--
                    编辑区:密文 ScrollViewer 与 明文 TextBlock 同位置叠放,
                    通过 ShowPassword 切换可见性
                -->
                <Grid Grid.Column="0">
                    <!--  实际密文输入区  -->
                    <ScrollViewer
                        x:Name="PART_ContentHost"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Hidden"
                        Visibility="{Binding Path=(hp:PasswordBoxHelper.ShowPassword), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:VisibilityConverter.VisibleWhenFalse}}" />

                    <!--  明文展示区 — ShowPassword=True 时可见,只读  -->
                    <TextBlock
                        x:Name="PlainText"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        IsHitTestVisible="False"
                        Text="{Binding Path=(hp:PasswordBoxHelper.Password), RelativeSource={RelativeSource AncestorType=PasswordBox}}"
                        Visibility="{Binding Path=(hp:PasswordBoxHelper.ShowPassword), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:VisibilityConverter.VisibleWhenTrue}}" />
                </Grid>

                <!--  密码可见性切换按钮  -->
                <CheckBox
                    x:Name="ToggleButton"
                    Grid.Column="1"
                    IsChecked="{Binding Path=(hp:PasswordBoxHelper.ShowPassword), RelativeSource={RelativeSource AncestorType=PasswordBox}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource PasswordBox.ToggleButton.Style}" />

                <!--
                    Clear 按钮 — Command 透过类级别 CommandBinding 路由到
                    PasswordBoxHelper.ExecuteClearCommand
                -->
                <Button
                    x:Name="ClearButton"
                    Grid.Column="2"
                    Command="{x:Static hp:PasswordBoxHelper.ClearCommand}"
                    Style="{StaticResource PasswordBox.ClearButton.Style}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>

            <!--  Watermark 显示条件:Password="" 且 未获焦  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="hp:PasswordBoxHelper.Password" Value="" />
                    <Condition Property="IsKeyboardFocused" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
            </MultiTrigger>

            <!--  Clear 按钮隐藏条件:HasClearButton=False  -->
            <DataTrigger Binding="{Binding Path=(hp:PasswordBoxHelper.HasClearButton), RelativeSource={RelativeSource Mode=Self}}" Value="False">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>

            <!--  Clear 按钮隐藏条件:Password 为空  -->
            <Trigger Property="hp:PasswordBoxHelper.Password" Value="">
                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  Toggle 按钮隐藏条件:HasPasswordVisibilityToggle=False  -->
            <DataTrigger Binding="{Binding Path=(hp:PasswordBoxHelper.HasPasswordVisibilityToggle), RelativeSource={RelativeSource Mode=Self}}" Value="False">
                <Setter TargetName="ToggleButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>

            <!--  Hover (未获焦) — 边框 Hover 色  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Border.Hover}" />
            </Trigger>

            <!--  Focused — 边框主色  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Border.Focused}" />
            </Trigger>

            <!--  Disabled — 边框 / 背景 / 前景全部走 Disabled token  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Background.Disabled}" />
                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Border.Disabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  ============================================================  -->
    <!--  PasswordBox 默认样式  -->
    <!--  ============================================================  -->
    <Style
        x:Key="PasswordBox.Style.Basic"
        BasedOn="{StaticResource Control.Style.Basic}"
        TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Foreground.Default}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Background.Selected}" />
        <Setter Property="Height" Value="{DynamicResource Height.Horizontal.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource ValidationError.ControlTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="hp:PasswordBoxHelper.HasClearButton" Value="True" />
        <Setter Property="hp:PasswordBoxHelper.HasPasswordVisibilityToggle" Value="True" />
        <Setter Property="Template" Value="{StaticResource PasswordBox.ControlTemplate.Basic}" />
        <Style.Triggers>
            <!--  失焦但保持选中文字高亮  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsInactiveSelectionHighlightEnabled" Value="True" />
                    <Condition Property="IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="SelectionBrush" Value="{DynamicResource Background.Selected}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource PasswordBox.Style.Basic}" TargetType="PasswordBox" />
</ResourceDictionary>
