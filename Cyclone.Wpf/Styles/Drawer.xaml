<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Cyclone.Wpf;component/Styles/Control.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  抽屉投影：朝向主内容方向投射  -->
    <DropShadowEffect
        x:Key="Drawer.Shadow.Left"
        BlurRadius="16"
        Direction="0"
        Opacity="0.25"
        ShadowDepth="3"
        Color="Black" />
    <DropShadowEffect
        x:Key="Drawer.Shadow.Right"
        BlurRadius="16"
        Direction="180"
        Opacity="0.25"
        ShadowDepth="3"
        Color="Black" />
    <DropShadowEffect
        x:Key="Drawer.Shadow.Top"
        BlurRadius="16"
        Direction="270"
        Opacity="0.25"
        ShadowDepth="3"
        Color="Black" />
    <DropShadowEffect
        x:Key="Drawer.Shadow.Bottom"
        BlurRadius="16"
        Direction="90"
        Opacity="0.25"
        ShadowDepth="3"
        Color="Black" />

    <ControlTemplate x:Key="Drawer.Template.Basic" TargetType="{x:Type ctl:Drawer}">
        <Grid>
            <ContentPresenter Content="{TemplateBinding Content}" />

            <Border
                x:Name="PART_Overlay"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource Overlay.Dark}"
                Opacity="0"
                Visibility="Collapsed" />

            <Border
                x:Name="PART_DrawerPanel"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                FocusManager.IsFocusScope="True"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                KeyboardNavigation.TabNavigation="Cycle">
                <ContentPresenter
                    Margin="{TemplateBinding Padding}"
                    Content="{Binding DrawerContent, RelativeSource={RelativeSource TemplatedParent}}"
                    ContentTemplate="{TemplateBinding DrawerContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding DrawerContentTemplateSelector}"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource TemplatedParent}}" />
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="Placement" Value="Left">
                <Setter TargetName="PART_DrawerPanel" Property="HorizontalAlignment" Value="Left" />
                <Setter TargetName="PART_DrawerPanel" Property="VerticalAlignment" Value="Stretch" />
                <Setter TargetName="PART_DrawerPanel" Property="Effect" Value="{StaticResource Drawer.Shadow.Left}" />
            </Trigger>
            <Trigger Property="Placement" Value="Right">
                <Setter TargetName="PART_DrawerPanel" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="PART_DrawerPanel" Property="VerticalAlignment" Value="Stretch" />
                <Setter TargetName="PART_DrawerPanel" Property="Effect" Value="{StaticResource Drawer.Shadow.Right}" />
            </Trigger>
            <Trigger Property="Placement" Value="Top">
                <Setter TargetName="PART_DrawerPanel" Property="HorizontalAlignment" Value="Stretch" />
                <Setter TargetName="PART_DrawerPanel" Property="VerticalAlignment" Value="Top" />
                <Setter TargetName="PART_DrawerPanel" Property="Effect" Value="{StaticResource Drawer.Shadow.Top}" />
            </Trigger>
            <Trigger Property="Placement" Value="Bottom">
                <Setter TargetName="PART_DrawerPanel" Property="HorizontalAlignment" Value="Stretch" />
                <Setter TargetName="PART_DrawerPanel" Property="VerticalAlignment" Value="Bottom" />
                <Setter TargetName="PART_DrawerPanel" Property="Effect" Value="{StaticResource Drawer.Shadow.Bottom}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Drawer.Style.Basic" TargetType="{x:Type ctl:Drawer}">
        <Setter Property="Background" Value="{DynamicResource Background.Container}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CloseOnOverlayClick" Value="True" />
        <Setter Property="CloseOnEscape" Value="True" />
        <Setter Property="FocusOnOpen" Value="True" />
        <Setter Property="Template" Value="{StaticResource Drawer.Template.Basic}" />
    </Style>

    <Style BasedOn="{StaticResource Drawer.Style.Basic}" TargetType="ctl:Drawer" />
</ResourceDictionary>