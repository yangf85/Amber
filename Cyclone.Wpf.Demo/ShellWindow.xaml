<cy:AdvancedWindow
    x:Class="Cyclone.Wpf.Demo.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Cyclone.Wpf.Demo.ViewModels"
    Title="MainWindow"
    Width="1080"
    Height="960"
    cy:WindowHelper.IsClosing="{Binding IsClosing, Mode=OneWayToSource}"
    cy:WindowHelper.IsClosingMonitorEnabled="True"
    d:DataContext="{d:DesignInstance Type=vm:ShellWindowViewModel}"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <cy:AdvancedWindow.Icon>
        <Image
            Width="27"
            Height="27"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="pack://application:,,,/Cyclone.Wpf.Demo;component/Assets/Logo.png" />
    </cy:AdvancedWindow.Icon>
    <cy:AdvancedWindow.FunctionalZone>
        <cy:SplitButton
            Height="{Binding Path=CaptionHeight, RelativeSource={RelativeSource AncestorType=cy:AdvancedWindow}}"
            HorizontalAlignment="Right"
            BorderThickness="0"
            Label="切换主题"
            WindowChrome.IsHitTestVisibleInChrome="True">
            <!--  CommandParameter 显式 hardcode 主题 Name —— 跟 Content 显示文本解耦  -->
            <cy:SplitButtonItem
                Command="{Binding SwitchThemeCommand}"
                CommandParameter="BasicTheme"
                Content="基础（亮色）" />
            <cy:SplitButtonItem
                Command="{Binding SwitchThemeCommand}"
                CommandParameter="DarkTheme"
                Content="暗色" />
        </cy:SplitButton>
    </cy:AdvancedWindow.FunctionalZone>
    <Grid>
        <local:MainView />
    </Grid>
</cy:AdvancedWindow>
