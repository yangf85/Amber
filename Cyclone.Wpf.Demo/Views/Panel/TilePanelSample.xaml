<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.TilePanelSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:TilePanelViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ButtonSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DemoBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  磁贴 — 普通模板 (用于 ① 固定网格)  -->
        <DataTemplate x:Key="FixedTileTemplate">
            <Border
                Margin="1"
                Background="{Binding Background}"
                CornerRadius="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding Content}" />
            </Border>
        </DataTemplate>

        <!--  磁贴 — 应用模板 (用于 ② 自适应填充, 带左上角图标)  -->
        <DataTemplate x:Key="AppTileTemplate">
            <Border Background="{Binding Background}" CornerRadius="6">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding Content}" />
                    <TextBlock
                        Margin="8,6,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="20"
                        Foreground="White"
                        Opacity="0.85"
                        Text="{Binding Icon}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4,4 L11,4 L11,11 L4,11 Z M13,4 L20,4 L20,8 L13,8 Z M13,10 L20,10 L20,20 L13,20 Z M4,13 L11,13 L11,20 L4,20 Z"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="2.5" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="TilePanel" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="Win11 风格" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="磁贴面板 — 自动混合 1×1 / 2×1 / 1×2 / 2×2 等不同尺寸磁贴的智能布局, 支持固定网格和 IsAutoFill 自适应填充两种模式。灵感来自 Windows 开始菜单。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 固定网格磁贴布局 ==========  -->
            <cy:SectionHeader
                MainTitle="① 固定网格磁贴布局"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Rows × Columns 固定 · MaxColumnSpan / MaxRowSpan 控制最大跨度" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="给定固定的行列数, TilePanel 会自动分配 1×1 / 2×1 / 1×2 / 2×2 等不同跨度的磁贴并均匀分布大磁贴, 避免视觉聚集。MaxColumnSpan / MaxRowSpan 限制单个磁贴的最大跨度。" />

            <Border Style="{StaticResource DemoBorderStyle}">
                <Border
                    Height="300"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Padding="10">
                    <ItemsControl
                        ItemTemplate="{StaticResource FixedTileTemplate}"
                        ItemsSource="{Binding FixedGridItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <cy:TilePanel
                                    Columns="8"
                                    MaxColumnSpan="3"
                                    MaxRowSpan="3"
                                    Rows="6"
                                    Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="6 行 × 8 列 = 48 个槽位 · 24 个数据项 · 磁贴智能选择跨度填充空白 · MaxColumnSpan / MaxRowSpan = 3 限制最大不超过 3×3。"
                TextWrapping="Wrap" />

            <!--  ========== ② 自适应填充磁贴布局 ==========  -->
            <cy:SectionHeader
                MainTitle="② 自适应填充磁贴布局"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsAutoFill=True · 自动调整网格大小并填充空白" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="IsAutoFill=True 时, TilePanel 会扩大磁贴跨度以填满整个容器, 不留空白格子。适合 Windows 开始菜单这类必须铺满的应用磁贴场景。" />

            <Border Style="{StaticResource DemoBorderStyle}">
                <Border
                    Height="280"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    Padding="10">
                    <ItemsControl
                        ItemTemplate="{StaticResource AppTileTemplate}"
                        ItemsSource="{Binding AutoFillItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <cy:TilePanel
                                    Columns="6"
                                    IsAutoFill="True"
                                    MaxColumnSpan="4"
                                    MaxRowSpan="4"
                                    Rows="5"
                                    Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="5 行 × 6 列 = 30 个槽位 · 15 个数据项 · 磁贴自动扩展占据剩余空间, 视觉上无任何空白。"
                TextWrapping="Wrap" />

            <!--  ========== ③ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="③ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="核心属性一览表" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Rows" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="int" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="网格的行数。" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Columns" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="int" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="网格的列数。" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Spacing" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double (0)" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="磁贴之间的间距, 水平垂直一致。" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="MaxColumnSpan" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="int" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="单个磁贴可跨的最大列数, 限制大磁贴的水平尺寸。" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="MaxRowSpan" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="int" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="单个磁贴可跨的最大行数, 限制大磁贴的垂直尺寸。" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="IsAutoFill" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="bool (false)" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="True 时磁贴自动扩展跨度填满容器, 不留空格; False 时保留空白格子。" />
                </Grid>
            </Border>

            <!--  ========== ④ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="TilePanel 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="智能分布大磁贴" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="不是简单按顺序填入, 而是均匀打散 2×2 / 2×1 等大磁贴, 避免视觉聚集"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="两种填充模式" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="固定模式留白严格按行列对齐; IsAutoFill 模式磁贴自动撑开消除空白, 应用启动器场景必备"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Span 约束" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="MaxColumnSpan / MaxRowSpan 限制单磁贴尺寸, 避免一块磁贴撑爆整个网格"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
