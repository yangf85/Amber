<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SpacingUniformGridSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:SpacingUniformGridViewModel}}"
    d:DesignHeight="2600"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ButtonSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DemoBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4,4 L20,4 L20,20 L4,20 Z M12,4 L12,20 M4,12 L20,12"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="2.5" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="SpacingUniformGrid" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="等分网格" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="带间距的均匀网格 — 在原生 UniformGrid 基础上补齐 HorizontalSpacing / VerticalSpacing 属性; HorizontalStackMode 切换为按列内容自适应宽度。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础网格布局 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础网格布局"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Rows × Columns 等分 · HorizontalSpacing / VerticalSpacing" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="设定 Rows / Columns 后, 容器被均分为 R×C 个相同尺寸的格子, 子元素按顺序填入。HorizontalSpacing / VerticalSpacing 控制水平/垂直间距, 与原生 UniformGrid 的最大差异点。" />

            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingUniformGrid
                    Columns="4"
                    HorizontalSpacing="10"
                    Rows="3"
                    VerticalSpacing="8">
                    <Button Height="40" Content="1" />
                    <Button Height="40" Content="2" />
                    <Button Height="40" Content="3" />
                    <Button Height="40" Content="4" />
                    <Button Height="40" Content="5" />
                    <Button Height="40" Content="6" />
                    <Button Height="40" Content="7" />
                    <Button Height="40" Content="8" />
                    <Button Height="40" Content="9" />
                    <Button Height="40" Content="10" />
                    <Button Height="40" Content="11" />
                    <Button Height="40" Content="12" />
                </cy:SpacingUniformGrid>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="3 行 × 4 列 · 水平间距 10px · 垂直间距 8px · 所有格子尺寸完全相同。"
                TextWrapping="Wrap" />

            <!--  ========== ② 间距对比 ==========  -->
            <cy:SectionHeader
                MainTitle="② 间距对比"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="不同 Spacing 对密度的影响" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="HorizontalSpacing 和 VerticalSpacing 可独立设置, 适合横疏纵密(如时间槽位)或纵疏横密(如表单分组)的非对称网格。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="紧凑 — Spacing = 2" />
            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingUniformGrid
                    Columns="6"
                    HorizontalSpacing="2"
                    Rows="2"
                    VerticalSpacing="2">
                    <Button Height="32" Content="1" />
                    <Button Height="32" Content="2" />
                    <Button Height="32" Content="3" />
                    <Button Height="32" Content="4" />
                    <Button Height="32" Content="5" />
                    <Button Height="32" Content="6" />
                    <Button Height="32" Content="7" />
                    <Button Height="32" Content="8" />
                    <Button Height="32" Content="9" />
                    <Button Height="32" Content="10" />
                    <Button Height="32" Content="11" />
                    <Button Height="32" Content="12" />
                </cy:SpacingUniformGrid>
            </Border>

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="宽松 — Spacing = 16" />
            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingUniformGrid
                    Columns="6"
                    HorizontalSpacing="16"
                    Rows="2"
                    VerticalSpacing="16">
                    <Button Height="32" Content="1" />
                    <Button Height="32" Content="2" />
                    <Button Height="32" Content="3" />
                    <Button Height="32" Content="4" />
                    <Button Height="32" Content="5" />
                    <Button Height="32" Content="6" />
                    <Button Height="32" Content="7" />
                    <Button Height="32" Content="8" />
                    <Button Height="32" Content="9" />
                    <Button Height="32" Content="10" />
                    <Button Height="32" Content="11" />
                    <Button Height="32" Content="12" />
                </cy:SpacingUniformGrid>
            </Border>

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="非对称 — H=24 / V=4" />
            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingUniformGrid
                    Columns="6"
                    HorizontalSpacing="24"
                    Rows="2"
                    VerticalSpacing="4">
                    <Button Height="32" Content="1" />
                    <Button Height="32" Content="2" />
                    <Button Height="32" Content="3" />
                    <Button Height="32" Content="4" />
                    <Button Height="32" Content="5" />
                    <Button Height="32" Content="6" />
                    <Button Height="32" Content="7" />
                    <Button Height="32" Content="8" />
                    <Button Height="32" Content="9" />
                    <Button Height="32" Content="10" />
                    <Button Height="32" Content="11" />
                    <Button Height="32" Content="12" />
                </cy:SpacingUniformGrid>
            </Border>

            <!--  ========== ③ HorizontalStackMode ==========  -->
            <cy:SectionHeader
                MainTitle="③ HorizontalStackMode"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="每列宽度按该列最宽内容自适应" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="开启 HorizontalStackMode 后, 每列的宽度由该列中最宽的元素决定 (非等分), 行高仍保持统一。适合内容长度差异大的列表/表格场景, 避免短内容浪费宽度。" />

            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingUniformGrid
                    Columns="3"
                    HorizontalSpacing="15"
                    HorizontalStackMode="True"
                    Rows="2"
                    VerticalSpacing="10">
                    <!--  第一列: 短内容  -->
                    <Button Height="35" Content="短" />
                    <Button Height="35" Content="A" />
                    <!--  第二列: 中等内容  -->
                    <Button Height="35" Content="中等长度内容" />
                    <Button Height="35" Content="Medium" />
                    <!--  第三列: 长内容  -->
                    <Button Height="35" Content="这是一个很长的按钮内容" />
                    <Button Height="35" Content="Very Long Button Content" />
                </cy:SpacingUniformGrid>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="对比 ① 的等分模式 — 这里第一列只有短按钮的宽度, 第三列拓宽以容纳长文本。"
                TextWrapping="Wrap" />

            <!--  ========== ④ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="④ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="核心属性一览表" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Rows" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="int (0)" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="行数。0 表示根据 Columns 与子元素总数自动推断。" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Columns" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="int (0)" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="列数。0 表示根据 Rows 与子元素总数自动推断。" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="HorizontalSpacing" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double (0)" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="列之间的水平间距, 单位为设备无关像素。" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="VerticalSpacing" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double (0)" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="行之间的垂直间距, 单位为设备无关像素。" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="HorizontalStackMode" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="bool (false)" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="True 时, 每列宽度按该列最宽内容自适应(非等分), 行高仍统一。" />
                </Grid>
            </Border>

            <!--  ========== ⑤ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="SpacingUniformGrid 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="原生 UniformGrid + 间距" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="WPF 自带 UniformGrid 没有间距属性, 通常要给每个子元素加 Margin — 这里两个属性一行搞定"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="水平堆叠模式" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="HorizontalStackMode 折中等分网格和 Grid — 列宽按内容, 行高仍齐, 适合内容长度差异大的标签/工具栏"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="间距独立" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="水平和垂直间距可不同, 支持非对称网格设计, 而不是被迫一致"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
