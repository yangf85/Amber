<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SpacingStackPanelSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hp="clr-namespace:Cyclone.Wpf.Demo.Helper"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:SpacingStackPanelViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ButtonSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DemoBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Demo Item — 用 Border 模拟带颜色的占位条, 避免依赖 Background  -->
        <Style x:Key="WeightBoxStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="2.5" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="SpacingStackPanel" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="权重布局" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="带间距的栈面板 — 支持 Auto / 固定像素 / 星号(*) 三种 Weight 模式, 一行 XAML 完成 Grid 的列宽分配; 内置 Spacing 属性, 省去手写 Margin。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 水平方向 Weight 分配 ==========  -->
            <cy:SectionHeader
                MainTitle="① 水平方向 Weight 分配"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Auto · 固定像素 · 1* / 2* 比例分配" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="通过附加属性 SpacingStackPanel.Weight 声明每个子元素的宽度策略 — Auto 按内容自适应, 数字按像素固定, 1* / 2* 按比例瓜分剩余空间。比 Grid + ColumnDefinitions 简洁很多。" />

            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingStackPanel
                    Height="40"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        cy:SpacingStackPanel.Weight="Auto"
                        Content="Auto" />
                    <Button
                        cy:SpacingStackPanel.Weight="120"
                        Content="固定 120px" />
                    <Button
                        cy:SpacingStackPanel.Weight="1*"
                        Content="1*"
                        Style="{DynamicResource Button.Style.Subtle}" />
                    <Button
                        cy:SpacingStackPanel.Weight="2*"
                        Content="2*"
                        Style="{DynamicResource Button.Style.Primary}" />
                </cy:SpacingStackPanel>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="拖宽窗口观察: Auto 按内容收缩, 120px 不变, 1* / 2* 按 1:2 比例瓜分剩余宽度。"
                TextWrapping="Wrap" />

            <!--  ========== ② Spacing 间距对比 ==========  -->
            <cy:SectionHeader
                MainTitle="② Spacing 间距对比"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="一处设置, 自动应用到所有子元素之间" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="Spacing 自动在相邻元素之间插入指定大小的间隔, 不需要给每个子元素设置 Margin。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Spacing = 0 (无间距)" />
            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingStackPanel
                    Height="36"
                    Orientation="Horizontal"
                    Spacing="0">
                    <Button cy:SpacingStackPanel.Weight="1*" Content="A" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="B" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="C" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="D" />
                </cy:SpacingStackPanel>
            </Border>

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="Spacing = 8" />
            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingStackPanel
                    Height="36"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button cy:SpacingStackPanel.Weight="1*" Content="A" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="B" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="C" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="D" />
                </cy:SpacingStackPanel>
            </Border>

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="Spacing = 24" />
            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingStackPanel
                    Height="36"
                    Orientation="Horizontal"
                    Spacing="24">
                    <Button cy:SpacingStackPanel.Weight="1*" Content="A" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="B" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="C" />
                    <Button cy:SpacingStackPanel.Weight="1*" Content="D" />
                </cy:SpacingStackPanel>
            </Border>

            <!--  ========== ③ 垂直方向 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 垂直方向"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Orientation=Vertical · Weight 控制行高" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="垂直方向下 Weight 改为控制每行的高度。常用于工具栏 + 主内容 + 状态栏式的纵向布局。" />

            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingStackPanel
                    Height="280"
                    Orientation="Vertical"
                    Spacing="6">
                    <Border
                        cy:SpacingStackPanel.Weight="Auto"
                        Padding="12,8"
                        Background="{DynamicResource Background.Header}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <TextBlock
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="顶部工具栏 (Auto — 按内容)" />
                    </Border>
                    <Border
                        cy:SpacingStackPanel.Weight="1*"
                        Background="{DynamicResource Background.Header}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="主内容 (1* — 占据剩余空间)" />
                    </Border>
                    <Border
                        cy:SpacingStackPanel.Weight="32"
                        Background="{DynamicResource Background.Header}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="状态栏 (固定 32px)" />
                    </Border>
                </cy:SpacingStackPanel>
            </Border>

            <!--  ========== ④ 表单场景 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 表单场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="与 FormItem / SharedName 联用 · 标签列宽自动对齐" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="搭配 cy:FormItem + SharedName 时, 同名标签的列宽会自动对齐, 无需手工设置 Width。垂直方向 + 小间距是表单的标准用法。" />

            <Border Style="{StaticResource DemoBorderStyle}">
                <cy:SpacingStackPanel
                    Orientation="Vertical"
                    Spacing="8">
                    <cy:FormItem Label="姓名:" SharedName="Model">
                        <TextBox />
                    </cy:FormItem>
                    <cy:FormItem
                        Description="请输入年龄..."
                        Label="年龄:"
                        SharedName="Model">
                        <cy:NumberBox />
                    </cy:FormItem>
                    <cy:FormItem
                        Label="状态:"
                        SharedName="Model"
                        VerticalContentAlignment="Center">
                        <cy:EnumSelector EnumType="{x:Type hp:UserStatus}" Rows="1" />
                    </cy:FormItem>
                    <cy:FormItem Label="备注:" SharedName="Model">
                        <TextBox AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                    </cy:FormItem>
                </cy:SpacingStackPanel>
            </Border>

            <!--  ========== ⑤ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="核心属性 + 附加属性一览表" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Orientation" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Orientation (Vertical)" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="布局方向。Horizontal 时 Weight 控制宽度, Vertical 时控制高度。" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Spacing" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double (0)" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="相邻子元素之间的固定间距, 单位为设备无关像素。" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="SpacingStackPanel.Weight" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="GridLength (附加)" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="附加属性 — Auto 按内容, 120 按像素, 1* / 2* 按比例瓜分剩余空间。语义等价于 Grid 的 ColumnDefinitions / RowDefinitions。" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="(默认 Weight)" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Auto" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="未指定时默认 Auto, 行为退化为普通 StackPanel + Spacing。" />
                </Grid>
            </Border>

            <!--  ========== ⑥ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="SpacingStackPanel 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="比 Grid 更轻量" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="不需要写 ColumnDefinitions / Grid.Column, 子元素直接声明 Weight, XAML 短一半"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="比 StackPanel 更灵活" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="原生 StackPanel 只能 Auto, 这里支持星号比例 — 工具栏左对齐 + 弹簧 + 右对齐一行搞定"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="间距统一" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Spacing 一处设置, 替代每个子元素的 Margin 写法, 改间距时只改一个值"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
