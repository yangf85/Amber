<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.NumberBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M2,12 L22,12 M7,7 L17,7 M9,17 L15,17"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.5" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="NumberBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="继承 RangeBase" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="带步进按钮的数字输入框, 支持整数 / 小数模式、前后缀、键盘 ↑↓ 与 PgUp/PgDn 步进、滚轮调节、横竖向布局。常用于表单字段、设置项、参数配置等场景。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Minimum · Maximum · Value 三件套" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="设置 Minimum / Maximum 限制范围, Value 是当前值。右侧实时显示 NumberBox 的属性状态, 用鼠标滚轮、键盘 ↑↓、或步进按钮调整。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <cy:NumberBox
                    x:Name="BasicNumberBox"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    Value="42" />
                <Border
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Padding="14,10"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="76"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Minimum:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="{Binding Minimum, ElementName=BasicNumberBox}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="76"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Maximum:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="{Binding Maximum, ElementName=BasicNumberBox}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="76"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Value:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="{Binding Value, ElementName=BasicNumberBox}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ② 数字模式与精度 ==========  -->
            <cy:SectionHeader
                MainTitle="② 数字模式与精度"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="NumberMode · DecimalPlaces · SmallChange" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="NumberMode 切换 Integer / Decimal 模式。Decimal 模式下 DecimalPlaces 控制显示精度, SmallChange 控制步长。键盘 ↑↓ 与 ± 按钮按 SmallChange 增减, PgUp/PgDn 按 LargeChange 增减。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="整数模式(NumberMode = Integer)" />
            <cy:NumberBox
                Width="320"
                HorizontalAlignment="Left"
                Maximum="999"
                Minimum="0"
                NumberMode="Integer"
                SmallChange="1"
                Value="25" />

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="小数模式(DecimalPlaces = 4, SmallChange = 0.001)" />
            <cy:NumberBox
                Width="320"
                HorizontalAlignment="Left"
                DecimalPlaces="4"
                Maximum="10"
                Minimum="-10"
                SmallChange="0.001"
                Value="3.1415" />

            <!--  ========== ③ 前后缀 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 前后缀"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Prefix · Suffix" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Prefix / Suffix 接受任意 object, 字符串、图标、任何 UIElement 都可以。用于货币、百分比、单位等场景, 视觉上紧贴输入区, 不占字符位置。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="前缀(货币 ¥)" />
            <cy:NumberBox
                Width="320"
                HorizontalAlignment="Left"
                DecimalPlaces="2"
                Maximum="100000"
                Minimum="0"
                Prefix="¥"
                SmallChange="10"
                Value="299.00" />

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="后缀(百分比 %)" />
            <cy:NumberBox
                Width="320"
                HorizontalAlignment="Left"
                Maximum="100"
                Minimum="0"
                NumberMode="Integer"
                Suffix="%"
                Value="80" />

            <!--  ========== ④ 步进按钮与清除 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 步进按钮与清除"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="SpinButtonOrientation · IsSpinButtonVisible · IsClearButtonVisible" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="SpinButtonOrientation 切换 ± 按钮的横竖向。IsSpinButtonVisible=False 完全隐藏步进按钮, 留给纯键盘 / 滚轮交互。IsClearButtonVisible=True 显示清除按钮, 一键归零。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="横向布局(SpinButtonOrientation = Horizontal)" />
            <cy:NumberBox
                Width="320"
                HorizontalAlignment="Left"
                Maximum="100"
                Minimum="0"
                SpinButtonOrientation="Horizontal"
                Value="50" />

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="隐藏步进按钮(IsSpinButtonVisible = False)" />
            <cy:NumberBox
                Width="320"
                HorizontalAlignment="Left"
                IsSpinButtonVisible="False"
                Maximum="100"
                Minimum="0"
                Value="60" />

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="清除按钮(IsClearButtonVisible = True)" />
            <cy:NumberBox
                Width="320"
                HorizontalAlignment="Left"
                IsClearButtonVisible="True"
                Maximum="1000"
                Minimum="-100"
                Value="42" />

            <!--  ========== ⑤ 状态对比 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 状态对比"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Normal / ReadOnly / Disabled" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="ReadOnly 仅禁止编辑, 步进按钮也禁用, 仍可聚焦 / 复制; Disabled 是完全禁用, 走 Disabled token 组置灰。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Normal" />
                <cy:NumberBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Maximum="100"
                    Minimum="0"
                    Value="33" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,8,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="ReadOnly" />
                <cy:NumberBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    IsReadOnly="True"
                    Maximum="100"
                    Minimum="0"
                    Value="33" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="8,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Disabled" />
                <cy:NumberBox
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    Value="33" />
            </Grid>

            <!--  ========== ⑥ 实战场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 实战场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="表单字段 / 价格 / 百分比 / 设置项" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,8"
                    Padding="14"
                    Background="{DynamicResource Background.Container}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.Default}" Text="表单字段 — 年龄" />
                        <TextBlock Margin="0,6,0,12" FontSize="12" Foreground="{DynamicResource Foreground.Caption}" Text="整数模式, 0-150 范围" TextWrapping="Wrap" />
                        <cy:NumberBox Maximum="150" Minimum="0" NumberMode="Integer" Suffix="岁" Value="28" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,8"
                    Padding="14"
                    Background="{DynamicResource Background.Container}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.Default}" Text="价格 — 商品定价" />
                        <TextBlock Margin="0,6,0,12" FontSize="12" Foreground="{DynamicResource Foreground.Caption}" Text="货币前缀, 两位小数" TextWrapping="Wrap" />
                        <cy:NumberBox
                            DecimalPlaces="2"
                            Maximum="100000"
                            Minimum="0"
                            Prefix="¥"
                            SmallChange="10"
                            Value="299.00" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Padding="14"
                    Background="{DynamicResource Background.Container}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.Default}" Text="百分比 — 阈值配置" />
                        <TextBlock Margin="0,6,0,12" FontSize="12" Foreground="{DynamicResource Foreground.Caption}" Text="0-100 整数, 后缀单位" TextWrapping="Wrap" />
                        <cy:NumberBox
                            Maximum="100"
                            Minimum="0"
                            NumberMode="Integer"
                            Suffix="%"
                            Value="80" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Padding="14"
                    Background="{DynamicResource Background.Container}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Foreground.Default}" Text="设置项 — 超时秒数" />
                        <TextBlock Margin="0,6,0,12" FontSize="12" Foreground="{DynamicResource Foreground.Caption}" Text="正整数, 默认 30 秒" TextWrapping="Wrap" />
                        <cy:NumberBox
                            Maximum="3600"
                            Minimum="1"
                            NumberMode="Integer"
                            Suffix="秒"
                            Value="30" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ⑦ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="RangeBase 继承属性 + NumberBox 扩展" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型 (默认)" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Value" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0)" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前数值, 继承自 RangeBase, 默认 TwoWay 绑定。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Minimum / Maximum" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数值范围, 继承自 RangeBase。输入超出范围会被强制夹紧到边界。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SmallChange" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (1)" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="步进按钮 / 键盘 ↑↓ / 鼠标滚轮 的步长。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="LargeChange" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (10)" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="PgUp / PgDn 步长。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="NumberMode" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (Decimal)" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Integer / Decimal。Integer 模式拒绝输入小数点。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="DecimalPlaces" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="int (2)" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Decimal 模式下的小数位数, 显示与四舍五入都按此精度。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Prefix / Suffix" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object (null)" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="输入框前 / 后的展示元素, 可为任意 UIElement (字符串、Path、Image 等)。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SpinButtonOrientation" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (Vertical)" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="步进按钮的排列方向。" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSpinButtonVisible" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (true)" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否显示步进按钮。隐藏后只能通过键盘 / 滚轮调整。" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsClearButtonVisible" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                    <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否显示清除按钮 (一键归零)。" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ValueChanged" />
                    <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="RoutedEvent" />
                    <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Value 变更时触发(继承自 RangeBase)。用户输入过程中不触发, 失焦或回车统一结算。" />
                </Grid>
            </Border>

            <!--  ========== ⑧ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑧ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="NumberBox 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="继承 RangeBase, 与 Slider 共享语义" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Value / Minimum / Maximum / SmallChange / LargeChange / ValueChanged 全部沿用 RangeBase, 任何熟悉 Slider 的开发者无学习成本"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="输入过程不更新 Value" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="键入中间状态(如 &quot;-&quot;、&quot;3.&quot;)不会回写 Value, 避免触发 ValueChanged 风暴; 失焦 / 回车 / 步进时统一结算"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Prefix / Suffix 是 object 而非 string" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="既可以放字符串, 也可以放 Path / Image / 任意控件 — 例如自定义图标货币符号或带 Tooltip 的单位说明"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="ReadOnly 与 Disabled 区分" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ReadOnly 只禁用编辑和步进, 视觉上仍是正常输入框; Disabled 整体置灰, 不可聚焦, 走 Disabled token 组"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
