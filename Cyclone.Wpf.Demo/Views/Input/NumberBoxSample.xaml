<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.NumberBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="2000"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ============ 章节编号小圆圈 ============  -->
        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  ============ 演示项标题（每个 NumberBox 上方那条小标题） ============  -->
        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DemoItemSubtitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!--  ============ 属性表的列样式 ============  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PropTableNameStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PropTableCellStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>

        <Style x:Key="PropTableTypeStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PropTableCellStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  ============ 代码块样式 ============  -->
        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="Auto" />
                <!--  主体两列  -->
                <RowDefinition Height="Auto" />
                <!--  Tip  -->
            </Grid.RowDefinitions>

            <!--  ============ Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}"
                        CornerRadius="0">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M2,12 L22,12 M7,7 L17,7 M9,17 L15,17"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeThickness="2.5" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="NumberBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}"
                                CornerRadius="0">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="带步进按钮的数字输入框，支持整数/小数模式、前后缀、键盘步进、滚轮调节、横竖向布局，常用于表单字段、设置项、参数配置等场景。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体：两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>
                                <cy:NumberBox
                                    x:Name="BasicNumberBox"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="42" />
                                <Border
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Padding="14,10"
                                    Background="{DynamicResource Background.Header}"
                                    CornerRadius="0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Width="80"
                                                FontSize="12"
                                                Foreground="{DynamicResource Foreground.Caption}"
                                                Text="Minimum:" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{DynamicResource Foreground.Default}"
                                                Text="{Binding Minimum, ElementName=BasicNumberBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                Width="80"
                                                FontSize="12"
                                                Foreground="{DynamicResource Foreground.Caption}"
                                                Text="Maximum:" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{DynamicResource Foreground.Default}"
                                                Text="{Binding Maximum, ElementName=BasicNumberBox}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                Width="80"
                                                FontSize="12"
                                                Foreground="{DynamicResource Foreground.Caption}"
                                                Text="Value:" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Foreground.Link}"
                                                Text="{Binding Value, ElementName=BasicNumberBox}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 其他样式示例  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="其他样式示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <StackPanel>

                            <!--  整数模式  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="整数模式 (NumberMode = Integer)" />
                                <cy:NumberBox
                                    Maximum="999"
                                    Minimum="0"
                                    NumberMode="Integer"
                                    SmallChange="1"
                                    Value="25" />
                            </StackPanel>

                            <!--  小数 + 自定义位数  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="小数模式 (DecimalPlaces = 4，SmallChange = 0.001)" />
                                <cy:NumberBox
                                    DecimalPlaces="4"
                                    Maximum="10"
                                    Minimum="-10"
                                    SmallChange="0.001"
                                    Value="3.1415" />
                            </StackPanel>

                            <!--  前缀（货币）  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="前缀 (Prefix = ¥)" />
                                <cy:NumberBox
                                    DecimalPlaces="2"
                                    Maximum="100000"
                                    Minimum="0"
                                    Prefix="¥"
                                    SmallChange="10"
                                    Value="299.00" />
                            </StackPanel>

                            <!--  后缀（百分比）  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="后缀 (Suffix = %)" />
                                <cy:NumberBox
                                    DecimalPlaces="0"
                                    Maximum="100"
                                    Minimum="0"
                                    NumberMode="Integer"
                                    Suffix="%"
                                    Value="80" />
                            </StackPanel>

                            <!--  横向布局  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="横向布局 (SpinButtonOrientation = Horizontal)" />
                                <cy:NumberBox
                                    Maximum="100"
                                    Minimum="0"
                                    SpinButtonOrientation="Horizontal"
                                    Value="50" />
                            </StackPanel>

                            <!--  Clear 按钮  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="清空按钮 (IsClearButtonVisible = True)" />
                                <cy:NumberBox
                                    IsClearButtonVisible="True"
                                    Maximum="1000"
                                    Minimum="-100"
                                    Value="42" />
                            </StackPanel>

                            <!--  隐藏 Spin  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="隐藏步进按钮 (IsSpinButtonVisible = False)" />
                                <cy:NumberBox
                                    IsSpinButtonVisible="False"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="60" />
                            </StackPanel>

                            <!--  只读  -->
                            <StackPanel>
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="只读 (IsReadOnly = True)" />
                                <cy:NumberBox
                                    IsReadOnly="True"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="33" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="常见使用场景">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <StackPanel>

                            <UniformGrid Columns="4" Rows="1">
                                <UniformGrid.Resources>
                                    <Style TargetType="{x:Type cy:Card}">
                                        <Setter Property="Margin" Value="6,0" />
                                    </Style>
                                </UniformGrid.Resources>

                                <cy:Card>
                                    <StackPanel>
                                        <Path
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            Data="M4,6 L20,6 L14,12 L14,19 L10,17 L10,12 Z"
                                            Stroke="{DynamicResource Foreground.Link}"
                                            StrokeLineJoin="Round"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Foreground.Default}"
                                            Text="表单字段" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="年龄、数量、库存等结构化字段输入"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </cy:Card>
                                <cy:Card>
                                    <StackPanel>
                                        <Path
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            Data="M12,2 L12,22 M5,8 L19,8 M5,16 L19,16"
                                            Stroke="{DynamicResource Foreground.Success}"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Foreground.Default}"
                                            Text="价格输入" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="货币、价格、金额等带前缀的小数输入"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </cy:Card>
                                <cy:Card>
                                    <StackPanel>
                                        <Path
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            Data="M3,12 L8,12 L10,7 L14,17 L16,12 L21,12"
                                            Stroke="{DynamicResource Foreground.Warning}"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Foreground.Default}"
                                            Text="百分比配置" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="阈值、占比、比率等带后缀的整数输入"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </cy:Card>
                                <cy:Card>
                                    <StackPanel>
                                        <Path
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            Data="M3,7 L21,7 M3,12 L17,12 M3,17 L21,17 M14,5 L14,9 M8,10 L8,14 M18,15 L18,19"
                                            Stroke="#8B5CF6"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Foreground.Default}"
                                            Text="设置项" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="超时秒数、缓存大小、并发数等系统配置"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </cy:Card>
                            </UniformGrid>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ 主要属性  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="主要属性">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <StackPanel>

                            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <!--  Header  -->
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Header 行背景  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.ColumnSpan="4"
                                        Background="{DynamicResource Background.Header}"
                                        CornerRadius="0" />

                                    <!--  Header  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableHeaderStyle}"
                                        Text="属性" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableHeaderStyle}"
                                        Text="类型" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableHeaderStyle}"
                                        Text="默认值" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Style="{StaticResource PropTableHeaderStyle}"
                                        Text="说明" />

                                    <!--  分隔线  -->
                                    <Border
                                        Grid.Row="0"
                                        Grid.ColumnSpan="4"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Border.Default}"
                                        Height="1" />

                                    <!--  Value  -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Value" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="当前数值" />

                                    <!--  Minimum  -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Minimum" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="MinValue" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="允许的最小值" />

                                    <!--  Maximum  -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Maximum" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="MaxValue" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="允许的最大值" />

                                    <!--  SmallChange  -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SmallChange" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="1" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="±按钮 / Up·Down 步长" />

                                    <!--  LargeChange  -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="LargeChange" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="10" />
                                    <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="PgUp / PgDn 步长" />

                                    <!--  DecimalPlaces  -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="DecimalPlaces" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="int" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="2" />
                                    <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="允许的小数位数" />

                                    <!--  NumberMode  -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="NumberMode" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum" />
                                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="Decimal" />
                                    <TextBlock Grid.Row="7" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="Integer / Decimal" />

                                    <!--  Prefix  -->
                                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Prefix" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                                    <TextBlock Grid.Row="8" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="输入框前缀（如 ¥）" />

                                    <!--  Suffix  -->
                                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Suffix" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                                    <TextBlock Grid.Row="9" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="输入框后缀（如 %）" />

                                    <!--  SpinButtonOrientation  -->
                                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SpinButtonOrientation" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum" />
                                    <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="Vertical" />
                                    <TextBlock Grid.Row="10" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="步进按钮方向" />

                                    <!--  IsReadOnly  -->
                                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsReadOnly" />
                                    <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                                    <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="False" />
                                    <TextBlock Grid.Row="11" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="是否只读" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ XAML 示例 + ⑥ 事件 (并排)  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <!--  ⑤ XAML 示例  -->
                        <cy:Card Grid.Column="0">
                            <cy:Card.Header>
                                <cy:CardHeader Title="XAML 示例">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberStyle}">
                                            <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>
                            <StackPanel>
                                <TextBox
                                    AcceptsReturn="True"
                                    Style="{StaticResource CodeBlockStyle}">
                                    <![CDATA[<cy:NumberBox
    Minimum="0"
    Maximum="100000"
    Value="299.00"
    DecimalPlaces="2"
    SmallChange="10"
    Prefix="¥"
    Suffix="USD"
    SpinButtonOrientation="Vertical"
    IsClearButtonVisible="True" />]]>
                                </TextBox>
                            </StackPanel>
                        </cy:Card>

                        <!--  ⑥ 事件  -->
                        <cy:Card Grid.Column="2">
                            <cy:Card.Header>
                                <cy:CardHeader Title="事件">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberStyle}">
                                            <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>
                            <StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="ValueChanged" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="Value 发生变化时触发（继承自 RangeBase 的路由事件）"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Placeholder}"
                                    Text="提示：用户输入过程中不会触发；失焦或按 Enter 时统一结算。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </cy:Card>
                    </Grid>
                </StackPanel>
            </Grid>

            <!--  ============ 底部 Tip ============  -->
            <Border
                Grid.Row="2"
                Margin="0,20,0,0"
                Padding="16,12"
                Background="{DynamicResource Background.Info}"
                BorderBrush="{DynamicResource Border.Info}"
                BorderThickness="1"
                CornerRadius="0">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Background.Highlighted}"
                        CornerRadius="999">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="i" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Default}">
                        <Run Text="NumberBox 继承自" />
                        <Run FontFamily="Consolas" Foreground="{DynamicResource Foreground.Link}" Text="RangeBase" />
                        <Run Text="，可像原生 Slider 一样使用 Value / Minimum / Maximum / SmallChange / LargeChange / ValueChanged 等成员，配合双向绑定无缝接入 MVVM。" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>