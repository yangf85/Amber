<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.FilterBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:FilterBoxViewModel}}"
    d:DesignHeight="3200"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryBoxStyle" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <Style x:Key="SubTableTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M3,5 L21,5 L14,12 L14,19 L10,17 L10,12 Z"
                            Stroke="White"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="FilterBox 系列" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="过滤控件对——NumberFilterBox(数字过滤,= ≠ &lt; ≤ &gt; ≥)与 TextFilterBox(文本过滤,= ≠ ∋ ∌ ^ $ .*)。结构对称、用法一致:复选框启用 + 操作符下拉 + 输入框。控件只暴露状态,过滤委托由调用方根据状态拼装。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列(① ~ ⑤)============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法对照  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法对照" Subtitle="NumberFilterBox / TextFilterBox 结构相同">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="两个控件三段结构完全一致:复选框 Label + Operator 下拉 + Value/Text 输入。勾选启用,未启用时下拉与输入框被禁用。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="NumberFilterBox" />
                            <cy:NumberFilterBox
                                IsActive="{Binding BasicNumberIsActive, Mode=TwoWay}"
                                Label="价格"
                                Maximum="9999"
                                Minimum="0"
                                Operator="{Binding BasicNumberOperator, Mode=TwoWay}"
                                Value="{Binding BasicNumberValue, Mode=TwoWay}" />
                            <Border Style="{StaticResource SummaryBoxStyle}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}">
                                    <Run Text="谓词:" />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding BasicNumberSummary, Mode=OneWay}" />
                                </TextBlock>
                            </Border>

                            <TextBlock
                                Margin="0,20,0,8"
                                Style="{StaticResource DemoItemTitleStyle}"
                                Text="TextFilterBox" />
                            <cy:TextFilterBox
                                IsActive="{Binding BasicTextIsActive, Mode=TwoWay}"
                                Label="名称"
                                Operator="{Binding BasicTextOperator, Mode=TwoWay}"
                                Text="{Binding BasicTextValue, Mode=TwoWay}"
                                Watermark="输入要匹配的文本…" />
                            <Border Style="{StaticResource SummaryBoxStyle}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}">
                                    <Run Text="谓词:" />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding BasicTextSummary, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 操作符全集  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="操作符全集" Subtitle="数字 6 个 / 文本 7 个">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="操作符以数学符号显示在 ComboBox 中,可读性优于英文枚举。展开下拉切换观察。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="数字: =  ≠  &lt;  ≤  &gt;  ≥" />
                            <cy:NumberFilterBox
                                IsActive="True"
                                Label="x"
                                Maximum="1000"
                                Minimum="0"
                                Operator="{Binding NumOperatorOperator, Mode=TwoWay}"
                                Value="{Binding NumOperatorValue, Mode=TwoWay}" />
                            <Border Style="{StaticResource SummaryBoxStyle}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}">
                                    <Run Text="谓词:" />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding NumOperatorSummary, Mode=OneWay}" />
                                </TextBlock>
                            </Border>

                            <TextBlock
                                Margin="0,20,0,8"
                                Style="{StaticResource DemoItemTitleStyle}"
                                Text="文本: =  ≠  ∋  ∌  ^  $  .*" />
                            <cy:TextFilterBox
                                IsActive="True"
                                Label="s"
                                MaxLength="40"
                                Operator="{Binding TextOperatorOperator, Mode=TwoWay}"
                                Text="{Binding TextOperatorValue, Mode=TwoWay}"
                                Watermark="∋=Contains, ^=StartsWith, .*=Regex…" />
                            <Border Style="{StaticResource SummaryBoxStyle}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}">
                                    <Run Text="谓词:" />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding TextOperatorSummary, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ Decimal 模式 + Tolerance  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="Decimal 模式 / Tolerance" Subtitle="数字过滤特有">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="切到 Decimal 模式时浮点比较容差不可避免。Tolerance 由控件暴露给 VM,典型用法:|x − Value| ≤ Tolerance 视为相等。Integer 模式建议把 Tolerance 设为 0。" />

                            <cy:NumberFilterBox
                                DecimalPlaces="2"
                                IsActive="{Binding DecimalIsActive, Mode=TwoWay}"
                                Label="温度"
                                Maximum="100"
                                Minimum="-100"
                                NumberMode="{x:Static cy:NumberMode.Decimal}"
                                Operator="{Binding DecimalOperator, Mode=TwoWay}"
                                SmallChange="0.01"
                                Tolerance="{Binding DecimalTolerance, Mode=TwoWay}"
                                Value="{Binding DecimalValue, Mode=TwoWay}" />

                            <Border Style="{StaticResource SummaryBoxStyle}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}">
                                    <Run Text="谓词:" />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding DecimalSummary, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ IsCaseSensitive 对照  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="IsCaseSensitive 大小写" Subtitle="文本过滤特有">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="数据集中商品名包含 Pro / pro 等大小写混杂的字串。同一关键字 Pro 在两种模式下命中数不同。" />

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="不区分大小写 (默认)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <cy:TextFilterBox
                                        Grid.Column="0"
                                        IsActive="{Binding CaseInsensitiveActive, Mode=TwoWay}"
                                        IsCaseSensitive="False"
                                        Label="名称"
                                        Operator="{x:Static cy:TextOperator.Contains}"
                                        Text="{Binding CaseInsensitiveText, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Success}">
                                        <Run Text="{Binding CaseInsensitiveMatchCount, Mode=OneWay}" />
                                        <Run Text="条" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="区分大小写" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <cy:TextFilterBox
                                        Grid.Column="0"
                                        IsActive="{Binding CaseSensitiveActive, Mode=TwoWay}"
                                        IsCaseSensitive="True"
                                        Label="名称"
                                        Operator="{x:Static cy:TextOperator.Contains}"
                                        Text="{Binding CaseSensitiveText, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Warning}">
                                        <Run Text="{Binding CaseSensitiveMatchCount, Mode=OneWay}" />
                                        <Run Text="条" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ Regex 模式  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="Regex 模式" Subtitle="Operator=Regex 时 Text 作正则解释">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="检测哪些商品名以大写字母开头(^[A-Z]\w+$)。表达式无效与否如何处理由 VM 决定,控件不抢策略。" />

                            <cy:TextFilterBox
                                IsActive="{Binding RegexIsActive, Mode=TwoWay}"
                                Label="名称"
                                Operator="{x:Static cy:TextOperator.Regex}"
                                Text="{Binding RegexText, Mode=TwoWay}"
                                Watermark="输入正则表达式…" />

                            <Border Style="{StaticResource SummaryBoxStyle}">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}">
                                    <Run Text="符合正则的商品:" />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Success}"
                                        Text="{Binding RegexMatchCount, Mode=OneWay}" />
                                    <Run Text="/ 12 条" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  ============ ⑥ MVVM 联合过滤(全宽)============  -->
            <cy:Card Grid.Row="2" Margin="0,20,0,0">
                <cy:Card.Header>
                    <cy:CardHeader Title="MVVM 联合过滤" Subtitle="NumberFilterBox 与 TextFilterBox 同时作用于同一个列表">
                        <cy:CardHeader.Icon>
                            <Border Style="{StaticResource SectionNumberStyle}">
                                <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                            </Border>
                        </cy:CardHeader.Icon>
                    </cy:CardHeader>
                </cy:Card.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左:两个 FilterBox 控制面板  -->
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="13"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="两个 FilterBox 各自控制一个维度,VM 把两个谓词 AND 组合后用作 ICollectionView.Filter。任一控件状态变化都触发刷新。" />

                        <StackPanel Grid.IsSharedSizeScope="True">
                            <cy:NumberFilterBox
                                Margin="0,0,0,8"
                                IsActive="{Binding PriceFilterActive, Mode=TwoWay}"
                                Label="价格"
                                Maximum="3000"
                                Minimum="0"
                                Operator="{Binding PriceFilterOperator, Mode=TwoWay}"
                                SharedName="filter-label"
                                SmallChange="50"
                                Value="{Binding PriceFilterValue, Mode=TwoWay}" />

                            <cy:TextFilterBox
                                IsActive="{Binding NameFilterActive, Mode=TwoWay}"
                                IsCaseSensitive="{Binding NameFilterCaseSensitive, Mode=TwoWay}"
                                Label="名称"
                                Operator="{Binding NameFilterOperator, Mode=TwoWay}"
                                SharedName="filter-label"
                                Text="{Binding NameFilterText, Mode=TwoWay}"
                                Watermark="按商品名搜索…">
                                <cy:TextFilterBox.ExtraContent>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        Content="Aa"
                                        IsChecked="{Binding NameFilterCaseSensitive, Mode=TwoWay}"
                                        ToolTip="区分大小写" />
                                </cy:TextFilterBox.ExtraContent>
                            </cy:TextFilterBox>
                        </StackPanel>

                        <Border Style="{StaticResource SummaryBoxStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    TextWrapping="Wrap">
                                    <Run Text="提示:" />
                                    <Run Text="同一个 SharedName 让两个控件的 Label 列宽自动对齐。需在外层容器设置 Grid.IsSharedSizeScope=&quot;True&quot;。" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  右:实时过滤的 ListView  -->
                    <Border
                        Grid.Column="2"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <ListView BorderThickness="0" ItemsSource="{Binding ProductsView}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        Width="220"
                                        DisplayMemberBinding="{Binding Name}"
                                        Header="商品" />
                                    <GridViewColumn
                                        Width="80"
                                        DisplayMemberBinding="{Binding Category}"
                                        Header="分类" />
                                    <GridViewColumn
                                        Width="100"
                                        DisplayMemberBinding="{Binding Price, StringFormat=¥{0:F0}}"
                                        Header="价格" />
                                    <GridViewColumn
                                        Width="80"
                                        DisplayMemberBinding="{Binding Stock}"
                                        Header="库存" />
                                    <GridViewColumn
                                        Width="80"
                                        DisplayMemberBinding="{Binding Rating, StringFormat=F1}"
                                        Header="评分" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </cy:Card>

            <!--  ============ ⑦ 常见使用场景 + ⑧ 属性表 + ⑨ XAML + ⑩ 设计要点 ============  -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ⑦ 常见场景 6 张小卡  -->
                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="常见使用场景">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <UniformGrid Columns="3" Rows="2">

                        <cy:Card Margin="6,6">
                            <StackPanel>
                                <Path
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    Data="M12,3 L21,12 L18,12 L18,21 L13,21 L13,15 L11,15 L11,21 L6,21 L6,12 L3,12 Z"
                                    Stroke="{DynamicResource Foreground.Warning}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1.5" />
                                <TextBlock
                                    Margin="0,8,0,4"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Foreground.Default}"
                                    Text="价格区间下限" />
                                <cy:NumberFilterBox
                                    IsActive="True"
                                    Label="≥"
                                    Maximum="10000"
                                    Minimum="0"
                                    Operator="{x:Static cy:NumberOperator.GreaterThanOrEqual}"
                                    SmallChange="100"
                                    Value="500" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="电商商品列表过滤"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </cy:Card>

                        <cy:Card Margin="6,6">
                            <StackPanel>
                                <Path
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    Data="M12,2 A10,10 0 1,1 2,12 A10,10 0 0,1 12,2 M12,6 L12,12 L17,15"
                                    Stroke="{DynamicResource Foreground.Link}"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="2" />
                                <TextBlock
                                    Margin="0,8,0,4"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Foreground.Default}"
                                    Text="年龄段" />
                                <cy:NumberFilterBox
                                    IsActive="True"
                                    Label="≤"
                                    Maximum="120"
                                    Minimum="0"
