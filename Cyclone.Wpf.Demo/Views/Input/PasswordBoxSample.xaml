<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.PasswordBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hp="clr-namespace:Cyclone.Wpf.Helpers;assembly=Cyclone.Wpf"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:PasswordBoxViewModel}}"
    d:DesignHeight="3200"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ButtonSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!--  密码强度文字配色 — 走主题 token, 不是验证错误, 纯展示性  -->
        <Style x:Key="StrengthTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PasswordStrength}" Value="弱">
                    <Setter Property="Foreground" Value="{DynamicResource Foreground.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PasswordStrength}" Value="中">
                    <Setter Property="Foreground" Value="{DynamicResource Foreground.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PasswordStrength}" Value="强">
                    <Setter Property="Foreground" Value="{DynamicResource Foreground.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M6,11 L18,11 L18,20 L6,20 Z M8,11 L8,7 A4,4 0 0,1 16,7 L16,11"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="PasswordBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="附加属性增强" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="密码输入框 — 通过 PasswordBoxHelper 解决原生 PasswordBox 不支持绑定的痛点, 内置可见性切换 / 清空 / 失焦自动隐藏明文等能力。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== 全局状态条 ==========  -->
            <Border
                Margin="0,16,0,0"
                Padding="14,10"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="最后事件:" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding LastEvent}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="Password 长度:" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding PasswordLength}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Padding="10,4"
                        Command="{Binding ResetCommand}"
                        Content="清零"
                        Style="{DynamicResource Button.Style.Subtle}" />
                </Grid>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="默认含 Watermark / Toggle 按钮 / Clear 按钮" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="默认隐式样式即包含 Watermark、可见性切换 (眼睛图标)、Clear (叉号) 三件套, 全部由 PasswordBoxHelper 提供, 不需要替换原生 PasswordBox。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="带 Watermark + Toggle + Clear" />
            <PasswordBox
                Width="320"
                HorizontalAlignment="Left"
                hp:PasswordBoxHelper.Password="{Binding Password}"
                hp:PasswordBoxHelper.Watermark="请输入密码" />

            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="无 Watermark 的纯输入框(默认仍含 Toggle / Clear)" />
            <PasswordBox Width="320" HorizontalAlignment="Left" />

            <!--  ========== ② 双向绑定 (核心价值) ==========  -->
            <cy:SectionHeader
                MainTitle="② 双向绑定 Password"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="hp:PasswordBoxHelper.Password 解决原生不可绑定的痛点" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="原生 PasswordBox.Password 出于安全考虑不是 DependencyProperty, 不可绑定。PasswordBoxHelper.Password 是镜像的附加 DP, 默认 TwoWay + PropertyChanged 触发, 用户每输入一字即回写 ViewModel。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="边输边同步" />
                    <PasswordBox
                        hp:PasswordBoxHelper.Password="{Binding Password}"
                        hp:PasswordBoxHelper.Watermark="试着键入, 右侧实时显示长度" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="14,10"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="ViewModel.Password 长度:" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontFamily="Consolas"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding PasswordLength}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="(出于演示, 这里只暴露长度而不显示明文)"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ③ 明文 / 密文切换 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 明文 / 密文切换"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ShowPassword 附加属性 · 失焦自动回到密文" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="点击右侧眼睛图标切换 ShowPassword。设计上失焦时会自动恢复密文模式, 出于安全考虑 — 用户切走窗口 / 点击别处不会让肩窥者看到密码。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="默认行为 — 点击眼睛切换, 失焦自动隐藏" />
            <PasswordBox
                Width="320"
                HorizontalAlignment="Left"
                hp:PasswordBoxHelper.Password="{Binding Password}"
                hp:PasswordBoxHelper.Watermark="点击眼睛图标看明文" />

            <!--  ========== ④ Toggle / Clear 按钮控制 ==========  -->
            <cy:SectionHeader
                MainTitle="④ Toggle / Clear 按钮控制"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="HasPasswordVisibilityToggle · HasClearButton" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="两个开关默认 True。需要更严格的安全场景(如银行、加密钱包)可关闭 Toggle, 禁止明文展示; 简化场景可关闭 Clear。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="默认 (Toggle + Clear)" />
                <PasswordBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,12"
                    hp:PasswordBoxHelper.Watermark="两个按钮都在" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="关闭 Toggle (Clear 保留)" />
                <PasswordBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,0,12"
                    hp:PasswordBoxHelper.HasPasswordVisibilityToggle="False"
                    hp:PasswordBoxHelper.Watermark="禁止明文展示" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="关闭 Clear (Toggle 保留)" />
                <PasswordBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,0,8,12"
                    hp:PasswordBoxHelper.HasClearButton="False"
                    hp:PasswordBoxHelper.Watermark="无清除按钮" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="8,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="全关 — 极简模式" />
                <PasswordBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="8,0,0,12"
                    hp:PasswordBoxHelper.HasClearButton="False"
                    hp:PasswordBoxHelper.HasPasswordVisibilityToggle="False"
                    hp:PasswordBoxHelper.Watermark="只有输入框本体" />
            </Grid>

            <!--  ========== ⑤ 状态对比 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 状态对比"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Normal / Focused / Disabled" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="鼠标悬停看 Hover 边框, Tab 聚焦看 Focused 主色边框。Disabled 走完整 Disabled token 组(背景 / 边框 / 前景全部置灰)。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Normal" />
                <PasswordBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,12"
                    hp:PasswordBoxHelper.Watermark="未获焦时" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Disabled" />
                <PasswordBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,0,12"
                    hp:PasswordBoxHelper.Watermark="禁用状态"
                    IsEnabled="False" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,0,6"
                    FontSize="11"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Busy 联动" />
                <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox
                        hp:PasswordBoxHelper.Watermark="Busy 时禁用"
                        IsEnabled="{Binding CanInteract}" />
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="10,0"
                        Command="{Binding ToggleBusyCommand}"
                        Content="切换 Busy"
                        Style="{DynamicResource Button.Style.Subtle}" />
                </Grid>
            </Grid>

            <!--  ========== ⑥ 实战 · 登录表单 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 实战 · 登录表单"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="账号 + 密码 + Primary 提交" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,8,0,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="账号" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,4,0,4"
                        hp:TextBoxHelper.Watermark="邮箱 / 用户名"
                        Text="{Binding LoginAccount, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,8,0,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="密码" />
                    <PasswordBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4,0,4"
                        hp:PasswordBoxHelper.Password="{Binding LoginPassword}"
                        hp:PasswordBoxHelper.Watermark="请输入密码" />

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Padding="14,8"
                            Command="{Binding ResetCommand}"
                            Content="重置" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="14,8"
                            Command="{Binding LoginCommand}"
                            Content="登录"
                            IsDefault="True"
                            Style="{DynamicResource Button.Style.Primary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ========== ⑦ 实战 · 注册场景 + 验证 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 实战 · 注册场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="MinLength 验证 + 两次密码 CustomValidation 跨字段比较" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="左侧 Password 用 [MinLength(8)] 验证, 右侧 ConfirmPassword 用 [CustomValidation] 跨字段比较两次输入。验证错误由 ObservableValidator 通过 INotifyDataErrorInfo 报告, 样式自带的 Validation.ErrorTemplate 自动渲染, 没有任何手写错误 UI。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="设置密码" />
                        <PasswordBox
                            hp:PasswordBoxHelper.Password="{Binding Password}"
                            hp:PasswordBoxHelper.Watermark="≥ 8 位, 含大小写 / 数字 / 符号" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="强度:" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource StrengthTextStyle}"
                                Text="{Binding PasswordStrength}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="再次确认" />
                        <PasswordBox
                            hp:PasswordBoxHelper.Password="{Binding ConfirmPassword}"
                            hp:PasswordBoxHelper.Watermark="重复输入密码" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ========== ⑧ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑧ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="PasswordBoxHelper 附加属性一览" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="附加属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型 (默认)" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="hp:PasswordBoxHelper.Password" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="string (&quot;&quot;)" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="可绑定的密码镜像。默认 TwoWay + PropertyChanged 触发, 解决原生 PasswordBox.Password 不可绑定的痛点。" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="hp:PasswordBoxHelper.Watermark" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="string (&quot;&quot;)" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="占位提示, Password 为空且未获焦时显示, Foreground.Placeholder 色。" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="hp:PasswordBoxHelper.HasClearButton" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="bool (true)" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="是否显示清空按钮。Password 为空时自动隐藏。" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="hp:PasswordBoxHelper.HasPasswordVisibilityToggle" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="bool (true)" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="是否显示明文 / 密文切换按钮。高安全场景可关闭。" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="hp:PasswordBoxHelper.ShowPassword" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="bool (false)" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="当前是否处于明文展示。失焦自动回 false (安全防肩窥)。" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="hp:PasswordBoxHelper.ClearCommand" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="RoutedCommand" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="类级 CommandBinding 已注册, 模板内 Clear 按钮通过 {x:Static} 引用即可。" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Validation.ErrorTemplate" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="ControlTemplate" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="默认样式已套用 ValidationError.ControlTemplate, 配合 ObservableValidator 自动渲染错误。" />
                </Grid>
            </Border>

            <!--  ========== ⑨ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑨ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="PasswordBox 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="附加属性绕过 PasswordBox.Password 不可绑定" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="原生 PasswordBox.Password 不是 DependencyProperty (安全设计), 不能直接绑定。Helper 用附加 DP 镜像 + 双向同步, 完整 MVVM 支持"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="失焦自动隐藏明文" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ShowPassword 开启后订阅 LostFocus, 离焦立刻回到密文 — 防止肩窥, 也避免用户切走窗口后明文残留在屏上"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Toggle 与 Clear 按钮 Focusable=False" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="两个内嵌按钮均设为 Focusable=False, 防止点击时把焦点抢离 PasswordBox 进而触发 LostFocus 导致 ShowPassword 一闪即灭"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="跨字段验证用 [CustomValidation]" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ConfirmPassword 需要参照 Password 才能判定合法, 通过 [CustomValidation] 指向静态方法, Password 变化时手动 ValidateProperty 重新触发"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
