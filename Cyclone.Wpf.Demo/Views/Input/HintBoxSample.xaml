<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.HintBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:HintBoxViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  结果展示框样式  -->
        <Style x:Key="ResultBoxStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="ResultLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <!--  Icon: 一个搜索框 + 下拉箭头  -->
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M3,6 L21,6 L21,12 L3,12 Z M9,16 L12,19 L15,16"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="HintBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="继承 ComboBox" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="智能提示输入框 — 边输边过滤的下拉选择。内置 ListCollectionView 自管, 多控件共享同一集合互不影响; 支持嵌套属性搜索 (Author.Name); 默认 OrdinalIgnoreCase 中间匹配。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础字符串列表 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础字符串列表"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ItemsSource = ObservableCollection&lt;string&gt;" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="最简单场景 — 直接绑字符串集合, 不需要 DisplayMemberPath / SearchMemberPath。试着输入 'C' 或 'java',支持中间匹配(不只是前缀)。" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="编程语言(20 项):" />
            <cy:HintBox
                Width="320"
                HorizontalAlignment="Left"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
            <Border Style="{StaticResource ResultBoxStyle}">
                <TextBlock Style="{StaticResource ResultLabelStyle}">
                    <Run Text="已选:" />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding SelectedLanguage, Mode=OneWay, FallbackValue='(未选)', TargetNullValue='(未选)'}" />
                </TextBlock>
            </Border>

            <!--  ========== ② 自定义对象 + 嵌套属性 ==========  -->
            <cy:SectionHeader
                MainTitle="② 自定义对象 + 嵌套属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="DisplayMemberPath / SearchMemberPath 独立配置" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="同一份图书列表(8 本 6 位作者), 三个 HintBox 用不同的 SearchMemberPath。显示文本统一是书名(Title), 但搜索字段各异: 试 '7-5366' / '余华' / 直接输书名。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="搜 ISBN(试 '7-5366'):" />
                    <cy:HintBox
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding Books}"
                        SearchMemberPath="Isbn"
                        SelectedItem="{Binding SelectedByIsbn, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="搜作者(试 '余华', 嵌套):" />
                    <cy:HintBox
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding Books}"
                        SearchMemberPath="Author.Name"
                        SelectedItem="{Binding SelectedByAuthor, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="默认(搜书名):" />
                    <cy:HintBox
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding Books}"
                        SelectedItem="{Binding SelectedDefaultBook, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ResultBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ResultLabelStyle}">
                        <Run Text="搜 ISBN 选了:" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding SelectedByIsbn.Title, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Style="{StaticResource ResultLabelStyle}">
                        <Run Text="搜作者选了:" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding SelectedByAuthor.Title, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Style="{StaticResource ResultLabelStyle}">
                        <Run Text="默认选了:" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding SelectedDefaultBook.Title, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                    </TextBlock>
                </Grid>
            </Border>

            <!--  ========== ③ 共享集合 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 共享集合 — Filter 互不影响"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ListCollectionView 自管的关键卖点" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="两个 HintBox 绑同一个 ObservableCollection&lt;string&gt;。在 A 输 'a' 过滤后, B 仍显示完整列表 — HintBox 内部用独立 ListCollectionView 包装 source, 不影响 source 的默认 view。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="HintBox A:" />
                    <cy:HintBox ItemsSource="{Binding SharedFruits}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="HintBox B:" />
                    <cy:HintBox ItemsSource="{Binding SharedFruits}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ResultBoxStyle}">
                <TextBlock Style="{StaticResource ResultLabelStyle}">
                    <Run Text="共享集合(Count:" />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding SharedFruits.Count, Mode=OneWay}" />
                    <Run Text=") — 同一 source 给两个 HintBox 各自 filter 互不干扰。" />
                </TextBlock>
            </Border>

            <!--  ========== ④ 实时增删 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 实时增删 — 集合变化自动同步"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ObservableCollection.Add / Remove → ListCollectionView 弱事件" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="点 '添加随机项' 往集合追加新项, 下拉中立即出现; 点 '删除选中' 移除当前项; 点 '清空' → popup 显示 '无匹配项' 占位。整个流程不需要手动 Refresh。" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="动态项目列表:" />
            <cy:HintBox
                Width="320"
                HorizontalAlignment="Left"
                ItemsSource="{Binding DynamicItems}"
                SelectedItem="{Binding DynamicSelected, Mode=TwoWay}" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="14,6"
                    Command="{Binding AddRandomItemCommand}"
                    Content="添加随机项" />
                <Button
                    Margin="0,0,8,0"
                    Padding="14,6"
                    Command="{Binding RemoveSelectedDynamicCommand}"
                    Content="删除选中" />
                <Button
                    Padding="14,6"
                    Command="{Binding ClearDynamicCommand}"
                    Content="清空" />
            </StackPanel>

            <Border Style="{StaticResource ResultBoxStyle}">
                <TextBlock Style="{StaticResource ResultLabelStyle}">
                    <Run Text="当前数量:" />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding DynamicItems.Count, Mode=OneWay}" />
                    <Run Text=" 项; 选中:" />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding DynamicSelected, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                </TextBlock>
            </Border>

            <!--  ========== ⑤ StringComparison 切换 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ StringComparison 切换"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="区分大小写 / 文化感知 / 序号比较" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="集合里故意混合了大小写(Apple / APPLE / apple / Application / BANANA / banana...)。切换不同 StringComparison 后再输 'apple': OrdinalIgnoreCase 命中所有 4 个; Ordinal 仅命中 'apple'。" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="混合大小写水果:" />
            <cy:HintBox
                Width="320"
                HorizontalAlignment="Left"
                ItemsSource="{Binding ComparisonItems}"
                StringComparison="{Binding Comparison}" />

            <StackPanel Margin="0,12,0,0">
                <RadioButton
                    Margin="0,0,0,4"
                    Content="OrdinalIgnoreCase (默认 · 序号 + 忽略大小写)"
                    GroupName="cmp"
                    IsChecked="{Binding IsCmpOrdinalIgnoreCase, Mode=TwoWay}" />
                <RadioButton
                    Margin="0,0,0,4"
                    Content="Ordinal (序号 + 区分大小写)"
                    GroupName="cmp"
                    IsChecked="{Binding IsCmpOrdinal, Mode=TwoWay}" />
                <RadioButton
                    Margin="0,0,0,4"
                    Content="CurrentCultureIgnoreCase (当前文化 + 忽略大小写)"
                    GroupName="cmp"
                    IsChecked="{Binding IsCmpCurrentCultureIgnoreCase, Mode=TwoWay}" />
                <RadioButton
                    Content="InvariantCulture (不变文化 + 区分大小写)"
                    GroupName="cmp"
                    IsChecked="{Binding IsCmpInvariantCulture, Mode=TwoWay}" />
            </StackPanel>

            <Border Style="{StaticResource ResultBoxStyle}">
                <TextBlock Style="{StaticResource ResultLabelStyle}">
                    <Run Text="当前模式:" />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding Comparison, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="附加属性 + 继承自 ComboBox 的成员" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="成员" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ItemsSource" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IEnumerable" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数据源。控件内部用独立 ListCollectionView 包装 — 不影响 source 的默认 view, 多控件共享同一集合不互相污染。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="DisplayMemberPath" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="显示文本的属性路径。不设走 item.ToString()。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SearchMemberPath" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="搜索匹配的属性路径, 支持嵌套('a.b.c')。不设时退到 DisplayMemberPath; 都没设走 item.ToString()。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="StringComparison" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (OrdinalIgnoreCase)" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="过滤时的字符串比较模式。中文场景一般无需改。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="MaxDropDownHeight" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (300)" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="下拉最大高度(像素), 超出时自动滚动条。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ClearTextCommand" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="RoutedCommand" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="清空输入文本 + 选中项, 模板内 X 按钮已绑定。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SelectedItem" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前选中的项(继承自 ComboBox)。用户从下拉点选 + 代码 setter 都会写入。" />
                </Grid>
            </Border>

            <!--  ========== ⑦ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="HintBox 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="ListCollectionView 自管, 不污染 source" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="多个 HintBox 绑同一 ObservableCollection 时各自 filter 互不影响 — 与原生 ComboBox 共享 default view 不同"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="监听 TextChanged 而非 PreviewTextInput" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="PreviewTextInput 读到的是旧值且不捕获退格 / Cut / Paste。TextChanged 在所有变化后触发, filter 用最新值"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="反射缓存 (Type, propertyPath)" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="按 (Type, propertyPath) 字典缓存 PropertyInfo 链。1 万项每次输入只反射一次, 后续命中缓存"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="无匹配项占位文本" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="filter 后无项时 popup 显示 '无匹配项' 占位, 比折叠成细条体验更好"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
