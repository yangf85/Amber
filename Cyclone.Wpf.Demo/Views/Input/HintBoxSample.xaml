<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.HintBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type={x:Type local:HintBoxViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ResultBoxStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="ResultLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                            Fill="White"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="HintBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Container}"
                            Text="带搜索过滤的 ComboBox。SearchMemberPath 支持嵌套属性、StringComparison 可配、清除按钮、Esc 关闭下拉、PropertyInfo 反射缓存。内部用独立 ListCollectionView 包装 source，多控件共享同一集合时各自的 filter 互不影响。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础字符串列表搜索  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础字符串列表" Subtitle="ItemsSource = ObservableCollection&lt;string&gt;">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="最简单场景：直接绑字符串集合，不需要 DisplayMemberPath / SearchMemberPath。试着输入 'C' 或 'java'——支持中间匹配（不只是前缀）。" />

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="编程语言（20 项）：" />
                            <cy:HintBox
                                Width="320"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

                            <Border Style="{StaticResource ResultBoxStyle}">
                                <TextBlock Style="{StaticResource ResultLabelStyle}">
                                    <Run Text="已选：" />
                                    <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding SelectedLanguage, Mode=OneWay, FallbackValue='（未选）', TargetNullValue='（未选）'}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 自定义对象 + 嵌套属性  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="自定义对象 + 嵌套属性" Subtitle="DisplayMemberPath / SearchMemberPath 各自独立配置">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="同一份图书列表（8 本，6 位作者），3 个 HintBox 用不同的 SearchMemberPath：第一个搜 ISBN（试 7-5366）、第二个搜作者（嵌套属性 Author.Name，试 '余华'）、第三个不设走默认 DisplayMemberPath（搜书名）。显示文本统一是书名。" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  搜 ISBN  -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="搜 ISBN（试 '7-5366'）：" />
                                    <cy:HintBox
                                        DisplayMemberPath="Title"
                                        ItemsSource="{Binding Books}"
                                        SearchMemberPath="Isbn"
                                        SelectedItem="{Binding SelectedByIsbn, Mode=TwoWay}" />
                                </StackPanel>

                                <!--  搜作者（嵌套）  -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="搜作者（试 '余华'）：" />
                                    <cy:HintBox
                                        DisplayMemberPath="Title"
                                        ItemsSource="{Binding Books}"
                                        SearchMemberPath="Author.Name"
                                        SelectedItem="{Binding SelectedByAuthor, Mode=TwoWay}" />
                                </StackPanel>

                                <!--  默认走 DisplayMemberPath  -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="默认（搜书名）：" />
                                    <cy:HintBox
                                        DisplayMemberPath="Title"
                                        ItemsSource="{Binding Books}"
                                        SelectedItem="{Binding SelectedDefaultBook, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource ResultBoxStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource ResultLabelStyle}">
                                        <Run Text="搜 ISBN 选了：" />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding SelectedByIsbn.Title, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ResultLabelStyle}">
                                        <Run Text="搜作者选了：" />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding SelectedByAuthor.Title, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Style="{StaticResource ResultLabelStyle}">
                                        <Run Text="默认选了：" />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding SelectedDefaultBook.Title, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 共享 source 不互相污染  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="共享集合 — Filter 互不影响" Subtitle="ListCollectionView 自管的关键卖点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="两个 HintBox 都绑同一个 ObservableCollection&lt;string&gt;（12 种水果）。在 A 输入 'a' 过滤 — 只看到 Apple/Apricot/Avocado/Banana/Mango...；同时 B 仍显示完整列表。证明 HintBox 内部用独立 ListCollectionView 包装，没污染共享 source 的默认 view。" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="HintBox A：" />
                                    <cy:HintBox ItemsSource="{Binding SharedFruits}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="HintBox B：" />
                                    <cy:HintBox ItemsSource="{Binding SharedFruits}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource ResultBoxStyle}">
                                <TextBlock Style="{StaticResource ResultLabelStyle}">
                                    <Run Text="共享集合 (Count: " />
                                    <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding SharedFruits.Count, Mode=OneWay}" />
                                    <Run Text=") — 同一 source 给两个 HintBox 各自 filter 互不干扰。" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ 实时增删  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="实时增删 — 集合变化自动同步" Subtitle="ObservableCollection.Add/Remove">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="点&quot;添加&quot;往集合追加新项，下拉中立即出现；点&quot;删除选中&quot;移除当前选项；点&quot;清空&quot;空集合 → popup 显示&quot;无匹配项&quot;占位。ListCollectionView 内部对 source 的 INotifyCollectionChanged 弱事件监听让这一切自动同步。" />

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="动态项目列表：" />
                            <cy:HintBox
                                Width="320"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding DynamicItems}"
                                SelectedItem="{Binding DynamicSelected, Mode=TwoWay}" />

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="14,6"
                                    Command="{Binding AddRandomItemCommand}"
                                    Content="添加随机项" />
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="14,6"
                                    Command="{Binding RemoveSelectedDynamicCommand}"
                                    Content="删除选中" />
                                <Button
                                    Padding="14,6"
                                    Command="{Binding ClearDynamicCommand}"
                                    Content="清空" />
                            </StackPanel>

                            <Border Style="{StaticResource ResultBoxStyle}">
                                <TextBlock Style="{StaticResource ResultLabelStyle}">
                                    <Run Text="当前数量：" />
                                    <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding DynamicItems.Count, Mode=OneWay}" />
                                    <Run Text="；选中：" />
                                    <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding DynamicSelected, Mode=OneWay, FallbackValue='—', TargetNullValue='—'}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ StringComparison  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="StringComparison 切换" Subtitle="区分大小写 / 文化感知 / 序号比较">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="集合里故意混合了大小写（Apple/APPLE/apple/Application/BANANA/banana...）。切换不同 StringComparison 后输 'apple'：OrdinalIgnoreCase 命中所有 4 个；Ordinal 仅命中 'apple'。" />

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="混合大小写水果：" />
                            <cy:HintBox
                                Width="320"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding ComparisonItems}"
                                StringComparison="{Binding Comparison}" />

                            <StackPanel Margin="0,12,0,0">
                                <RadioButton
                                    Margin="0,0,0,4"
                                    Content="OrdinalIgnoreCase（默认，序号 + 忽略大小写）"
                                    GroupName="cmp"
                                    IsChecked="{Binding IsCmpOrdinalIgnoreCase, Mode=TwoWay}" />
                                <RadioButton
                                    Margin="0,0,0,4"
                                    Content="Ordinal（序号 + 区分大小写）"
                                    GroupName="cmp"
                                    IsChecked="{Binding IsCmpOrdinal, Mode=TwoWay}" />
                                <RadioButton
                                    Margin="0,0,0,4"
                                    Content="CurrentCultureIgnoreCase（当前文化 + 忽略大小写）"
                                    GroupName="cmp"
                                    IsChecked="{Binding IsCmpCurrentCultureIgnoreCase, Mode=TwoWay}" />
                                <RadioButton
                                    Content="InvariantCulture（不变文化 + 区分大小写）"
                                    GroupName="cmp"
                                    IsChecked="{Binding IsCmpInvariantCulture, Mode=TwoWay}" />
                            </StackPanel>

                            <Border Style="{StaticResource ResultBoxStyle}">
                                <TextBlock Style="{StaticResource ResultLabelStyle}">
                                    <Run Text="当前模式：" />
                                    <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding Comparison, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  ============ 底部：API 表 + 代码示例 + 设计要点 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  API 表  -->
                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="主要 API">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="成员" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ItemsSource" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IEnumerable" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数据源。控件内部用独立 ListCollectionView 包装——不影响 source 的默认 view，多控件共享同一集合不互相污染。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="DisplayMemberPath" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="决定显示文本的属性路径。不设走 item.ToString()。" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SearchMemberPath" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="搜索匹配的属性路径。支持嵌套（'a.b.c'）。不设时退到 DisplayMemberPath；都没设走 item.ToString()。" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="StringComparison" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="StringComparison" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="过滤时的字符串比较模式。默认 OrdinalIgnoreCase。中文场景一般无需改。" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="MaxDropDownHeight" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="下拉最大高度（像素）。默认 300。超出时自动滚动条。" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ClearTextCommand" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="RoutedCommand" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="清空输入文本 + 选中项的命令。模板内的 X 按钮已经绑定。" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SelectedItem" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前选中的项（继承自 ComboBox）。用户从下拉点选 + 代码 setter 都会写入。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <!--  代码示例 + 设计要点  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                            <sys:String xml:space="preserve">&lt;!-- 1. 简单字符串列表（默认配置）--&gt;
&lt;cy:HintBox ItemsSource="{Binding Languages}"
            SelectedItem="{Binding SelectedLanguage}" /&gt;

&lt;!-- 2. 自定义对象 + 显示/搜索字段分开 --&gt;
&lt;cy:HintBox ItemsSource="{Binding Books}"
            DisplayMemberPath="Title"
            SearchMemberPath="Isbn"
            SelectedItem="{Binding SelectedBook}" /&gt;

&lt;!-- 3. 嵌套属性搜索（支持 a.b.c 语法）--&gt;
&lt;cy:HintBox ItemsSource="{Binding Books}"
            DisplayMemberPath="Title"
            SearchMemberPath="Author.Name" /&gt;

&lt;!-- 4. 区分大小写 --&gt;
&lt;cy:HintBox ItemsSource="{Binding Items}"
            StringComparison="Ordinal" /&gt;

&lt;!-- 5. 同一 source 给多个 HintBox（filter 各自独立）--&gt;
&lt;cy:HintBox ItemsSource="{Binding SharedItems}" /&gt;
&lt;cy:HintBox ItemsSource="{Binding SharedItems}" /&gt;
&lt;!-- A 输 'a' 过滤；B 仍显示完整列表 --&gt;</sys:String>
                        </TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="ListCollectionView 自管" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="不污染共享 source 的默认 view。多个 HintBox 绑同一 ObservableCollection 时各自的 filter 互不影响。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="TextChanged 监听" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="替代 PreviewTextInput——后者读到旧值且不捕获退格 / Cut / Paste。TextChanged 在所有变化后触发，filter 用最新值。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="反射缓存" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="按 (Type, propertyPath) 字典缓存 PropertyInfo 链。1 万项每次输入只反射一次，之后命中缓存。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="无匹配项占位" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="filter 后无项时下拉显示&quot;无匹配项&quot;占位文本，比 popup 折叠成细条体验更好。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>