<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SliderSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:SliderViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Grid>
                            <Path
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M3,12 L21,12 M9,12 A3,3 0 1,1 9,12.01"
                                Stretch="None"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2.5" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Slider" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="单值滑块——拖动 Thumb 在区间内选数值。WinUI 3 风格圆形 Thumb,Hover 略放大、Dragging 实心 + 外圈光环,Passed 区段用主色高亮。支持水平/垂直、整数步长、TickBar、ToolTip 实时显示。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法" Subtitle="Value · Minimum · Maximum + 实时数值">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Value 双向绑定 ViewModel,Min/Max 限定区间。拖动时 ToolTip 实时显示数值,Passed 段用主色,Unpassed 段灰色。" />

                            <!--  音量  -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="音量" />
                                <Slider
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding Volume, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding Volume, StringFormat={}{0:F0}%}" />
                            </Grid>

                            <!--  亮度  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="亮度" />
                                <Slider
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding Brightness, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding Brightness, StringFormat={}{0:F0}%}" />
                            </Grid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 离散步长 + TickBar  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="离散步长 + 刻度" Subtitle="IsSnapToTickEnabled + TickFrequency + TickPlacement">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="设 IsSnapToTickEnabled=True + TickFrequency=1,Thumb 会吸附到整数刻度。TickPlacement 控制刻度位置(TopLeft / BottomRight / Both)。" />

                            <!--  评分 0-10  -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="评分" />
                                <Slider
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    IsSnapToTickEnabled="True"
                                    Maximum="10"
                                    Minimum="0"
                                    TickFrequency="1"
                                    TickPlacement="BottomRight"
                                    Value="{Binding Rating, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding Rating, StringFormat={}{0:F0} 分}" />
                            </Grid>

                            <!--  价格 0-10000,步长 100  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="预算" />
                                <Slider
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="500"
                                    Maximum="10000"
                                    Minimum="0"
                                    SmallChange="100"
                                    TickFrequency="100"
                                    Value="{Binding Price, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding PriceText}" />
                            </Grid>

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="预算 Slider 步长 100,LargeChange=500(PageUp/Down)、SmallChange=100(方向键)。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 禁用态  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="禁用态" Subtitle="IsEnabled=False">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="禁用时整体 Opacity 0.5,Thumb 不响应鼠标和键盘。" />

                            <Slider
                                Margin="0,0,0,8"
                                IsEnabled="False"
                                Maximum="100"
                                Minimum="0"
                                Value="40" />

                            <Slider
                                IsEnabled="False"
                                IsSnapToTickEnabled="True"
                                Maximum="10"
                                Minimum="0"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                Value="3" />
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ 垂直 Slider  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="垂直布局" Subtitle="Orientation=Vertical">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="设 Orientation=Vertical 切换为垂直布局。注意 WPF Slider 垂直时 Min 在底部、Max 在顶部(跟视觉直觉一致)。" />

                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                                <StackPanel Margin="0,0,28,0" HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding VerticalLevel1, StringFormat={}{0:F0}}" />
                                    <Slider
                                        Height="180"
                                        Margin="0,8"
                                        HorizontalAlignment="Center"
                                        Maximum="100"
                                        Minimum="0"
                                        Orientation="Vertical"
                                        Value="{Binding VerticalLevel1, Mode=TwoWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="低音" />
                                </StackPanel>

                                <StackPanel Margin="0,0,28,0" HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding VerticalLevel2, StringFormat={}{0:F0}}" />
                                    <Slider
                                        Height="180"
                                        Margin="0,8"
                                        HorizontalAlignment="Center"
                                        IsSnapToTickEnabled="True"
                                        Maximum="100"
                                        Minimum="0"
                                        Orientation="Vertical"
                                        TickFrequency="10"
                                        TickPlacement="BottomRight"
                                        Value="{Binding VerticalLevel2, Mode=TwoWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="中音" />
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding VerticalLevel3, StringFormat={}{0:F0}}" />
                                    <Slider
                                        Height="180"
                                        Margin="0,8"
                                        HorizontalAlignment="Center"
                                        Maximum="100"
                                        Minimum="0"
                                        Orientation="Vertical"
                                        Value="{Binding VerticalLevel3, Mode=TwoWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="高音" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ RGB 颜色调节 (实战 demo)  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="RGB 颜色调节" Subtitle="三个 Slider 联动颜色预览">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="实战场景:三个 Slider 分别调 R/G/B,实时拼接成颜色预览。" />

                            <!--  颜色预览块  -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Height="64"
                                    Background="{Binding PreviewBrush}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="{Binding ColorHex}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="实时预览,拖动 R/G/B 即时更新" />
                                </StackPanel>
                            </Grid>

                            <!--  R  -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontWeight="Bold"
                                    Foreground="#E53935"
                                    Text="R" />
                                <Slider
                                    Grid.Column="1"
                                    Margin="8,0,12,0"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    TickFrequency="1"
                                    Value="{Binding Red, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Text="{Binding Red, StringFormat={}{0:F0}}" />
                            </Grid>

                            <!--  G  -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontWeight="Bold"
                                    Foreground="#43A047"
                                    Text="G" />
                                <Slider
                                    Grid.Column="1"
                                    Margin="8,0,12,0"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    TickFrequency="1"
                                    Value="{Binding Green, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Text="{Binding Green, StringFormat={}{0:F0}}" />
                            </Grid>

                            <!--  B  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontWeight="Bold"
                                    Foreground="#1E88E5"
                                    Text="B" />
                                <Slider
                                    Grid.Column="1"
                                    Margin="8,0,12,0"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    TickFrequency="1"
                                    Value="{Binding Blue, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Text="{Binding Blue, StringFormat={}{0:F0}}" />
                            </Grid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑥ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="常见使用场景">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <UniformGrid Columns="2" Rows="2">

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M4,8 L8,8 L12,4 L12,20 L8,16 L4,16 Z M16,8 A6,6 0 0,1 16,16"
                                        Stretch="None"
                                        Stroke="{DynamicResource Foreground.Link}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="音量 / 亮度" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="0-100 百分比,实时反馈"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M12,4 L14.5,9 L20,10 L16,14 L17,20 L12,17 L7,20 L8,14 L4,10 L9.5,9 Z"
                                        Stretch="None"
                                        Stroke="{DynamicResource Foreground.Warning}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="评分 / 等级" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="离散步长 + Tick 可视化"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M4,6 A2,2 0 0,1 4,18 M20,6 A2,2 0 0,0 20,18 M4,9 L20,9 M4,12 L20,12 M4,15 L20,15"
                                        Stretch="None"
                                        Stroke="{DynamicResource Foreground.Success}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="均衡器 / 混音器" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="多个垂直 Slider 并排,音频/调色板专用"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M12,3 A9,9 0 1,1 11.99,3 M12,7 L12,12 L16,14"
                                        Stretch="None"
                                        Stroke="{DynamicResource Foreground.Info}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="进度 / 时间线" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="视频播放进度、时间选择"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                        </UniformGrid>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  ============ 底部:属性表 + 代码示例 + 设计要点 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="Slider 主要属性">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="属性" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型 (默认)" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Value" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0)" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前值。默认 TwoWay 绑定。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Minimum / Maximum" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0 / 10)" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数值范围。注意默认 Maximum=10,常需显式改为 100。" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Orientation" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Orientation (Horizontal)" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Horizontal / Vertical。Vertical 时 Min 在底、Max 在顶。" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSnapToTickEnabled" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="True 时 Thumb 吸附到 Tick 位置(整数滑块必备)。" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickFrequency" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (1)" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Tick 间距,跟 IsSnapToTickEnabled 配合决定吸附步长。" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickPlacement" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="TickPlacement (None)" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="None / TopLeft / BottomRight / Both。控制刻度线是否显示及位置。" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SmallChange / LargeChange" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0.1 / 1)" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="方向键 / PageUp+PageDown 的步长。" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="AutoToolTipPlacement / AutoToolTipPrecision" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum / int" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="拖动时自动显示数值 ToolTip。本样式默认 TopLeft + 2 位精度。" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsDirectionReversed" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                            <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="反向 — 让 Max 在起始端。少见,RTL 布局或特殊视觉需求时用。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                            <![CDATA[<!-- 基础百分比 -->
<Slider
    Minimum="0"
    Maximum="100"
    Value="{Binding Volume, Mode=TwoWay}" />

<!-- 离散整数 + 刻度 -->
<Slider
    Minimum="0"
    Maximum="10"
    Value="{Binding Rating, Mode=TwoWay}"
    IsSnapToTickEnabled="True"
    TickFrequency="1"
    TickPlacement="BottomRight" />

<!-- 大范围 + 自定义步长 -->
<Slider
    Minimum="0"
    Maximum="10000"
    Value="{Binding Price, Mode=TwoWay}"
    IsSnapToTickEnabled="True"
    TickFrequency="100"
    SmallChange="100"
    LargeChange="500" />

<!-- 垂直 -->
<Slider
    Orientation="Vertical"
    Height="180"
    Minimum="0"
    Maximum="100"
    Value="{Binding Level, Mode=TwoWay}" />

<!-- 禁用 -->
<Slider IsEnabled="False" Value="40" />]]>
                        </TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="9" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="圆形 Thumb" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="18px 圆形 + 主色边,Hover 略放大,Dragging 实心,符合 WinUI 3 / Material 直觉"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="拖动光环" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="IsDragging 时外圈 ScaleX/Y 0.7→1 + Opacity 0→0.3,明确反馈"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="Passed/Unpassed 双色" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="已通过部分 Background.Selected 主色,未通过部分 Background.Inactive 灰色"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="垂直版逻辑统一" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="跟水平版一致 token,修复了原版写死 Background 导致外部赋值失效的 bug"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
