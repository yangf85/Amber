                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                            <![CDATA[<!-- 基础:主按钮 + 几个菜单项,各自独立的 Command -->
<cy:SplitButton Label="保存" Command="{Binding SaveCommand}">
    <cy:SplitButtonItem Content="另存为 PDF"  Command="{Binding SaveAsPdfCommand}" />
    <cy:SplitButtonItem Content="另存为 Word" Command="{Binding SaveAsWordCommand}" />
    <cy:SplitButtonItem Content="另存为 HTML" Command="{Binding SaveAsHtmlCommand}" />
</cy:SplitButton>

<!-- 带图标的菜单项 -->
<cy:SplitButton Label="新建">
    <cy:SplitButtonItem Content="文件" Command="{Binding NewFileCommand}">
        <cy:SplitButtonItem.Icon>
            <Path Data="..." Stroke="..." />
        </cy:SplitButtonItem.Icon>
    </cy:SplitButtonItem>
    <cy:SplitButtonItem Content="文件夹" Command="{Binding NewFolderCommand}" />
</cy:SplitButton>

<!-- ItemsSource 数据驱动:子项 VM 各自的 ExecuteCommand -->
<cy:SplitButton ItemsSource="{Binding Formats}">
    <cy:SplitButton.ItemContainerStyle>
        <Style TargetType="{x:Type cy:SplitButtonItem}">
            <Setter Property="Command" Value="{Binding ExecuteCommand}" />
        </Style>
    </cy:SplitButton.ItemContainerStyle>
    <cy:SplitButton.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
    </cy:SplitButton.ItemTemplate>
</cy:SplitButton>

<!-- 不绑 Command,改用路由事件 -->
<cy:SplitButton Label="操作"
                Click="OnMainClick"
                ItemClick="OnItemClick">
    <cy:SplitButtonItem Content="复制" />
    <cy:SplitButtonItem Content="剪切" />
    <cy:SplitButtonItem Content="粘贴" />
</cy:SplitButton>

<!-- 不同弹出位置 -->
<cy:SplitButton Label="向上展开" Placement="Top">
    <cy:SplitButtonItem Content="选项 1" />
    <cy:SplitButtonItem Content="选项 2" />
</cy:SplitButton>]]>
                        </TextBox>
