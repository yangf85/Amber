<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SplitButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:SplitButtonViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M3,5 L14,5 M3,5 L3,15 M14,5 L14,15 M3,15 L14,15 M17,9 L21,9 L19,13 Z"
                            Stroke="White"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="SplitButton" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="分割按钮——左侧主按钮执行默认动作,右侧箭头展开菜单。主按钮和每个菜单项各自独立的 Command,点击菜单项后 popup 自动关闭并冒泡 ItemClick 路由事件。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法" Subtitle="Label / Command / 菜单项">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="点击 &quot;保存&quot; 文字执行主按钮命令;点击右侧箭头展开下拉菜单。每项命令独立绑定。下方 Echo 区显示最近一次执行的命令。" />

                            <StackPanel Orientation="Horizontal">
                                <cy:SplitButton
                                    MinWidth="120"
                                    Command="{Binding SaveCommand}"
                                    Label="保存">
                                    <cy:SplitButtonItem Command="{Binding SaveAsPdfCommand}" Content="另存为 PDF" />
                                    <cy:SplitButtonItem Command="{Binding SaveAsWordCommand}" Content="另存为 Word" />
                                    <cy:SplitButtonItem Command="{Binding SaveAsHtmlCommand}" Content="另存为 HTML" />
                                    <cy:SplitButtonItem Command="{Binding SaveAsMarkdownCommand}" Content="另存为 Markdown" />
                                </cy:SplitButton>
                            </StackPanel>

                            <Border
                                Margin="0,16,0,0"
                                Padding="14,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="LastAction (Echo):" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding LastAction}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 带图标的菜单项  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="带图标的菜单项" Subtitle="SplitButtonItem.Icon">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="SplitButtonItem.Icon 接受任意 UIElement,通常放置 Path / IconBox 等图标元素。Icon 与 Content 自动横向布局。" />

                            <StackPanel Orientation="Horizontal">
                                <cy:SplitButton
                                    MinWidth="120"
                                    Command="{Binding NewFileCommand}"
                                    Label="新建">
                                    <cy:SplitButtonItem Command="{Binding NewFileCommand}" Content="文件">
                                        <cy:SplitButtonItem.Icon>
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="M5,3 L14,3 L19,8 L19,21 L5,21 Z M14,3 L14,8 L19,8"
                                                Stroke="{DynamicResource Foreground.Link}"
                                                StrokeThickness="1.5" />
                                        </cy:SplitButtonItem.Icon>
                                    </cy:SplitButtonItem>
                                    <cy:SplitButtonItem Command="{Binding NewFolderCommand}" Content="文件夹">
                                        <cy:SplitButtonItem.Icon>
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="M3,7 L9,7 L11,5 L21,5 L21,19 L3,19 Z"
                                                Stroke="{DynamicResource Foreground.Warning}"
                                                StrokeThickness="1.5" />
                                        </cy:SplitButtonItem.Icon>
                                    </cy:SplitButtonItem>
                                    <cy:SplitButtonItem Command="{Binding NewProjectCommand}" Content="项目">
                                        <cy:SplitButtonItem.Icon>
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="M3,3 L21,3 L21,21 L3,21 Z M3,9 L21,9 M9,9 L9,21"
                                                Stroke="{DynamicResource Foreground.Success}"
                                                StrokeThickness="1.5" />
                                        </cy:SplitButtonItem.Icon>
                                    </cy:SplitButtonItem>
                                </cy:SplitButton>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ ItemsSource 数据驱动 ★ 新增  -->
                    <cy:Card Margin="0,0,0,20" DataContext="{Binding ExportPanel}">
                        <cy:Card.Header>
                            <cy:CardHeader Title="ItemsSource 数据驱动" Subtitle="ItemContainerStyle 绑定子项 VM 的同名 Command">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="子项 VM 列表中每项都有 [RelayCommand] private void Execute(),生成的属性都叫 ExecuteCommand。通过 ItemContainerStyle 把容器 Command 绑到 DataContext.ExecuteCommand——WPF 让每个容器各自指向自己那项的实例,点击谁执行谁。第 3 项 (HTML 网页) 默认 IsAvailable=false,可观察 CanExecute 各自独立。"
                                TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <cy:SplitButton
                                    MinWidth="160"
                                    Command="{Binding Formats[0].ExecuteCommand}"
                                    ItemsSource="{Binding Formats}">
                                    <cy:SplitButton.Label>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="导出" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                Opacity="0.7"
                                                Text="(默认 PDF)" />
                                        </StackPanel>
                                    </cy:SplitButton.Label>
                                    <cy:SplitButton.ItemContainerStyle>
                                        <Style TargetType="{x:Type cy:SplitButtonItem}">
                                            <!--  每个容器的 DataContext 已自动设为对应的 ExportFormatViewModel  -->
                                            <Setter Property="Command" Value="{Binding ExecuteCommand}" />
                                        </Style>
                                    </cy:SplitButton.ItemContainerStyle>
                                    <cy:SplitButton.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    Text="{Binding Extension}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </cy:SplitButton.ItemTemplate>
                                </cy:SplitButton>

                                <Button
                                    Margin="12,0,0,0"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleHtmlAvailabilityCommand}"
                                    Content="切换 HTML 可用性" />
                            </StackPanel>

                            <Border
                                Margin="0,16,0,0"
                                Padding="14,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="子项 VM 各自的回显 (LastResult):" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding LastResult}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,12,0,0"
                                Padding="12,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="ItemContainerStyle 关键写法:" />
                                    <TextBox
                                        Margin="0,6,0,0"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        IsReadOnly="True">
                                        <![CDATA[<cy:SplitButton ItemsSource="{Binding Formats}">
    <cy:SplitButton.ItemContainerStyle>
        <Style TargetType="{x:Type cy:SplitButtonItem}">
            <Setter Property="Command" Value="{Binding ExecuteCommand}" />
        </Style>
    </cy:SplitButton.ItemContainerStyle>
    <cy:SplitButton.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
    </cy:SplitButton.ItemTemplate>
</cy:SplitButton>]]>
                                    </TextBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ④ 路由事件 Click / ItemClick  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="路由事件" Subtitle="Click / ItemClick / Opened / Closed">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="不绑 Command 也行——SplitButton 暴露 Click 路由事件(主按钮),ItemClick 路由事件(任一菜单项)。OriginalSource 可拿到具体的 SplitButtonItem。" />

                            <StackPanel Orientation="Horizontal">
                                <cy:SplitButton
                                    MinWidth="120"
                                    Click="OnPlainClick"
                                    ItemClick="OnPlainItemClick"
                                    Label="操作">
                                    <cy:SplitButtonItem Content="复制" />
                                    <cy:SplitButtonItem Content="剪切" />
                                    <cy:SplitButtonItem Content="粘贴" />
                                    <cy:SplitButtonItem Content="全选" />
                                </cy:SplitButton>
                            </StackPanel>

                            <Border
                                Margin="0,16,0,0"
                                Padding="14,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <UniformGrid Columns="2">
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                        <Run Foreground="{DynamicResource Foreground.Link}" Text="Click" />
                                        <Run Text=" 主按钮被点击" />
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                        <Run Foreground="{DynamicResource Foreground.Link}" Text="ItemClick" />
                                        <Run Text=" 任一菜单项被点击" />
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                        <Run Foreground="{DynamicResource Foreground.Link}" Text="Opened" />
                                        <Run Text=" popup 展开" />
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                        <Run Foreground="{DynamicResource Foreground.Link}" Text="Closed" />
                                        <Run Text=" popup 关闭" />
                                    </TextBlock>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ Disabled 状态 + 键盘  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="Disabled / 键盘交互" Subtitle="IsEnabled / Esc / F4 / Alt+Down">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="主按钮 Command.CanExecute=false 时自动 disabled;整个 SplitButton 也可手动 IsEnabled=false。" />

                            <StackPanel Orientation="Horizontal">
                                <cy:SplitButton
                                    MinWidth="120"
                                    Margin="0,0,12,0"
                                    Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding IsMainEnabled}"
                                    Label="保存">
                                    <cy:SplitButtonItem Command="{Binding SaveAsPdfCommand}" Content="另存为 PDF" />
                                    <cy:SplitButtonItem Command="{Binding SaveAsWordCommand}" Content="另存为 Word" />
                                </cy:SplitButton>

                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="启用 SplitButton"
                                    IsChecked="{Binding IsMainEnabled}" />
                            </StackPanel>

                            <Border
                                Margin="0,16,0,0"
                                Padding="12,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="键盘交互" />
                                    <UniformGrid Margin="0,8,0,0" Columns="2">
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Tab" />
                                            <Run Text=" 在主按钮 / 箭头之间切换焦点" />
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Enter / Space" />
                                            <Run Text=" 触发当前焦点元素" />
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="F4 / Alt+↓" />
                                            <Run Text=" 切换下拉" />
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Esc" />
                                            <Run Text=" 关闭下拉" />
                                        </TextBlock>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑥ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="常见使用场景">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <UniformGrid Columns="2" Rows="2">

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M5,3 L19,3 L19,21 L5,21 Z M5,8 L19,8 M9,12 L15,12 M9,16 L13,16"
                                        Stroke="{DynamicResource Foreground.Link}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.5" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="保存 / 另存为" />
                                    <cy:SplitButton
                                        MinWidth="120"
                                        Margin="0,4,0,4"
                                        HorizontalAlignment="Left"
                                        Command="{Binding SaveCommand}"
                                        Label="保存">
                                        <cy:SplitButtonItem Command="{Binding SaveAsPdfCommand}" Content="另存为 PDF" />
                                        <cy:SplitButtonItem Command="{Binding SaveAsWordCommand}" Content="另存为 Word" />
                                        <cy:SplitButtonItem Command="{Binding SaveAsHtmlCommand}" Content="另存为 HTML" />
                                    </cy:SplitButton>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="文档编辑器最常见模式"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,18 L20,18 L20,21 L4,21 Z"
                                        Stroke="{DynamicResource Foreground.Success}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.5" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="导出格式" />
                                    <cy:SplitButton
                                        MinWidth="120"
                                        Margin="0,4,0,4"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExportPngCommand}"
                                        Label="导出 PNG">
                                        <cy:SplitButtonItem Command="{Binding ExportPngCommand}" Content="PNG (位图)" />
                                        <cy:SplitButtonItem Command="{Binding ExportSvgCommand}" Content="SVG (矢量)" />
                                        <cy:SplitButtonItem Command="{Binding ExportJsonCommand}" Content="JSON (数据)" />
                                    </cy:SplitButton>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="设计工具、数据可视化"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M5,12 L19,12 M12,5 L12,19"
                                        Stroke="{DynamicResource Foreground.Warning}"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="新建" />
                                    <cy:SplitButton
                                        MinWidth="120"
                                        Margin="0,4,0,4"
                                        HorizontalAlignment="Left"
                                        Command="{Binding NewFileCommand}"
                                        Label="新建">
                                        <cy:SplitButtonItem Command="{Binding NewFileCommand}" Content="文件" />
