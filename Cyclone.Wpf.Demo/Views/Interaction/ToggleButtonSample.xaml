<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.ToggleButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:ToggleButtonViewModel}}"
    d:DesignHeight="2200"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  预览文字根据 ToggleButton 状态动态样式  -->
        <Style x:Key="PreviewTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBold}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsItalic}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnderline}" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" Background="{DynamicResource Background.Info}">
                        <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border BorderBrush="White" BorderThickness="2.5" />
                            <Border Margin="6" Background="White" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="32" FontWeight="Bold"
                                       Foreground="{DynamicResource Foreground.Default}" Text="ToggleButton" />
                            <Border Margin="12,4,0,0" Padding="10,4" VerticalAlignment="Center"
                                    Background="{DynamicResource Background.Info}">
                                <TextBlock FontSize="12" FontWeight="Medium"
                                           Foreground="White" Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="14"
                                   Foreground="{DynamicResource Foreground.Caption}"
                                   Text="切换按钮——独立 on/off 状态。Checked 时整个按钮主色实心 + 白字,跟 CheckBox/RadioButton 选中态视觉对齐。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  主体  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <!--  ① 富文本工具栏 (经典 B/I/U)  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="富文本工具栏" Subtitle="经典 B / I / U 切换按钮组">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,16" FontSize="13"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="ToggleButton 经典用法 — 独立 on/off 状态。每个按钮的 IsChecked 双向绑定到 ViewModel,下方预览文字 DataTrigger 实时响应。" />

                            <!--  工具栏  -->
                            <Border Margin="0,0,0,12" Padding="4" Background="{DynamicResource Background.Header}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Width="36" Height="32" Margin="2"
                                                  IsChecked="{Binding IsBold, Mode=TwoWay}" ToolTip="加粗 (Ctrl+B)">
                                        <TextBlock FontWeight="Bold" Text="B" />
                                    </ToggleButton>
                                    <ToggleButton Width="36" Height="32" Margin="2"
                                                  IsChecked="{Binding IsItalic, Mode=TwoWay}" ToolTip="斜体 (Ctrl+I)">
                                        <TextBlock FontStyle="Italic" Text="I" />
                                    </ToggleButton>
                                    <ToggleButton Width="36" Height="32" Margin="2"
                                                  IsChecked="{Binding IsUnderline, Mode=TwoWay}" ToolTip="下划线 (Ctrl+U)">
                                        <TextBlock TextDecorations="Underline" Text="U" />
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <!--  预览  -->
                            <Border Padding="20,16" Background="{DynamicResource Background.Container}"
                                    BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <TextBlock Style="{StaticResource PreviewTextStyle}"
                                           Text="The quick brown fox jumps over the lazy dog 中文预览" />
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 设置开关  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="设置开关" Subtitle="独立 on/off 配文字 Label">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,16" FontSize="13"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="ToggleButton 也可以放在设置页 — 每个独立切换。状态用 IsChecked 表达,Checked 时整个按钮主色实心。" />

                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="开启桌面通知" />
                                    <ToggleButton Grid.Column="1" Padding="14,4"
                                                  IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="已关闭" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NotificationsEnabled}" Value="True">
                                                            <Setter Property="Text" Value="已开启" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="深色模式" />
                                    <ToggleButton Grid.Column="1" Padding="14,4"
                                                  IsChecked="{Binding DarkMode, Mode=TwoWay}"
                                                  Content="切换" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="自动保存草稿" />
                                    <ToggleButton Grid.Column="1" Padding="14,4"
                                                  IsChecked="{Binding AutoSave, Mode=TwoWay}"
                                                  Content="自动" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <!--  ③ 视图切换器 (互斥 ToggleButton 模拟 RadioButton)  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="视图切换器" Subtitle="ToggleButton 配 GroupName 模拟分段控件">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,16" FontSize="13"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="说明:ToggleButton 也可以用 RadioButton 的 GroupName 实现互斥 — 但语义上还是用 RadioButton 更合适。这里做视图模式切换器,视觉上像分段控件。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="视图模式" />
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <RadioButton Padding="20,6" Content="网格" GroupName="View" IsChecked="True" Style="{DynamicResource ToggleButton.Style.Basic}" />
                                <RadioButton Padding="20,6" Content="列表" GroupName="View" Style="{DynamicResource ToggleButton.Style.Basic}" />
                                <RadioButton Padding="20,6" Content="时间线" GroupName="View" Style="{DynamicResource ToggleButton.Style.Basic}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="排序方向" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Padding="20,6" Content="↑ 升序" GroupName="Sort" IsChecked="True" Style="{DynamicResource ToggleButton.Style.Basic}" />
                                <RadioButton Padding="20,6" Content="↓ 降序" GroupName="Sort" Style="{DynamicResource ToggleButton.Style.Basic}" />
                            </StackPanel>

                            <TextBlock Margin="0,16,0,0" FontSize="11"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="提示:这里用 RadioButton + ToggleButton 样式,实际是 RadioButton 的互斥语义但视觉是 ToggleButton。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ④ 禁用态 + 键盘  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="禁用 + 键盘" Subtitle="Disabled / Tab / Space">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="禁用态" />
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <ToggleButton Margin="0,0,8,0" Padding="14,4" Content="关 (禁用)" IsEnabled="False" />
                                <ToggleButton Padding="14,4" Content="开 (禁用)" IsChecked="True" IsEnabled="False" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="键盘交互(Tab 切换,Space 切换状态)" />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Margin="0,0,8,0" Padding="14,4" Content="按钮 A" />
                                <ToggleButton Margin="0,0,8,0" Padding="14,4" Content="按钮 B" />
                                <ToggleButton Padding="14,4" Content="按钮 C" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  底部  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <cy:Card Grid.Column="0">
                    <cy:Card.Header>
                        <cy:CardHeader Title="XAML 示例">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>
                    <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                        <![CDATA[<!-- 基础切换按钮 -->
<ToggleButton Content="加粗" IsChecked="{Binding IsBold, Mode=TwoWay}" />

<!-- 工具栏 (B/I/U) -->
<StackPanel Orientation="Horizontal">
    <ToggleButton Width="36" IsChecked="{Binding IsBold}">
        <TextBlock FontWeight="Bold" Text="B" />
    </ToggleButton>
    <ToggleButton Width="36" IsChecked="{Binding IsItalic}">
        <TextBlock FontStyle="Italic" Text="I" />
    </ToggleButton>
</StackPanel>

<!-- 状态文字 (用 DataTrigger 切换显示) -->
<ToggleButton IsChecked="{Binding Enabled}">
    <TextBlock>
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Text" Value="已关闭" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                        <Setter Property="Text" Value="已开启" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>
</ToggleButton>]]>
                    </TextBox>
                </cy:Card>

                <cy:Card Grid.Column="2">
                    <cy:Card.Header>
                        <cy:CardHeader Title="设计要点">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Foreground.Link}" Text="实心 Checked" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="Checked 时主色实心 + 白字,跟 CheckBox/Pagination 选中态视觉对齐"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Foreground.Link}" Text="Hover 反馈" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="Unchecked Hover 边框变主色淡边;Checked Hover 背景变 Highlighted 深色"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Foreground.Link}" Text="vs RadioButton" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="ToggleButton 独立 on/off,RadioButton 互斥分组。视图切换器要互斥用 RadioButton + ToggleButton 样式"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </cy:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
