<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SwitchButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type={x:Type local:SwitchButtonViewModel}}"
    d:DesignHeight="2600"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ResultBoxStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="ResultLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
        </Style>

        <!--  主题切换按钮  -->
        <Style x:Key="ThemeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Card 5 设置项 DataTemplate  -->
        <DataTemplate x:Key="SettingItemTemplate" DataType="{x:Type local:SettingItem}">
            <Border Padding="0,14" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Icon  -->
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Background.Highlighted}"
                        CornerRadius="999">
                        <Path
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{Binding IconData}"
                            Fill="White"
                            Stretch="Uniform" />
                    </Border>

                    <!--  Name + Description  -->
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,16,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="{Binding Name}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Container}"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  SwitchButton  -->
                    <cy:SwitchButton
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsOn, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M17 6H7c-3.31 0-6 2.69-6 6s2.69 6 6 6h10c3.31 0 6-2.69 6-6s-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"
                            Fill="White"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="SwitchButton" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Container}"
                            Text="滑动开关。继承 ToggleButton，二态切换 + 滑块缓动动画。轨道宽高、滑块尺寸、各状态颜色、动画时长均可自定义。模板内置阴影 + 焦点视觉。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础切换  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础切换" Subtitle="IsChecked TwoWay binding">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="最简单的用法：在 SwitchButton 内放 Content 作为标签，IsChecked 双向绑定到 ViewModel。下面演示&quot;允许编辑&quot;开关控制&quot;自动保存&quot;开关的 IsEnabled——SwitchButton 联动其他控件可用性的常见用法。" />

                            <StackPanel>
                                <cy:SwitchButton
                                    Margin="0,4,0,0"
                                    Content="允许编辑（控制下面开关的 IsEnabled）"
                                    IsChecked="{Binding IsAllowEdit, Mode=TwoWay}" />
                                <cy:SwitchButton
                                    Margin="0,12,0,0"
                                    Content="自动保存草稿"
                                    IsChecked="{Binding IsAutoSave, Mode=TwoWay}"
                                    IsEnabled="{Binding IsAllowEdit}" />
                            </StackPanel>

                            <Border Style="{StaticResource ResultBoxStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ResultLabelStyle}">
                                        <Run Text="允许编辑：" />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding IsAllowEdit, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource ResultLabelStyle}">
                                        <Run Text="自动保存：" />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding IsAutoSave, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 多种尺寸  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="多种尺寸" Subtitle="TrackWidth / TrackHeight / ThumbSize">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="3 个尺寸 DP 配合 TrackCornerRadius / ThumbCornerRadius 决定控件外观。修改 layout 属性时 thumb 会立即重定位（不带动画），避免视觉抖动。" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="小（30 × 18 / 14）" />
                                    <cy:SwitchButton
                                        HorizontalAlignment="Center"
                                        IsChecked="True"
                                        ThumbCornerRadius="7"
                                        ThumbMargin="2"
                                        ThumbSize="14"
                                        TrackCornerRadius="9"
                                        TrackHeight="18"
                                        TrackWidth="30" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="中（默认 40 × 22 / 16）" />
                                    <cy:SwitchButton HorizontalAlignment="Center" IsChecked="True" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="大（60 × 32 / 26）" />
                                    <cy:SwitchButton
                                        HorizontalAlignment="Center"
                                        IsChecked="True"
                                        ThumbCornerRadius="13"
                                        ThumbMargin="3"
                                        ThumbSize="26"
                                        TrackCornerRadius="16"
                                        TrackHeight="32"
                                        TrackWidth="60" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 颜色主题  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="自定义颜色主题" Subtitle="CheckedBackground / UncheckedBackground / ThumbBackground">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="点按钮切换不同风格。三个 Brush DP 完整覆盖控件视觉。点开关本身也可看到状态切换效果。" />

                            <WrapPanel Margin="0,0,0,16">
                                <Button
                                    Background="#FF4B4B"
                                    Command="{Binding ApplyDefaultThemeCommand}"
                                    Content="默认（红）"
                                    Style="{StaticResource ThemeButtonStyle}" />
                                <Button
                                    Background="#34C759"
                                    Command="{Binding ApplyIosThemeCommand}"
                                    Content="iOS（绿）"
                                    Style="{StaticResource ThemeButtonStyle}" />
                                <Button
                                    Background="#673AB7"
                                    Command="{Binding ApplyMaterialThemeCommand}"
                                    Content="Material（紫）"
                                    Style="{StaticResource ThemeButtonStyle}" />
                                <Button
                                    Background="#00BCD4"
                                    Command="{Binding ApplyDarkThemeCommand}"
                                    Content="暗色（青）"
                                    Style="{StaticResource ThemeButtonStyle}" />
                            </WrapPanel>

                            <StackPanel HorizontalAlignment="Center">
                                <cy:SwitchButton
                                    HorizontalAlignment="Center"
                                    CheckedBackground="{Binding Card3CheckedBg}"
                                    Content="点击试试切换效果"
                                    IsChecked="{Binding Card3IsChecked, Mode=TwoWay}"
                                    ThumbBackground="{Binding Card3ThumbBg}"
                                    ThumbCornerRadius="13"
                                    ThumbMargin="3"
                                    ThumbSize="26"
                                    TrackCornerRadius="16"
                                    TrackHeight="32"
                                    TrackWidth="60"
                                    UncheckedBackground="{Binding Card3UncheckedBg}" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ 动画时长对比  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="动画时长对比" Subtitle="AnimationDuration（0 / 100 / 200 / 500ms）">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="点&quot;同步切换&quot;同时翻转 4 个 SwitchButton——一眼看出不同 AnimationDuration 的视觉差异。0ms 等价于无动画立即跳转。" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="0ms（无动画）" />
                                    <cy:SwitchButton
                                        HorizontalAlignment="Center"
                                        AnimationDuration="0:0:0"
                                        IsChecked="{Binding Card4Switch0, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="100ms（快）" />
                                    <cy:SwitchButton
                                        HorizontalAlignment="Center"
                                        AnimationDuration="0:0:0.1"
                                        IsChecked="{Binding Card4Switch100, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="200ms（默认）" />
                                    <cy:SwitchButton
                                        HorizontalAlignment="Center"
                                        AnimationDuration="0:0:0.2"
                                        IsChecked="{Binding Card4Switch200, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="500ms（慢）" />
                                    <cy:SwitchButton
                                        HorizontalAlignment="Center"
                                        AnimationDuration="0:0:0.5"
                                        IsChecked="{Binding Card4Switch500, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Button
                                Padding="20,8"
                                HorizontalAlignment="Center"
                                Command="{Binding Card4ToggleAllCommand}"
                                Content="同步切换 4 个" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ 综合应用：设置面板  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="综合应用 — 设置面板" Subtitle="ItemsControl + DataTemplate">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="模拟系统设置面板：每行图标 + 名称 + 描述 + SwitchButton。ItemsControl 绑定 ObservableCollection&lt;SettingItem&gt;，DataTemplate 内嵌 SwitchButton 双向绑定到 IsOn 字段。" />

                            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <ItemsControl ItemTemplate="{StaticResource SettingItemTemplate}" ItemsSource="{Binding Settings}" />
                            </Border>
                        </StackPanel>
                    </cy:Card>

                </StackPanel>
            </Grid>

            <!--  ============ 底部：API 表 + 代码示例 + 设计要点 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  API 表  -->
                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="主要 API">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="成员" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsChecked" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool?" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="开关状态（继承自 ToggleButton）。已锁定 IsThreeState 默认 false——只有 true / false。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TrackWidth" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="轨道宽度（默认 50）。决定 thumb 滑动范围。" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TrackHeight" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="轨道高度（默认 26）。" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ThumbSize" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="滑块尺寸（正方形，默认 22）。建议略小于 TrackHeight 以避免溢出。" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ThumbMargin" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Thickness" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="滑块与轨道边缘的间距（默认 2）。Left + Right 影响滑块的有效移动距离。" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TrackCornerRadius" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="CornerRadius" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="轨道圆角（默认 13）。设为 TrackHeight/2 实现胶囊形状。" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ThumbCornerRadius" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="CornerRadius" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="滑块圆角（默认 11）。设为 ThumbSize/2 实现圆形 thumb。" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="UncheckedBackground" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Brush" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="未选中时的轨道颜色（默认浅灰 #CCCCCC）。" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="CheckedBackground" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Brush" />
                            <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="选中时的轨道颜色（默认红 #FF4B4B）。" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ThumbBackground" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Brush" />
                            <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="滑块颜色（默认 White）。Hover / Pressed 时由 trigger 自动覆盖。" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="AnimationDuration" />
                            <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Duration" />
                            <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="切换动画时长（默认 200ms）。设 0:0:0 等价于无动画立即切换。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <!--  代码示例 + 设计要点  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}"><sys:String xml:space="preserve">&lt;!-- 1. 基础（带标签）--&gt;
&lt;cy:SwitchButton Content="自动保存"
                 IsChecked="{Binding IsAutoSave}" /&gt;

&lt;!-- 2. 自定义尺寸（大号开关）--&gt;
&lt;cy:SwitchButton TrackWidth="60" TrackHeight="32"
                 ThumbSize="26" ThumbMargin="3"
                 TrackCornerRadius="16"
                 ThumbCornerRadius="13"
                 IsChecked="{Binding IsEnabled}" /&gt;

&lt;!-- 3. iOS 绿色风格 --&gt;
&lt;cy:SwitchButton CheckedBackground="#34C759"
                 UncheckedBackground="#E9E9EB"
                 IsChecked="{Binding IsOn}" /&gt;

&lt;!-- 4. 立即切换无动画 --&gt;
&lt;cy:SwitchButton AnimationDuration="0:0:0"
                 IsChecked="{Binding IsOn}" /&gt;

&lt;!-- 5. 联动 — 主开关控制其他控件 --&gt;
&lt;cy:SwitchButton x:Name="MasterSwitch"
                 Content="启用通知"
                 IsChecked="{Binding NotificationsEnabled}" /&gt;
&lt;CheckBox Content="邮件提醒"
          IsEnabled="{Binding IsChecked, ElementName=MasterSwitch}" /&gt;

&lt;!-- 6. 设置面板列表（DataTemplate）--&gt;
&lt;ItemsControl ItemsSource="{Binding Settings}"&gt;
    &lt;ItemsControl.ItemTemplate&gt;
        &lt;DataTemplate&gt;
            &lt;Grid&gt;
                &lt;TextBlock Text="{Binding Name}" /&gt;
                &lt;cy:SwitchButton IsChecked="{Binding IsOn}" /&gt;
            &lt;/Grid&gt;
        &lt;/DataTemplate&gt;
    &lt;/ItemsControl.ItemTemplate&gt;
&lt;/ItemsControl&gt;</sys:String></TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="二态锁定" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="IsThreeState 默认锁 false——switch 控件本质二态，避免 IsChecked=null 时 thumb 卡住不动。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="Animation 优先级" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="layout 改时 thumb 立即重定位前会先 BeginAnimation(prop, null) 清除已有动画——否则 active animation 会让 SetValue 无效。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="布局自动化" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="不强制 set 控件 MinWidth/Height——尺寸由模板自然决定，user 可自由约束控件大小。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="焦点视觉" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="自定义 FocusVisualStyle 仅围绕 track 而非整个控件（包括 Content 文字），更精致。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
