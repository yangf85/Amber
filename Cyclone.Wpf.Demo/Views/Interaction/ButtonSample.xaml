<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.ButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:ButtonViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  Icon 按钮 Path 样式  -->
        <Style x:Key="ButtonIconPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource Icon.Foreground.Default}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4,8 L20,8 L20,16 L4,16 Z"
                            Stretch="None"
                            Stroke="White"
                            StrokeLineJoin="Round"
                            StrokeThickness="2.5" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Button" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="按钮——WinUI 3 风格无圆角。提供四个 Style 变体:Basic 默认、Primary 主操作、Subtle 次要操作、Icon 工具栏图标。支持 IsDefault 自动强调、键盘焦点 outline、Hover/Pressed/Disabled 完整状态。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 操作日志(贴在 Header 下方,全宽,任何按钮触发都能看到) ============  -->
            <Border
                Grid.Row="1"
                Margin="0,0,0,20"
                Padding="14,10"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="最后操作:" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding LastAction}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="点击次数:" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding ClickCount}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Padding="10,4"
                        Command="{Binding ResetCounterCommand}"
                        Content="清零"
                        Style="{DynamicResource Button.Style.Subtle}" />
                </Grid>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 四种变体  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="四种变体" Subtitle="Basic · Primary · Subtle · Icon">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Basic — 默认隐式样式(无需指定 Style)" />
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <Button
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Basic 按钮"
                                    Content="保存" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Basic 取消"
                                    Content="取消" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Content="禁用"
                                    IsEnabled="False" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Primary — 主操作(蓝底白字)" />
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <Button
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Primary 提交"
                                    Content="提交"
                                    Style="{DynamicResource Button.Style.Primary}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Primary 开始下载"
                                    Content="开始下载"
                                    Style="{DynamicResource Button.Style.Primary}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Content="禁用"
                                    IsEnabled="False"
                                    Style="{DynamicResource Button.Style.Primary}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Subtle — 次要按钮(透明,Hover 才显色)" />
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <Button
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Subtle 忽略"
                                    Content="忽略"
                                    Style="{DynamicResource Button.Style.Subtle}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Subtle 跳过"
                                    Content="跳过"
                                    Style="{DynamicResource Button.Style.Subtle}" />
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Subtle 稍后"
                                    Content="稍后"
                                    Style="{DynamicResource Button.Style.Subtle}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Icon — 工具栏图标按钮(32×32)" />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Icon 刷新"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="刷新">
                                    <Path Data="M3,12 A9,9 0 1,1 12,21 M3,12 L3,6 M3,12 L9,12" Style="{StaticResource ButtonIconPathStyle}" />
                                </Button>
                                <Button
                                    Margin="4,0,0,0"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Icon 搜索"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="搜索">
                                    <Path Data="M10,4 A6,6 0 1,1 10,16 A6,6 0 0,1 10,4 M14.5,14.5 L20,20" Style="{StaticResource ButtonIconPathStyle}" />
                                </Button>
                                <Button
                                    Margin="4,0,0,0"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Icon 设置"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="设置">
                                    <Path Data="M12,9 A3,3 0 1,1 9,12 A3,3 0 0,1 12,9 M12,3 L12,5 M12,19 L12,21 M3,12 L5,12 M19,12 L21,12 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M5.6,18.4 L7,17 M17,7 L18.4,5.6" Style="{StaticResource ButtonIconPathStyle}" />
                                </Button>
                                <Button
                                    Margin="4,0,0,0"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Icon 下载"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="下载">
                                    <Path Data="M12,4 L12,16 M7,11 L12,16 L17,11 M4,20 L20,20" Style="{StaticResource ButtonIconPathStyle}" />
                                </Button>
                                <Button
                                    Margin="4,0,0,0"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="Icon 关闭"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="关闭">
                                    <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource ButtonIconPathStyle}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 内容组合  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="内容组合" Subtitle="图标 + 文本 / 多行 / 自定义内容">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Button 继承自 ContentControl,Content 可以是任意 UI。常用:图标 + 文本组合。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="图标 + 文本" />
                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <Button
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="新建文件">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Data="M12,5 L12,19 M5,12 L19,12"
                                            Style="{StaticResource ButtonIconPathStyle}" />
                                        <TextBlock VerticalAlignment="Center" Text="新建" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="保存为"
                                    Style="{DynamicResource Button.Style.Primary}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Data="M5,4 L17,4 L20,7 L20,20 L4,20 L4,5 Z M7,4 L7,10 L15,10 L15,4"
                                            Stretch="Uniform"
                                            Stroke="White"
                                            StrokeLineJoin="Round"
                                            StrokeThickness="1.5" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Text="保存" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="删除"
                                    Style="{DynamicResource Button.Style.Subtle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Data="M5,6 L19,6 M9,6 L9,4 L15,4 L15,6 M7,6 L7,20 L17,20 L17,6"
                                            Style="{StaticResource ButtonIconPathStyle}" />
                                        <TextBlock VerticalAlignment="Center" Text="删除" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="多行内容(主标题 + 副说明)" />
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Height="Auto"
                                    Padding="16,10"
                                    Command="{Binding ExecuteCommand}"
                                    CommandParameter="升级">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Text="升级到 Pro" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="解锁全部高级功能" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 状态  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="状态" Subtitle="Hover / Pressed / Disabled / Focused">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="鼠标悬停看 Hover 反馈,按下看 Pressed,Tab 键聚焦看 outline。" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Basic" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Primary" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Subtle" />

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,4,8"
                                    Padding="14,8"
                                    HorizontalAlignment="Stretch"
                                    Content="Normal" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="4,0,4,8"
                                    Padding="14,8"
                                    HorizontalAlignment="Stretch"
                                    Content="Normal"
                                    Style="{DynamicResource Button.Style.Primary}" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="4,0,0,8"
                                    Padding="14,8"
                                    HorizontalAlignment="Stretch"
                                    Content="Normal"
                                    Style="{DynamicResource Button.Style.Subtle}" />

                                <Button
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,4,8"
                                    Padding="14,8"
                                    HorizontalAlignment="Stretch"
                                    Content="Disabled"
                                    IsEnabled="False" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="4,0,4,8"
                                    Padding="14,8"
                                    HorizontalAlignment="Stretch"
                                    Content="Disabled"
                                    IsEnabled="False"
                                    Style="{DynamicResource Button.Style.Primary}" />
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="4,0,0,8"
                                    Padding="14,8"
                                    HorizontalAlignment="Stretch"
                                    Content="Disabled"
                                    IsEnabled="False"
                                    Style="{DynamicResource Button.Style.Subtle}" />
                            </Grid>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ IsDefault 自动强调  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="IsDefault 自动强调" Subtitle="Enter 触发的按钮自动套用 Primary 风格">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="WPF Button 有 IsDefault=True 属性,在窗口按 Enter 时触发。Basic 样式自动检测此属性,套用 Primary 蓝底白字,无需手动设 Style。" />

                            <Border
                                Padding="16"
                                Background="{DynamicResource Background.Container}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="Medium"
                                        Text="确认操作"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,8,0,16"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="删除后无法恢复,是否继续?"
                                        TextWrapping="Wrap" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Padding="14,8"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="对话框取消"
                                            Content="取消"
                                            IsCancel="True" />
                                        <!--
                                            IsDefault=True — Basic 样式自动套用 Primary 蓝底白字
                                            无需手动指定 Style
                                        -->
                                        <Button
                                            Margin="8,0,0,0"
                                            Padding="14,8"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="对话框确认"
                                            Content="确认"
                                            IsDefault="True" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="提示:这个对话框示意只是视觉演示,Enter 不会真的触发(因为没在 Window 顶层)。实际用法见 XAML 示例。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ Busy 联动禁用  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="Busy 联动禁用" Subtitle="批量按钮禁用 / 启用">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="点击 开始处理 切换 IsBusy 状态——下方一组按钮的 IsEnabled 绑定 CanInteract 计算属性。" />

                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <Button
                                    Padding="14,8"
                                    Command="{Binding ToggleBusyCommand}"
                                    Content="切换 Busy"
                                    Style="{DynamicResource Button.Style.Primary}" />
                                <TextBlock
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ValueLabelStyle}">
                                    <Run Text="IsBusy =" />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding IsBusy, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Border
                                Padding="12"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="工具栏(Busy 时禁用)" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="工具栏 新建"
                                            IsEnabled="{Binding CanInteract}"
                                            Style="{DynamicResource Button.Style.Icon}"
                                            ToolTip="新建">
                                            <Path Data="M12,5 L12,19 M5,12 L19,12" Style="{StaticResource ButtonIconPathStyle}" />
                                        </Button>
                                        <Button
                                            Margin="4,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="工具栏 编辑"
                                            IsEnabled="{Binding CanInteract}"
                                            Style="{DynamicResource Button.Style.Icon}"
                                            ToolTip="编辑">
                                            <Path Data="M4,20 L8,19 L20,7 L17,4 L5,16 L4,20 Z" Style="{StaticResource ButtonIconPathStyle}" />
                                        </Button>
                                        <Button
                                            Margin="4,0,0,0"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="工具栏 删除"
                                            IsEnabled="{Binding CanInteract}"
                                            Style="{DynamicResource Button.Style.Icon}"
                                            ToolTip="删除">
                                            <Path Data="M5,6 L19,6 M9,6 L9,4 L15,4 L15,6 M7,6 L7,20 L17,20 L17,6" Style="{StaticResource ButtonIconPathStyle}" />
                                        </Button>
                                        <Button
                                            Margin="12,0,0,0"
                                            Padding="14,8"
                                            Command="{Binding ExecuteCommand}"
                                            CommandParameter="工具栏 提交"
                                            Content="提交"
                                            IsEnabled="{Binding CanInteract}"
                                            Style="{DynamicResource Button.Style.Primary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑥ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="使用场景指南">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Border
                                    Width="60"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <Button Padding="10,5" Content="Basic" />
                                </Border>
                                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Text="普通操作" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="取消、重置、打开、关闭、刷新等中性操作" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Border Width="60" VerticalAlignment="Top">
                                    <Button
                                        Padding="10,5"
                                        Content="Primary"
                                        Style="{DynamicResource Button.Style.Primary}" />
                                </Border>
                                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Text="主操作" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="提交、确认、保存——每个区域 / 对话框通常只有一个 Primary" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Border Width="60" VerticalAlignment="Top">
                                    <Button
                                        Padding="10,5"
                                        Content="Subtle"
                                        Style="{DynamicResource Button.Style.Subtle}" />
                                </Border>
                                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Text="次要操作" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="忽略、跳过、稍后、文本链接式按钮" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="60" VerticalAlignment="Top">
                                    <Button Style="{DynamicResource Button.Style.Icon}">
                                        <Path Data="M12,5 L12,19 M5,12 L19,12" Style="{StaticResource ButtonIconPathStyle}" />
                                    </Button>
                                </Border>
                                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Text="纯图标" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="工具栏图标按钮,搭配 ToolTip 标识功能" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  ============ 底部:属性表 + 代码示例 + 设计要点 ============  -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="Button 属性 + Style 变体">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="属性 / Style" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="Content" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="object" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="按钮内容,字符串或任意 UI 元素(如 StackPanel + Icon + Text)。" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="Command / CommandParameter" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="ICommand / object" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="点击触发的命令。CanExecute=false 时按钮自动 IsEnabled=false。" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="IsDefault" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="bool (false)" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="True 时窗口按 Enter 触发该按钮。Basic 样式会自动套用 Primary 蓝底白字。" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="IsCancel" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="bool (false)" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="True 时窗口按 Esc 触发该按钮。视觉无强调(取消是普通操作)。" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="IsEnabled" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="bool" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="禁用时整体 Opacity 0.5,Cursor 变 Arrow。" />

                            <Border
                                Grid.Row="6"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="Style 变体" />

                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="Button.Style.Basic" />
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="Style (隐式)" />
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="默认隐式样式,无需指定 — 灰白底 + 边框,适合普通操作。" />

                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="Button.Style.Primary" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="Style" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="主操作 — 蓝底白字,每页 / 对话框通常只有一个。" />

                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="Button.Style.Subtle / Icon" />
                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="Style / Style" />
                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="Subtle 透明背景仅 Hover 显色;Icon 是 32×32 正方形纯图标变体。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                            <![CDATA[<!-- 普通按钮(隐式 Basic) -->
<Button Content="取消" Command="{Binding CancelCommand}" />

<!-- 主操作按钮 -->
<Button
    Style="{StaticResource Button.Style.Primary}"
    Content="提交"
    Command="{Binding SubmitCommand}" />

<!-- 次要按钮 -->
<Button
    Style="{StaticResource Button.Style.Subtle}"
    Content="忽略" />

<!-- 工具栏图标按钮 -->
<Button
    Style="{StaticResource Button.Style.Icon}"
    ToolTip="刷新">
    <Path Data="..." Stroke="..." />
</Button>

<!-- 图标 + 文本 -->
<Button Padding="14,8" Command="{Binding NewFileCommand}">
    <StackPanel Orientation="Horizontal">
        <Path Margin="0,0,8,0" Data="M12,5 L12,19 M5,12 L19,12" ... />
        <TextBlock VerticalAlignment="Center" Text="新建" />
    </StackPanel>
</Button>

<!-- Enter / Esc 触发(对话框) -->
<StackPanel Orientation="Horizontal">
    <Button Content="取消" IsCancel="True" />
    <!-- IsDefault=True 自动套用 Primary 风格 -->
    <Button Content="确认" IsDefault="True" Command="..." />
</StackPanel>]]>
                        </TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="9" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="四种变体" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="覆盖 90% 的场景。需要时改 Foreground 就能做 Success / Danger 变体"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="键盘焦点 outline" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="外层 FocusBorder + IsKeyboardFocused trigger,无障碍友好"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="IsDefault 自动强调" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Enter 触发的按钮自动视觉强调,无需手动指定 Primary"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="Cursor 反馈" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="可点击时 Hand,Disabled 时 Arrow,Web 风格直观"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>