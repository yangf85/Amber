<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.CircularGaugeSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls;assembly=Cyclone.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:CircularGaugeViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M12,4 A8,8 0 1,1 11.99,4 M12,12 L18,7"
                            Stretch="None"
                            Stroke="White"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.5" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="CircularGauge" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="自定义控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="圆形仪表盘——派生自 RangeBase。支持分段染色、平滑动画、键盘操作、鼠标拖动、自定义数值格式和单位文字。0° = 顶部 12 点钟方向,SweepAngle 默认 270°(底部对称开口)。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 实时监控仪表板 — 多个 Gauge 配合  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="实时监控仪表板" Subtitle="模拟 CPU / 温度 / 速度 / 电量">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="数据每 800ms 自动变化(DispatcherTimer),观察指针平滑动画。每个 Gauge 都用 Ranges 配置了不同的分段染色。" />

                            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                <CheckBox Content="开启模拟数据更新" IsChecked="{Binding IsSimulating}" />
                                <Button
                                    Margin="16,0,0,0"
                                    Padding="14,4"
                                    Command="{Binding ResetAllCommand}"
                                    Content="重置所有" />
                            </StackPanel>

                            <UniformGrid Columns="2" Rows="2">

                                <!--  CPU 使用率  -->
                                <Border Padding="8" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource DemoItemTitleStyle}"
                                            Text="CPU 使用率" />
                                        <ctl:CircularGauge
                                            Width="160"
                                            Height="160"
                                            HorizontalAlignment="Center"
                                            LargeChange="20"
                                            Maximum="100"
                                            Minimum="0"
                                            SmallChange="5"
                                            Unit="%"
                                            Value="{Binding CpuUsage}"
                                            ValueStringFormat="{}{0:F0}">
                                            <ctl:CircularGauge.Ranges>
                                                <ctl:GaugeRange
                                                    Brush="#4CAF50"
                                                    From="0"
                                                    To="60" />
                                                <ctl:GaugeRange
                                                    Brush="#FF9800"
                                                    From="60"
                                                    To="85" />
                                                <ctl:GaugeRange
                                                    Brush="#F44336"
                                                    From="85"
                                                    To="100" />
                                            </ctl:CircularGauge.Ranges>
                                        </ctl:CircularGauge>
                                    </StackPanel>
                                </Border>

                                <!--  温度计  -->
                                <Border Padding="8" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource DemoItemTitleStyle}"
                                            Text="环境温度" />
                                        <ctl:CircularGauge
                                            Width="160"
                                            Height="160"
                                            HorizontalAlignment="Center"
                                            LargeChange="10"
                                            Maximum="50"
                                            Minimum="-10"
                                            SmallChange="5"
                                            Unit="°C"
                                            Value="{Binding Temperature}"
                                            ValueStringFormat="{}{0:F1}">
                                            <ctl:CircularGauge.Ranges>
                                                <ctl:GaugeRange
                                                    Brush="#2196F3"
                                                    From="-10"
                                                    To="10" />
                                                <ctl:GaugeRange
                                                    Brush="#4CAF50"
                                                    From="10"
                                                    To="30" />
                                                <ctl:GaugeRange
                                                    Brush="#F44336"
                                                    From="30"
                                                    To="50" />
                                            </ctl:CircularGauge.Ranges>
                                        </ctl:CircularGauge>
                                    </StackPanel>
                                </Border>

                                <!--  速度表  -->
                                <Border Padding="8" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource DemoItemTitleStyle}"
                                            Text="车辆速度" />
                                        <ctl:CircularGauge
                                            Width="160"
                                            Height="160"
                                            HorizontalAlignment="Center"
                                            LargeChange="40"
                                            Maximum="200"
                                            Minimum="0"
                                            SmallChange="10"
                                            Unit="km/h"
                                            Value="{Binding Speed}"
                                            ValueStringFormat="{}{0:F0}">
                                            <ctl:CircularGauge.Ranges>
                                                <ctl:GaugeRange
                                                    Brush="#4CAF50"
                                                    From="0"
                                                    To="80" />
                                                <ctl:GaugeRange
                                                    Brush="#FF9800"
                                                    From="80"
                                                    To="120" />
                                                <ctl:GaugeRange
                                                    Brush="#F44336"
                                                    From="120"
                                                    To="200" />
                                            </ctl:CircularGauge.Ranges>
                                        </ctl:CircularGauge>
                                    </StackPanel>
                                </Border>

                                <!--  电量  -->
                                <Border Padding="8" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource DemoItemTitleStyle}"
                                            Text="电池电量" />
                                        <ctl:CircularGauge
                                            Width="160"
                                            Height="160"
                                            HorizontalAlignment="Center"
                                            LargeChange="25"
                                            Maximum="100"
                                            Minimum="0"
                                            SmallChange="5"
                                            Unit="%"
                                            Value="{Binding BatteryLevel}"
                                            ValueStringFormat="{}{0:F0}">
                                            <ctl:CircularGauge.Ranges>
                                                <ctl:GaugeRange
                                                    Brush="#F44336"
                                                    From="0"
                                                    To="20" />
                                                <ctl:GaugeRange
                                                    Brush="#FF9800"
                                                    From="20"
                                                    To="50" />
                                                <ctl:GaugeRange
                                                    Brush="#4CAF50"
                                                    From="50"
                                                    To="100" />
                                            </ctl:CircularGauge.Ranges>
                                        </ctl:CircularGauge>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 可拖动调整  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="拖动 / 键盘交互" Subtitle="IsDraggable + 键盘 ↑↓ PgUp/Dn Home/End">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="鼠标拖动调整指针位置 — 死区(底部 90°)不响应,避免误操作跳变到最大值。点击 Gauge 获得焦点后用 ↑↓ ±1, PgUp/Dn ±10, Home/End 跳到 Min/Max。" />

                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <ctl:CircularGauge
                                    Width="200"
                                    Height="200"
                                    IsDraggable="True"
                                    LargeChange="10"
                                    Maximum="100"
                                    Minimum="0"
                                    SmallChange="1"
                                    Unit="Value"
                                    Value="{Binding Value1, Mode=TwoWay}"
                                    ValueStringFormat="{}{0:F0}" />
                                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ValueLabelStyle}" Text="操作提示" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="• 鼠标拖动指针" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="• ↑→ +1, ↓← -1" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="• PgUp +10, PgDn -10" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="• Home=0, End=100" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        FontFamily="Consolas"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding Value1, StringFormat={}{0:F0}}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ③ SweepAngle 演示  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="SweepAngle 弧形跨度" Subtitle="从扇形到完整圆环">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="SweepAngle 控制弧形跨度。180° = 半圆,270° = 默认,360° = 完整圆环。0° 始终是顶部 12 点钟。" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ValueLabelStyle}"
                                    Text="SweepAngle" />
                                <Slider
                                    Grid.Column="1"
                                    IsSnapToTickEnabled="True"
                                    Maximum="360"
                                    Minimum="90"
                                    TickFrequency="30"
                                    TickPlacement="BottomRight"
                                    Value="{Binding DemoSweepAngle, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding DemoSweepAngle, StringFormat={}{0:F0}°}" />
                            </Grid>

                            <ctl:CircularGauge
                                Width="200"
                                Height="200"
                                HorizontalAlignment="Center"
                                LargeChange="20"
                                Maximum="100"
                                Minimum="0"
                                SmallChange="5"
                                SweepAngle="{Binding DemoSweepAngle}"
                                Unit=""
                                Value="{Binding DemoValue, Mode=TwoWay}"
                                ValueStringFormat="{}{0:F0}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ValueLabelStyle}"
                                    Text="Value" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding DemoValue, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ④ 不同尺寸  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="尺寸自适应" Subtitle="同一控件不同 Width/Height">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Viewbox 模板,指针自动随控件大小缩放。配合 FontSize 调整中心数值字号。" />

                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <ctl:CircularGauge
                                    Width="100"
                                    Height="100"
                                    Margin="0,0,12,0"
                                    FontSize="14"
                                    LabelFontSize="8"
                                    Value="{Binding CpuUsage}" />
                                <ctl:CircularGauge
                                    Width="160"
                                    Height="160"
                                    Margin="0,0,12,0"
                                    Value="{Binding CpuUsage}" />
                                <ctl:CircularGauge
                                    Width="220"
                                    Height="220"
                                    FontSize="30"
                                    LabelFontSize="14"
                                    Value="{Binding CpuUsage}" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ 无分段染色 + 无单位 + 动画时长  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="极简模式" Subtitle="无 Ranges / 无 Unit / AnimationDuration">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="不设 Ranges 就没有分段染色环;不设 Unit(或设 null/空)就不显示单位文字。下面对比 0ms(瞬间)和 800ms(慢动画)。" />

                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DemoItemTitleStyle}"
                                        Text="瞬间 (AnimationDuration=0)" />
                                    <ctl:CircularGauge
                                        Width="160"
                                        Height="160"
                                        HorizontalAlignment="Center"
                                        AnimationDuration="0:0:0"
                                        Value="{Binding CpuUsage}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DemoItemTitleStyle}"
                                        Text="慢动画 (AnimationDuration=0.8s)" />
                                    <ctl:CircularGauge
                                        Width="160"
                                        Height="160"
                                        HorizontalAlignment="Center"
                                        AnimationDuration="0:0:0.8"
                                        Value="{Binding CpuUsage}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  ============ 底部 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="CircularGauge 属性 + 行为">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="属性" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型(默认)" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Value / Minimum / Maximum" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="继承自 RangeBase。Minimum 默认 0、Maximum 默认 100(覆写)。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SmallChange / LargeChange" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (1 / 10)" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="SmallChange 是短刻度间距 + 键盘 ↑↓ 步长。LargeChange 是长刻度(带数字标签)间距 + PgUp/Dn 步长。" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SweepAngle" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (270)" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="弧形跨度(度),取值 (0, 360]。0° = 顶部,顺时针展开。" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Ranges" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="ObservableCollection&lt;GaugeRange&gt;" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="分段染色集合,每段 (From, To, Brush)。在刻度盘外画一段彩色弧。" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="RangeRingThickness" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (6)" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="分段染色环厚度(像素)。仅 Ranges 非空时有效。" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ValueStringFormat" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string (&quot;{0:F0}&quot;)" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="中心数值显示格式。&quot;{0:F0}&quot;=整数,&quot;{0:F2}&quot;=2位小数,&quot;{0:P0}&quot;=百分比。" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Unit" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string (null)" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数值下方单位文本(如 &quot;%&quot; &quot;km/h&quot; &quot;°C&quot;)。null/空时不显示。" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsDraggable" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (true)" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否允许鼠标拖动调整 Value。死区(底部)不响应,避免误操作。" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="AnimationDuration" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="TimeSpan (300ms)" />
                            <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Value 改变时指针缓动到新位置的时长。TimeSpan.Zero 关闭动画(即时跳转)。" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickBrush / LabelFontSize / TickLengthRatio" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Brush / double / double" />
                            <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="刻度颜色 / 数字标签字号 / 刻度长度比例(相对半径)。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                            <![CDATA[<!-- 基础 -->
<ctl:CircularGauge
    Width="160" Height="160"
    Minimum="0" Maximum="100"
    SmallChange="5" LargeChange="20"
    Value="{Binding CpuUsage}"
    Unit="%" />

<!-- 分段染色 (绿/黄/红) -->
<ctl:CircularGauge
    Value="{Binding CpuUsage}"
    Unit="%">
    <ctl:CircularGauge.Ranges>
        <ctl:GaugeRange From="0"  To="60"  Brush="#4CAF50" />
        <ctl:GaugeRange From="60" To="85"  Brush="#FF9800" />
        <ctl:GaugeRange From="85" To="100" Brush="#F44336" />
    </ctl:CircularGauge.Ranges>
</ctl:CircularGauge>

<!-- 半圆仪表 (SweepAngle=180) -->
<ctl:CircularGauge
    SweepAngle="180"
    Maximum="100"
    Value="{Binding ...}" />

<!-- 自定义格式 + 关闭动画 -->
<ctl:CircularGauge
    ValueStringFormat="{}{0:F2}"
    AnimationDuration="0"
    Value="{Binding ...}" />

<!-- 禁用拖动 (只读监控显示) -->
<ctl:CircularGauge
    IsDraggable="False"
    Value="{Binding ServerLoad}" />]]>
                        </TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="性能优化" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Value 改变只动画 RotateTransform,不触发 OnRender。Pen/Typeface 缓存复用"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="死区保护" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="鼠标拖到弧形外不响应,避免点底部跳到 Maximum 的 bug"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="0° 顶部直觉" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="SweepAngle 替代反直觉的 StartAngle/EndAngle 双值,0° 始终在 12 点钟"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="无浮点累加误差" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="用 int 循环 + Minimum + i*SmallChange 计算刻度位置,避免末尾刻度漏画"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
