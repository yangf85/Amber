<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.RangeSliderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:RangeSliderViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Grid>
                            <Path
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M3,12 L21,12 M8,9 L8,15 M16,9 L16,15"
                                Stroke="White"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeThickness="2" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="RangeSlider" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="范围滑块——双 Thumb 表示一段数值区间。支持完整键盘交互（Tab 切换 thumb / 方向键 ±Step / PageUp/Down ±LargeChange / Home/End 跳两端）、刻度对齐、点击跳转。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法" Subtitle="Minimum / Maximum / LowerValue / UpperValue">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="拖动两端 thumb 调整区间。点击轨道空白处按 LargeChange 跳跃。中段单击靠近哪个 thumb 移哪个（IsMoveToPoint=true）。" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <cy:RangeSlider
                                    Grid.Column="0"
                                    Margin="0,0,16,0"
                                    AutoToolTipPlacement="TopLeft"
                                    LowerValue="{Binding PriceLower, Mode=TwoWay}"
                                    Maximum="1000"
                                    Minimum="0"
                                    UpperValue="{Binding PriceUpper, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding PriceRangeText}" />
                            </Grid>

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="拖动 thumb 时显示数值 tooltip（AutoToolTipPlacement=TopLeft）。" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ② Step + LargeChange + 键盘  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="Step / LargeChange / 键盘">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Step=5（方向键步进） / LargeChange=10（PageUp/Down 步进 + 点击轨道空白处的步进）。先 Tab 给 thumb 焦点，再用方向键试试。" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <cy:RangeSlider
                                    Grid.Column="0"
                                    Margin="0,0,16,0"
                                    AutoToolTipPlacement="TopLeft"
                                    IsSnapToStep="True"
                                    LargeChange="10"
                                    LowerValue="{Binding HourLower, Mode=TwoWay}"
                                    Maximum="24"
                                    Minimum="0"
                                    Step="1"
                                    UpperValue="{Binding HourUpper, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding HourRangeText}" />
                            </Grid>

                            <Border
                                Margin="0,16,0,0"
                                Padding="12,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="键盘交互" />
                                    <UniformGrid
                                        Margin="0,8,0,0"
                                        Columns="2">
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Tab" />
                                            <Run Text=" 切换 thumb 焦点" />
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="←/→ ↑/↓" />
                                            <Run Text=" ±Step" />
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="PgUp/PgDn" />
                                            <Run Text=" ±LargeChange" />
                                        </TextBlock>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Home/End" />
                                            <Run Text=" 跳到两端" />
                                        </TextBlock>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 刻度线  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="刻度线 / 离散值" Subtitle="TickPlacement / TickFrequency / IsSnapToTick">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="TickPlacement=Both / TickFrequency=10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <cy:RangeSlider
                                        Grid.Column="0"
                                        Margin="0,0,16,0"
                                        AutoToolTipPlacement="TopLeft"
                                        IsSnapToTick="True"
                                        LowerValue="{Binding AgeLower, Mode=TwoWay}"
                                        Maximum="100"
                                        Minimum="0"
                                        TickFrequency="10"
                                        TickPlacement="Both"
                                        UpperValue="{Binding AgeUpper, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding AgeRangeText}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="TickPlacement=BottomRight" />
                                <cy:RangeSlider
                                    Margin="0,0,0,4"
                                    LowerValue="0.3"
                                    Maximum="1"
                                    Minimum="0"
                                    Step="0.1"
                                    TickFrequency="0.1"
                                    TickPlacement="BottomRight"
                                    UpperValue="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ MVVM 双向绑定  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="MVVM 双向绑定" Subtitle="LowerValue / UpperValue 默认 TwoWay">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="透明度范围（视觉实时反映）" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <cy:RangeSlider
                                    Grid.Column="0"
                                    Margin="0,0,16,0"
                                    AutoToolTipPlacement="TopLeft"
                                    AutoToolTipPrecision="2"
                                    LargeChange="0.1"
                                    LowerValue="{Binding OpacityLower, Mode=TwoWay}"
                                    Maximum="1"
                                    Minimum="0"
                                    Step="0.05"
                                    UpperValue="{Binding OpacityUpper, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="Lower:" />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding OpacityLower, Mode=OneWay, StringFormat=F2}" />
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="Upper:" />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding OpacityUpper, Mode=OneWay, StringFormat=F2}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="60"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <Grid>
                                    <Border
                                        Width="60"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Foreground.Link}"
                                        Opacity="{Binding OpacityLower}" />
                                    <Border
                                        Width="60"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource Foreground.Link}"
                                        Opacity="{Binding OpacityUpper}" />
                                    <TextBlock
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="左 = OpacityLower / 中 = OpacityUpper" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="常见使用场景">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <UniformGrid Columns="2" Rows="2">

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M12,2 L13,8 L20,8 L14,12 L17,19 L12,15 L7,19 L10,12 L4,8 L11,8 Z"
                                        Fill="{DynamicResource Foreground.Warning}"
                                        Stroke="{DynamicResource Foreground.Warning}"
                                        StrokeThickness="1" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="价格筛选" />
                                    <cy:RangeSlider
                                        Margin="0,4,0,4"
                                        LowerValue="200"
                                        Maximum="2000"
                                        Minimum="0"
                                        Step="50"
                                        UpperValue="1500" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="商品列表、机票酒店"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M12,2 A10,10 0 1,1 2,12 A10,10 0 0,1 12,2 M12,6 L12,12 L17,15"
                                        Stroke="{DynamicResource Foreground.Link}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="时间窗口" />
                                    <cy:RangeSlider
                                        Margin="0,4,0,4"
                                        IsSnapToStep="True"
                                        LowerValue="9"
                                        Maximum="24"
                                        Minimum="0"
                                        Step="1"
                                        UpperValue="18" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="工作时段、营业时间"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M9,2 A3,3 0 0,1 15,2 V12 A6,6 0 1,1 9,12 Z"
                                        Stroke="{DynamicResource Foreground.Success}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="温度区间" />
                                    <cy:RangeSlider
                                        Margin="0,4,0,4"
                                        LowerValue="-5"
                                        Maximum="40"
                                        Minimum="-20"
                                        TickFrequency="10"
                                        TickPlacement="BottomRight"
                                        UpperValue="25" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="设备控制、阈值监控"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M3,3 L21,3 L21,21 L3,21 Z M3,3 L21,21 M21,3 L3,21"
                                        Stroke="#8B5CF6"
                                        StrokeThickness="1.5" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="数据过滤" />
                                    <cy:RangeSlider
                                        Margin="0,4,0,4"
                                        AutoToolTipPlacement="TopLeft"
                                        AutoToolTipPrecision="0"
                                        LowerValue="20"
                                        Maximum="100"
                                        Minimum="0"
                                        UpperValue="80" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="柱状图、直方图过滤"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                        </UniformGrid>
                    </cy:Card>

                </StackPanel>
            </Grid>

            <!--  ============ 底部：属性表 + 代码示例 + 设计要点 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ⑥ 主要属性  -->
                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="RangeSlider 主要属性">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="属性" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Minimum / Maximum" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="区间端点。Min/Max 自动 coerce 互不交叉。默认 0 / 100。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="LowerValue / UpperValue" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (TwoWay)" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="区间下界 / 上界。默认双向绑定。Lower≤Upper 自动保证。" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Step" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="方向键 / IsSnapToStep 步进。必须 &gt; 0。默认 1。" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="LargeChange" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="PageUp/Down 步进，以及点击轨道空白段时的步进量。默认 10。" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSnapToStep" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否对齐到 Step 整数倍。默认 true。" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSnapToTick" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否对齐到刻度线。优先级高于 IsSnapToStep。默认 false。" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickFrequency / Ticks" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double / DoubleCollection" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="等距刻度频率 / 自定义刻度位置。Ticks 设了之后 TickFrequency 失效。" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickPlacement" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="TickPlacement" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="刻度线显示位置：None / TopLeft / BottomRight / Both。默认 None。" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Orientation" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Orientation" />
                            <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Horizontal / Vertical。默认 Horizontal。" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsDirectionReversed" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                            <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="反转方向。键盘和拖动方向同步反转。" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsMoveToPoint" />
                            <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                            <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="点击中段轨道时的行为。true=移动最近的 thumb 到点击点，false=按 LargeChange 步进。默认 true。" />

                            <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="AutoToolTipPlacement" />
                            <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="AutoToolTipPlacement" />
                            <TextBlock Grid.Row="12" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="拖动 thumb 时显示数值 tooltip 的位置。默认 None。" />

                            <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="InactiveTrackBrush / ActiveTrackBrush" />
                            <TextBlock Grid.Row="13" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Brush" />
                            <TextBlock Grid.Row="13" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="区间外 / 区间内的轨道刷子。默认由主题资源提供。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <!--  ⑦ XAML 示例 + ⑧ 设计要点  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}"><![CDATA[<!-- 基础 -->
<cy:RangeSlider
    Minimum="0"
    Maximum="1000"
    LowerValue="{Binding PriceLower, Mode=TwoWay}"
    UpperValue="{Binding PriceUpper, Mode=TwoWay}"
    AutoToolTipPlacement="TopLeft" />

<!-- 离散值 + 刻度线 -->
<cy:RangeSlider
    Minimum="0" Maximum="100"
    Step="10" LargeChange="20"
    IsSnapToTick="True"
    TickFrequency="10"
    TickPlacement="Both" />

<!-- 自定义刻度位置 -->
<cy:RangeSlider Minimum="0" Maximum="100">
    <cy:RangeSlider.Ticks>
        <DoubleCollection>0 25 50 75 100</DoubleCollection>
    </cy:RangeSlider.Ticks>
</cy:RangeSlider>

<!-- 垂直 + 反向 -->
<cy:RangeSlider
    Orientation="Vertical"
    IsDirectionReversed="True"
    Height="200" />]]></TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="Coerce 链单向" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Min 变 → coerce Max → coerce Lower → coerce Upper。永不死锁。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="完整键盘" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Tab 切换 thumb / 方向键 ±Step / PageUp/Down ±LargeChange / Home/End 跳两端"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="刻度缓存" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Min/Max/Ticks/TickFrequency 变化时 invalidate，否则二分查找命中"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="标准 ToolTip" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="按 WPF Slider 模式：DragStarted 时按需创建、DragCompleted 时关闭"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
