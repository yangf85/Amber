<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.DateRangePickerSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:DateRangePickerViewModel}}"
    d:DesignHeight="2200"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" Background="{DynamicResource Background.Info}">
                        <Path Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 5 L 22 5 L 22 20 L 0 20 Z M 0 8 L 22 8 M 5 0 L 5 8 M 17 0 L 17 8"
                              Stretch="None"
                              Stroke="White" StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="32" FontWeight="Bold"
                                       Foreground="{DynamicResource Foreground.Default}" Text="DateRangePicker" />
                            <Border Margin="12,4,0,0" Padding="10,4" VerticalAlignment="Center"
                                    Background="{DynamicResource Background.Info}">
                                <TextBlock FontSize="12" FontWeight="Medium"
                                           Foreground="White" Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" FontSize="14"
                                   Foreground="{DynamicResource Foreground.Caption}"
                                   Text="日期范围选择器 — 两次点击选起止日期,中间区段自动高亮。Hover 预览 + 17 个内置预定义范围(今天/近 7 天/本月等),也可自定义。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  主体  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <!--  ① 基础绑定 — 订单查询  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础绑定" Subtitle="RangeStart / RangeEnd 双向绑定 ViewModel">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,16" FontSize="13"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="经典订单查询场景 — 选范围后下方计算 持续天数 。默认显示 17 个预定义范围 + 单 Calendar 月历。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="订单时间范围" />
                            <cy:DateRangePicker Width="280"
                                                HorizontalAlignment="Left"
                                                RangeStart="{Binding OrderStart, Mode=TwoWay}"
                                                RangeEnd="{Binding OrderEnd, Mode=TwoWay}" />

                            <Border Padding="12,8" Margin="0,16,0,0"
                                    Background="{DynamicResource Background.Header}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="RangeStart = " />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}"
                                             Text="{Binding OrderStart, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="RangeEnd   = " />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}"
                                             Text="{Binding OrderEnd, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="持续天数  = " />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}"
                                             Text="{Binding OrderDays, Mode=OneWay}" />
                                        <Run Text=" 天" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Padding="14,6"
                                        Command="{Binding SetLastWeekCommand}" Content="设为近 7 天" />
                                <Button Padding="14,6"
                                        Command="{Binding ClearOrderRangeCommand}" Content="清空" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② BlackoutDates — 节假日不可选  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="禁用日期" Subtitle="BlackoutDates 列表中的日期划掉禁选">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,16" FontSize="13"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="模拟 节假日不可预约 场景 — 部分日期划掉禁选,光标变 Arrow,鼠标 hover 跳过。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="预约时间(避开节假日)" />
                            <cy:DateRangePicker Width="280"
                                                HorizontalAlignment="Left"
                                                BlackoutDates="{Binding Holidays}" />

                            <TextBlock Margin="0,12,0,0" FontSize="11"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="提示:Holidays 列表里设了 4 个日期(前后各 2 天),打开 Popup 查看划掉效果。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <!--  ③ 自定义预定义范围  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="自定义预定义范围" Subtitle="替换默认 17 项 — 只显示季度">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,16" FontSize="13"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="业务场景定制 — 财务报表只关心 Q1/Q2/Q3/Q4,默认 17 项太杂。把 PredefinedRanges 设成自定义列表即可。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="财务季度选择" />
                            <cy:DateRangePicker Width="280"
                                                HorizontalAlignment="Left"
                                                PredefinedRanges="{Binding QuarterRanges}"
                                                RangeStart="{Binding QuarterStart, Mode=TwoWay}"
                                                RangeEnd="{Binding QuarterEnd, Mode=TwoWay}" />

                            <Border Padding="12,8" Margin="0,12,0,0"
                                    Background="{DynamicResource Background.Header}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="Start = " />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}"
                                             Text="{Binding QuarterStart, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="End   = " />
                                        <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}"
                                             Text="{Binding QuarterEnd, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ④ 极简 + 禁用  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="极简 + 禁用" Subtitle="无预定义范围列表 / 禁用态">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="无预定义列表(ShowPredefinedRanges=False)" />
                            <cy:DateRangePicker Width="280"
                                                HorizontalAlignment="Left"
                                                ShowPredefinedRanges="False"
                                                RangeStart="{Binding PlainStart, Mode=TwoWay}"
                                                RangeEnd="{Binding PlainEnd, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="禁用态(IsEnabled=False)" />
                            <cy:DateRangePicker Width="280"
                                                HorizontalAlignment="Left"
                                                IsEnabled="False"
                                                RangeStart="{Binding FrozenStart}"
                                                RangeEnd="{Binding FrozenEnd}" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="自定义分隔符" />
                            <cy:DateRangePicker Width="280"
                                                HorizontalAlignment="Left"
                                                Separator=" 至 " />
                        </StackPanel>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  底部  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <cy:Card Grid.Column="0">
                    <cy:Card.Header>
                        <cy:CardHeader Title="XAML 示例">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>
                    <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                        <![CDATA[<!-- 基础绑定 -->
<cy:DateRangePicker RangeStart="{Binding OrderStart, Mode=TwoWay}"
                    RangeEnd="{Binding OrderEnd, Mode=TwoWay}" />

<!-- 禁用日期 -->
<cy:DateRangePicker BlackoutDates="{Binding Holidays}" />

<!-- 自定义预定义范围 -->
<cy:DateRangePicker PredefinedRanges="{Binding QuarterRanges}" />

<!-- 隐藏预定义面板,只用月历 -->
<cy:DateRangePicker ShowPredefinedRanges="False" />

<!-- 自定义分隔符 -->
<cy:DateRangePicker Separator=" 至 " />

<!-- 自定义预定义范围(C#) -->
public IList<IPredefinedRange> QuarterRanges { get; } = new[]
{
    new PredefinedRange("Q1", new DateTime(2025, 1, 1), new DateTime(2025, 3, 31)),
    new PredefinedRange("Q2", new DateTime(2025, 4, 1), new DateTime(2025, 6, 30)),
    // ...
};]]>
                    </TextBox>
                </cy:Card>

                <cy:Card Grid.Column="2">
                    <cy:Card.Header>
                        <cy:CardHeader Title="设计要点">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Foreground.Link}" Text="两次点击选范围" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="状态机:第一次点 = Start,第二次点 = End(自动按时间排序),第三次点重置"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Foreground.Link}" Text="Hover 预览" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="Start 选中后,鼠标 hover 哪个日期 → 那段范围淡色高亮预览"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Foreground.Link}" Text="自实现 MonthView" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="放弃 WPF Calendar (SelectionMode 不支持范围语义),Grid 6×7 完全自实现"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Foreground.Link}" Text="17 个开箱即用范围" />
                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                       Foreground="{DynamicResource Foreground.Caption}"
                                       Text="今天/昨天/近 N 天/本周/上周/下周/本月/上月/下月/季度/年... PredefinedRanges 可覆盖"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </cy:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>