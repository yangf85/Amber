<!-- 3. 列头排序（code-behind） -->
<ListView ItemsSource="{Binding View}"
          GridViewColumnHeader.Click="OnSortHeaderClick" />

private void OnSortHeaderClick(object sender, RoutedEventArgs e)
{
    var header = e.OriginalSource as GridViewColumnHeader;
    var binding = header.Column.DisplayMemberBinding as Binding;
    var path = binding.Path.Path;
    view.SortDescriptions.Clear();
    view.SortDescriptions.Add(new SortDescription(path,
        ListSortDirection.Ascending));
}

