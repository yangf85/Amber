                                                        Foreground="{DynamicResource Foreground.Default}"
                                                        Text="{Binding FullName}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Foreground.Caption}"
                                                        Text="{Binding Email}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!--  城市 + 国家  -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Foreground.Link}"
                                                        Text="{Binding City}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Foreground.Caption}"
                                                        Text="{Binding Country}" />
                                                </StackPanel>

                                                <!--  年龄  -->
                                                <StackPanel
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource Foreground.Caption}"
                                                        Text="年龄" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Foreground.Default}"
                                                        Text="{Binding Age}" />
                                                </StackPanel>

                                                <!--  状态标  -->
                                                <Border
                                                    Grid.Column="4"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Background.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                    <Setter Property="Background" Value="{DynamicResource Background.Error}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                    <Setter Property="Background" Value="{DynamicResource Background.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding Status}" />
                                                </Border>

                                                <!--  验证  -->
                                                <StackPanel
                                                    Grid.Column="5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <Border Width="22" Height="22">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Background.Error}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Background.Success}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="White">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="✗" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                                            <Setter Property="Text" Value="✓" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        HorizontalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource Foreground.Caption}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="未验证" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                                        <Setter Property="Text" Value="已验证" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock
                                    Margin="0,12,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="实现要点：CollectionViewSource.GetDefaultView(_data) 取默认视图 → 设置 Filter 委托 + SortDescriptions + GroupDescriptions。属性变化时调 Refresh() 重新过滤；分组通过 GroupStyle.HeaderTemplate 渲染分组头。" />
                            </StackPanel>
                        </cy:Card>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>