                <!--  ====================================================  -->
                <!--  Tab 2：完整业务示例（保留过滤排序分组功能）  -->
                <!--  ====================================================  -->
                <TabItem Header="完整业务示例">

                    <Grid Margin="0,16,0,0">
                        <cy:Card>
                            <cy:Card.Header>
                                <cy:CardHeader Title="过滤 / 排序 / 分组" Subtitle="ICollectionView · CollectionViewSource · GroupStyle">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberStyle}">
                                            <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="★" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>

                            <StackPanel>

                                <!--  控制面板  -->
                                <Border
                                    Padding="14"
                                    Background="{DynamicResource Background.Header}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1">
                                    <StackPanel>

                                        <!--  第一行：搜索 + 年龄 + 状态过滤  -->
                                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource Foreground.Default}"
                                                Text="搜索：" />
                                            <TextBox
                                                Width="180"
                                                Margin="0,0,20,0"
                                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource Foreground.Default}"
                                                Text="年龄：" />
                                            <ComboBox
                                                Width="100"
                                                Margin="0,0,20,0"
                                                ItemsSource="{Binding AgeRanges}"
                                                SelectedItem="{Binding SelectedAgeRange}" />

                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource Foreground.Default}"
                                                Text="状态：" />
                                            <ComboBox
                                                Width="100"
                                                ItemsSource="{Binding StatusFilters}"
                                                SelectedItem="{Binding SelectedStatusFilter}" />
                                        </StackPanel>

                                        <!--  第二行：排序 + 分组 + 清除按钮 + 状态文字  -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource Foreground.Default}"
                                                Text="排序：" />
                                            <ComboBox
                                                Width="100"
                                                Margin="0,0,10,0"
                                                ItemsSource="{Binding SortOptions}"
                                                SelectedItem="{Binding SelectedSortOption}" />

                                            <CheckBox
                                                Margin="0,0,20,0"
                                                VerticalAlignment="Center"
                                                Content="降序"
                                                IsChecked="{Binding IsDescending}" />

                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource Foreground.Default}"
                                                Text="分组：" />
                                            <ComboBox
                                                Width="100"
                                                Margin="0,0,20,0"
                                                ItemsSource="{Binding GroupOptions}"
                                                SelectedItem="{Binding SelectedGroupOption}" />

                                            <Button
                                                Margin="0,0,20,0"
                                                Padding="14,6"
                                                Command="{Binding ClearFiltersCommand}"
                                                Content="清除过滤" />

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Foreground.Link}"
                                                Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  表头  -->
                                <Border
                                    Margin="0,12,0,0"
                                    Padding="10,8"
                                    Background="{DynamicResource Background.Header}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1">
                                    <Grid Margin="6,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="头像" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="姓名 / 邮箱" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="地址信息" />
                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="年龄" />
                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="状态" />
                                        <TextBlock
                                            Grid.Column="5"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="验证" />
                                    </Grid>
                                </Border>

                                <!--  ListBox  -->
                                <ListBox
                                    Height="500"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding FilteredData}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    SelectedItem="{Binding SelectedAdvancedPerson}">

                                    <!--  分组样式  -->
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,8" Background="{DynamicResource Background.Highlighted}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="{Binding Name}" />
                                                            <TextBlock
                                                                Margin="6,0,0,0"
                                                                FontFamily="Consolas"
                                                                FontSize="11"
                                                                Foreground="#E6FFFFFF"
                                                                Text="{Binding ItemCount, StringFormat=' ({0} 项)'}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>

                                    <!--  ItemTemplate  -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <!--  头像  -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="32"
                                                    Height="32"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Background.Info}">
                                                    <TextBlock
