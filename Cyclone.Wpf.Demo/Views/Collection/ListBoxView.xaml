<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.ListBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hp="clr-namespace:Cyclone.Wpf.Helpers;assembly=Cyclone.Wpf"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ListBoxViewModel}"
    d:DesignHeight="2200"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <local:AgeGroupConverter x:Key="AgeGroupConverter" />
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Grid>
                            <!--  列表图标  -->
                            <Path
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M3,5 L21,5 M3,12 L21,12 M3,19 L21,19"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2.5" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="ListBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 原生控件 · 主题样式" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="列表选择控件——单选 / 多选 / 扩展选择，本库提供 WinUI 3 风格主题样式（左 3px 竖条选中指示器 + 整行 hover/选中 + 文字不反色），并通过 ListBoxHelper 附加属性提供(全选)扩展能力。配合 ICollectionView 可实现过滤、排序、分组。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ TabControl ============  -->
            <TabControl Grid.Row="1" Background="Transparent">

                <!--  ====================================================  -->
                <!--  Tab 1：基础用法（4 章节展示控件本身能力）  -->
                <!--  ====================================================  -->
                <TabItem Header="基础用法">

                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  主体两列  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  ===== 左列 =====  -->
                            <StackPanel Grid.Column="0">

                                <!--  ① 基础用法 + 单选  -->
                                <cy:Card Margin="0,0,0,20">
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="基础用法" Subtitle="ItemsSource + SelectedItem">
                                            <cy:CardHeader.Icon>
                                                <Border Style="{StaticResource SectionNumberStyle}">
                                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                                </Border>
                                            </cy:CardHeader.Icon>
                                        </cy:CardHeader>
                                    </cy:Card.Header>

                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,12"
                                            FontSize="13"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="DisplayMemberPath 直接显示数据对象的某个属性。SelectedItem 双向绑定到 ViewModel——选中变化实时反映。" />

                                        <ListBox
                                            Height="240"
                                            DisplayMemberPath="FullName"
                                            ItemsSource="{Binding BasicData}"
                                            SelectedItem="{Binding SelectedBasicPerson}" />

                                        <Border
                                            Margin="0,12,0,0"
                                            Padding="12,10"
                                            Background="{DynamicResource Background.Header}"
                                            BorderBrush="{DynamicResource Border.Default}"
                                            BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource Foreground.Default}"
                                                    Text="当前选中：" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueLabelStyle}">
                                                    <Run Text="FullName = " />
                                                    <Run
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Foreground.Link}"
                                                        Text="{Binding SelectedBasicPerson.FullName, Mode=OneWay, FallbackValue=（无）}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </cy:Card>

                                <!--  ② SelectionMode  -->
                                <cy:Card>
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="SelectionMode" Subtitle="Single / Multiple / Extended">
                                            <cy:CardHeader.Icon>
                                                <Border Style="{StaticResource SectionNumberStyle}">
                                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                                </Border>
                                            </cy:CardHeader.Icon>
                                        </cy:CardHeader>
                                    </cy:Card.Header>

                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,12"
                                            FontSize="13"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="三种选择模式：Single（单选，默认）/ Multiple（多选，单击切换）/ Extended（扩展，Ctrl/Shift 配合）。" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Single" />
                                                <ListBox
                                                    Height="220"
                                                    ItemsSource="{Binding Fruits}"
                                                    SelectionMode="Single" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Multiple（单击切换）" />
                                                <ListBox
                                                    Height="220"
                                                    hp:ListBoxHelper.SelectedItems="{Binding SelectedFruits}"
                                                    ItemsSource="{Binding Fruits}"
                                                    SelectionMode="Multiple" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Extended（Ctrl / Shift）" />
                                                <ListBox
                                                    Height="220"
                                                    ItemsSource="{Binding Fruits}"
                                                    SelectionMode="Extended" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  Multiple 列实时选中显示 — 通过 hp:ListBoxHelper.SelectedItems 双向绑定  -->
                                        <Border
                                            Margin="0,16,0,0"
                                            Padding="14,12"
                                            Background="{DynamicResource Background.Header}"
                                            BorderBrush="{DynamicResource Border.Default}"
                                            BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="12"
                                                        FontWeight="Medium"
                                                        Foreground="{DynamicResource Foreground.Default}"
                                                        Text="Multiple 列实时选中：" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource ValueLabelStyle}">
                                                        <Run Text="共 " />
                                                        <Run
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource Foreground.Link}"
                                                            Text="{Binding SelectedFruits.Count, Mode=OneWay, FallbackValue=0}" />
                                                        <Run Text=" 项" />
                                                    </TextBlock>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding SelectedFruits}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="0,2,6,2"
                                                                Padding="10,4"
                                                                Background="{DynamicResource Background.Info}">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="Medium"
                                                                    Foreground="White"
                                                                    Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!--  空状态提示 — DataTrigger 控制可见性  -->
                                                <TextBlock
                                                    FontSize="11"
                                                    FontStyle="Italic"
                                                    Foreground="{DynamicResource Foreground.Caption}"
                                                    Text="（点击中间列选择水果，这里会实时同步）">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedFruits.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock
                                            Margin="0,12,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="键盘：↑/↓ 移动焦点，Space 切换选中（Multiple/Extended），Ctrl+A 全选（Extended）。"
                                            TextWrapping="Wrap" />

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="实现方式：hp:ListBoxHelper.SelectedItems=&quot;{Binding SelectedFruits}&quot; — 本库附加属性双向同步，纯 MVVM，无需 code-behind。要求 ViewModel 集合类型实现 INotifyCollectionChanged（推荐 ObservableCollection）。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </cy:Card>
                            </StackPanel>

                            <!--  ===== 右列 =====  -->
                            <StackPanel Grid.Column="2">

                                <!--  ③ IsSelectAllEnabled（本库扩展）  -->
                                <cy:Card Margin="0,0,0,20">
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="全选 CheckBox" Subtitle="本库扩展：ListBoxHelper.IsSelectAllEnabled">
                                            <cy:CardHeader.Icon>
                                                <Border Style="{StaticResource SectionNumberStyle}">
                                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                                </Border>
                                            </cy:CardHeader.Icon>
                                        </cy:CardHeader>
                                    </cy:Card.Header>

                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,12"
                                            FontSize="13"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="设置附加属性 hp:ListBoxHelper.IsSelectAllEnabled=True 自动启用顶部(选择全部) CheckBox + 每行前的选择框列。三态联动（部分选中显示半选）。" />

                                        <CheckBox
                                            Margin="0,0,0,8"
                                            Content="启用全选 CheckBox"
                                            IsChecked="{Binding IsSelectAllEnabled, Mode=TwoWay}" />

                                        <ListBox
                                            Height="260"
                                            hp:ListBoxHelper.IsSelectAllEnabled="{Binding IsSelectAllEnabled}"
                                            ItemsSource="{Binding Permissions}"
                                            SelectionMode="Multiple" />

                                        <TextBlock
                                            Margin="0,12,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="必须配合 SelectionMode=Multiple 或 Extended——单选模式下(全选)无意义。" />
                                    </StackPanel>
                                </cy:Card>

                                <!--  ④ DataTemplate 自定义项  -->
                                <cy:Card>
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="DataTemplate" Subtitle="自定义 ItemTemplate">
                                            <cy:CardHeader.Icon>
                                                <Border Style="{StaticResource SectionNumberStyle}">
                                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                                </Border>
                                            </cy:CardHeader.Icon>
                                        </cy:CardHeader>
                                    </cy:Card.Header>

                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,12"
                                            FontSize="13"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="ItemTemplate 决定每行内容的渲染——头像 + 多行文本 + 状态标。整行选中视觉由控件主题样式提供（无需在模板里写 trigger）。" />

                                        <ListBox
                                            Height="320"
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{Binding TemplateSample}"
                                            SelectedItem="{Binding SelectedTemplatePerson}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  头像（首字母）  -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="36"
                                                            Height="36"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource Background.Info}">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="{Binding FirstName}" />
                                                        </Border>

                                                        <!--  姓名 + 邮箱  -->
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Foreground.Default}"
                                                                Text="{Binding FullName}" />
                                                            <TextBlock
                                                                Margin="0,2,0,0"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource Foreground.Caption}"
                                                                Text="{Binding Email}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!--  状态标  -->
                                                        <Border
                                                            Grid.Column="2"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource Background.Header}"
                                                            BorderBrush="{DynamicResource Border.Default}"
                                                            BorderThickness="1">
                                                            <TextBlock
                                                                FontFamily="Consolas"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource Foreground.Caption}"
                                                                Text="{Binding Status}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </cy:Card>
                            </StackPanel>
                        </Grid>

                        <!--  ============ 底部：属性表 ============  -->
                        <cy:Card Grid.Row="1" Margin="0,20,0,20">
                            <cy:Card.Header>
                                <cy:CardHeader Title="ListBox 主要属性 / 附加属性">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberStyle}">
                                            <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>

                            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Grid.ColumnSpan="3"
                                        Background="{DynamicResource Background.Header}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableHeaderStyle}"
                                        Text="名称" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableHeaderStyle}"
                                        Text="类型 / 来源" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableHeaderStyle}"
                                        Text="说明" />
                                    <Border
                                        Grid.Row="0"
                                        Grid.ColumnSpan="3"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource Border.Default}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableNameStyle}"
                                        Text="ItemsSource" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableTypeStyle}"
                                        Text="IEnumerable" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableCellStyle}"
                                        Text="数据源（继承自 ItemsControl）。绑定 ICollectionView 时支持过滤 / 排序 / 分组。" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableNameStyle}"
                                        Text="DisplayMemberPath" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableTypeStyle}"
                                        Text="string" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableCellStyle}"
                                        Text="不写 ItemTemplate 时直接显示数据对象的某个属性。和 ItemTemplate 互斥。" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableNameStyle}"
                                        Text="ItemTemplate" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableTypeStyle}"
                                        Text="DataTemplate" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableCellStyle}"
                                        Text="自定义每项的渲染。整行选中视觉由控件主题样式提供——模板内不要写选中态 trigger。" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableNameStyle}"
                                        Text="SelectedItem / SelectedIndex" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableTypeStyle}"
                                        Text="object / int (TwoWay)" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableCellStyle}"
                                        Text="单选模式当前选中。可写——直接 TwoWay 绑回 ViewModel（与 TreeView 不同）。" />

                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableNameStyle}"
                                        Text="SelectedItems" />
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableTypeStyle}"
                                        Text="IList (只读)" />
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableCellStyle}"
                                        Text="多选模式所有选中项。原生 DP 没有 setter，不能直接 TwoWay 绑——MVVM 时用本库 hp:ListBoxHelper.SelectedItems 附加属性桥接。" />

                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableNameStyle}"
                                        Text="SelectionMode" />
                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableTypeStyle}"
                                        Text="SelectionMode" />
                                    <TextBlock
                                        Grid.Row="6"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableCellStyle}"
                                        Text="Single（默认）/ Multiple（单击切换）/ Extended（Ctrl+Shift 经典桌面模式）。" />

                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="0"
                                        Style="{StaticResource PropTableNameStyle}"
                                        Text="ItemContainerStyle" />
                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        Style="{StaticResource PropTableTypeStyle}"
                                        Text="Style" />
                                    <TextBlock
                                        Grid.Row="7"
                                        Grid.Column="2"
                                        Style="{StaticResource PropTableCellStyle}"
                                        Text="ListBoxItem 容器样式。MVVM 把 IsSelected 双向绑定到模型常用此入口。" />

                                    <TextBlock
