<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.CarouselSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:CarouselViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  Carousel Item 模板——图片 + 渐变遮罩 + 标题副标题  -->
        <DataTemplate x:Key="CarouselItemTemplate" DataType="{x:Type local:ImageViewModel}">
            <Grid>
                <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                <Border Height="100" VerticalAlignment="Bottom">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#CC000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Margin="24,0,24,20" VerticalAlignment="Bottom">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding MainTitle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="#E6FFFFFF"
                        Text="{Binding SubTitle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Grid>
                            <!--  幻灯片图标：方框 + 内部三条横线  -->
                            <Path
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M3,5 L21,5 L21,17 L3,17 Z M7,9 L17,9 M7,13 L13,13"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Carousel" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="轮播图——继承自 ListBox，平滑 slide 动画 + 自动播放 + 左右导航按钮 + 指示器。支持循环播放（IsRepeatPlayback）和 wrap 倒带动画（IsWrapAnimated）。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法" Subtitle="ItemsSource + 左右导航 + 指示器">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="点击左右箭头切换，或点底部圆点指示器跳转。相邻切换播放 200ms slide 动画。" />

                            <cy:Carousel
                                Height="320"
                                ItemTemplate="{StaticResource CarouselItemTemplate}"
                                ItemsSource="{Binding BasicSample}" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 自动播放  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="自动播放" Subtitle="AutoPlay + AutoPlayInterval">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="AutoPlay=true + AutoPlayInterval=2s——每 2 秒自动滑到下一张。Items.Count ≤ 1 时 timer 自动停止，Unloaded 时也会停。" />

                            <cy:Carousel
                                Height="280"
                                AutoPlay="True"
                                AutoPlayInterval="0:0:2"
                                ItemTemplate="{StaticResource CarouselItemTemplate}"
                                ItemsSource="{Binding AutoPlaySample}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="提示：手动点导航按钮或指示器不会暂停 timer——如需(hover 暂停)行为请在外部 trigger 控制 AutoPlay 属性。" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ Wrap 倒带动画  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="Wrap 倒带动画" Subtitle="IsRepeatPlayback + IsWrapAnimated">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="IsWrapAnimated=true——末项→首项（或反向）时播放跨多项的 slide，视觉上是(倒带)效果。默认 false 时硬切定位。仅当 IsRepeatPlayback=true 时生效。" />

                            <cy:Carousel
                                Height="280"
                                AnimationDuration="0:0:0.6"
                                IsRepeatPlayback="True"
                                IsWrapAnimated="True"
                                ItemTemplate="{StaticResource CarouselItemTemplate}"
                                ItemsSource="{Binding WrapSample}" />

                            <Border
                                Margin="0,16,0,0"
                                Padding="12,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="动画规则速查" />
                                    <UniformGrid Margin="0,8,0,0" Columns="1">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="相邻切换" />
                                            <Run Text="——播放标准 slide 动画（一个 item 宽度）" />
                                        </TextBlock>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="跨多项跳转（点指示器）" />
                                            <Run Text="——直接定位，无动画" />
                                        </TextBlock>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}">
                                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Wrap（首↔尾）" />
                                            <Run Text="——IsWrapAnimated=true 时倒带动画，否则硬切" />
                                        </TextBlock>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ MVVM 双向绑定  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="MVVM 双向绑定" Subtitle="SelectedIndex / SelectedItem TwoWay">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="外部按钮控制 + SelectedIndex 实时反映" />

                            <cy:Carousel
                                x:Name="MvvmCarousel"
                                Height="240"
                                ItemTemplate="{StaticResource CarouselItemTemplate}"
                                ItemsSource="{Binding ShowcaseSample}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button
                                        Padding="14,6"
                                        Command="{x:Static cy:Carousel.PrevCommand}"
                                        CommandTarget="{Binding ElementName=MvvmCarousel}"
                                        Content="◀  Prev" />
                                    <Button
                                        Margin="8,0,0,0"
                                        Padding="14,6"
                                        Command="{x:Static cy:Carousel.NextCommand}"
                                        CommandTarget="{Binding ElementName=MvvmCarousel}"
                                        Content="Next  ▶" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="SelectedIndex:" />
                                        <Run
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground.Link}"
                                            Text="{Binding SelectedIndex, ElementName=MvvmCarousel, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="MainTitle:" />
                                        <Run
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground.Link}"
                                            Text="{Binding SelectedItem.MainTitle, ElementName=MvvmCarousel, Mode=OneWay, FallbackValue=-}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="外部 Button 通过 Carousel.PrevCommand / NextCommand 静态 RoutedCommand 控制——CommandTarget 指向具体 Carousel 实例。" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="常见使用场景">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <UniformGrid Columns="2" Rows="2">

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M3,3 L21,3 L21,21 L3,21 Z M3,16 L9,10 L13,14 L17,9 L21,13"
                                        Stroke="{DynamicResource Foreground.Warning}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.5" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="首页 Banner" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="AutoPlay=true、3~5s 间隔、IsRepeatPlayback=true。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M5,3 L19,3 L19,21 L5,21 Z M9,7 L15,7 M9,11 L15,11 M9,15 L13,15"
                                        Stroke="{DynamicResource Foreground.Link}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.5" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="产品介绍" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="AutoPlay=false——用户主导节奏，搭配指示器跳转。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M2,7 L22,7 L20,17 L4,17 Z M9,11 L15,11"
                                        Stroke="{DynamicResource Foreground.Success}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.5" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="图片画廊" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="IsWrapAnimated=true 倒带动画，AnimationDuration 调慢观感更佳。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,6">
                                <StackPanel>
                                    <Path
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        Data="M4,4 L20,4 L20,20 L4,20 Z M4,4 L20,20 M20,4 L4,20"
                                        Stroke="#8B5CF6"
                                        StrokeThickness="1.5" />
                                    <TextBlock
                                        Margin="0,8,0,4"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="新手引导" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="IsRepeatPlayback=false——走完最后一页 Next 自动禁用。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                        </UniformGrid>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  ============ 底部：属性表 + 代码示例 + 设计要点 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ⑥ 主要属性  -->
                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="Carousel 主要属性">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="属性 / 命令" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="ItemsSource" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="IEnumerable" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="数据源（继承自 ItemsControl）。多个 Carousel 共享同一集合时会通过 default ICollectionView 同步选中——demo 里每个 sample 都用独立 ObservableCollection 实例。" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="SelectedIndex / SelectedItem" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="int / object (TwoWay)" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="当前显示项的索引 / 对象（继承自 Selector）。改变时触发 slide 动画或直接定位。" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="IsEnableAnimation" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="bool" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="是否启用切换动画。默认 true。设为 false 时所有切换都是硬切。" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="AnimationDuration" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="Duration" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="切换动画时长。默认 200ms。SineEase EaseInOut。" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="IsRepeatPlayback" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="bool" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="是否循环播放——到末尾后跳回开头。默认 true。设为 false 时 Prev/Next 命令在两端会自动 Disable。" />

                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="IsWrapAnimated" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="bool" />
                            <TextBlock
                                Grid.Row="6"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="循环 wrap 跳转（首↔尾）是否播放动画。默认 false 直接定位。true 时播放跨多项的 slide 倒带动画。仅 IsRepeatPlayback + IsEnableAnimation 都 true 时生效。" />

                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="AutoPlay" />
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="bool" />
                            <TextBlock
                                Grid.Row="7"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="是否自动播放。默认 false。Items.Count ≤ 1 时 timer 自动停止，Unloaded 时也会停。" />

                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="AutoPlayInterval" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="TimeSpan" />
                            <TextBlock
                                Grid.Row="8"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="自动播放间隔。默认 3s。运行时改变会重启 timer 让新值立即生效。" />

                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="FunctionBar" />
                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="object" />
                            <TextBlock
                                Grid.Row="9"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="模板上 PART_FunctionBar 区域的内容，用于注入操作按钮（收藏 / 分享等）。" />

                            <TextBlock
                                Grid.Row="10"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="NavigationBar" />
                            <TextBlock
                                Grid.Row="10"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="object" />
                            <TextBlock
                                Grid.Row="10"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="模板上 PART_NavigationBar 区域的内容，可替换默认指示器。变化时对称 Remove/Add 到 logical tree。" />

                            <TextBlock
                                Grid.Row="11"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="PrevCommand / NextCommand" />
                            <TextBlock
                                Grid.Row="11"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="static RoutedCommand" />
                            <TextBlock
                                Grid.Row="11"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="上一项 / 下一项命令。CanExecute 自动按 IsRepeatPlayback 和 SelectedIndex 计算。外部按钮通过 CommandTarget 绑定。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <!--  ⑦ XAML 示例 + ⑧ 设计要点  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                            <![CDATA[<!-- 基础 -->
<cy:Carousel
    Height="320"
    ItemsSource="{Binding Images}"
    ItemTemplate="{StaticResource CarouselItemTemplate}" />

<!-- 自动播放 -->
<cy:Carousel
    AutoPlay="True"
    AutoPlayInterval="0:0:3"
    ItemsSource="{Binding Images}"
    ItemTemplate="{StaticResource CarouselItemTemplate}" />

<!-- Wrap 倒带动画 -->
<cy:Carousel
    IsRepeatPlayback="True"
    IsWrapAnimated="True"
    AnimationDuration="0:0:0.6"
    ItemsSource="{Binding Images}"
    ItemTemplate="{StaticResource CarouselItemTemplate}" />

<!-- 外部按钮 -->
<cy:Carousel x:Name="MyCarousel"
             ItemsSource="{Binding Images}" />
<Button Content="Prev"
        Command="{x:Static cy:Carousel.PrevCommand}"
        CommandTarget="{Binding ElementName=MyCarousel}" />
<Button Content="Next"
        Command="{x:Static cy:Carousel.NextCommand}"
        CommandTarget="{Binding ElementName=MyCarousel}" />]]>
                        </TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="独立集合实例" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="共享集合会让多个 Carousel 通过 default CollectionView CurrentItem 同步选中——每个用独立实例。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="动画隔离" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="相邻才有 slide 动画。跨多项跳转直接定位。Wrap 由 IsWrapAnimated 决定走哪条路径。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="冒泡拦截" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="内部 RequestBringIntoView 不冒泡——避免外层 ScrollViewer 自动跳到 Carousel 位置。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="资源回收" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Unloaded 时停止 timer + storyboard，解绑所有事件——避免 detached visual 上动画继续 tick。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>