<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.DataGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance local:DataGridViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="10">
        <cy:SpacingStackPanel Spacing="10">
            <GroupBox Header="Pagination">
                <StackPanel>
                    <DataGrid
                        Height="300"
                        cy:DataGridHelper.SelectedItems="{Binding SelectedItems}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding Pagination.Data}"
                        SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding FirstName}" Header="First Name" />
                            <DataGridTextColumn
                                Binding="{Binding LastName}"
                                EditingElementStyle="{StaticResource DataGrid.EditingTextBox.Style}"
                                Header="Last Name" />
                            <DataGridTextColumn
                                Binding="{Binding Age}"
                                EditingElementStyle="{StaticResource DataGrid.EditingTextBox.Style}"
                                Header="Age" />
                            <DataGridTextColumn Binding="{Binding Email}" Header="Email" />
                            <DataGridTextColumn Binding="{Binding Address}" Header="Address" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding City}"
                                Header="City" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Lorem}" />
                                    <TextBlock Text="{Binding DateOfBirth}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <cy:Pagination
                        Margin="0,5,0,0"
                        ItemCount="{Binding Pagination.Total}"
                        PerpageCount="{Binding Pagination.PerPageCount}"
                        PageIndex="{Binding Pagination.PageIndex}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                Grid.Column="1"
                Margin="10,0,0,0"
                Header="Validation Test">
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding MockData}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            EditingElementStyle="{StaticResource DataGrid.EditingTextBox.Style}"
                            Header="名称" />
                        <DataGridCheckBoxColumn Binding="{Binding Gender}" Header="性别" />
                        <DataGridTextColumn Binding="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Header="年龄" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Status}"
                            Header="状态"
                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </cy:SpacingStackPanel>
    </Grid>
</UserControl>