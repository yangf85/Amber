            <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                <![CDATA[<!-- 静态 -->
<TreeView>
    <TreeViewItem Header="Root" IsExpanded="True">
        <TreeViewItem Header="Child A" />
        <TreeViewItem Header="Child B" />
    </TreeViewItem>
</TreeView>

<!-- HierarchicalDataTemplate -->
<TreeView ItemsSource="{Binding Roots}">
    <TreeView.Resources>
        <HierarchicalDataTemplate
            DataType="{x:Type local:FileNode}"
            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path ... />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </TreeView.Resources>
</TreeView>

<!-- 双向绑定 IsExpanded / IsSelected (MVVM 关键) -->
<Style x:Key="BoundItemStyle" TargetType="TreeViewItem">
    <Setter Property="IsExpanded"
            Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="IsSelected"
            Value="{Binding IsSelected, Mode=TwoWay}" />
</Style>

<TreeView ItemContainerStyle="{StaticResource BoundItemStyle}"
          ItemsSource="{Binding Roots}" />

<!-- 多类型分发 — 按 DataType 自动选模板 -->
<HierarchicalDataTemplate DataType="{x:Type local:DepartmentNode}"
                          ItemsSource="{Binding Children}"> ... </HierarchicalDataTemplate>
<HierarchicalDataTemplate DataType="{x:Type local:EmployeeNode}"
                          ItemsSource="{Binding Children}"> ... </HierarchicalDataTemplate>]]>
