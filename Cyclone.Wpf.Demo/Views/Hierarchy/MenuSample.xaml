            <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                <![CDATA[<!-- 经典 Menu 栏 -->
<Menu>
    <MenuItem Header="文件(_F)">
        <MenuItem
            Command="{Binding NewFileCommand}"
            Header="新建"
            InputGestureText="Ctrl+N">
            <MenuItem.Icon>
                <Path Data="M12,5 L12,19 M5,12 L19,12" ... />
            </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="退出" InputGestureText="Alt+F4" />
    </MenuItem>
</Menu>

<!-- IsCheckable 勾选项 -->
<MenuItem
    Header="显示工具栏"
    IsCheckable="True"
    IsChecked="{Binding ShowToolbar, Mode=TwoWay}" />

<!-- 嵌套子菜单 (自动应用 SubmenuHeader 模板) -->
<MenuItem Header="导出">
    <MenuItem Header="文档">
        <MenuItem Header="PDF" />
        <MenuItem Header="Word" />
    </MenuItem>
</MenuItem>

<!-- ContextMenu 直接挂 -->
<Button Content="右键我">
    <Button.ContextMenu>
        <ContextMenu>
            <MenuItem Header="操作 A" Command="..." />
            <Separator />
            <MenuItem Header="删除" />
        </ContextMenu>
    </Button.ContextMenu>
</Button>

<!-- ContextMenu 数据绑定 — 通过 PlacementTarget 拿宿主 DataContext -->
<Button.ContextMenu>
    <ContextMenu
        DataContext="{Binding PlacementTarget.DataContext,
                              RelativeSource={RelativeSource Self}}"
        ItemsSource="{Binding RecentFiles}">
        <ContextMenu.ItemContainerStyle>
            <Style TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding}" />
                <Setter Property="Command"
                    Value="{Binding DataContext.ExecuteCommand,
                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>
        </ContextMenu.ItemContainerStyle>
    </ContextMenu>
</Button.ContextMenu>]]>
            </TextBox>

