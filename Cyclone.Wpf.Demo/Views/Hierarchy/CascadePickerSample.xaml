                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ItemsSource 设值时递归遍历一次, 按 item / value / path 三张索引表存好祖先链与完整路径, 之后所有同步走 O(1) 字典"
                        TextWrapping="Wrap" />
