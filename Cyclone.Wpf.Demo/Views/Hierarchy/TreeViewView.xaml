<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.TreeViewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:TreeViewViewModel}}"
    d:DesignHeight="2200"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  简单节点模板（只显示 Name）  -->
        <HierarchicalDataTemplate x:Key="SimpleNodeTemplate" DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
        </HierarchicalDataTemplate>

        <!--  复杂节点模板（图标 + 名称 + 数量徽章）  -->
        <HierarchicalDataTemplate x:Key="IconNodeTemplate" DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                <Border
                    Margin="8,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Background.Caption}"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Container}"
                        Text="{Binding Count}" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>

    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Grid>
                            <Path
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M5,4 L5,20 M5,8 L9,8 M5,14 L13,14 M9,12 L9,8 M13,18 L13,14"
                                Stroke="White"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="TreeView" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="基于 WPF 原生 TreeView 的样式覆盖——扁平展开按钮、hover/selected/focused 状态、子节点缩进、自定义 ItemTemplate。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 静态节点  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Subtitle="XAML 直接嵌套 TreeViewItem" Title="静态节点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="最简用法——直接在 XAML 中嵌套 TreeViewItem。适合内容固定、层次明确的场景（设置面板、文档大纲、固定分类）。"
                                TextWrapping="Wrap" />

                            <Border
                                Background="{DynamicResource Background.Default}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <TreeView Height="280" BorderThickness="0">
                                    <TreeViewItem Header="📁 收藏夹" IsExpanded="True">
                                        <TreeViewItem Header="🌐 GitHub" />
                                        <TreeViewItem Header="🌐 Stack Overflow" />
                                        <TreeViewItem Header="🌐 MSDN" />
                                    </TreeViewItem>
                                    <TreeViewItem Header="📁 工具" IsExpanded="True">
                                        <TreeViewItem Header="🔧 Visual Studio" />
                                        <TreeViewItem Header="🔧 Git" />
                                        <TreeViewItem Header="🔧 Notepad++" />
                                    </TreeViewItem>
                                    <TreeViewItem Header="📁 文档" />
                                </TreeView>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 数据驱动 / HierarchicalDataTemplate  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Subtitle="ItemsSource + HierarchicalDataTemplate" Title="数据驱动">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="ItemsSource 绑定 ObservableCollection。HierarchicalDataTemplate 描述每个节点如何渲染、子节点从哪来——TreeView 会递归应用模板到任意深度。"
                                TextWrapping="Wrap" />

                            <Border
                                Background="{DynamicResource Background.Default}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <TreeView
                                    Height="280"
                                    BorderThickness="0"
                                    ItemTemplate="{StaticResource SimpleNodeTemplate}"
                                    ItemsSource="{Binding DataDrivenTree}" />
                            </Border>
                        </StackPanel>
                    </cy:Card>

                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ③ 复杂节点  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Subtitle="DataTemplate 内的 StackPanel + DataTrigger" Title="复杂节点（图标 + 数量徽章）">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="HierarchicalDataTemplate 内可以塞任意 UIElement——StackPanel 横向排列图标、名称、徽章，DataTrigger 隐藏 Count = 0 的徽章。常见场景：文件树、组织架构、分类目录。"
                                TextWrapping="Wrap" />

                            <Border
                                Background="{DynamicResource Background.Default}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <TreeView
                                    Height="320"
                                    BorderThickness="0"
                                    ItemTemplate="{StaticResource IconNodeTemplate}"
                                    ItemsSource="{Binding FileTree}" />
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ④ Selection 跟踪  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Subtitle="SelectedItemChanged → VM" Title="选中节点跟踪">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="TreeView.SelectedItem 是 readonly DP，不能 TwoWay binding——用 SelectedItemChanged 事件在 code-behind 同步到 VM。点击任何节点查看右侧反馈。"
                                TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Background="{DynamicResource Background.Default}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1">
                                    <TreeView
                                        Height="280"
                                        BorderThickness="0"
                                        ItemTemplate="{StaticResource SimpleNodeTemplate}"
                                        ItemsSource="{Binding SelectableTree}"
                                        SelectedItemChanged="OnTreeViewSelectedItemChanged" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Padding="14"
                                    Background="{DynamicResource Background.Header}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="当前选中" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="名称" />
                                        <TextBlock
                                            Margin="0,2,0,12"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            Foreground="{DynamicResource Foreground.Link}"
                                            Text="{Binding SelectedNode.Name, FallbackValue=（未选中）, TargetNullValue=（未选中）}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Caption}"
                                            Text="子节点数" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            Foreground="{DynamicResource Foreground.Link}"
                                            Text="{Binding SelectedNode.Children.Count, FallbackValue=-, TargetNullValue=-}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </cy:Card>

                </StackPanel>
            </Grid>

            <!--  ============ 底部 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ⑤ API 表  -->
                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="关键属性与事件">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="0,0,0,1" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="名称" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类别" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="ItemsSource" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="DP (IEnumerable)" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="数据集合，配合 HierarchicalDataTemplate 实现层级渲染。" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="ItemTemplate" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="DP (DataTemplate)" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="HierarchicalDataTemplate——指定 ItemsSource 让递归生效。" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="SelectedItem" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="DP（只读）" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="不能 TwoWay binding——用 SelectedItemChanged 事件同步。" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="SelectedItemChanged" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="路由事件" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="选中项变化时触发，e.NewValue 是新选中的数据对象。" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Style="{StaticResource PropTableNameStyle}"
                                Text="TreeViewItem.IsExpanded" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource PropTableTypeStyle}"
                                Text="DP" />
                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="2"
                                Style="{StaticResource PropTableCellStyle}"
                                Text="展开状态——可在 ItemContainerStyle 里 TwoWay 绑到 model.IsExpanded。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <!--  ⑥ XAML 示例 + ⑦ 设计要点  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}"><![CDATA[<!-- 静态节点 -->
<TreeView>
    <TreeViewItem Header="📁 工具" IsExpanded="True">
        <TreeViewItem Header="🔧 Visual Studio" />
        <TreeViewItem Header="🔧 Git" />
    </TreeViewItem>
</TreeView>

<!-- 数据驱动 -->
<UserControl.Resources>
    <HierarchicalDataTemplate
        x:Key="NodeTemplate"
        DataType="{x:Type local:TreeNode}"
        ItemsSource="{Binding Children}">
        <TextBlock Text="{Binding Name}" />
    </HierarchicalDataTemplate>
</UserControl.Resources>

<TreeView
    ItemsSource="{Binding RootNodes}"
    ItemTemplate="{StaticResource NodeTemplate}" />

<!-- Selection 跟踪 -->
<TreeView SelectedItemChanged="OnSelectedItemChanged" ... />

// code-behind
private void OnSelectedItemChanged(
    object sender, RoutedPropertyChangedEventArgs<object> e)
{
    if (DataContext is MyVM vm && e.NewValue is TreeNode node)
        vm.SelectedNode = node;
}]]></TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="ClickMode=Press" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="ToggleButton 按下立即展开/折叠，比 Click 跟手"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="三态背景" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="Hover / Selected (active) / Selected (失焦)，跟 Explorer 行为一致"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="叶子占位" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="HasItems=False 时 ToggleButton.Visibility=Hidden 而非 Collapsed——保留 15px 占位让叶子节点跟父项对齐"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="子树缩进" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="ItemsHost.Margin=15,0,0,0——深嵌套时层级清晰"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="不虚拟化" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="ScrollViewer.CanContentScroll=False 走像素滚动，平滑但不支持虚拟化"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
