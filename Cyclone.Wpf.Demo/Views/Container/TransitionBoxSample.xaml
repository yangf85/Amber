<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.TransitionBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  ========== 演示用页面 (Border 资源, 让 codebehind 直接把 Border 实例赋给 TransitionBox.Content) ==========  -->
        <!--  注: 内部 White Foreground 是 内容 - 颜色页 的视觉规约 (类似 Carousel ItemTemplate 文字叠图), 不走主题层  -->
        <Border
            x:Key="Page1"
            Padding="40"
            Background="#3B82F6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Page 1" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.85"
                    Text="蓝色页面" />
            </StackPanel>
        </Border>

        <Border
            x:Key="Page2"
            Padding="40"
            Background="#10B981">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Page 2" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.85"
                    Text="绿色页面" />
            </StackPanel>
        </Border>

        <Border
            x:Key="Page3"
            Padding="40"
            Background="#F59E0B">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Page 3" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.85"
                    Text="橙色页面" />
            </StackPanel>
        </Border>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M5,5 H11 V11 H5 Z M14,14 H20 V20 H14 Z M11,8 L17,8 M14,11 L14,17"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="TransitionBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="内容切换时播放过渡动画的容器控件。内置淡入淡出 / 滑动 / 缩放 / 翻转四种过渡, 通过 ITransition 接口可扩展自定义过渡。所有过渡支持 MarkupExtension 短语法。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="切换页面观察过渡效果 — RadioButton 切 Content, ComboBox 切 Transition, Slider 调 Duration" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="把 Border 资源直接赋给 TransitionBox.Content (codebehind Page1_Checked / Page2_Checked / Page3_Checked); TransitionSelector_SelectionChanged 替换 Transition; DurationSlider_ValueChanged 改 TransitionDuration。所有 Transition 都是 MarkupExtension, 可在 XAML 中以 {cy:Xxx} 短语法直接写。" />

            <cy:TransitionBox
                x:Name="MyTransitionBox"
                Height="200"
                Margin="0,0,0,16"
                Content="{StaticResource Page1}"
                Transition="{cy:FadeTransition}"
                TransitionDuration="0:0:0.5" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Page 切换  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,12">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="切换内容" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Margin="0,0,12,0"
                            Checked="Page1_Checked"
                            Content="Page 1"
                            IsChecked="True" />
                        <RadioButton
                            Margin="0,0,12,0"
                            Checked="Page2_Checked"
                            Content="Page 2" />
                        <RadioButton Checked="Page3_Checked" Content="Page 3" />
                    </StackPanel>
                </StackPanel>

                <!--  过渡选择  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="12,0,0,12">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="过渡效果" />
                    <ComboBox
                        x:Name="TransitionSelector"
                        SelectedIndex="0"
                        SelectionChanged="TransitionSelector_SelectionChanged">
                        <ComboBoxItem Content="Fade" />
                        <ComboBoxItem Content="Slide (Right → Left)" />
                        <ComboBoxItem Content="Slide (Left → Right)" />
                        <ComboBoxItem Content="Slide (Top → Bottom)" />
                        <ComboBoxItem Content="Slide (Bottom → Top)" />
                        <ComboBoxItem Content="Scale" />
                        <ComboBoxItem Content="Flip (Horizontal)" />
                        <ComboBoxItem Content="Flip (Vertical)" />
                    </ComboBox>
                </StackPanel>

                <!--  时长  -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="时长 (ms): " />
                    <Slider
                        x:Name="DurationSlider"
                        Grid.Column="1"
                        Margin="8,0,8,0"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="2000"
                        Minimum="100"
                        TickFrequency="100"
                        ValueChanged="DurationSlider_ValueChanged"
                        Value="500" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat={}{0:F0} ms}" />
                </Grid>
            </Grid>

            <!--  ========== ② 过渡效果对比 ==========  -->
            <cy:SectionHeader
                MainTitle="② 过渡效果对比"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="4 个 TransitionBox 并排, 点底部按钮触发循环切换" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Fade / Slide / Scale / Flip 四种内置过渡的并排对比。每个 TransitionBox 用不同 Transition, 按钮 Click 走 codebehind CycleFade_Click / CycleSlide_Click / CycleScale_Click / CycleFlip_Click 触发 Content 循环。" />

            <UniformGrid Columns="2" Rows="2">
                <!--  Fade  -->
                <StackPanel Margin="0,0,8,12">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Fade" />
                    <cy:TransitionBox
                        x:Name="FadeBox"
                        Height="120"
                        Content="{StaticResource Page1}"
                        Transition="{cy:FadeTransition}"
                        TransitionDuration="0:0:0.4" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Click="CycleFade_Click"
                        Content="切换" />
                </StackPanel>

                <!--  Slide  -->
                <StackPanel Margin="8,0,0,12">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Slide (Right → Left)" />
                    <cy:TransitionBox
                        x:Name="SlideBox"
                        Height="120"
                        Content="{StaticResource Page2}"
                        Transition="{cy:SlideTransition Direction=RightToLeft}"
                        TransitionDuration="0:0:0.4" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Click="CycleSlide_Click"
                        Content="切换" />
                </StackPanel>

                <!--  Scale  -->
                <StackPanel Margin="0,12,8,0">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Scale" />
                    <cy:TransitionBox
                        x:Name="ScaleBox"
                        Height="120"
                        Content="{StaticResource Page3}"
                        Transition="{cy:ScaleTransition}"
                        TransitionDuration="0:0:0.5" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Click="CycleScale_Click"
                        Content="切换" />
                </StackPanel>

                <!--  Flip  -->
                <StackPanel Margin="8,12,0,0">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Flip (Horizontal)" />
                    <cy:TransitionBox
                        x:Name="FlipBox"
                        Height="120"
                        Content="{StaticResource Page1}"
                        Transition="{cy:FlipTransition Orientation=Horizontal}"
                        TransitionDuration="0:0:0.5" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Click="CycleFlip_Click"
                        Content="切换" />
                </StackPanel>
            </UniformGrid>

            <!--  ========== ③ 常见使用场景 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 常见使用场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="TransitionBox 在产品里最常出现的 4 种位置" />

            <UniformGrid Columns="2" Rows="2">
                <Border
                    Margin="0,0,8,8"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,5 H21 V19 H3 Z M3,9 H21 M7,14 H10"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="向导步骤" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="多步表单、注册流程的步骤切换"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,0,0,8"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M5,5 H19 V19 H5 Z M5,12 H19 M12,5 V19"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="标签页内容" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="TabControl 内嵌过渡, 让标签切换更平滑"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,8,8,0"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,12 L9,6 L9,9 L21,9 L21,15 L9,15 L9,18 Z"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="导航容器" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="主内容区根据导航变化平滑切换页面"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,8,0,0"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M5,12 A7,7 0 1 0 12,5 M12,5 L9,8 M12,5 L9,2"
                            Stroke="{DynamicResource Foreground.Info}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="状态切换" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="加载中 / 空状态 / 数据视图三态切换"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  ========== ④ 主要属性 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 主要属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ContentControl 基类 + Transition / Duration 扩展" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="属性" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="默认值" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Content" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="当前内容 (基类成员)。变化时触发过渡动画。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Transition" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="ITransition" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="过渡动画策略。null 时无动画切换。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TransitionDuration" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Duration" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="300ms" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="动画总时长" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsAnimating" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="—" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="只读。当前是否处于过渡动画中。" />
                </Grid>
            </Border>

            <!--  ========== ⑤ 内置过渡 / 短语法 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 内置过渡 / 短语法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="4 种内置 Transition 的 MarkupExtension 写法" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="过渡类型" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="XAML 用法" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Fade" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:FadeTransition}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Slide" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:SlideTransition Direction=RightToLeft}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Scale" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:ScaleTransition}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Flip" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:FlipTransition Orientation=Horizontal}" />
                </Grid>
            </Border>

            <!--  ========== ⑥ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="3 条接口设计取舍" />

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="MarkupExtension" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="所有内置 Transition 都是 MarkupExtension, 可在 XAML 中以 {cy:Xxx} 短语法直接使用, 无需在 Resources 中预先声明。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="可取消" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="快速连续切换 Content 时, 前一次动画自动取消, 避免视觉残留。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="ITransition 接口" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Transition 接口只负责生产 Storyboard, TransitionBox 集中管理动画的启动 / 取消 / 资源清理 — 这种职责分离让自定义过渡只需关注动画本身, 控件库不绑死内置类型。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
