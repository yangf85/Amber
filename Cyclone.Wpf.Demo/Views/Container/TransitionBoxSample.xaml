<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.TransitionBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="2200"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  章节编号小圆圈（放进 CardHeader.Icon 槽用）  -->
        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  小标题  -->
        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  代码块  -->
        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!--  属性表  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  ============ 演示用页面（DataTemplate 在 Content 里通过 string 选择）============  -->
        <!--  注：用 Border 资源而不是 DataTemplate，让 ToggleButton 可以直接把 Border 实例赋给 TransitionBox.Content  -->

        <Border
            x:Key="Page1"
            Padding="40"
            Background="#3B82F6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Page 1" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.85"
                    Text="蓝色页面" />
            </StackPanel>
        </Border>

        <Border
            x:Key="Page2"
            Padding="40"
            Background="#10B981">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Page 2" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.85"
                    Text="绿色页面" />
            </StackPanel>
        </Border>

        <Border
            x:Key="Page3"
            Padding="40"
            Background="#F59E0B">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="Page 3" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Opacity="0.85"
                    Text="橙色页面" />
            </StackPanel>
        </Border>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M5,5 H11 V11 H5 Z M14,14 H20 V20 H14 Z M11,8 L17,8 M14,11 L14,17"
                            Stroke="White"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="TransitionBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="内容切换时播放过渡动画的容器控件。内置淡入淡出 / 滑动 / 缩放 / 翻转四种过渡，通过 ITransition 接口可扩展自定义过渡。所有过渡支持 MarkupExtension 短语法。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法 —— 交互式  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法"
                                           Subtitle="切换页面观察过渡效果">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <!--  TransitionBox 演示区  -->
                            <cy:TransitionBox
                                x:Name="MyTransitionBox"
                                Height="200"
                                Margin="0,0,0,16"
                                Content="{StaticResource Page1}"
                                Transition="{cy:FadeTransition}"
                                TransitionDuration="0:0:0.5" />

                            <!--  控制：页面 + 过渡 + 时长  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Page 切换  -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="切换内容" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            Margin="0,0,12,0"
                                            Checked="Page1_Checked"
                                            Content="Page 1"
                                            IsChecked="True" />
                                        <RadioButton
                                            Margin="0,0,12,0"
                                            Checked="Page2_Checked"
                                            Content="Page 2" />
                                        <RadioButton Checked="Page3_Checked" Content="Page 3" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  过渡选择  -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="过渡效果" />
                                    <ComboBox
                                        x:Name="TransitionSelector"
                                        SelectedIndex="0"
                                        SelectionChanged="TransitionSelector_SelectionChanged">
                                        <ComboBoxItem Content="Fade" />
                                        <ComboBoxItem Content="Slide (Right → Left)" />
                                        <ComboBoxItem Content="Slide (Left → Right)" />
                                        <ComboBoxItem Content="Slide (Top → Bottom)" />
                                        <ComboBoxItem Content="Slide (Bottom → Top)" />
                                        <ComboBoxItem Content="Scale" />
                                        <ComboBoxItem Content="Flip (Horizontal)" />
                                        <ComboBoxItem Content="Flip (Vertical)" />
                                    </ComboBox>
                                </StackPanel>

                                <!--  时长  -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Foreground.Default}"
                                            Text="时长 (ms)：" />
                                        <Slider
                                            x:Name="DurationSlider"
                                            Grid.Column="1"
                                            Margin="8,0,8,0"
                                            VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True"
                                            Maximum="2000"
                                            Minimum="100"
                                            TickFrequency="100"
                                            ValueChanged="DurationSlider_ValueChanged"
                                            Value="500" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground.Link}"
                                            Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat={}{0:F0} ms}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 过渡效果对比  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="过渡效果对比"
                                           Subtitle="点击各卡片底部按钮触发自动循环切换">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <UniformGrid Columns="2" Rows="2">
                            <!--  Fade  -->
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Fade" />
                                <cy:TransitionBox
                                    x:Name="FadeBox"
                                    Height="120"
                                    Content="{StaticResource Page1}"
                                    Transition="{cy:FadeTransition}"
                                    TransitionDuration="0:0:0.4" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="CycleFade_Click"
                                    Content="切换" />
                            </StackPanel>

                            <!--  Slide  -->
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Slide (Right → Left)" />
                                <cy:TransitionBox
                                    x:Name="SlideBox"
                                    Height="120"
                                    Content="{StaticResource Page2}"
                                    Transition="{cy:SlideTransition Direction=RightToLeft}"
                                    TransitionDuration="0:0:0.4" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="CycleSlide_Click"
                                    Content="切换" />
                            </StackPanel>

                            <!--  Scale  -->
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Scale" />
                                <cy:TransitionBox
                                    x:Name="ScaleBox"
                                    Height="120"
                                    Content="{StaticResource Page3}"
                                    Transition="{cy:ScaleTransition}"
                                    TransitionDuration="0:0:0.5" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="CycleScale_Click"
                                    Content="切换" />
                            </StackPanel>

                            <!--  Flip  -->
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Flip (Horizontal)" />
                                <cy:TransitionBox
                                    x:Name="FlipBox"
                                    Height="120"
                                    Content="{StaticResource Page1}"
                                    Transition="{cy:FlipTransition Orientation=Horizontal}"
                                    TransitionDuration="0:0:0.5" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="CycleFlip_Click"
                                    Content="切换" />
                            </StackPanel>
                        </UniformGrid>
                    </cy:Card>

                    <!--  ③ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="常见使用场景">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <UniformGrid Columns="4" Rows="1">
                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M3,5 H21 V19 H3 Z M3,9 H21 M7,14 H10"
                                        Stroke="{DynamicResource Foreground.Link}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="向导步骤" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="多步表单、注册流程的步骤切换"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M5,5 H19 V19 H5 Z M5,12 H19 M12,5 V19"
                                        Stroke="{DynamicResource Foreground.Success}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="标签页内容" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="TabControl 内嵌过渡，让标签切换更平滑"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M3,12 L9,6 L9,9 L21,9 L21,15 L9,15 L9,18 Z"
                                        Stroke="{DynamicResource Foreground.Warning}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="导航容器" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="主内容区根据导航变化平滑切换页面"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M5,12 A7,7 0 1 0 12,5 M12,5 L9,8 M12,5 L9,2"
                                        Stroke="#8B5CF6"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeThickness="1.8" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="状态切换" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="加载中 / 空状态 / 数据视图三态切换"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                        </UniformGrid>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ TransitionBox 主要属性  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="TransitionBox 主要属性">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="4"
                                    Background="{DynamicResource Background.Header}" />

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="属性" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="默认值" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="4"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Border.Default}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Content" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="当前内容（基类成员）。变化时触发过渡动画。" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Transition" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="ITransition" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="过渡动画策略。null 时无动画切换。" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TransitionDuration" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Duration" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="300ms" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="动画总时长" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsAnimating" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="—" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="只读。当前是否处于过渡动画中。" />
                            </Grid>
                        </Border>
                    </cy:Card>

                    <!--  ⑤ 内置过渡  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="内置过渡 / 短语法">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Background="{DynamicResource Background.Header}" />

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="过渡类型" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="XAML 用法" />

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Border.Default}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Fade" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:FadeTransition}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Slide" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:SlideTransition Direction=RightToLeft}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Scale" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:ScaleTransition}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Flip" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="{}{cy:FlipTransition Orientation=Horizontal}" />
                            </Grid>
                        </Border>
                    </cy:Card>

                    <!--  ⑥ XAML 示例 + ⑦ 设计要点  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <cy:Card Grid.Column="0">
                            <cy:Card.Header>
                                <cy:CardHeader Title="XAML 示例">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberStyle}">
                                            <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>
                            <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                                <![CDATA[<cy:TransitionBox
    Content="{Binding CurrentPage}"
    Transition="{cy:SlideTransition Direction=RightToLeft}"
    TransitionDuration="0:0:0.4" />

<!-- 翻转，垂直方向 -->
<cy:TransitionBox
    Transition="{cy:FlipTransition Orientation=Vertical}"
    TransitionDuration="0:0:0.6" />

<!-- 自定义过渡：实现 ITransition 接口即可 -->
<cy:TransitionBox
    Transition="{StaticResource MyCustomTransition}" />]]>
                            </TextBox>
                        </cy:Card>

                        <cy:Card Grid.Column="2">
                            <cy:Card.Header>
                                <cy:CardHeader Title="设计要点">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberStyle}">
                                            <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>

                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="MarkupExtension" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="所有内置 Transition 都是 MarkupExtension，可在 XAML 中以 {cy:Xxx} 短语法直接使用，无需在 Resources 中预先声明。"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="可取消" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="快速连续切换 Content 时，前一次动画自动取消，避免视觉残留。"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="ITransition" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="实现接口即可扩展自定义过渡，控件库不绑死内置类型。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </cy:Card>
                    </Grid>
                </StackPanel>
            </Grid>

            <!--  ============ 底部 Tip ============  -->
            <Border
                Grid.Row="2"
                Margin="0,20,0,0"
                Padding="16,12"
                Background="{DynamicResource Background.Info}"
                BorderBrush="{DynamicResource Border.Info}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Background.Highlighted}"
                        CornerRadius="999">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="i" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="White">
                        <Run Text="Transition 接口只负责生产 Storyboard，TransitionBox 集中管理动画的启动 / 取消 / 资源清理——这种职责分离让自定义过渡只需关注动画本身。" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>