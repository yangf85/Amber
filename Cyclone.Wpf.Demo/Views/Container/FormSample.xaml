<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.FormSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hp="clr-namespace:Cyclone.Wpf.Demo.Helper"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:FormViewModel}"
    d:DesignHeight="2400"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4,5 L20,5 M4,10 L14,10 M4,15 L20,15 M4,20 L12,20"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Form" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="表单控件族 — FormItem (标签 + 控件单元) / Form (容器 + Header + Footer + FormSeperater) / 附加属性写法 (cy:Form.Label / Description / IsRequired)。配合 SharedSizeScope + SharedName 自动对齐标签列宽度,支持 IDataErrorInfo 校验红边提示。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 独立 FormItem ==========  -->
            <cy:SectionHeader
                MainTitle="① 独立 FormItem"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="不放 Form 容器, 也能用" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="FormItem 自己就是一个完整的 标签 + 控件 单元。多个 FormItem 共用同一 SharedName 时, 标签列会自动对齐 (依赖 Grid.IsSharedSizeScope=True)。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <cy:SpacingStackPanel Grid.IsSharedSizeScope="True" Spacing="8">
                    <cy:FormItem Label="姓名:" SharedName="Demo">
                        <TextBox />
                    </cy:FormItem>
                    <cy:FormItem Label="性别:" SharedName="Demo">
                        <TextBox />
                    </cy:FormItem>
                </cy:SpacingStackPanel>
            </Border>

            <!--  ========== ② Form 容器: 显式 FormItem 写法 ==========  -->
            <cy:SectionHeader
                MainTitle="② Form 容器: 显式 FormItem 写法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="cy:Form 自带 SharedSizeScope, 子项写 FormItem + FormSeperater" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="把字段全部写成 cy:FormItem 显式子节点。LabelHorizontalAlignment / IsSyncLabelHorizontalAlignment 在容器上设一次, 全部子项跟随。FormSeperater 用来插入分组小标题, 自带分隔线。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <cy:Form
                    BorderThickness="0"
                    IsSyncLabelHorizontalAlignment="True"
                    LabelHorizontalAlignment="Left">
                    <cy:FormItem
                        Description="这是一个描述"
                        IsRequired="True"
                        Label="用户名:"
                        SharedName="FormA">
                        <TextBox />
                    </cy:FormItem>
                    <cy:FormItem
                        IsRequired="True"
                        Label="密码:"
                        LabelHorizontalAlignment="Right"
                        SharedName="FormA">
                        <PasswordBox />
                    </cy:FormItem>

                    <cy:FormSeperater Description="描述文本">
                        <TextBlock Text="这是一个标题" />
                    </cy:FormSeperater>

                    <cy:FormItem Label="电子邮箱:" SharedName="FormB">
                        <TextBox />
                    </cy:FormItem>
                    <cy:FormItem Label="测试:" SharedName="FormB">
                        <TextBox Text="提交" />
                    </cy:FormItem>
                </cy:Form>
            </Border>

            <!--  ========== ③ Form 容器: 附加属性写法 ==========  -->
            <cy:SectionHeader
                MainTitle="③ Form 容器: 附加属性写法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="直接写 TextBox / DatePicker / ComboBox, Label 通过 cy:Form.Label 附加属性指定" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="不嵌 FormItem 标签 — 字段控件直接挂 cy:Form.Label / Description / IsRequired / SharedName 附加属性, Form 内部自动包成 FormItem 渲染。配合 IDataErrorInfo + ValidatesOnDataErrors=True 即可触发红边校验。Form.Header / Footer 槽位用于顶部标题区和底部按钮区。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <cy:Form
                    x:Name="Form"
                    DataContext="{Binding Data}"
                    IsSyncLabelHorizontalAlignment="True"
                    LabelHorizontalAlignment="Right">
                    <cy:Form.ItemsPanel>
                        <ItemsPanelTemplate>
                            <cy:SpacingStackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </cy:Form.ItemsPanel>
                    <cy:Form.Header>
                        <StackPanel Margin="0,12,0,16">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                Foreground="{DynamicResource Text.Title}"
                                Text="Form" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource Text.Prompt}"
                                Text="Please fill in the following personal information fields" />
                            <Rectangle
                                Height="2"
                                Margin="0,10,0,0"
                                Fill="{DynamicResource Background.Checked}" />
                        </StackPanel>
                    </cy:Form.Header>

                    <cy:FormSeperater Title="Basic Info" Description="basic" />
                    <TextBox
                        Height="64"
                        cy:Form.Description="This is first name."
                        cy:Form.IsRequired="True"
                        cy:Form.Label="FirstName:"
                        cy:Form.SharedName="Form"
                        Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        TextWrapping="WrapWithOverflow" />

                    <TextBox
                        cy:Form.Description="This is last name."
                        cy:Form.IsRequired="True"
                        cy:Form.Label="LastName:"
                        cy:Form.SharedName="Form"
                        Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                    <DatePicker
                        cy:Form.Description="Your date of birth."
                        cy:Form.Label="Date of Birth:"
                        cy:Form.SharedName="Form"
                        SelectedDate="{Binding DateOfBirth}" />

                    <TextBox
                        cy:Form.Description="Age must be between 0 and 120."
                        cy:Form.Label="Age:"
                        cy:Form.SharedName="Form"
                        Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                    <cy:FormSeperater Title="Contact Info" Description="contact info" />
                    <TextBox
                        cy:Form.Description="Please enter a valid email address."
                        cy:Form.IsRequired="True"
                        cy:Form.Label="Email:"
                        cy:Form.SharedName="Form"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />

                    <TextBox
                        cy:Form.Description="Your contact phone number."
                        cy:Form.Label="Phone:"
                        cy:Form.SharedName="Form"
                        Text="{Binding Contact.PhoneNumber}" />

                    <TextBox
                        cy:Form.Description="Your LinkedIn profile URL."
                        cy:Form.Label="LinkedIn:"
                        cy:Form.SharedName="Form"
                        Text="{Binding Contact.LinkedInProfile}" />

                    <cy:FormSeperater Title="Address Info" />
                    <TextBox
                        cy:Form.Description="Your street address."
                        cy:Form.Label="Address:"
                        cy:Form.SharedName="Form"
                        Text="{Binding Address}" />

                    <TextBox
                        cy:Form.Description="Your city."
                        cy:Form.Label="City:"
                        cy:Form.SharedName="Form"
                        Text="{Binding City}" />

                    <TextBox
                        cy:Form.Description="Your postal/zip code."
                        cy:Form.Label="Zip Code:"
                        cy:Form.SharedName="Form"
                        Text="{Binding ZipCode}" />

                    <TextBox
                        cy:Form.Description="Your country."
                        cy:Form.Label="Country:"
                        cy:Form.SharedName="Form"
                        Text="{Binding Country}" />

                    <ComboBox
                        cy:Form.Description="Your current status."
                        cy:Form.Label="Status:"
                        cy:Form.SharedName="Form"
                        ItemsSource="{cy:EnumToItemsSource EnumType={x:Type hp:UserStatus}}"
                        SelectedItem="{Binding Status}" />

                    <CheckBox
                        cy:Form.Description="Check if your account is verified."
                        cy:Form.Label="Verified:"
                        cy:Form.SharedName="Form"
                        IsChecked="{Binding IsVerified}" />

                    <cy:FormSeperater Title="Other" Description="other info." />
                    <TextBox
                        MinHeight="60"
                        cy:Form.Description="Additional description."
                        cy:Form.Label="Description:"
                        cy:Form.SharedName="Form"
                        AcceptsReturn="True"
                        Text="{Binding Lorem}"
                        TextWrapping="Wrap" />

                    <cy:Form.Footer>
                        <Button
                            Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding Path=DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="Show" />
                    </cy:Form.Footer>
                </cy:Form>
            </Border>

            <!--  ========== ④ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="4 条用法约定" />

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="SharedName + IsSharedSizeScope" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="同一 SharedName 的 FormItem 标签列宽度自动对齐 — 但必须有共同祖先开 Grid.IsSharedSizeScope=True (cy:Form 自带, 独立用时记得设)。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="附加属性写法 vs 显式 FormItem" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="附加属性写法直观且少嵌一层标签, 适合大表单; 显式 FormItem 写法可读性更高, 适合字段少且需要逐字段精细控制的场景。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="FormSeperater 是分组小标题" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Title + Description, 自带分隔线 — 把长表单按 基本信息 / 联系方式 / 地址 等逻辑切片, 比再嵌一层 GroupBox 视觉更轻。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="校验红边 = IDataErrorInfo" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="字段 Binding 加 ValidatesOnDataErrors=True + UpdateSourceTrigger=PropertyChanged, ViewModel 实现 IDataErrorInfo 返回错误文案 — Form 内置 ErrorTemplate 会显示红边和气泡。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
