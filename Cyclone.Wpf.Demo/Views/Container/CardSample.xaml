<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.CardSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="3000"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M5,7 H17 V19 H5 Z M9,3 H21 V15"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2.2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Card" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="通用卡片容器, 由 Card / CardHeader / CardFooter 三个控件组合。Card 提供三段结构与分隔线开关; CardHeader 提供 图标 + 标题 + 副标题 + 操作 四槽位的标准业务头部; CardFooter 提供与 Card 视觉协调的底部容器。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="只填 Header + Content, Footer 不填则自动收起" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="只填 Header 槽 + Content 内容, Footer 不填 — 模板自动收起 Footer 区域, 连分隔线也不会渲染。" />

            <cy:Card>
                <cy:Card.Header>
                    <cy:CardHeader Subtitle="只有 Header 和 Content, 没有 Footer" Title="一张普通卡片" />
                </cy:Card.Header>
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource Foreground.Default}"
                    Text="这是 Content 区域的内容。可以放任意 WPF 元素。"
                    TextWrapping="Wrap" />
            </cy:Card>

            <!--  ========== ② 其他用法示例 ==========  -->
            <cy:SectionHeader
                MainTitle="② 其他用法示例"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Header + Footer / SeparatorVisibility 开关 / 完整四槽位" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Header + Footer 都有 (带按钮)" />
            <cy:Card Margin="0,0,0,16">
                <cy:Card.Header>
                    <cy:CardHeader Subtitle="此操作不可恢复" Title="确认删除" />
                </cy:Card.Header>
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource Foreground.Default}"
                    Text="将永久删除选中的 3 个项目。请确认操作。"
                    TextWrapping="Wrap" />
                <cy:Card.Footer>
                    <cy:CardFooter>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button MinWidth="72" Content="取消" />
                            <Button
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Content="确认删除" />
                        </StackPanel>
                    </cy:CardFooter>
                </cy:Card.Footer>
            </cy:Card>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="SeparatorVisibility = None (无分隔线, 更紧凑)" />
            <cy:Card Margin="0,0,0,16" SeparatorVisibility="None">
                <cy:Card.Header>
                    <cy:CardHeader Subtitle="2026-05-01" Title="今日数据" />
                </cy:Card.Header>
                <TextBlock
                    FontSize="14"
                    Foreground="{DynamicResource Foreground.Default}"
                    Text="访客数 1,234 / 转化率 8.6% / 平均停留 3min 24s" />
            </cy:Card>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="SeparatorVisibility = HeaderOnly" />
            <cy:Card Margin="0,0,0,16" SeparatorVisibility="HeaderOnly">
                <cy:Card.Header>
                    <cy:CardHeader Subtitle="Footer 区不画分隔线" Title="带 Header 分隔线" />
                </cy:Card.Header>
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource Foreground.Default}"
                    Text="主体内容..."
                    TextWrapping="Wrap" />
                <cy:Card.Footer>
                    <cy:CardFooter>
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Placeholder}"
                            Text="更新于 5 分钟前" />
                    </cy:CardFooter>
                </cy:Card.Footer>
            </cy:Card>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="CardHeader 四槽位完整演示 (Icon + Title + Subtitle + Action)" />
            <cy:Card>
                <cy:Card.Header>
                    <cy:CardHeader Subtitle="Overview Card / 数据同步状态总览" Title="任务概览">
                        <cy:CardHeader.Icon>
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource Background.Highlighted}">
                                <Path
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M4,18 V14 H7 V18 Z M10,18 V8 H13 V18 Z M16,18 V11 H19 V18 Z"
                                    Fill="{DynamicResource Text.Invert}" />
                            </Border>
                        </cy:CardHeader.Icon>
                        <cy:CardHeader.Action>
                            <Button MinWidth="32" Content="⋯" />
                        </cy:CardHeader.Action>
                    </cy:CardHeader>
                </cy:Card.Header>

                <StackPanel>
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="状态" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource Foreground.Success}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="运行中" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="进度" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="78%" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="已处理" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="1,248" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="总数" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="1,600" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            Grid.Column="0"
                            Height="8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Background.Header}"
                            BorderThickness="0"
                            Foreground="{DynamicResource Foreground.Link}"
                            Value="78" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="78%" />
                    </Grid>
                </StackPanel>

                <cy:Card.Footer>
                    <cy:CardFooter>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button MinWidth="72" Content="详情" />
                            <Button
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Content="操作" />
                        </StackPanel>
                    </cy:CardFooter>
                </cy:Card.Footer>
            </cy:Card>

            <!--  ========== ③ 常见使用场景 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 常见使用场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Card 在业务里最常出现的 4 种位置" />

            <UniformGrid Columns="2" Rows="2">
                <Border
                    Margin="0,0,8,8"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M5,7 H17 V19 H5 Z M9,3 H21 V15"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="信息卡片" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="任务概览、数据看板、监控面板等业务展示"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,0,0,8"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,5 H21 V19 H3 Z M3,9 H21 M7,14 H10"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="对话框" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="确认对话、表单弹窗、设置弹层等"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,8,8,0"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="网格列表" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="商品卡、用户卡、项目卡等并排展示"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,8,0,0"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,5 H21 M3,12 H17 M3,19 H21"
                            Stroke="{DynamicResource Foreground.Info}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="文档章节" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="文档页面、设置面板的章节分块"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  ========== ④ Card 主要属性 ==========  -->
            <cy:SectionHeader
                MainTitle="④ Card 主要属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="三段槽 + 分隔线开关" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="属性" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="默认值" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Header" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="顶部内容槽 (继承自 HeaderedContentControl)。null 时整段收起。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Content" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="主体内容槽 (继承自 ContentControl)。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Footer" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="底部内容槽。null 时整段收起 (含分隔线)。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SeparatorVisibility" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="Both" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="None / HeaderOnly / FooterOnly / Both" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Padding" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Thickness" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="16" />
                    <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="Content 区域内边距 (基类成员)" />
                </Grid>
            </Border>

            <!--  ========== ⑤ CardHeader 主要属性 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ CardHeader 主要属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Icon + Title + Subtitle + Action 四槽位" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="属性" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="默认值" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="4"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Icon" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="左侧图标槽, null 时收起" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Title" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="主标题文字" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Subtitle" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="副标题文字, 空时收起" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Action" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableTypeStyle}" Text="null" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource PropTableCellStyle}" Text="右侧操作槽, null 时收起" />
                </Grid>
            </Border>

            <!--  ========== ⑥ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="3 条设计取舍" />

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="HeaderedContentControl" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Card 继承自 HeaderedContentControl, Header 槽免费拿 — Footer 是额外加的, null 时整段收起。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="槽位语义" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Card 不知道 Title / Icon 是什么 — 这是 CardHeader 的事。Card 是纯几何容器, CardHeader 才有业务语义。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="可点击需求" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Card 默认不响应点击 — 需要的话把整个 Card 包在 Button 里, 行为和布局职责分离, 不要给 Card 加 ClickMode。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
