<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.CardSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  ============ 颜色资源 ============  -->
        <!--  章节编号圆圈（放进 CardHeader.Icon 槽）  -->
        <Style x:Key="SectionNumberBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  小标题  -->
        <Style x:Key="DemoItemTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  代码块  -->
        <Style x:Key="CodeBlock" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!--  属性表  -->
        <Style x:Key="PropTable.Header" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTable.Cell" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTable.Name"
            BasedOn="{StaticResource PropTable.Cell}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTable.Type"
            BasedOn="{StaticResource PropTable.Cell}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M5,7 H17 V19 H5 Z M9,3 H21 V15"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2.2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Card" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="通用卡片容器，由 Card / CardHeader / CardFooter 三个控件组合。Card 提供三段结构与分隔线开关；CardHeader 提供“图标 + 标题 + 副标题 + 操作”四槽位的标准业务头部；CardFooter 提供与 Card 视觉协调的底部容器。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础用法  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础用法">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberBorder}">
                                        <TextBlock Style="{StaticResource SectionNumberText}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="只填 Header 槽 + Content 内容，Footer 不填——模板自动收起 Footer 区域，连分隔线也不会渲染。" />
                            <cy:Card>
                                <cy:Card.Header>
                                    <cy:CardHeader Title="一张普通卡片"
                                                   Subtitle="只有 Header 和 Content，没有 Footer" />
                                </cy:Card.Header>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource Foreground.Default}"
                                    Text="这是 Content 区域的内容。可以放任意 WPF 元素。"
                                    TextWrapping="Wrap" />
                            </cy:Card>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 其他用法示例  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="其他用法示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberBorder}">
                                        <TextBlock Style="{StaticResource SectionNumberText}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>

                            <!--  Header + Footer  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitle}" Text="Header + Footer 都有（带按钮）" />
                                <cy:Card>
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="确认删除" Subtitle="此操作不可恢复" />
                                    </cy:Card.Header>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="将永久删除选中的 3 个项目。请确认操作。"
                                        TextWrapping="Wrap" />
                                    <cy:Card.Footer>
                                        <cy:CardFooter>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button MinWidth="72" Content="取消" />
                                                <Button
                                                    MinWidth="72"
                                                    Margin="8,0,0,0"
                                                    Content="确认删除" />
                                            </StackPanel>
                                        </cy:CardFooter>
                                    </cy:Card.Footer>
                                </cy:Card>
                            </StackPanel>

                            <!--  无分隔线  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitle}" Text="SeparatorVisibility = None（无分隔线，更紧凑）" />
                                <cy:Card SeparatorVisibility="None">
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="今日数据" Subtitle="2026-05-01" />
                                    </cy:Card.Header>
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="访客数 1,234 / 转化率 8.6% / 平均停留 3min 24s" />
                                </cy:Card>
                            </StackPanel>

                            <!--  仅 Header 分隔线  -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource DemoItemTitle}" Text="SeparatorVisibility = HeaderOnly" />
                                <cy:Card SeparatorVisibility="HeaderOnly">
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="带 Header 分隔线" Subtitle="Footer 区不画分隔线" />
                                    </cy:Card.Header>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="主体内容..."
                                        TextWrapping="Wrap" />
                                    <cy:Card.Footer>
                                        <cy:CardFooter>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource Foreground.Placeholder}"
                                                Text="更新于 5 分钟前" />
                                        </cy:CardFooter>
                                    </cy:Card.Footer>
                                </cy:Card>
                            </StackPanel>

                            <!--  完整四槽位演示（参考图复刻）  -->
                            <StackPanel>
                                <TextBlock Style="{StaticResource DemoItemTitle}" Text="CardHeader 四槽位完整演示（Icon + Title + Subtitle + Action）" />
                                <cy:Card>
                                    <cy:Card.Header>
                                        <cy:CardHeader Title="任务概览"
                                                       Subtitle="Overview Card / 数据同步状态总览">
                                            <cy:CardHeader.Icon>
                                                <Border
                                                    Width="48"
                                                    Height="48"
                                                    Background="{DynamicResource Background.Highlighted}">
                                                    <Path
                                                        Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M4,18 V14 H7 V18 Z M10,18 V8 H13 V18 Z M16,18 V11 H19 V18 Z"
                                                        Fill="White" />
                                                </Border>
                                            </cy:CardHeader.Icon>
                                            <cy:CardHeader.Action>
                                                <Button MinWidth="32" Content="⋯" />
                                            </cy:CardHeader.Action>
                                        </cy:CardHeader>
                                    </cy:Card.Header>

                                    <StackPanel>
                                        <Grid Margin="0,4,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Foreground.Caption}"
                                                    Text="状态" />
                                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Center"
                                                        Fill="{DynamicResource Foreground.Success}" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        FontSize="18"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Foreground.Link}"
                                                        Text="运行中" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Foreground.Caption}"
                                                    Text="进度" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="22"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Foreground.Default}"
                                                    Text="78%" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Foreground.Caption}"
                                                    Text="已处理" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="22"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Foreground.Default}"
                                                    Text="1,248" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource Foreground.Caption}"
                                                    Text="总数" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="22"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Foreground.Default}"
                                                    Text="1,600" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar
                                                Grid.Column="0"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Background.Header}"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource Foreground.Link}"
                                                Value="78" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{DynamicResource Foreground.Caption}"
                                                Text="78%" />
                                        </Grid>
                                    </StackPanel>

                                    <cy:Card.Footer>
                                        <cy:CardFooter>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button MinWidth="72" Content="详情" />
                                                <Button
                                                    MinWidth="72"
                                                    Margin="8,0,0,0"
                                                    Content="操作" />
                                            </StackPanel>
                                        </cy:CardFooter>
                                    </cy:Card.Footer>
                                </cy:Card>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 常见使用场景  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="常见使用场景">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberBorder}">
                                        <TextBlock Style="{StaticResource SectionNumberText}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <UniformGrid Columns="4" Rows="1">

                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M5,7 H17 V19 H5 Z M9,3 H21 V15"
                                        Stroke="{DynamicResource Foreground.Link}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="信息卡片" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="任务概览、数据看板、监控面板等业务展示"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M3,5 H21 V19 H3 Z M3,9 H21 M7,14 H10"
                                        Stroke="{DynamicResource Foreground.Success}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="对话框" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="确认对话、表单弹窗、设置弹层等"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"
                                        Stroke="{DynamicResource Foreground.Warning}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.8" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="网格列表" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="商品卡、用户卡、项目卡等并排展示"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>

                            <cy:Card Margin="6,0">
                                <StackPanel>
                                    <Path
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        Data="M3,5 H21 M3,12 H17 M3,19 H21"
                                        Stroke="#8B5CF6"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeThickness="2" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Foreground.Default}"
                                        Text="文档章节" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="文档页面、设置面板的章节分块"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </cy:Card>
                        </UniformGrid>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ Card 主要属性  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="Card 主要属性">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberBorder}">
                                        <TextBlock Style="{StaticResource SectionNumberText}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="4"
                                    Background="{DynamicResource Background.Header}" />

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTable.Header}" Text="属性" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTable.Header}" Text="类型" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTable.Header}" Text="默认值" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PropTable.Header}" Text="说明" />

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="4"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Border.Default}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Header" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="object" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="null" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="顶部内容槽（继承自 HeaderedContentControl）。null 时整段收起。" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Content" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="object" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="null" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="主体内容槽（继承自 ContentControl）。" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Footer" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="object" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="null" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="底部内容槽。null 时整段收起（含分隔线）。" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="SeparatorVisibility" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="enum" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="Both" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="None / HeaderOnly / FooterOnly / Both" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Padding" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="Thickness" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="16" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="Content 区域内边距（基类成员）" />
                            </Grid>
                        </Border>
                    </cy:Card>

                    <!--  ⑤ CardHeader 主要属性  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="CardHeader 主要属性">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberBorder}">
                                        <TextBlock Style="{StaticResource SectionNumberText}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="4"
                                    Background="{DynamicResource Background.Header}" />

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTable.Header}" Text="属性" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTable.Header}" Text="类型" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTable.Header}" Text="默认值" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource PropTable.Header}" Text="说明" />

                                <Border
                                    Grid.Row="0"
                                    Grid.ColumnSpan="4"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Border.Default}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Icon" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="object" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="null" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="左侧图标槽，null 时收起" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Title" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="string" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="null" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="主标题文字" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Subtitle" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="string" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="null" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="副标题文字，空时收起" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTable.Name}" Text="Action" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTable.Type}" Text="object" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTable.Type}" Text="null" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource PropTable.Cell}" Text="右侧操作槽，null 时收起" />
                            </Grid>
                        </Border>
                    </cy:Card>

                    <!--  ⑥ XAML 示例 + ⑦ 设计要点  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <cy:Card Grid.Column="0">
                            <cy:Card.Header>
                                <cy:CardHeader Title="XAML 示例">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberBorder}">
                                            <TextBlock Style="{StaticResource SectionNumberText}" Text="6" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>
                            <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlock}">
                                <![CDATA[<cy:Card>
    <cy:Card.Header>
        <cy:CardHeader Title="任务概览"
                       Subtitle="数据同步状态总览">
            <cy:CardHeader.Icon>
                <Border Background="..." />
            </cy:CardHeader.Icon>
            <cy:CardHeader.Action>
                <Button Content="⋯" />
            </cy:CardHeader.Action>
        </cy:CardHeader>
    </cy:Card.Header>

    <!-- 主体内容 -->

    <cy:Card.Footer>
        <cy:CardFooter>
            <Button Content="操作" />
        </cy:CardFooter>
    </cy:Card.Footer>
</cy:Card>]]>
                            </TextBox>
                        </cy:Card>

                        <cy:Card Grid.Column="2">
                            <cy:Card.Header>
                                <cy:CardHeader Title="设计要点">
                                    <cy:CardHeader.Icon>
                                        <Border Style="{StaticResource SectionNumberBorder}">
                                            <TextBlock Style="{StaticResource SectionNumberText}" Text="7" />
                                        </Border>
                                    </cy:CardHeader.Icon>
                                </cy:CardHeader>
                            </cy:Card.Header>

                            <StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="HeaderedContentControl" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="Card 继承自 HeaderedContentControl，Header 槽免费拿"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="槽位语义" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="Card 不知道 Title / Icon 是什么——这是 CardHeader 的事"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="可点击需求" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource Foreground.Caption}"
                                        Text="把 Card 包在 Button 里，行为和布局职责分离"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </cy:Card>
                    </Grid>
                </StackPanel>
            </Grid>

            <!--  ============ 底部 Tip ============  -->
            <Border
                Grid.Row="2"
                Margin="0,20,0,0"
                Padding="16,12"
                Background="{DynamicResource Background.Info}"
                BorderBrush="{DynamicResource Border.Info}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Background.Highlighted}"
                        CornerRadius="999">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="i" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Default}">
                        <Run Text="本页所有章节卡片都是用 Card 控件搭建的——观察这份 XAML 源码可以看到，相比之前 Demo 页中“Border + Style + 嵌套 StackPanel”的写法，结构更扁平、语义更清晰。" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>