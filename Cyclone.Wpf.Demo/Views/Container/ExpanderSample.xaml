<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.ExpanderSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:ExpanderViewModel}}"
    d:DesignHeight="3600"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M14,10 L17,13 L20,10"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Expander" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="折叠展开容器 — 可点击的 Header + 可折叠的 Content。展开/折叠基于 LayoutTransform.ScaleY 真实参与布局测量, 内容长度变化无需手动测量, 外部布局的其他控件被平滑推开/收回。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Header + Content, 点击 Header 切换展开态" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="默认折叠态。点击 Header 行任意位置可切换。展开/折叠时 Header 下方的其他控件会平滑跟随移动, 而不是瞬间跳位。动画时长 0.22s, 展开用 EaseOut, 折叠用 EaseIn — 展开 (飞出) 感更强, 折叠收得利落。" />

            <Expander Header="点击展开 / 折叠">
                <StackPanel>
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="这是 Expander 的内容区。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="内容可以是任何 UI 元素 — 文本、按钮、表单、嵌套面板, 等等。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander>

            <!--  ========== ② MVVM 双向绑定 ==========  -->
            <cy:SectionHeader
                MainTitle="② MVVM 双向绑定"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsExpanded 默认 TwoWay" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="IsExpanded 绑定到 ViewModel, 双向同步。点击下方按钮也能反向控制展开态。" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource ValueLabelStyle}">
                    <Run Text="IsAccountExpanded =" />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding AccountExpandedText, Mode=OneWay}" />
                </TextBlock>
                <cy:SwitchButton Grid.Column="1" IsChecked="{Binding IsAccountExpanded, Mode=TwoWay}" />
            </Grid>

            <Expander Header="账户信息" IsExpanded="{Binding IsAccountExpanded, Mode=TwoWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,0,8"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="用户名" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="邮箱" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Expander>

            <!--  ========== ③ 展开方向 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 展开方向"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ExpandDirection = Down / Up" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="ExpandDirection=Down (默认)" />
            <Expander Margin="0,0,0,16" Header="内容向下展开">
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Header 在上, Content 在下, 分隔线在 Content 顶部。这是默认行为。"
                    TextWrapping="Wrap" />
            </Expander>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="ExpandDirection=Up" />
            <Expander ExpandDirection="Up" Header="内容向上展开">
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Header 在下, Content 在上, 分隔线在 Content 底部。适合贴底部工具栏的场景。"
                    TextWrapping="Wrap" />
            </Expander>

            <!--  ========== ④ HeaderTemplate 自定义 ==========  -->
            <cy:SectionHeader
                MainTitle="④ HeaderTemplate 自定义"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="icon + 标题 + 副标题" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Header 不限于字符串 — 任何 UI 元素都可以。可以用 HeaderTemplate 把 Header 绑成 ViewModel, 统一渲染。" />

            <Expander>
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Data="M12,2 A10,10 0 1,1 2,12 A10,10 0 0,1 12,2 M12,6 L12,12 L17,15"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="时区设置" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="当前 UTC+8 北京" />
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="此处放时区选择 UI。Header 是自定义 StackPanel — icon + 标题 + 副标题双行排版。"
                    TextWrapping="Wrap" />
            </Expander>

            <!--  ========== ⑤ Accordion 风格 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ Accordion 风格"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="多个 Expander 上下排列, 边框合并" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="把多个 Expander 直接堆叠成 StackPanel, 就是常见的 FAQ / 帮助中心样式。展开时下面的兄弟会平滑推开。Margin=0,0,0,-1 让相邻 Expander 的边框重叠成一条, 看起来连成整体。" />

            <StackPanel>
                <Expander Margin="0,0,0,-1" Header="如何重置密码?">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="进入 (设置 → 安全 → 重置密码), 验证邮箱后即可设置新密码。"
                        TextWrapping="Wrap" />
                </Expander>
                <Expander Margin="0,0,0,-1" Header="如何启用两步验证?">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="在 安全 页面打开 两步验证 开关, 绑定身份验证器 App 或手机号即可。"
                        TextWrapping="Wrap" />
                </Expander>
                <Expander Header="忘记账户怎么办?">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="通过绑定的邮箱或手机号找回。若都已失效, 请联系客服提供身份证明。"
                        TextWrapping="Wrap" />
                </Expander>
            </StackPanel>

            <!--  ========== ⑥ 常见使用场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 常见使用场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Expander 在业务里最常出现的 4 种位置" />

            <UniformGrid Columns="2" Rows="2">
                <Border
                    Margin="0,0,8,8"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M12,15 C8.7,15 6,12.3 6,9 C6,5.7 8.7,3 12,3 C15.3,3 18,5.7 18,9 C18,12.3 15.3,15 12,15 M12,17 L12,21 M9,21 L15,21"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="设置面板" />
                        <Expander Margin="0,4,0,4" Header="通知">
                            <StackPanel>
                                <CheckBox
                                    Margin="0,0,0,6"
                                    Content="允许桌面通知"
                                    IsChecked="{Binding IsNotificationsEnabled}" />
                                <CheckBox
                                    Margin="0,0,0,6"
                                    Content="邮件提醒"
                                    IsChecked="{Binding IsEmailEnabled}" />
                                <CheckBox Content="短信提醒" IsChecked="{Binding IsSmsEnabled}" />
                            </StackPanel>
                        </Expander>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="分组隐藏二级选项"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,0,0,8"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M9,9 A3,3 0 1,1 12,12 L12,14 M12,17 L12,17.5"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="FAQ" />
                        <Expander Margin="0,4,0,4" Header="问题示例?">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="问题的详细解答放在这里。"
                                TextWrapping="Wrap" />
                        </Expander>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="帮助中心、产品文档"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,8,8,0"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M4,4 L20,4 L20,8 L4,8 Z M4,12 L20,12 L20,16 L4,16 Z M4,20 L12,20"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="表单分组" />
                        <Expander Margin="0,4,0,4" Header="高级选项">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Text="代理地址" />
                                <TextBox FontSize="11" />
                            </StackPanel>
                        </Expander>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="把非必填项隐藏起来"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="8,8,0,0"
                    Padding="16,14"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M3,12 L9,12 L11,8 L13,16 L15,12 L21,12"
                            Stroke="{DynamicResource Foreground.Info}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="详情面板" />
                        <Expander Margin="0,4,0,4" Header="查看详情">
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="日志、堆栈、原始数据放这里。"
                                TextWrapping="Wrap" />
                        </Expander>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="错误详情、日志展开"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  ========== ⑦ 主要属性 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 主要属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="HeaderedContentControl 基类 + 展开态扩展" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="属性" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Header" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Header 内容, 可以是字符串, 也可以是任意 UI 元素或 ViewModel (配合 HeaderTemplate)。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="HeaderTemplate" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="DataTemplate" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="渲染 Header 的模板。Header 是数据对象时用这个统一呈现。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Content" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="折叠区域的内容。从 ContentControl 继承。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsExpanded" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (TwoWay)" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="展开/折叠状态。默认 false。改变时触发 Expanded / Collapsed 路由事件。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ExpandDirection" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="ExpandDirection" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="展开方向: Down (默认) / Up。本样式两个方向都做了完整支持, 边框分隔线会随方向调整位置。Left / Right 当前不支持。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Padding" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Thickness" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Header 和 Content 的内边距。默认 12,8。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="HorizontalContentAlignment" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="HorizontalAlignment" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Content 的水平对齐。默认 Stretch。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Background / BorderBrush / BorderThickness" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Brush / Brush / Thickness" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="整体容器外观。默认由主题资源提供。" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsEnabled" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="禁用态 — Header 不响应点击, 文字与箭头淡化。" />
                </Grid>
            </Border>

            <!--  ========== ⑧ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑧ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="4 条实现笔记" />

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="LayoutTransform" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ScaleY 真实参与布局测量, 内容长度变化无需 Measure, 外部布局平滑跟随。比 RenderTransform 的方案更可靠。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="箭头 RotateTransform" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="0°↔180° 平滑旋转, 替代多组 Path Data 直接切换。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="完整状态反馈" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="hover / pressed / keyboard-focused / disabled 全状态视觉。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="无圆角" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="对齐项目 Win10 规约, 整套不出现 CornerRadius。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
