<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.GroupBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:GroupBoxViewModel}}"
    d:DesignHeight="3200"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  表单字段标签样式  -->
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4,7 L20,7 L20,21 L4,21 Z M4,7 L4,3 L20,3 L20,7"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="GroupBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="分组容器 — 把相关的控件框在一起, 顶部带 Header 标题。WPF 标准内置控件, WinUI 3 风格无圆角, Header 灰底 + 分隔线 + 白色内容区。常用于表单分组、设置面板、属性栏。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Header 字符串 + Content 内容" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="最简形式 — Header 设字符串, 内容自由放置。Header 自动 Medium 字重, 灰底 Header 行 + 1px 分隔线 + 白底内容区。" />

            <GroupBox Header="基本信息">
                <StackPanel>
                    <TextBlock Text="这里放任意 UI 元素 —— 文本、表单、列表、嵌套面板, 等等。" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="默认 Padding 12,8 让内容不贴边。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <!--  ========== ② 表单分组 ==========  -->
            <cy:SectionHeader
                MainTitle="② 表单分组"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="最常见的用途 — 框一组相关字段" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="GroupBox 最经典的用途 — 把相关的表单字段视觉上分组。" />

            <GroupBox Header="个人信息">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="姓名" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,12,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="邮箱" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="电话" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>

            <!--  ========== ③ 多个 GroupBox 并列 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 多个 GroupBox 并列"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="设置面板典型布局" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="StackPanel 里堆叠多个 GroupBox 是设置面板的标准做法。每个 Group 一组逻辑相关选项。" />

            <GroupBox Margin="0,0,0,12" Header="通知">
                <StackPanel>
                    <CheckBox
                        Margin="0,0,0,6"
                        Content="启用桌面通知"
                        IsChecked="{Binding EnableNotifications}" />
                    <CheckBox Content="订阅每周简报" IsChecked="{Binding EnableNewsletters}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="外观">
                <CheckBox Content="深色模式" IsChecked="{Binding DarkMode}" />
            </GroupBox>

            <!--  ========== ④ 自定义 Header ==========  -->
            <cy:SectionHeader
                MainTitle="④ 自定义 Header"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Header 可以是任意 UI 元素" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Header 是 object 类型, 可以放图标 + 文本、Toggle 控件等任意内容。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Header 含图标" />
            <GroupBox Margin="0,0,0,16">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="M12,8 A4,4 0 1,1 8,12 A4,4 0 0,1 12,8 M12,3 L12,5 M12,19 L12,21 M3,12 L5,12 M19,12 L21,12"
                            Stretch="Uniform"
                            Stroke="{DynamicResource Icon.Foreground.Default}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                        <TextBlock Text="网络配置" />
                    </StackPanel>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="服务器" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Text="{Binding ServerAddress}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,12,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="端口" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        Text="{Binding Port}" />

                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Content="使用 HTTP 代理"
                        IsChecked="{Binding UseProxy}" />
                </Grid>
            </GroupBox>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Header 含 Switch 切换" />
            <GroupBox>
                <GroupBox.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="高级选项" />
                        <CheckBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="启用"
                            IsChecked="{Binding UseProxy}" />
                    </Grid>
                </GroupBox.Header>
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="Header 里可以放控件 (CheckBox / Toggle / Button 等), 做成 可启用的分组。"
                    TextWrapping="Wrap" />
            </GroupBox>

            <!--  ========== ⑤ 嵌套 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 嵌套"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="GroupBox 可以包含 GroupBox" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="复杂表单可以嵌套 — 但嵌套层级太深视觉混乱, 通常 2 层够用。" />

            <GroupBox Header="账户设置">
                <StackPanel>
                    <GroupBox Margin="0,0,0,12" Header="基本信息">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="用户名" />
                            <TextBox Grid.Column="1" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="联系方式">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="邮箱" />
                            <TextBox Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </GroupBox>

            <!--  ========== ⑥ 边界场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 边界场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Header=null / IsEnabled=False" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Header=null — 自动隐藏 Header 行" />
            <GroupBox Margin="0,0,0,16">
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="没有 Header 时, 顶部灰条和分隔线都隐藏, 只剩纯边框容器。"
                    TextWrapping="Wrap" />
            </GroupBox>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="IsEnabled=False — 整体淡化" />
            <GroupBox Header="禁用的分组" IsEnabled="False">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="12"
                        Text="内容也跟随禁用, Foreground 变灰, Opacity 0.7。" />
                    <CheckBox Content="点不动的复选框" />
                </StackPanel>
            </GroupBox>

            <!--  ========== ⑦ 主要属性 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 主要属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="HeaderedContentControl 基类 + 主题资源" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="属性" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Header" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="标题内容, 字符串或任意 UI 元素。null 时整个 Header 行自动隐藏。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="HeaderTemplate" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="DataTemplate" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="渲染 Header 的模板, Header 是数据对象时配合使用。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Content" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="容器内容, 从 ContentControl 继承。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Padding" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Thickness" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="内容区的内边距, 默认 12,8。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Background / BorderBrush / BorderThickness" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Brush / Brush / Thickness" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="容器外观, 默认主题资源。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsEnabled" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="禁用时 Foreground 变灰, 整体 Opacity 0.7。" />
                </Grid>
            </Border>

            <!--  ========== ⑧ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑧ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="4 条用法约定" />

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Header 灰底 + 分隔线" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Background.Header 浅灰 + 1px 分隔线, 跟内容区视觉拆分清晰。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Header=null 自动隐藏" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="未设 Header 时灰条 + 分隔线整个隐藏, 等同纯边框 Border 容器。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="无圆角" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="对齐 Win10 视觉规约, 跟项目其他控件一致。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="跟 Expander / Card 的区别" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="GroupBox 永远展开 + 强调框线, Expander 可折叠, Card 是悬浮卡片 (有阴影/三段结构)。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
