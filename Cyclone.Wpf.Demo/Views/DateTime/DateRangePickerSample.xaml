<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.DateRangePickerSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:DateRangePickerViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 0 5 L 22 5 L 22 20 L 0 20 Z M 0 8 L 22 8 M 5 0 L 5 8 M 17 0 L 17 8 M 6 14 L 16 14"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="DateRangePicker" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="日期范围选择器 — 两次点击选起止日期, 中间区段自动高亮。Hover 预览 + 17 个内置预定义范围 (今天 / 近 7 天 / 本月等), 也可自定义。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础绑定 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础绑定"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="RangeStart / RangeEnd 双向绑定 ViewModel" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="经典订单查询场景 — 选范围后下方计算持续天数。默认显示 17 个预定义范围 + 单 Calendar 月历。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="订单时间范围" />
            <cy:DateRangePicker
                Width="280"
                HorizontalAlignment="Left"
                RangeEnd="{Binding OrderEnd, Mode=TwoWay}"
                RangeStart="{Binding OrderStart, Mode=TwoWay}" />

            <Border
                Margin="0,16,0,0"
                Padding="12,8"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="RangeStart = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding OrderStart, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="RangeEnd   = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding OrderEnd, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="持续天数  = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding OrderDays, Mode=OneWay}" />
                        <Run Text=" 天" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="14,6"
                    Command="{Binding SetLastWeekCommand}"
                    Content="设为近 7 天" />
                <Button
                    Padding="14,6"
                    Command="{Binding ClearOrderRangeCommand}"
                    Content="清空" />
            </StackPanel>

            <!--  ========== ② 禁用日期 ==========  -->
            <cy:SectionHeader
                MainTitle="② 禁用日期"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="BlackoutDates 列表中的日期划掉禁选" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="模拟节假日不可预约场景 — 部分日期划掉禁选, 光标变 Arrow, 鼠标 hover 跳过。BlackoutDates 直接接受 IEnumerable&lt;DateTime&gt;, 比原生 Calendar 友好得多。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="预约时间 (避开节假日)" />
            <cy:DateRangePicker
                Width="280"
                HorizontalAlignment="Left"
                BlackoutDates="{Binding Holidays}" />

            <TextBlock
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="Holidays 列表里设了 4 个日期 (前后各 2 天), 打开 Popup 查看划掉效果。"
                TextWrapping="Wrap" />

            <!--  ========== ③ 自定义预定义范围 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 自定义预定义范围"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="替换默认 17 项 — 只显示季度" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="业务场景定制 — 财务报表只关心 Q1/Q2/Q3/Q4, 默认 17 项太杂。把 PredefinedRanges 设成自定义列表即可。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="财务季度选择" />
            <cy:DateRangePicker
                Width="280"
                HorizontalAlignment="Left"
                PredefinedRanges="{Binding QuarterRanges}"
                RangeEnd="{Binding QuarterEnd, Mode=TwoWay}"
                RangeStart="{Binding QuarterStart, Mode=TwoWay}" />

            <Border
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="Start = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding QuarterStart, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="End   = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding QuarterEnd, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue='(未选)'}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  ========== ④ 极简 + 禁用 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 极简 + 禁用"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ShowPredefinedRanges / IsEnabled / Separator" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="无预定义列表 (ShowPredefinedRanges=False)" />
            <cy:DateRangePicker
                Width="280"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                RangeEnd="{Binding PlainEnd, Mode=TwoWay}"
                RangeStart="{Binding PlainStart, Mode=TwoWay}"
                ShowPredefinedRanges="False" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="禁用态 (IsEnabled=False)" />
            <cy:DateRangePicker
                Width="280"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                IsEnabled="False"
                RangeEnd="{Binding FrozenEnd}"
                RangeStart="{Binding FrozenStart}" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="自定义分隔符" />
            <cy:DateRangePicker
                Width="280"
                HorizontalAlignment="Left"
                Separator=" 至 " />

            <!--  ========== ⑤ 主要属性 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 主要属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="DateRangePicker DP 列表" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="名称" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="RangeStart" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="DateTime?" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="起始日期。TwoWay 可绑定。第一次点击设置此值。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="RangeEnd" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="DateTime?" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="结束日期。TwoWay 可绑定。第二次点击设置此值, 内部自动按时间排序。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BlackoutDates" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IEnumerable&lt;DateTime&gt;" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="禁用日期集合。可直接绑定 VM 集合 (不像原生 Calendar 那样只读)。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="PredefinedRanges" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IList&lt;IPredefinedRange&gt;" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="左侧预定义快捷选项。默认 17 项 (今天 / 近 N 天 / 周 / 月 / 季 / 年), 可全量替换。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ShowPredefinedRanges" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否显示左侧快捷面板。False 时 Popup 只有月历。默认 True。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Separator" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="输入框中起止日期之间的分隔符。默认 ' - ', 可改 ' 至 ' 等。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsEnabled" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否启用 (UIElement 标准 DP)。" />
                </Grid>
            </Border>

            <!--  ========== ⑥ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="4 条架构理念" />

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="两次点击选范围" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="状态机: 第一次点 = Start, 第二次点 = End (自动按时间排序), 第三次点重置。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Hover 预览" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Start 选中后, 鼠标 hover 哪个日期 → 那段范围淡色高亮预览, 用户提前看到结果。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="自实现 MonthView" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="放弃 WPF Calendar (SelectionMode 不支持范围语义 + BlackoutDates 集合无 setter), Grid 6×7 完全自实现。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="17 个开箱即用范围" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="今天 / 昨天 / 近 N 天 / 本周 / 上周 / 下周 / 本月 / 上月 / 下月 / 季度 / 年... PredefinedRanges 可覆盖。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
