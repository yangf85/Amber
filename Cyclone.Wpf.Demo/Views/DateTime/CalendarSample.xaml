<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.CalendarSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:CalendarViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 0 5 L 22 5 L 22 20 L 0 20 Z M 0 8 L 22 8 M 5 0 L 5 8 M 17 0 L 17 8 M 8 12 L 14 12 L 14 16 L 8 16 Z"
                            Stretch="None"
                            Stroke="White"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Calendar" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 原生控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="WPF 原生月历控件 — WinUI 3 无圆角风格重制。支持单选 / 范围 / 多段三种模式,可配置导航边界、禁用日期、周首日等。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  主体  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左列  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 基础绑定 — 单选  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="基础绑定" Subtitle="SelectedDate 双向绑定 ViewModel">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="最常见场景 — 填表单的出生日期 / 入职日期。SelectedDate 是 DP, 直接 TwoWay 绑定到 VM。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="出生日期" />
                            <Calendar
                                HorizontalAlignment="Left"
                                SelectedDate="{Binding BirthDate, Mode=TwoWay}" />

                            <Border
                                Margin="0,16,0,0"
                                Padding="12,8"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                                        <Run Text="SelectedDate = " />
                                        <Run
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground.Link}"
                                            Text="{Binding BirthDateDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="14,6"
                                    Command="{Binding SetBirthTodayCommand}"
                                    Content="设为今天" />
                                <Button
                                    Padding="14,6"
                                    Command="{Binding ClearBirthDateCommand}"
                                    Content="清空" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② BlackoutDates  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="禁用日期" Subtitle="BlackoutDates 列表中的日期划掉禁选">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="模拟 节假日不可预约 场景 — 用代码把日期 Add 到 BlackoutDates 集合即可,选中态会有跨叉图标。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="预约时间(避开节假日)" />
                            <Calendar
                                x:Name="AppointmentCalendar"
                                HorizontalAlignment="Left"
                                Loaded="OnAppointmentCalendarLoaded"
                                SelectedDate="{Binding AppointmentDate, Mode=TwoWay}" />

                            <Border
                                Margin="0,16,0,0"
                                Padding="12,8"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <TextBlock Style="{StaticResource ValueLabelStyle}">
                                    <Run Text="AppointmentDate = " />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Foreground.Link}"
                                        Text="{Binding AppointmentDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </Border>

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="提示:Holidays 列表里设了 5 个日期(前 3 天、后 5~7 天)。BlackoutDates 是只读集合,需要在 Loaded 时从 VM Add。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  右列  -->
                <StackPanel Grid.Column="2">

                    <!--  ③ 选择模式  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="选择模式" Subtitle="SingleRange / MultipleRange">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="SelectionMode 切换日历的选择行为。注意:SelectedDates 是只读集合,无法 TwoWay 绑定到 VM,需通过 SelectionChanged 事件读取。" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="SingleRange — 拖选连续区段" />
                            <Calendar HorizontalAlignment="Left" SelectionMode="SingleRange" />
                            <TextBlock
                                Margin="0,4,0,16"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="鼠标按下拖动 / Shift+点击 → 选中连续区段"
                                TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="MultipleRange — 多段非连续" />
                            <Calendar HorizontalAlignment="Left" SelectionMode="MultipleRange" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Ctrl+点击单日 / Ctrl+拖动 → 多段选择, 每段独立"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </cy:Card>

                    <!--  ④ 自定义 + 禁用  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="自定义 + 禁用" Subtitle="周首日 / 今天高亮 / 导航边界 / 禁用态">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="FirstDayOfWeek=Monday (周一开始)" />
                            <Calendar HorizontalAlignment="Left" FirstDayOfWeek="Monday" />

                            <TextBlock
                                Margin="0,16,0,8"
                                Style="{StaticResource DemoItemTitleStyle}"
                                Text="IsTodayHighlighted=False (不高亮今天)" />
                            <Calendar HorizontalAlignment="Left" IsTodayHighlighted="False" />

                            <TextBlock
                                Margin="0,16,0,8"
                                Style="{StaticResource DemoItemTitleStyle}"
                                Text="DisplayDateStart/End (限制可导航范围)" />
                            <Calendar
                                HorizontalAlignment="Left"
                                DisplayDateEnd="{Binding BusinessTripEnd, Mode=OneWay}"
                                DisplayDateStart="{Binding BusinessTripStart, Mode=OneWay}"
                                SelectedDate="{Binding TripDate, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="只能在 [今天, 今天+30 天] 内导航,导航按钮自动禁用"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,16,0,8"
                                Style="{StaticResource DemoItemTitleStyle}"
                                Text="IsEnabled=False (禁用态)" />
                            <Calendar
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                SelectedDate="{Binding FrozenDate}" />
                        </StackPanel>
                    </cy:Card>
                </StackPanel>
            </Grid>

            <!--  底部  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <cy:Card Grid.Column="0">
                    <cy:Card.Header>
                        <cy:CardHeader Title="XAML 示例">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>
                    <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}">
                        <![CDATA[<!-- 基础绑定 (SelectedDate 是 DP,可直接 TwoWay) -->
<Calendar SelectedDate="{Binding BirthDate, Mode=TwoWay}" />

<!-- 选择模式 -->
<Calendar SelectionMode="SingleDate" />     <!-- 默认: 单选 -->
<Calendar SelectionMode="SingleRange" />    <!-- 拖选连续区段 -->
<Calendar SelectionMode="MultipleRange" />  <!-- Ctrl 多段 -->
<Calendar SelectionMode="None" />           <!-- 只展示不可选 -->

<!-- 周首日 / 今天高亮 -->
<Calendar FirstDayOfWeek="Monday"
          IsTodayHighlighted="False" />

<!-- 导航边界 -->
<Calendar DisplayDateStart="{Binding TripStart}"
          DisplayDateEnd="{Binding TripEnd}" />

<!-- BlackoutDates 集合操作 (代码: 该集合无 setter, 只能 Add) -->
public partial class CalendarSample : UserControl
{
    private void OnAppointmentCalendarLoaded(object sender, RoutedEventArgs e)
    {
        var cal = (Calendar)sender;
        var vm = (CalendarViewModel)DataContext;
        cal.BlackoutDates.Clear();
        foreach (var d in vm.Holidays)
            cal.BlackoutDates.Add(new CalendarDateRange(d));
    }
}

<!-- SelectedDates (多选/范围) 不能 TwoWay 绑定, 需用事件: -->
<Calendar SelectionMode="MultipleRange"
          SelectedDatesChanged="OnSelectionChanged" />]]>
                    </TextBox>
                </cy:Card>

                <cy:Card Grid.Column="2">
                    <cy:Card.Header>
                        <cy:CardHeader Title="设计要点">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="WinUI 3 无圆角" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="与 ListBox v4 对齐: 全部 DynamicResource 走主题 token, 扁平直角, SnapsToDevicePixels"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="今天: 描边圈" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="IsToday → 1px Border.Selected 描边(无填充), 不再用奇怪的勾选 Path"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="选中: 实色 + 反白" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="IsSelected → Background.Selected 实色填充 + Foreground.Invert 反白文字"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="状态优先级" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="MultiTrigger 处理 Hover+IsSelected=False; IsPressed 排在 IsSelected 之后, 按下选中态也能看到反馈"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="WPF 限制提醒" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="SelectedDates / BlackoutDates 是只读集合, 不可 TwoWay 绑定, 需通过事件或 Loaded 时初始化"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </cy:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
