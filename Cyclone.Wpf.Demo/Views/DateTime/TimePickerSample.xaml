<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.TimePickerSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:TimePickerViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 14 0 A 14 14 0 1 0 14 28 A 14 14 0 1 0 14 0 Z M 14 6 L 14 14 L 20 18"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2.2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="TimePicker" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="时间选择器 — 三列滚轮 (时 / 分 / 秒)。基于 CyclicPanel 的拖动选择, 中心遮罩高亮选中态。Snapshot 机制: 确定提交, 取消真正回滚。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础绑定 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础绑定"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="SelectedTime 双向绑定 TimeSpan?" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="会议起止时间 — 选时间后下方计算会议时长。点确定才提交, 取消回滚到原值。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="开始时间" />
            <cy:TimePicker
                Width="200"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                SelectedTime="{Binding MeetingStart, Mode=TwoWay}" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="结束时间" />
            <cy:TimePicker
                Width="200"
                HorizontalAlignment="Left"
                SelectedTime="{Binding MeetingEnd, Mode=TwoWay}" />

            <Border
                Margin="0,16,0,0"
                Padding="12,8"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="开始 = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding MeetingStart, Mode=OneWay, StringFormat={}{0:hh\\:mm\\:ss}}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="结束 = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding MeetingEnd, Mode=OneWay, StringFormat={}{0:hh\\:mm\\:ss}}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="时长 = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding MeetingDuration, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  ========== ② 未设置时间 ==========  -->
            <cy:SectionHeader
                MainTitle="② 未设置时间"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Watermark + null 值绑定" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="SelectedTime 为 null 时显示 Watermark 占位文字。SelectedTime 是 TimeSpan?, 默认 null。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="闹钟时间 (默认 null)" />
            <cy:TimePicker
                Width="200"
                HorizontalAlignment="Left"
                SelectedTime="{Binding AlarmTime, Mode=TwoWay}"
                Watermark="设置闹钟..." />

            <Border
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <TextBlock Style="{StaticResource ValueLabelStyle}">
                    <Run Text="AlarmTime = " />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding AlarmTime, Mode=OneWay, StringFormat={}{0:hh\\:mm\\:ss}, TargetNullValue='(未设置)'}" />
                </TextBlock>
            </Border>

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="14,6"
                    Command="{Binding SetNowCommand}"
                    Content="设为当前时间" />
                <Button
                    Padding="14,6"
                    Command="{Binding ClearAlarmCommand}"
                    Content="清空" />
            </StackPanel>

            <!--  ========== ③ 自定义格式 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 自定义格式"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="TimeFormat 控制显示文本格式" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="DateTime 标准格式串 — 不影响内部 TimeSpan 选值, 只影响显示文本。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="HH:mm:ss (默认)" />
            <cy:TimePicker
                Width="200"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                SelectedTime="{Binding DepartureTime}" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="HH:mm (隐藏秒)" />
            <cy:TimePicker
                Width="200"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                SelectedTime="{Binding DepartureTime}"
                TimeFormat="HH:mm" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="hh:mm tt (12 小时制 + AM/PM)" />
            <cy:TimePicker
                Width="200"
                HorizontalAlignment="Left"
                SelectedTime="{Binding DepartureTime}"
                TimeFormat="hh:mm tt" />

            <!--  ========== ④ 尺寸 + 禁用 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 尺寸 + 禁用"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="VisibleItemCount / MaxContainerHeight / IsEnabled" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="VisibleItemCount 必须是奇数 (中心项是选中项), 非法值会自动 clamp。MaxContainerHeight 控制 Popup 内 selector 总高度。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="3 项可见 (紧凑)" />
            <cy:TimePicker
                Width="200"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                MaxContainerHeight="100"
                SelectedTime="{Binding DepartureTime}"
                VisibleItemCount="3" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="7 项可见 (宽阔)" />
            <cy:TimePicker
                Width="200"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                MaxContainerHeight="200"
                SelectedTime="{Binding DepartureTime}"
                VisibleItemCount="7" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="禁用态" />
            <cy:TimePicker
                Width="200"
                HorizontalAlignment="Left"
                IsEnabled="False"
                SelectedTime="{Binding FrozenTime}" />

            <!--  ========== ⑤ 主要属性 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 主要属性"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="TimePicker DP 列表" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource PropTableHeaderStyle}" Text="名称" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PropTableHeaderStyle}" Text="类型" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource PropTableHeaderStyle}" Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SelectedTime" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="TimeSpan?" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前选中时间。TwoWay 可绑定。null 时显示 Watermark。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TimeFormat" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="DateTime 标准格式串。默认 HH:mm:ss。仅影响显示, 不影响内部 TimeSpan 值。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Watermark" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="SelectedTime 为 null 时显示的占位文字。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="VisibleItemCount" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="int" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="滚轮内可见项数。必须为奇数 (中心项是选中项), 偶数自动调成相邻奇数。默认 5。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="MaxContainerHeight" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Popup 内 selector 总高度。配合 VisibleItemCount 控制单项行高。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsEnabled" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否启用 (UIElement 标准 DP)。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsDropDownOpen" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Popup 是否展开。可代码控制 / 监听。" />
                </Grid>
            </Border>

            <!--  ========== ⑥ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="4 条架构理念" />

            <StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="拖动滚动" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="基于 CyclicPanel 的拖动选择 + Snap 到中心, 中心遮罩高亮选中态。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Snapshot 机制" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Popup 打开时缓存原值, 确定提交, 取消 / 点外部真正回滚 selectors 位置 — 不像很多控件取消只是关 Popup 但值已被改。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="奇数项" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="VisibleItemCount 必须是奇数 (中心项是选中项), 传 4 自动调成 5。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="主题响应" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="中心遮罩 Selection.Background (主色淡蓝)、选中字 Foreground.Focused, 适配主题切换。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
