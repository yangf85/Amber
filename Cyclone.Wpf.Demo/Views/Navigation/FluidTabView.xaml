<!-- MVVM 数据驱动：双模板 -->
<cy:FluidTabControl
    ItemsSource="{Binding Sections}"
    SelectedItem="{Binding Current, Mode=TwoWay}"
    ItemHeaderTemplate="{StaticResource HeaderTpl}"
    ItemTemplate="{StaticResource ContentTpl}" />

<!-- 用 MemberPath 简化 Header 显示 -->
<cy:FluidTabControl
    ItemsSource="{Binding Sections}"
    ItemHeaderMemberPath="Title"
    ItemTemplate="{StaticResource ContentTpl}" />

<!-- 自定义动画 + 中心锚点 -->
<cy:FluidTabControl
    AnimationDuration="0:0:0.6"
    SnapAlignment="Center"
    ItemsSource="{Binding Sections}">
    <cy:FluidTabControl.EasingFunction>
        <CubicEase EasingMode="EaseInOut" />
    </cy:FluidTabControl.EasingFunction>
</cy:FluidTabControl>

<!-- 标签列在右侧 -->
<cy:FluidTabControl FluidTabPlacement="Right" ... />]]>
                        </TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
