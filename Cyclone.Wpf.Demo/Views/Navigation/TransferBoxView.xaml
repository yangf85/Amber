<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.TransferBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type={x:Type local:TransferBoxViewModel}}"
    d:DesignHeight="3000"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ResultBoxStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <Style x:Key="ResultLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Container}" />
        </Style>

        <!--  Header 样式：放在 SourceHeader / TargetHeader 里  -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z"
                            Fill="White"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="TransferBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Container}"
                            Text="双列表选择控件（穿梭框）。左 / 右两个 ListBox + 中间箭头按钮，把 item 在两侧之间移动。支持 multi-select、全选、自定义 ItemTemplate、路由事件监听。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体卡片 ============  -->
            <StackPanel Grid.Row="1">

                <!--  ① 基础字符串列表  -->
                <cy:Card Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="基础字符串列表" Subtitle="SourceItems / TargetItems = ObservableCollection&lt;string&gt;">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="最简场景：直接绑两个 ObservableCollection&lt;string&gt;。点击列表项选中（支持 Ctrl/Shift 多选 + 顶部&quot;全选&quot;CheckBox），点中间 → / ← 移动；空选中时长按按钮可批量推送（移动第一项）。" />

                        <cy:TransferBox
                            Height="280"
                            HorizontalAlignment="Stretch"
                            SourceItems="{Binding AvailableLanguages}"
                            TargetItems="{Binding SelectedLanguages}">
                            <cy:TransferBox.SourceHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="可用编程语言" />
                            </cy:TransferBox.SourceHeader>
                            <cy:TransferBox.TargetHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="已选编程语言" />
                            </cy:TransferBox.TargetHeader>
                        </cy:TransferBox>

                        <Border Style="{StaticResource ResultBoxStyle}">
                            <TextBlock Style="{StaticResource ResultLabelStyle}">
                                <Run Text="可用：" />
                                <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding AvailableLanguages.Count, Mode=OneWay}" />
                                <Run Text="项；已选：" />
                                <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding SelectedLanguages.Count, Mode=OneWay}" />
                                <Run Text="项" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </cy:Card>

                <!--  ② 自定义对象 + DisplayMemberPath  -->
                <cy:Card Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="自定义对象 + DisplayMemberPath" Subtitle="SourceDisplayMemberPath / TargetDisplayMemberPath">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="数据是 TeamMember 对象（Name + Role）。SourceDisplayMemberPath / TargetDisplayMemberPath 都设 'Name'——列表显示姓名，但底层对象完整保留（下方显示已选成员的角色）。" />

                        <cy:TransferBox
                            Height="280"
                            HorizontalAlignment="Stretch"
                            SourceDisplayMemberPath="Name"
                            SourceItems="{Binding AvailableMembers}"
                            TargetDisplayMemberPath="Name"
                            TargetItems="{Binding SelectedMembers}">
                            <cy:TransferBox.SourceHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="候选成员" />
                            </cy:TransferBox.SourceHeader>
                            <cy:TransferBox.TargetHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="项目组成员" />
                            </cy:TransferBox.TargetHeader>
                        </cy:TransferBox>

                        <Border Style="{StaticResource ResultBoxStyle}">
                            <ItemsControl ItemsSource="{Binding SelectedMembers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" Style="{StaticResource ResultLabelStyle}">
                                            <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Role, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </cy:Card>

                <!--  ③ ItemTemplate 自定义渲染  -->
                <cy:Card Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="自定义渲染（ItemTemplate）" Subtitle="图标 + 名称 + 描述">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="用 ItemTemplate 自定义列表项渲染——Permission 对象用图标 + 名称 + 描述展示。模板同时应用于源列表和目标列表。" />

                        <cy:TransferBox
                            Height="320"
                            HorizontalAlignment="Stretch"
                            SourceItems="{Binding AvailablePermissions}"
                            TargetItems="{Binding GrantedPermissions}">
                            <cy:TransferBox.SourceHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="所有权限" />
                            </cy:TransferBox.SourceHeader>
                            <cy:TransferBox.TargetHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="已授予权限" />
                            </cy:TransferBox.TargetHeader>
                            <cy:TransferBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Permission}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Data="{Binding IconData}"
                                            Fill="{DynamicResource Icon.Foreground.Default}"
                                            Stretch="Uniform" />
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource Foreground.Container}"
                                                Text="{Binding Description}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </cy:TransferBox.ItemTemplate>
                        </cy:TransferBox>
                    </StackPanel>
                </cy:Card>

                <!--  ④ 路由事件监听  -->
                <cy:Card Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="路由事件监听" Subtitle="SourceItemsChanged / TargetItemsChanged">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="每次移动会同时触发两个路由事件：SourceItemsChanged + TargetItemsChanged。code-behind 订阅事件，把变化信息追加到下方活动日志（保留最近 6 条）。事件冒泡——可以在父容器上统一监听。" />

                        <cy:TransferBox
                            Height="240"
                            HorizontalAlignment="Stretch"
                            SourceItems="{Binding AvailableFruits}"
                            SourceItemsChanged="OnSourceItemsChanged"
                            TargetItems="{Binding SelectedFruits}"
                            TargetItemsChanged="OnTargetItemsChanged">
                            <cy:TransferBox.SourceHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="水果库存" />
                            </cy:TransferBox.SourceHeader>
                            <cy:TransferBox.TargetHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="购物车" />
                            </cy:TransferBox.TargetHeader>
                        </cy:TransferBox>

                        <Border Style="{StaticResource ResultBoxStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ResultLabelStyle}">
                                    <Run Text="累计移动次数：" />
                                    <Run FontWeight="Bold" Foreground="{DynamicResource Foreground.Link}" Text="{Binding TotalMoveCount, Mode=OneWay}" />
                                </TextBlock>
                                <Border
                                    Margin="0,8,0,0"
                                    Padding="0,8,0,0"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="{DynamicResource Foreground.Container}"
                                            Text="活动日志（最近 6 条）：" />
                                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="0,2"
                                                        FontFamily="Consolas"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Foreground.Default}"
                                                        Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </cy:Card>

                <!--  ⑤ 综合实战 — 表格列配置  -->
                <cy:Card>
                    <cy:Card.Header>
                        <cy:CardHeader Title="综合实战 — 表格列可见性配置" Subtitle="VisibleColumns 实时驱动表头预览">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="模拟&quot;配置表格可见列&quot;场景。左侧&quot;隐藏列&quot;、右侧&quot;显示列&quot;，配合 ItemTemplate 显示列名 + 描述。下方表头预览实时反映 VisibleColumns——这是 TransferBox 在生产环境最常见用途之一。" />

                        <cy:TransferBox
                            Height="320"
                            HorizontalAlignment="Stretch"
                            SourceItems="{Binding HiddenColumns}"
                            TargetItems="{Binding VisibleColumns}">
                            <cy:TransferBox.SourceHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="隐藏列" />
                            </cy:TransferBox.SourceHeader>
                            <cy:TransferBox.TargetHeader>
                                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="显示列（按顺序）" />
                            </cy:TransferBox.TargetHeader>
                            <cy:TransferBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TableColumn}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource Foreground.Link}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource Foreground.Container}"
                                            Text="{Binding Description}" />
                                    </StackPanel>
                                </DataTemplate>
                            </cy:TransferBox.ItemTemplate>
                        </cy:TransferBox>

                        <TextBlock
                            Margin="0,16,0,8"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="表头预览（实时更新）：" />
                        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                            <ItemsControl Background="{DynamicResource Background.Header}" ItemsSource="{Binding VisibleColumns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TableColumn}">
                                        <Border
                                            Padding="16,12"
                                            BorderBrush="{DynamicResource Border.Default}"
                                            BorderThickness="0,0,1,0">
                                            <StackPanel>
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Foreground.Default}"
                                                    Text="{Binding Name}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Foreground.Container}"
                                                    Text="{Binding Description}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </cy:Card>

            </StackPanel>

            <!--  ============ 底部：API 表 + 代码示例 + 设计要点 ============  -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  API 表  -->
                <cy:Card Grid.Row="0" Margin="0,0,0,20">
                    <cy:Card.Header>
                        <cy:CardHeader Title="主要 API">
                            <cy:CardHeader.Icon>
                                <Border Style="{StaticResource SectionNumberStyle}">
                                    <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                </Border>
                            </cy:CardHeader.Icon>
                        </cy:CardHeader>
                    </cy:Card.Header>

                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource Background.Header}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="成员" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="类型" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource PropTableHeaderStyle}"
                                Text="说明" />
                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Border.Default}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SourceItems" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IList" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="左列表的数据集合。必须实现 INotifyCollectionChanged（推荐 ObservableCollection&lt;T&gt;）。" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TargetItems" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IList" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="右列表的数据集合。同样要求 INotifyCollectionChanged。" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SourceHeader" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="左列表标题。可以是字符串或任意 UI 元素。" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TargetHeader" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="右列表标题。" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SourceDisplayMemberPath" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="左列表显示文本的属性路径（等价于 ItemsControl.DisplayMemberPath）。" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TargetDisplayMemberPath" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="右列表显示文本的属性路径。" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ItemTemplate" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="DataTemplate" />
                            <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="自定义列表项渲染。同时应用于源列表和目标列表。" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ItemContainerStyle" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Style" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="ListBoxItem 样式。default style 已经设了带左侧 CheckBox 的内置样式。" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SourceItemsChanged" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="RoutedEvent" />
                            <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="左列表内容变化（移入 / 移出）后触发。冒泡路由。" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TargetItemsChanged" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="RoutedEvent" />
                            <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="右列表内容变化后触发。每次移动两个事件都会触发。" />
                        </Grid>
                    </Border>
                </cy:Card>

                <!--  代码示例 + 设计要点  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <cy:Card Grid.Column="0">
                        <cy:Card.Header>
                            <cy:CardHeader Title="XAML 示例">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="7" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>
                        <TextBox AcceptsReturn="True" Style="{StaticResource CodeBlockStyle}"><sys:String xml:space="preserve">&lt;!-- 1. 基础（字符串列表）--&gt;
&lt;cy:TransferBox SourceItems="{Binding Available}"
                TargetItems="{Binding Selected}"
                SourceHeader="可选"
                TargetHeader="已选" /&gt;

&lt;!-- 2. 自定义对象 + DisplayMemberPath --&gt;
&lt;cy:TransferBox SourceItems="{Binding AllUsers}"
                TargetItems="{Binding SelectedUsers}"
                SourceDisplayMemberPath="DisplayName"
                TargetDisplayMemberPath="DisplayName" /&gt;

&lt;!-- 3. 自定义 ItemTemplate --&gt;
&lt;cy:TransferBox SourceItems="{Binding Available}"
                TargetItems="{Binding Granted}"&gt;
    &lt;cy:TransferBox.ItemTemplate&gt;
        &lt;DataTemplate&gt;
            &lt;StackPanel Orientation="Horizontal"&gt;
                &lt;Path Data="{Binding IconData}" .../&gt;
                &lt;TextBlock Text="{Binding Name}" /&gt;
            &lt;/StackPanel&gt;
        &lt;/DataTemplate&gt;
    &lt;/cy:TransferBox.ItemTemplate&gt;
&lt;/cy:TransferBox&gt;

&lt;!-- 4. 监听路由事件 --&gt;
&lt;cy:TransferBox SourceItems="{Binding Available}"
                TargetItems="{Binding Selected}"
                SourceItemsChanged="OnSourceChanged"
                TargetItemsChanged="OnTargetChanged" /&gt;

&lt;!-- 5. 程序化触发命令 --&gt;
&lt;Button Command="{x:Static cy:TransferBox.ToTargetCommand}"
        CommandTarget="{Binding ElementName=MyTransferBox}"
        Content="移到右侧" /&gt;</sys:String></TextBox>
                    </cy:Card>

                    <cy:Card Grid.Column="2">
                        <cy:Card.Header>
                            <cy:CardHeader Title="设计要点">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="8" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="ToList 快照" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="批量移动前 SelectedItems.Cast&lt;object&gt;().ToList() 拷贝快照——避免遍历期间集合在变。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="集合类型检查" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="DP 改变时检测非 INotifyCollectionChanged 输出 trace warning——绑普通 List&lt;T&gt; / 数组时立即提示。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="RepeatButton 长按" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="箭头是 RepeatButton——按住可连续触发。配合空选时移&quot;第一项&quot;的逻辑，长按相当于&quot;全部移过去&quot;。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="SelectAll" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Container}"
                                    Text="顶部&quot;全选&quot;CheckBox + 行内 CheckBox 双向同步——通过 ListBoxHelper.IsSelectAllEnabled 附加属性实现。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>
                </Grid>

            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
