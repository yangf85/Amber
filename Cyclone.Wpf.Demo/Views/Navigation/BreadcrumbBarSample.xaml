<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.BreadcrumbBarSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:BreadcrumbBarViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  场景小卡样式  -->
        <Style x:Key="ScenarioCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Breadcrumb demo 容器样式  -->
        <Style x:Key="BreadcrumbHostStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource Background.Default}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Chevron 分隔符模板  -->
        <DataTemplate x:Key="ChevronIndicatorTemplate">
            <Path
                Width="8"
                Height="12"
                Margin="6,0"
                VerticalAlignment="Center"
                Data="M0,0 L6,6 L0,12"
                Stretch="None"
                Stroke="{DynamicResource Foreground.Caption}"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="1.5" />
        </DataTemplate>

        <!--  小图标 Path 样式  -->
        <Style x:Key="ItemIconPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource Icon.Foreground.Default}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M3,6 L7,6 M10,6 L14,6 M17,6 L21,6 M5,10 L5,18 M12,10 L12,18 M19,10 L19,18 M3,18 L7,18 M10,18 L14,18 M17,18 L21,18"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="BreadcrumbBar" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="面包屑导航" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="显示当前位置的层级路径。WinUI 3 风格 — 扁平文本 + 分隔符, 最后一项自动强调为当前位置。支持自定义分隔符(字符 / 模板)、数据绑定、ItemClicked 路由事件。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="文本 + &gt; 分隔符" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="最简形式 — 只有 Content, 默认分隔符是 &gt;。最后一项的分隔符自动隐藏, 文字色加深表示当前位置。" />

            <Border Style="{StaticResource BreadcrumbHostStyle}">
                <cy:BreadcrumbBar>
                    <cy:BreadcrumbBarItem Content="Home" />
                    <cy:BreadcrumbBarItem Content="Documents" />
                    <cy:BreadcrumbBarItem Content="Reports" />
                    <cy:BreadcrumbBarItem Content="2026 年度报告" />
                </cy:BreadcrumbBar>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="提示: 鼠标悬停可点击的项时显示手型 Cursor, 最后一项(当前位置)是箭头 Cursor。" />

            <!--  ========== ② 带图标 ==========  -->
            <cy:SectionHeader
                MainTitle="② 带图标"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Icon 属性 — null 时图标列自动隐藏" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="每个 Item 可以单独设 Icon。Icon=null 时图标列彻底不占空间, 跟没 Icon 的项视觉一致。" />

            <Border Style="{StaticResource BreadcrumbHostStyle}">
                <cy:BreadcrumbBar>
                    <cy:BreadcrumbBarItem Content="Home">
                        <cy:BreadcrumbBarItem.Icon>
                            <Path Data="M3,12 L12,4 L21,12 M5,10 L5,20 L19,20 L19,10" Style="{StaticResource ItemIconPathStyle}" />
                        </cy:BreadcrumbBarItem.Icon>
                    </cy:BreadcrumbBarItem>
                    <cy:BreadcrumbBarItem Content="Documents">
                        <cy:BreadcrumbBarItem.Icon>
                            <Path Data="M5,4 L13,4 L19,10 L19,20 L5,20 Z M13,4 L13,10 L19,10" Style="{StaticResource ItemIconPathStyle}" />
                        </cy:BreadcrumbBarItem.Icon>
                    </cy:BreadcrumbBarItem>
                    <cy:BreadcrumbBarItem Content="Settings">
                        <cy:BreadcrumbBarItem.Icon>
                            <Path Data="M12,8 A4,4 0 1,1 8,12 A4,4 0 0,1 12,8 M12,3 L12,5 M12,19 L12,21 M3,12 L5,12 M19,12 L21,12 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M5.6,18.4 L7,17 M17,7 L18.4,5.6" Style="{StaticResource ItemIconPathStyle}" />
                        </cy:BreadcrumbBarItem.Icon>
                    </cy:BreadcrumbBarItem>
                </cy:BreadcrumbBar>
            </Border>

            <!--  ========== ③ 自定义分隔符 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 自定义分隔符"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Indicator 字符 / IndicatorTemplate 模板" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="默认分隔符是 &gt;, 可以改成任何字符或自定义模板(Path / Image / 任意 UI)。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="路径风格 — / 分隔符" />
            <Border Margin="0,0,0,16" Style="{StaticResource BreadcrumbHostStyle}">
                <cy:BreadcrumbBar>
                    <cy:BreadcrumbBarItem Content="api" Indicator="/" />
                    <cy:BreadcrumbBarItem Content="v2" Indicator="/" />
                    <cy:BreadcrumbBarItem Content="users" Indicator="/" />
                    <cy:BreadcrumbBarItem Content="123" />
                </cy:BreadcrumbBar>
            </Border>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="箭头风格 — → 字符" />
            <Border Margin="0,0,0,16" Style="{StaticResource BreadcrumbHostStyle}">
                <cy:BreadcrumbBar>
                    <cy:BreadcrumbBarItem Content="开始" Indicator="→" />
                    <cy:BreadcrumbBarItem Content="进行中" Indicator="→" />
                    <cy:BreadcrumbBarItem Content="待审核" Indicator="→" />
                    <cy:BreadcrumbBarItem Content="已完成" />
                </cy:BreadcrumbBar>
            </Border>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="Chevron 风格 — Path 模板" />
            <Border Style="{StaticResource BreadcrumbHostStyle}">
                <cy:BreadcrumbBar>
                    <cy:BreadcrumbBarItem Content="项目" IndicatorTemplate="{StaticResource ChevronIndicatorTemplate}" />
                    <cy:BreadcrumbBarItem Content="模块" IndicatorTemplate="{StaticResource ChevronIndicatorTemplate}" />
                    <cy:BreadcrumbBarItem Content="组件" IndicatorTemplate="{StaticResource ChevronIndicatorTemplate}" />
                    <cy:BreadcrumbBarItem Content="详情" />
                </cy:BreadcrumbBar>
            </Border>

            <!--  ========== ④ 动态路径 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 动态路径"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ItemsSource 绑定 + 点击截断" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="ItemsSource 绑定 ObservableCollection&lt;string&gt;。点击任一节点后截断到该节点(模拟文件浏览器跳回上级目录)。code-behind 的 OnBreadcrumbClicked 截断 ViewModel.CurrentPath。" />

            <Border Margin="0,0,0,12" Style="{StaticResource BreadcrumbHostStyle}">
                <cy:BreadcrumbBar ItemClicked="OnBreadcrumbClicked" ItemsSource="{Binding CurrentPath}">
                    <cy:BreadcrumbBar.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type cy:BreadcrumbBarItem}}" TargetType="cy:BreadcrumbBarItem">
                            <Setter Property="Indicator" Value="/" />
                            <EventSetter Event="MouseLeftButtonUp" Handler="OnBreadcrumbClicked" />
                        </Style>
                    </cy:BreadcrumbBar.ItemContainerStyle>
                </cy:BreadcrumbBar>
            </Border>

            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                <Button
                    Padding="14,8"
                    Command="{Binding GoDeeperCommand}"
                    Content="进入子目录" />
                <Button
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Command="{Binding ResetPathCommand}"
                    Content="重置路径" />
            </StackPanel>

            <Border
                Padding="12,10"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="LastClicked =" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding LastClicked, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource ValueLabelStyle}">
                        <Run Text="路径深度 =" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding CurrentPath.Count, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="点击中间节点(如 alice) → 后面所有节点被移除。进入子目录按钮模拟向下导航, 可看到长路径横向滚动。"
                TextWrapping="Wrap" />

            <!--  ========== ⑤ 实战场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 实战场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="文件浏览器 / 管理后台 / 文档站 / 向导流程" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="文件浏览器" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="C: / Users / alice / Documents — 点击节点跳回上级目录"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M4,4 L20,4 L20,20 L4,20 Z M4,9 L20,9 M9,9 L9,20"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="管理后台 / 设置" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="系统 &gt; 用户 &gt; 权限 — 多级嵌套配置页"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M4,4 L20,4 L20,20 L4,20 Z M8,8 L8,16 M12,12 L12,16 M16,10 L16,16"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="文档 / 内容站" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="API → v2 → users → 123 — 用 / 分隔符显示 URL 路径"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M5,8 L19,8 M5,12 L19,12 M5,16 L12,16"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Info}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="向导 / 流程" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="开始 → 配置 → 完成 — 用 → 分隔符表示前进流程"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="BreadcrumbBar / BreadcrumbBarItem 配置属性 / 事件" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性 / 事件" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBar.ItemsSource" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IEnumerable" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="继承自 ListBox。绑定动态路径数据, 通常是 ObservableCollection&lt;string&gt; 或自定义 PathSegment。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBar.ItemClicked" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="RoutedEvent" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="用户点击某项时触发。OriginalSource 是被点击的 BreadcrumbBarItem, 通过 .Content 获取数据。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBarItem.Content" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="项的显示内容, 通常是字符串。继承自 ContentControl。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBarItem.Icon" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="左侧图标, 通常是 Path 或 Image。null 时图标列彻底隐藏(不占空间)。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBarItem.Indicator" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="object (&quot;&gt;&quot;)" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="右侧分隔符内容, 可设为任意字符 (/ → |) 或对象。最后一项自动隐藏。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBarItem.IndicatorTemplate" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="DataTemplate" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Indicator 的 DataTemplate, 用于完全自定义分隔符渲染(Path 箭头、Image 等)。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBarItem.IsFirst / IsLast" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (只读)" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="位置元数据。IsLast=true 时分隔符隐藏, 文字色加深为 Foreground.Default。由 BreadcrumbBar 自动维护。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="BreadcrumbBarItem.IsSelected" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (TwoWay)" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="继承自 ListBoxItem。点击时设为 true, 可通过 BreadcrumbBar.SelectedItem 程序化访问。" />
                </Grid>
            </Border>

