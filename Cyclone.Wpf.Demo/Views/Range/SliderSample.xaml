<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SliderSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:SliderViewModel}}"
    d:DesignHeight="3400"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  场景小卡样式  -->
        <Style x:Key="ScenarioCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Slider 三列布局 (Label + Slider + Value)  -->
        <Style x:Key="SliderRowLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
        </Style>
        <Style x:Key="SliderRowValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <!--  Icon: 水平轨道 + 圆形 Thumb  -->
                        <Grid
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Rectangle
                                Height="3"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Text.Invert}" />
                            <Ellipse
                                Width="12"
                                Height="12"
                                Margin="14,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Text.Invert}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Slider" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="原生 + 主题样式" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="原生 Slider 的主题样式 — Passed 段主色填充, Thumb 拖动时显示 ToolTip。支持离散步长(IsSnapToTickEnabled)、刻度线(TickPlacement)、水平 / 垂直方向。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Value · Minimum · Maximum + 实时数值" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Value 双向绑定 ViewModel, Min/Max 限定区间。拖动时 ToolTip 实时显示数值, Passed 段用主色, Unpassed 段灰色。" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource SliderRowLabelStyle}"
                    Text="音量" />
                <Slider
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Volume, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource SliderRowValueStyle}"
                    Text="{Binding Volume, StringFormat={}{0:F0}%}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource SliderRowLabelStyle}"
                    Text="亮度" />
                <Slider
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Brightness, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource SliderRowValueStyle}"
                    Text="{Binding Brightness, StringFormat={}{0:F0}%}" />
            </Grid>

            <!--  ========== ② 离散步长 + 刻度 ==========  -->
            <cy:SectionHeader
                MainTitle="② 离散步长 + 刻度"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsSnapToTickEnabled · TickFrequency · TickPlacement" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="设 IsSnapToTickEnabled=True + TickFrequency=1, Thumb 会吸附到整数刻度。TickPlacement 控制刻度位置(TopLeft / BottomRight / Both)。" />

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource SliderRowLabelStyle}"
                    Text="评分" />
                <Slider
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    IsSnapToTickEnabled="True"
                    Maximum="10"
                    Minimum="0"
                    TickFrequency="1"
                    TickPlacement="BottomRight"
                    Value="{Binding Rating, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource SliderRowValueStyle}"
                    Text="{Binding Rating, StringFormat={}{0:F0} 分}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource SliderRowLabelStyle}"
                    Text="预算" />
                <Slider
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    IsSnapToTickEnabled="True"
                    LargeChange="500"
                    Maximum="10000"
                    Minimum="0"
                    SmallChange="100"
                    TickFrequency="100"
                    Value="{Binding Price, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource SliderRowValueStyle}"
                    Text="{Binding PriceText}" />
            </Grid>
            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="预算 Slider 步长 100, LargeChange=500 (PageUp/Down)、SmallChange=100 (方向键)。"
                TextWrapping="Wrap" />

            <!--  ========== ③ 禁用态 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 禁用态"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsEnabled=False" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="禁用时整体置灰, Thumb 不响应鼠标和键盘。带刻度的版本刻度线也一同置灰。" />

            <Slider
                Margin="0,0,0,12"
                IsEnabled="False"
                Maximum="100"
                Minimum="0"
                Value="40" />

            <Slider
                IsEnabled="False"
                IsSnapToTickEnabled="True"
                Maximum="10"
                Minimum="0"
                TickFrequency="1"
                TickPlacement="BottomRight"
                Value="3" />

            <!--  ========== ④ 垂直布局 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 垂直布局"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Orientation=Vertical · 均衡器示意" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="设 Orientation=Vertical 切换为垂直布局。WPF Slider 垂直时 Min 在底、Max 在顶(跟视觉直觉一致)。三个垂直 Slider 模拟均衡器 — 中间那个加了 TickPlacement=BottomRight。" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <StackPanel Margin="0,0,28,0" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding VerticalLevel1, StringFormat={}{0:F0}}" />
                    <Slider
                        Height="180"
                        Margin="0,8"
                        HorizontalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Orientation="Vertical"
                        Value="{Binding VerticalLevel1, Mode=TwoWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="低音" />
                </StackPanel>

                <StackPanel Margin="0,0,28,0" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding VerticalLevel2, StringFormat={}{0:F0}}" />
                    <Slider
                        Height="180"
                        Margin="0,8"
                        HorizontalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="100"
                        Minimum="0"
                        Orientation="Vertical"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="{Binding VerticalLevel2, Mode=TwoWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="中音" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding VerticalLevel3, StringFormat={}{0:F0}}" />
                    <Slider
                        Height="180"
                        Margin="0,8"
                        HorizontalAlignment="Center"
                        Maximum="100"
                        Minimum="0"
                        Orientation="Vertical"
                        Value="{Binding VerticalLevel3, Mode=TwoWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="高音" />
                </StackPanel>
            </StackPanel>

            <!--  ========== ⑤ 实战 · RGB 颜色调节 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 实战 · RGB 颜色调节"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="三个 Slider 联动颜色预览" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="经典场景:三个 Slider 分别调 R/G/B, 实时拼接成颜色预览。ViewModel 把 Red/Green/Blue 三个属性合成成 PreviewBrush + ColorHex 字符串。" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Height="64"
                    Background="{Binding PreviewBrush}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1" />
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="{Binding ColorHex}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="实时预览, 拖动 R/G/B 即时更新" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontWeight="Bold"
                    Foreground="#E53935"
                    Text="R" />
                <Slider
                    Grid.Column="1"
                    Margin="8,0,12,0"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1"
                    Value="{Binding Red, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{DynamicResource Foreground.Default}"
                    Text="{Binding Red, StringFormat={}{0:F0}}" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontWeight="Bold"
                    Foreground="#43A047"
                    Text="G" />
                <Slider
                    Grid.Column="1"
                    Margin="8,0,12,0"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1"
                    Value="{Binding Green, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{DynamicResource Foreground.Default}"
                    Text="{Binding Green, StringFormat={}{0:F0}}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontWeight="Bold"
                    Foreground="#1E88E5"
                    Text="B" />
                <Slider
                    Grid.Column="1"
                    Margin="8,0,12,0"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1"
                    Value="{Binding Blue, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    Foreground="{DynamicResource Foreground.Default}"
                    Text="{Binding Blue, StringFormat={}{0:F0}}" />
            </Grid>

            <!--  ========== ⑥ 实战场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 实战场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="音量 / 评分 / 均衡器 / 时间线" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M4,8 L8,8 L12,4 L12,20 L8,16 L4,16 Z M16,8 A6,6 0 0,1 16,16"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="音量 / 亮度" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="0-100 百分比, 实时反馈"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M12,4 L14.5,9 L20,10 L16,14 L17,20 L12,17 L7,20 L8,14 L4,10 L9.5,9 Z"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="评分 / 等级" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="离散步长 + Tick 可视化"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M6,4 V20 M10,8 V20 M14,4 V16 M18,10 V20"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="均衡器 / 混音器" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="多个垂直 Slider 并排, 音频 / 调色板专用"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M12,3 A9,9 0 1,1 11.99,3 M12,7 L12,12 L16,14"
                            Stretch="None"
                            Stroke="{DynamicResource Foreground.Info}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="进度 / 时间线" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="视频播放进度、时间选择"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ⑦ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="原生 Slider 成员(RangeBase 继承)" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型 (默认)" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Value" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0)" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前值, 默认 TwoWay 绑定。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Minimum / Maximum" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0 / 10)" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数值范围。注意默认 Maximum=10, 常需显式改为 100。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Orientation" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (Horizontal)" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Horizontal / Vertical。Vertical 时 Min 在底、Max 在顶。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSnapToTickEnabled" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="True 时 Thumb 吸附到 Tick 位置(整数滑块必备)。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickFrequency" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (1)" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Tick 间距, 与 IsSnapToTickEnabled 配合决定吸附步长。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickPlacement" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (None)" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="None / TopLeft / BottomRight / Both。控制刻度线是否显示及位置。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SmallChange / LargeChange" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0.1 / 1)" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="方向键 / PageUp · PageDown 的步长。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="AutoToolTipPlacement / AutoToolTipPrecision" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum / int" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="拖动时自动显示数值 ToolTip。本主题默认 TopLeft + 2 位精度。" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsDirectionReversed" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="反向 — 让 Max 在起始端。少见, RTL 布局或特殊视觉需求时用。" />
                </Grid>
            </Border>

            <!--  ========== ⑧ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑧ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Slider 主题样式的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="不引入新 DP, 完全用原生 Slider" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Value / IsSnapToTickEnabled / TickFrequency / TickPlacement 全部沿用 WPF Slider, 没有新增任何依赖属性"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Passed 段填色 + Unpassed 段轨道灰" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="通过 RepeatButton.PART_LeftBackground 与 RightBackground 上色 — 不需要 IValueConverter 即可实现 WinUI 3 风格视觉"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="AutoToolTip 默认开启" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="默认 AutoToolTipPlacement=TopLeft + 精度 2 位, 拖动时实时显示数值, 无需业务侧绑定额外 Tooltip"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="离散滑块用 IsSnapToTickEnabled" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="整数 / 步长滑块标配。TickFrequency 同时充当吸附粒度, 不需要业务侧自己 Round"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
