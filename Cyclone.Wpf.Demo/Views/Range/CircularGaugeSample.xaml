<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.CircularGaugeSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Cyclone.Wpf.Controls;assembly=Cyclone.Wpf"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:CircularGaugeViewModel}}"
    d:DesignHeight="3200"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <!--  Icon: 半圆 + 指针  -->
                        <Grid
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Path
                                Data="M4,20 A12,12 0 0,1 28,20"
                                Stretch="None"
                                Stroke="{DynamicResource Text.Invert}"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeThickness="2.5" />
                            <Path
                                Data="M16,20 L22,10"
                                Stretch="None"
                                Stroke="{DynamicResource Text.Invert}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2.5" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="CircularGauge" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="圆形仪表" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="圆形仪表盘 — 分段染色 Ranges、可拖动 + 完整键盘交互、SweepAngle 从扇形到完整圆环可配置、自带 Value 平滑过渡动画。常用于 CPU / 温度 / 速度 / 电量等实时监控场景。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 实时监控仪表板 ==========  -->
            <cy:SectionHeader
                MainTitle="① 实时监控仪表板"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="模拟 CPU / 温度 / 速度 / 电量 · 多 Gauge 同时工作" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="数据每 800ms 自动变化 (DispatcherTimer), 观察指针平滑动画。每个 Gauge 都用 Ranges 配置了不同的分段染色 — 同一数值区间在不同业务里有不同语义。" />

            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <CheckBox Content="开启模拟数据更新" IsChecked="{Binding IsSimulating}" />
                <Button
                    Margin="16,0,0,0"
                    Padding="14,4"
                    Command="{Binding ResetAllCommand}"
                    Content="重置所有" />
            </StackPanel>

            <UniformGrid Columns="2" Rows="2">
                <Border Padding="8" Background="Transparent">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource DemoItemTitleStyle}"
                            Text="CPU 使用率" />
                        <ctl:CircularGauge
                            Width="160"
                            Height="160"
                            HorizontalAlignment="Center"
                            LargeChange="20"
                            Maximum="100"
                            Minimum="0"
                            SmallChange="5"
                            Unit="%"
                            Value="{Binding CpuUsage}"
                            ValueStringFormat="{}{0:F0}">
                            <ctl:CircularGauge.Ranges>
                                <ctl:GaugeRange
                                    Brush="#4CAF50"
                                    From="0"
                                    To="60" />
                                <ctl:GaugeRange
                                    Brush="#FF9800"
                                    From="60"
                                    To="85" />
                                <ctl:GaugeRange
                                    Brush="#F44336"
                                    From="85"
                                    To="100" />
                            </ctl:CircularGauge.Ranges>
                        </ctl:CircularGauge>
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="Transparent">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource DemoItemTitleStyle}"
                            Text="环境温度" />
                        <ctl:CircularGauge
                            Width="160"
                            Height="160"
                            HorizontalAlignment="Center"
                            LargeChange="10"
                            Maximum="50"
                            Minimum="-10"
                            SmallChange="5"
                            Unit="°C"
                            Value="{Binding Temperature}"
                            ValueStringFormat="{}{0:F1}">
                            <ctl:CircularGauge.Ranges>
                                <ctl:GaugeRange
                                    Brush="#2196F3"
                                    From="-10"
                                    To="10" />
                                <ctl:GaugeRange
                                    Brush="#4CAF50"
                                    From="10"
                                    To="30" />
                                <ctl:GaugeRange
                                    Brush="#F44336"
                                    From="30"
                                    To="50" />
                            </ctl:CircularGauge.Ranges>
                        </ctl:CircularGauge>
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="Transparent">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource DemoItemTitleStyle}"
                            Text="车辆速度" />
                        <ctl:CircularGauge
                            Width="160"
                            Height="160"
                            HorizontalAlignment="Center"
                            LargeChange="40"
                            Maximum="200"
                            Minimum="0"
                            SmallChange="10"
                            Unit="km/h"
                            Value="{Binding Speed}"
                            ValueStringFormat="{}{0:F0}">
                            <ctl:CircularGauge.Ranges>
                                <ctl:GaugeRange
                                    Brush="#4CAF50"
                                    From="0"
                                    To="80" />
                                <ctl:GaugeRange
                                    Brush="#FF9800"
                                    From="80"
                                    To="120" />
                                <ctl:GaugeRange
                                    Brush="#F44336"
                                    From="120"
                                    To="200" />
                            </ctl:CircularGauge.Ranges>
                        </ctl:CircularGauge>
                    </StackPanel>
                </Border>

                <Border Padding="8" Background="Transparent">
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource DemoItemTitleStyle}"
                            Text="电池电量" />
                        <ctl:CircularGauge
                            Width="160"
                            Height="160"
                            HorizontalAlignment="Center"
                            LargeChange="25"
                            Maximum="100"
                            Minimum="0"
                            SmallChange="5"
                            Unit="%"
                            Value="{Binding BatteryLevel}"
                            ValueStringFormat="{}{0:F0}">
                            <ctl:CircularGauge.Ranges>
                                <ctl:GaugeRange
                                    Brush="#F44336"
                                    From="0"
                                    To="20" />
                                <ctl:GaugeRange
                                    Brush="#FF9800"
                                    From="20"
                                    To="50" />
                                <ctl:GaugeRange
                                    Brush="#4CAF50"
                                    From="50"
                                    To="100" />
                            </ctl:CircularGauge.Ranges>
                        </ctl:CircularGauge>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--  ========== ② 拖动 / 键盘交互 ==========  -->
            <cy:SectionHeader
                MainTitle="② 拖动 / 键盘交互"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsDraggable + 键盘 ↑↓ PgUp/Dn Home/End" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="鼠标拖动指针调整 Value — 死区(底部 90°)不响应, 避免误操作跳变到最大值。点击 Gauge 获得焦点后 ↑↓ ±SmallChange, PgUp/Dn ±LargeChange, Home/End 跳到 Min/Max。" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ctl:CircularGauge
                    Width="200"
                    Height="200"
                    IsDraggable="True"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    Unit="Value"
                    Value="{Binding Value1, Mode=TwoWay}"
                    ValueStringFormat="{}{0:F0}" />
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ValueLabelStyle}" Text="操作提示" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="• 鼠标拖动指针" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="• ↑→ +1, ↓← −1" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="• PgUp +10, PgDn −10" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="• Home = 0, End = 100" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontFamily="Consolas"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding Value1, StringFormat={}{0:F0}}" />
                </StackPanel>
            </StackPanel>

            <!--  ========== ③ SweepAngle 弧形跨度 ==========  -->
            <cy:SectionHeader
                MainTitle="③ SweepAngle 弧形跨度"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="从扇形到完整圆环 · 90° 至 360°" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="SweepAngle 控制弧形跨度。180° = 半圆, 270° = 默认, 360° = 完整圆环。0° 始终是顶部 12 点钟方向。" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource ValueLabelStyle}"
                    Text="SweepAngle" />
                <Slider
                    Grid.Column="1"
                    IsSnapToTickEnabled="True"
                    Maximum="360"
                    Minimum="90"
                    TickFrequency="30"
                    TickPlacement="BottomRight"
                    Value="{Binding DemoSweepAngle, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    Foreground="{DynamicResource Foreground.Link}"
                    Text="{Binding DemoSweepAngle, StringFormat={}{0:F0}°}" />
            </Grid>

            <ctl:CircularGauge
                Width="200"
                Height="200"
                HorizontalAlignment="Center"
                LargeChange="20"
                Maximum="100"
                Minimum="0"
                SmallChange="5"
                SweepAngle="{Binding DemoSweepAngle}"
                Unit=""
                Value="{Binding DemoValue, Mode=TwoWay}"
                ValueStringFormat="{}{0:F0}" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource ValueLabelStyle}"
                    Text="Value" />
                <Slider
                    Grid.Column="1"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding DemoValue, Mode=TwoWay}" />
            </Grid>

            <!--  ========== ④ 尺寸自适应 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 尺寸自适应"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="同一控件不同 Width / Height · Viewbox 模板自动缩放" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Viewbox 模板, 指针自动随控件大小缩放。配合 FontSize / LabelFontSize 调整中心数值字号与刻度文字字号。三个 Gauge 共享同一 CpuUsage 源, 只是尺寸不同。" />

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ctl:CircularGauge
                    Width="100"
                    Height="100"
                    Margin="0,0,12,0"
                    FontSize="14"
                    LabelFontSize="8"
                    Value="{Binding CpuUsage}" />
                <ctl:CircularGauge
                    Width="160"
                    Height="160"
                    Margin="0,0,12,0"
                    Value="{Binding CpuUsage}" />
                <ctl:CircularGauge
                    Width="220"
                    Height="220"
                    FontSize="30"
                    LabelFontSize="14"
                    Value="{Binding CpuUsage}" />
            </StackPanel>

            <!--  ========== ⑤ 极简模式 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 极简模式"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="无 Ranges / 无 Unit · AnimationDuration 对比" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="不设 Ranges 就没有分段染色环; 不设 Unit (或设 null/空字符串) 就不显示单位文字。下面对比 0ms (瞬间) 和 800ms (慢动画) 两种 AnimationDuration。" />

            <UniformGrid Columns="2">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource DemoItemTitleStyle}"
                        Text="瞬间 (AnimationDuration=0)" />
                    <ctl:CircularGauge
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Center"
                        AnimationDuration="0:0:0"
                        Value="{Binding CpuUsage}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource DemoItemTitleStyle}"
                        Text="慢动画 (AnimationDuration=0.8s)" />
                    <ctl:CircularGauge
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Center"
                        AnimationDuration="0:0:0.8"
                        Value="{Binding CpuUsage}" />
                </StackPanel>
            </UniformGrid>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="CircularGauge 配置属性 + 行为" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型 (默认)" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Value" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0)" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前值, 继承自 RangeBase。指针位置通过 AnimationDuration 平滑过渡。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Minimum / Maximum" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0 / 100)" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数值范围, 决定指针的可达区间。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SmallChange / LargeChange" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="键盘 ↑↓ 与 PgUp/Dn 的步长。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SweepAngle" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (270)" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="弧形跨度 (度)。90 = 1/4 圆, 180 = 半圆, 270 = 默认, 360 = 完整圆环。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Ranges" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="GaugeRangeCollection" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="分段染色配置, 每段是 (From, To, Brush)。null / 空时无分段染色环。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Unit" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数值下方的单位文字 (%、°C、km/h 等)。null / 空时不显示。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ValueStringFormat" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="中心数值的格式串, 例如 {}{0:F0} (整数)、{}{0:F1} (一位小数)。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsDraggable" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="True 时启用鼠标拖动指针 + 键盘交互。底部 90° 死区不响应避免误操作。" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="AnimationDuration" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Duration" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Value 变化时指针的过渡时长。0 = 瞬间, 较长时间适合监控场景。" />
                </Grid>
            </Border>

            <!--  ========== ⑦ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="CircularGauge 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="继承 RangeBase, 复用 Slider 语义" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Value / Minimum / Maximum / SmallChange / LargeChange 全部沿用 RangeBase, 任何熟悉 Slider 的开发者无学习成本"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Ranges 是声明式分段染色" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="不需要 IValueConverter 或 DataTrigger — 用 (From, To, Brush) 三元组列举即可。同一数值范围在不同业务里给不同颜色"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="底部 90° 拖动死区" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="拖动时底部 90° 范围不响应, 避免指针穿越底部时跳变到 Max 端。SweepAngle &lt; 360 时尤为关键"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Viewbox 模板尺寸自适应" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="内部所有几何按 Viewbox 缩放, 改 Width/Height 即可不同尺寸; FontSize / LabelFontSize 单独调节文字字号"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
