<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.RangeSliderSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:RangeSliderViewModel}}"
    d:DesignHeight="3200"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  场景小卡样式  -->
        <Style x:Key="ScenarioCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <!--  Icon: 轨道 + 两个 thumb  -->
                        <Grid
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Rectangle
                                Height="3"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Text.Invert}" />
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Text.Invert}" />
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Text.Invert}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="RangeSlider" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="区间选择" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="区间选择滑块 — 两个 thumb 分别控制 LowerValue / UpperValue, 两者之间的轨道高亮显示。支持 Step 步进、TickFrequency 刻度、AutoToolTip、垂直布局等。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Minimum · Maximum · LowerValue · UpperValue" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="拖动两端 thumb 调整区间, 点击轨道空白处按 LargeChange 跳跃。中段单击靠近哪个 thumb 移哪个(IsMoveToPoint=true)。Lower / Upper 自动 coerce 保证不交叉。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <cy:RangeSlider
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    AutoToolTipPlacement="TopLeft"
                    LowerValue="{Binding PriceLower, Mode=TwoWay}"
                    Maximum="1000"
                    Minimum="0"
                    UpperValue="{Binding PriceUpper, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="{DynamicResource Foreground.Link}"
                    Text="{Binding PriceRangeText}" />
            </Grid>
            <TextBlock
                Margin="0,12,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="拖动 thumb 时显示数值 ToolTip (AutoToolTipPlacement=TopLeft)。" />

            <!--  ========== ② Step / LargeChange / 键盘 ==========  -->
            <cy:SectionHeader
                MainTitle="② Step / LargeChange / 键盘"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Step=1 + LargeChange=10 · 完整键盘交互" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="Step=1(方向键步进) / LargeChange=10(PageUp/Down 步进 + 点击轨道空白处的步进)。先 Tab 给 thumb 焦点, 再用方向键试试。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <cy:RangeSlider
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    AutoToolTipPlacement="TopLeft"
                    IsSnapToStep="True"
                    LargeChange="10"
                    LowerValue="{Binding HourLower, Mode=TwoWay}"
                    Maximum="24"
                    Minimum="0"
                    Step="1"
                    UpperValue="{Binding HourUpper, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="{DynamicResource Foreground.Link}"
                    Text="{Binding HourRangeText}" />
            </Grid>

            <Border
                Margin="0,16,0,0"
                Padding="12,10"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="键盘交互" />
                    <UniformGrid Margin="0,8,0,0" Columns="2">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Tab" />
                            <Run Text=" 切换 thumb 焦点" />
                        </TextBlock>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="←/→ ↑/↓" />
                            <Run Text=" ±Step" />
                        </TextBlock>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="PgUp/PgDn" />
                            <Run Text=" ±LargeChange" />
                        </TextBlock>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Home/End" />
                            <Run Text=" 跳到两端" />
                        </TextBlock>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!--  ========== ③ 刻度线 / 离散值 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 刻度线 / 离散值"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="TickPlacement · TickFrequency · IsSnapToTick" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="TickPlacement 控制刻度线位置 (None / TopLeft / BottomRight / Both)。IsSnapToTick 让 thumb 吸附到刻度线 — 优先级高于 IsSnapToStep。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="TickPlacement=Both · TickFrequency=10" />
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <cy:RangeSlider
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    AutoToolTipPlacement="TopLeft"
                    IsSnapToTick="True"
                    LowerValue="{Binding AgeLower, Mode=TwoWay}"
                    Maximum="100"
                    Minimum="0"
                    TickFrequency="10"
                    TickPlacement="Both"
                    UpperValue="{Binding AgeUpper, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="{DynamicResource Foreground.Link}"
                    Text="{Binding AgeRangeText}" />
            </Grid>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="TickPlacement=BottomRight · 小数步长 0.1" />
            <cy:RangeSlider
                LowerValue="0.3"
                Maximum="1"
                Minimum="0"
                Step="0.1"
                TickFrequency="0.1"
                TickPlacement="BottomRight"
                UpperValue="0.7" />

            <!--  ========== ④ MVVM 双向绑定 ==========  -->
            <cy:SectionHeader
                MainTitle="④ MVVM 双向绑定"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="LowerValue / UpperValue 默认 TwoWay · 透明度可视化" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="LowerValue / UpperValue 默认双向绑定到 ViewModel。下方两个色块的 Opacity 直接绑定 OpacityLower / OpacityUpper, 拖动滑块即时反馈。" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <cy:RangeSlider
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    AutoToolTipPlacement="TopLeft"
                    AutoToolTipPrecision="2"
                    LargeChange="0.1"
                    LowerValue="{Binding OpacityLower, Mode=TwoWay}"
                    Maximum="1"
                    Minimum="0"
                    Step="0.05"
                    UpperValue="{Binding OpacityUpper, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}">
                        <Run Text="Lower:" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding OpacityLower, Mode=OneWay, StringFormat=F2}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource ValueLabelStyle}">
                        <Run Text="Upper:" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding OpacityUpper, Mode=OneWay, StringFormat=F2}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border
                Height="60"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid>
                    <Border
                        Width="60"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Foreground.Link}"
                        Opacity="{Binding OpacityLower}" />
                    <Border
                        Width="60"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Foreground.Link}"
                        Opacity="{Binding OpacityUpper}" />
                    <TextBlock
                        Margin="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="左 = OpacityLower / 中 = OpacityUpper" />
                </Grid>
            </Border>

            <!--  ========== ⑤ 实战场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 实战场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="价格筛选 / 时间窗口 / 温度区间 / 数据过滤" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M12,2 L13,8 L20,8 L14,12 L17,19 L12,15 L7,19 L10,12 L4,8 L11,8 Z"
                            Fill="{DynamicResource Foreground.Warning}"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeThickness="1" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="价格筛选" />
                        <cy:RangeSlider
                            Margin="0,8,0,8"
                            LowerValue="200"
                            Maximum="2000"
                            Minimum="0"
                            Step="50"
                            UpperValue="1500" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="商品列表、机票酒店"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M12,2 A10,10 0 1,1 2,12 A10,10 0 0,1 12,2 M12,6 L12,12 L17,15"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="时间窗口" />
                        <cy:RangeSlider
                            Margin="0,8,0,8"
                            IsSnapToStep="True"
                            LowerValue="9"
                            Maximum="24"
                            Minimum="0"
                            Step="1"
                            UpperValue="18" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="工作时段、营业时间"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M9,2 A3,3 0 0,1 15,2 V12 A6,6 0 1,1 9,12 Z"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="温度区间" />
                        <cy:RangeSlider
                            Margin="0,8,0,8"
                            LowerValue="-5"
                            Maximum="40"
                            Minimum="-20"
                            TickFrequency="10"
                            TickPlacement="BottomRight"
                            UpperValue="25" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="设备控制、阈值监控"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M3,3 L21,3 L21,21 L3,21 Z M3,3 L21,21 M21,3 L3,21"
                            Stroke="#8B5CF6"
                            StrokeThickness="1.5" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="数据过滤" />
                        <cy:RangeSlider
                            Margin="0,8,0,8"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            LowerValue="20"
                            Maximum="100"
                            Minimum="0"
                            UpperValue="80" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="柱状图、直方图过滤"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="RangeSlider 配置属性" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Minimum / Maximum" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (0 / 100)" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="区间端点。Min / Max 自动 coerce 互不交叉。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="LowerValue / UpperValue" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (TwoWay)" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="区间下界 / 上界, 默认 TwoWay。Lower ≤ Upper 自动保证。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Step" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (1)" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="方向键 / IsSnapToStep 步进。必须 &gt; 0。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="LargeChange" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (10)" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="PageUp / Down 步进, 以及点击轨道空白段时的步进量。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSnapToStep" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (true)" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否对齐到 Step 整数倍。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSnapToTick" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否对齐到刻度线。优先级高于 IsSnapToStep。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickFrequency / Ticks" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double / DoubleCollection" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="等距刻度频率 / 自定义刻度位置。Ticks 设了之后 TickFrequency 失效。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="TickPlacement" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (None)" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="刻度线显示位置: None / TopLeft / BottomRight / Both。" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Orientation" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (Horizontal)" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Horizontal / Vertical。" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsDirectionReversed" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                    <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="反转方向。键盘和拖动方向同步反转。" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsMoveToPoint" />
                    <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (true)" />
                    <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="点击中段轨道时的行为。true = 移动最近的 thumb 到点击点, false = 按 LargeChange 步进。" />

                    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="AutoToolTipPlacement" />
                    <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (None)" />
                    <TextBlock Grid.Row="12" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="拖动 thumb 时显示数值 ToolTip 的位置。" />
                </Grid>
            </Border>

            <!--  ========== ⑦ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="RangeSlider 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Lower ≤ Upper 自动 coerce" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="代码 / 绑定写入 LowerValue &gt; UpperValue 时, 控件内部 coerce 保证两者不交叉, 无需业务侧校验"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="IsSnapToTick 优先于 IsSnapToStep" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="自定义刻度 (Ticks DoubleCollection) 给业务侧最大灵活度 — 例如 [0, 25, 50, 75, 100] 跳点选择, 不需要等距 Step"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="IsMoveToPoint=true 默认" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="点击中段轨道时移动最近的 thumb 到点击点 — 比按 LargeChange 步进更符合用户预期 (与现代 web range slider 一致)"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="区间高亮独立于 Tick 视觉" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ActiveTrackBrush / InactiveTrackBrush 分别控制区间内外的轨道刷子, 与 TickPlacement 独立。便于品牌色定制"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
