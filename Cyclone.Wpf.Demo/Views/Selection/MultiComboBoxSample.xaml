<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.MultiComboBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:MultiComboBoxViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  场景小卡样式  -->
        <Style x:Key="ScenarioCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <!--  Icon: 三个堆叠的 chip 形矩形  -->
                        <Grid
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Rectangle
                                Width="16"
                                Height="6"
                                Margin="0,0,8,12"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Stroke="{DynamicResource Text.Invert}"
                                StrokeThickness="2" />
                            <Rectangle
                                Width="16"
                                Height="6"
                                Margin="6,8,0,8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Stroke="{DynamicResource Text.Invert}"
                                StrokeThickness="2" />
                            <Rectangle
                                Width="16"
                                Height="6"
                                Margin="0,12,8,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Stroke="{DynamicResource Text.Invert}"
                                StrokeThickness="2" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="MultiComboBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="继承 ListBox" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="下拉式多选控件 — 已选项以 chip 形式展示在控件内, 每个 chip 自带 × 按钮可单独移除。支持全选 / 自定义 chip 模板; SelectedItemsBindable 绕过原生 ListBox.SelectedItems 不可绑定的限制。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ItemsSource · SelectedItemsBindable · Watermark" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="点击下拉箭头展开列表, 鼠标点击或 Space 键切换选中状态。已选项以 chip 显示在控件内, 每个 chip 上的 × 可单独移除。SelectedItemsBindable 双向同步到 ObservableCollection。" />

            <cy:MultiComboBox
                Width="320"
                HorizontalAlignment="Left"
                ItemsSource="{Binding Cities}"
                SelectedItemsBindable="{Binding SelectedCities}"
                Watermark="选择城市..." />

            <TextBlock
                Margin="0,12,0,0"
                FontSize="12"
                Foreground="{DynamicResource Foreground.Caption}">
                <Run Text="已选数量:" />
                <Run
                    FontWeight="Bold"
                    Foreground="{DynamicResource Foreground.Link}"
                    Text="{Binding SelectedCities.Count, Mode=OneWay}" />
                <Run Text="项" />
            </TextBlock>

            <!--  ========== ② DisplayMemberPath + 自定义 chip ==========  -->
            <cy:SectionHeader
                MainTitle="② 数据对象 / 自定义 chip"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="DisplayMemberPath · SelectionChipTemplate" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="DisplayMemberPath 决定数据对象上显示哪个字段(默认走 ToString())。SelectionChipTemplate 可完全自定义 chip 视觉 — 自定义模板时需保留绑定 RemoveItemCommand 的按钮以实现单项移除。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="DisplayMemberPath(默认 chip 视觉, 取 Name 字段)" />
            <cy:MultiComboBox
                Width="320"
                HorizontalAlignment="Left"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Products}"
                SelectedItemsBindable="{Binding SelectedProducts}"
                Watermark="选择产品..." />

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="SelectionChipTemplate(自定义 pill 形状 chip)" />
            <cy:MultiComboBox
                Width="320"
                HorizontalAlignment="Left"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Products}"
                Watermark="选择产品...">
                <cy:MultiComboBox.SelectionChipTemplate>
                    <DataTemplate>
                        <Border
                            Margin="2"
                            Padding="10,3,4,3"
                            Background="{DynamicResource Background.Highlighted}"
                            CornerRadius="999">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="{Binding Name}" />
                                <Button
                                    Width="16"
                                    Height="16"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Static cy:MultiComboBox.RemoveItemCommand}"
                                    CommandParameter="{Binding}"
                                    Content="×"
                                    Foreground="{DynamicResource Text.Invert}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </cy:MultiComboBox.SelectionChipTemplate>
            </cy:MultiComboBox>
            <TextBlock
                Margin="0,8,0,0"
                FontSize="11"
                Foreground="{DynamicResource Foreground.Caption}"
                Text="自定义 chip 时, 模板内放一个 Command={x:Static cy:MultiComboBox.RemoveItemCommand}、CommandParameter={Binding} 的按钮即可保留单项删除能力。"
                TextWrapping="Wrap" />

            <!--  ========== ③ 全选 / 自定义文本 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 全选 / 自定义文本"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsSelectAllVisible · SelectAllText" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="IsSelectAllVisible=True 在下拉顶部显示全选 CheckBox(三态: 全选 / 部分 / 未选)。SelectAllText 自定义全选文字, 默认为 '全选'。" />

            <cy:MultiComboBox
                Width="320"
                HorizontalAlignment="Left"
                IsSelectAllVisible="True"
                ItemsSource="{Binding Permissions}"
                SelectAllText="授予所有权限"
                SelectedItemsBindable="{Binding SelectedPermissions}"
                Watermark="选择权限..." />

            <!--  ========== ④ MVVM 双向绑定 ==========  -->
            <cy:SectionHeader
                MainTitle="④ MVVM 双向绑定"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="UI ↔ ViewModel 实时同步" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="左侧 MultiComboBox 的选中状态直接反映到右侧 ViewModel 视图(ItemsControl 绑同一个 SelectedRecipients 集合), 反之亦然。SelectedItemsBindable 是 MultiComboBox 为绕过 ListBox.SelectedItems 不可绑定限制设计的镜像依赖属性。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="选择收件人" />
                    <cy:MultiComboBox
                        DisplayMemberPath="Name"
                        IsSelectAllVisible="True"
                        ItemsSource="{Binding Recipients}"
                        SelectedItemsBindable="{Binding SelectedRecipients}"
                        Watermark="收件人..." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="ViewModel 视图(实时同步)" />
                    <Border
                        Padding="12"
                        Background="{DynamicResource Background.Header}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text="已选 " />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Foreground.Link}"
                                    Text="{Binding SelectedRecipients.Count, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource Foreground.Caption}"
                                    Text=" 项" />
                            </StackPanel>
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedRecipients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,2,0,2"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource Foreground.Default}">
                                            <Run Text="• " />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Foreground="{DynamicResource Foreground.Caption}" Text=" — " />
                                            <Run Foreground="{DynamicResource Foreground.Caption}" Text="{Binding Email, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!--  ========== ⑤ 实战场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 实战场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="标签筛选 / 权限多选 / 多收件人 / 范围过滤" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M4,4 L11,4 L20,13 L13,20 L4,11 Z M7,7 L7.5,7"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="标签筛选" />
                        <cy:MultiComboBox
                            Margin="0,4,0,8"
                            ItemsSource="{Binding Tags}"
                            SelectedItemsBindable="{Binding SelectedTags}"
                            Watermark="选择标签..." />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="文章列表、博客分类、产品筛选"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M5,11 L11,5 L19,5 L19,13 L13,19 Z M9,9 L9.5,9"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="权限多选" />
                        <cy:MultiComboBox
                            Margin="0,4,0,8"
                            IsSelectAllVisible="True"
                            ItemsSource="{Binding Permissions}"
                            Watermark="授权..." />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="角色配置、ACL 编辑、操作授权"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,7 L21,7 L21,17 L3,17 Z M3,7 L12,13 L21,7"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="多收件人" />
                        <cy:MultiComboBox
                            Margin="0,4,0,8"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Recipients}"
                            Watermark="收件人..." />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="邮件、消息、通知收件人列表"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,5 H21 M6,12 H18 M9,19 H15"
                            Stroke="#8B5CF6"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="范围过滤" />
                        <cy:MultiComboBox
                            Margin="0,4,0,8"
                            ItemsSource="{Binding PriceRanges}"
                            SelectedItemsBindable="{Binding SelectedRanges}"
                            Watermark="价格范围..." />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="价格区间、时间窗、数据分组"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="MultiComboBox 配置属性" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="ItemsSource" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IEnumerable" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数据源(基类成员)。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SelectedItemsBindable" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="IList (TwoWay)" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="可绑定的选中项集合, 双向同步。建议绑定 ObservableCollection — 绕过 ListBox.SelectedItems 不可绑定的限制。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="DisplayMemberPath" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="数据对象上要显示的属性名(基类成员)。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SelectionChipTemplate" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="DataTemplate" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="顶部 chip 的视觉模板, null 时使用内置默认 chip(边框 + 文本 + ×)。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Watermark" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="string" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="无选中项时显示的占位文字。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsSelectAllVisible" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (false)" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="下拉顶部是否显示全选 CheckBox(三态)。配合 SelectAllText 自定义文字。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="MaxDropDownHeight" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="double (200)" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="下拉面板最大高度, 超出时自动滚动条。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="HasSelectedItems" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (只读)" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否有任何选中项 — 常用于 IValueConverter 或 DataTrigger 切换 UI 状态。" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="RemoveItemCommand" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="RoutedCommand" />
                    <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="移除单个选中项的命令, CommandParameter=数据项。chip 上的 × 按钮通过此命令实现单项取消, 自定义 chip 模板时可复用。" />
                </Grid>
            </Border>

            <!--  ========== ⑦ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="MultiComboBox 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="继承 ListBox 复用全套交互" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="鼠标点击、Space、方向键、Ctrl+A 等多选键盘交互全部沿用原生 ListBox, 无需自实现"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="SelectedItemsBindable 绕过原生限制" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="原生 ListBox.SelectedItems 不可双向绑定。SelectedItemsBindable 是镜像 DP, 内部维持双向同步 — 既可 VM 改集合 / UI 更新, 也可 UI 选中 / VM 拿到结果"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="RemoveItemCommand 是静态 RoutedCommand" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="自定义 SelectionChipTemplate 时, 把 Command={x:Static cy:MultiComboBox.RemoveItemCommand}、CommandParameter={Binding} 挂到任意按钮即可保留单项删除"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="键盘交互" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Alt + ↓ 打开下拉 / Esc 关闭 / Space 切换选中 / 方向键移动焦点 / Ctrl + A 全选"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
