<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.EnumSelectorSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:EnumSelectorDemoViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 TextBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  场景小卡样式  -->
        <Style x:Key="ScenarioCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Background.Container}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <!--  Icon: 2x2 圆点矩阵, 暗示枚举选项的网格排列  -->
                        <Grid
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="10"
                                Height="10"
                                Margin="2"
                                Fill="{DynamicResource Text.Invert}" />
                            <Ellipse
                                Grid.Row="0"
                                Grid.Column="1"
                                Width="10"
                                Height="10"
                                Margin="2"
                                Stroke="{DynamicResource Text.Invert}"
                                StrokeThickness="2" />
                            <Ellipse
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="10"
                                Height="10"
                                Margin="2"
                                Stroke="{DynamicResource Text.Invert}"
                                StrokeThickness="2" />
                            <Ellipse
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="10"
                                Height="10"
                                Margin="2"
                                Fill="{DynamicResource Text.Invert}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="EnumSelector" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="枚举绑定控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="基于枚举类型的单选 / 多选选择器。普通枚举默认渲染为 RadioButton(单选), [Flags] 枚举默认渲染为 CheckBox(多选), 支持 [Description] 别名、Rows / Columns 布局控制、Auto / 强制模式切换。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="EnumType · SelectedEnum · 自动模式识别" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="只需绑定 EnumType + SelectedEnum 即可工作。控件会读取枚举元数据(是否标注 [Flags] / [Description]), 自动选择 RadioButton 或 CheckBox 模式。右侧实时显示枚举类型、是否多选、当前选中值。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <cy:EnumSelector
                    x:Name="BasicEnumSelector"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Columns="2"
                    EnumType="{x:Type local:UserRole}"
                    SelectedEnum="{Binding UserRole, Mode=TwoWay}" />
                <Border
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    Padding="14,10"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Width="92"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="EnumType:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="UserRole" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="92"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="HasFlags:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="{Binding HasFlags, ElementName=BasicEnumSelector}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="92"
                                FontSize="12"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="SelectedEnum:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="{Binding UserRole}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ② 自动模式识别 ==========  -->
            <cy:SectionHeader
                MainTitle="② 自动模式识别"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="普通枚举 → RadioButton, [Flags] 枚举 → CheckBox" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="DisplayMode=Auto(默认)时, 控件检查枚举类型是否标注 [FlagsAttribute]。普通枚举强制单选(避免合出无效值), Flags 枚举允许多选(按位或合并)。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="普通枚举 Priority(自动识别为 RadioButton 单选)" />
            <cy:EnumSelector
                Columns="4"
                EnumType="{x:Type local:Priority}"
                SelectedEnum="{Binding Priority, Mode=TwoWay}" />
            <TextBlock
                Margin="0,6,0,0"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{DynamicResource Foreground.Link}"
                Text="{Binding Priority, StringFormat='SelectedEnum = {0}'}" />

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="Flags 枚举 FilePermissions(自动识别为 CheckBox 多选)" />
            <cy:EnumSelector
                Columns="3"
                EnumType="{x:Type local:FilePermissions}"
                SelectedEnum="{Binding FilePermissions, Mode=TwoWay}" />
            <TextBlock
                Margin="0,6,0,0"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{DynamicResource Foreground.Link}"
                Text="{Binding FilePermissions, StringFormat='SelectedEnum = {0}'}" />

            <!--  ========== ③ 别名对照 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 别名对照 — IsUseAlias"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="读取 [Description] 作为显示文本" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="在枚举值上标注 DescriptionAttribute 即可作为别名显示。IsUseAlias 默认为 True, 关闭后显示原始枚举名。两侧绑定同一个 SelectedEnum, 选中状态联动。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="14,10"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="IsUseAlias = False" />
                        <cy:EnumSelector
                            Columns="2"
                            EnumType="{x:Type local:UserRole}"
                            IsUseAlias="False"
                            SelectedEnum="{Binding UserRoleForAliasDemo, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Padding="14,10"
                    Background="{DynamicResource Background.Header}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="IsUseAlias = True (默认)" />
                        <cy:EnumSelector
                            Columns="2"
                            EnumType="{x:Type local:UserRole}"
                            IsUseAlias="True"
                            SelectedEnum="{Binding UserRoleForAliasDemo, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ④ 强制模式与布局 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 强制模式与布局"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="DisplayMode · Rows · Columns" />

            <TextBlock Style="{StaticResource CaptionStyle}" Text="DisplayMode 可强制改为 RadioButton / CheckBox; 但非 Flags 枚举即使强制 CheckBox 视觉, 行为仍为单选 — 避免合并出无效枚举值。Rows / Columns 控制 UniformGrid 网格布局(0 = 自动)。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="强制 CheckBox 视觉(非 Flags 枚举, 行为仍是单选)" />
            <cy:EnumSelector
                Columns="4"
                DisplayMode="CheckBox"
                EnumType="{x:Type local:Priority}"
                SelectedEnum="{Binding PriorityCheckboxStyle, Mode=TwoWay}" />

            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource DemoItemTitleStyle}"
                Text="布局: Rows = 2, Columns = 4(WorkDays)" />
            <cy:EnumSelector
                Columns="4"
                EnumType="{x:Type local:WorkDays}"
                Rows="2"
                SelectedEnum="{Binding WorkDays, Mode=TwoWay}" />
            <TextBlock
                Margin="0,6,0,0"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{DynamicResource Foreground.Link}"
                Text="{Binding WorkDays, StringFormat='SelectedEnum = {0}'}" />

            <!--  ========== ⑤ 实战场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 实战场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="状态选择 / 权限配置 / 筛选条件 / 偏好设置" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M5,5 L9,5 L9,9 L5,9 Z M5,15 L9,15 L9,19 L5,19 Z M13,5 H19 M13,7 H17 M13,15 H19 M13,17 H17"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="状态选择" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="订单状态、用户角色、审批结果等单选枚举字段"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,8"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M3,5 H21 M3,12 H21 M3,19 H21 M5,5 v3 M11,12 v3 M17,19 v-3"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="权限配置" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="文件读写执行、API 范围等 Flags 多选权限"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M5,8 H19 M5,12 H19 M5,16 H14 M9,4 V20"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="筛选条件" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="日志级别、消息类型等多选筛选"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Style="{StaticResource ScenarioCardStyle}">
                    <StackPanel>
                        <Path
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            Data="M12,3 L4,7 V12 C4,16 8,20 12,21 C16,20 20,16 20,12 V7 Z"
                            Stroke="#8B5CF6"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.8" />
                        <TextBlock
                            Margin="0,10,0,4"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="偏好设置" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="主题模式、语言、通知偏好等单选设置项"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="EnumType / SelectedEnum 与配置属性" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型 (默认)" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="EnumType" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Type (null)" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="要展示的枚举类型, 通常用 {x:Type local:MyEnum} 提供。" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="SelectedEnum" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="Enum (null)" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="当前选中值, 默认 TwoWay 绑定。Flags 枚举时为多个值按位或的结果。" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="DisplayMode" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (Auto)" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Auto / RadioButton / CheckBox。Auto 时按 [Flags] 自动选择。" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="IsUseAlias" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (true)" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="是否使用 [Description] 别名作为显示文本; false 则显示原始枚举名。" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Rows" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="int (0)" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="UniformGrid 行数, 0 = 自动。" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="Columns" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="int (0)" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="UniformGrid 列数, 0 = 自动。" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="HasFlags" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="bool (只读)" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="EnumType 是否标记 [Flags], 控件内部根据该属性决定 Auto 模式的行为。" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource PropTableNameStyle}" Text="EffectiveDisplayMode" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource PropTableTypeStyle}" Text="enum (只读)" />
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource PropTableCellStyle}" Text="Auto 解析后的实际渲染模式 — 用于调试。" />
                </Grid>
            </Border>

            <!--  ========== ⑦ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="EnumSelector 的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="[Description] 即别名" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="为枚举值标注 DescriptionAttribute 即可作为显示文本, 不需要额外的 IValueConverter 或资源字典"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="[Flags] 即多选" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="为枚举类型标注 FlagsAttribute 后, Auto 模式自动启用按位多选语义, 选中值即位掩码合并结果"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="非 Flags 枚举强制 CheckBox 仍是单选" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="DisplayMode=CheckBox 只影响视觉; 行为仍按枚举类型的多选能力决定 — 避免合并出无效枚举值"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Rows / Columns 走 UniformGrid" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="内部 ItemsPanel 是 UniformGrid, 行列规则与原生一致。任一为 0 表示按枚举值数量自动布局"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
