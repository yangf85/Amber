<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.ColorPickerSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:ColorPickerViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  统一段头样式: 左对齐, 显示副标题和分隔线, 段间距 36px  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 0 0 L 22 0 L 22 22 L 0 22 Z M 11 0 L 11 22 M 0 11 L 22 11"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="ColorPicker" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="下拉式颜色选择器 — 主控区 HSV 选区 + 4 路滑块 + HEX/RGB 输入 + 预设/历史色板 + 屏幕取色器。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础绑定 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础绑定"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="SelectedColor 双向绑定 ViewModel" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="最常见场景 — 表单里挑一个颜色。SelectedColor 是 DP, BindsTwoWayByDefault, 直接绑过去就行。点 Chevron 弹出完整面板。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="主题色" />
            <cy:ColorPicker
                Width="240"
                HorizontalAlignment="Left"
                SelectedColor="{Binding PickerColor, Mode=TwoWay}" />

            <Border
                Margin="0,16,0,0"
                Padding="12,10"
                HorizontalAlignment="Left"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid Width="380">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Height="40"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding PickerColor}" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ValueLabelStyle}">
                            <Run Text="HEX = " />
                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="{Binding PickerColorHex, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource ValueLabelStyle}">
                            <Run Text="RGB = " />
                            <Run Foreground="{DynamicResource Foreground.Default}" Text="{Binding PickerColorRgb, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="14,6"
                    Command="{Binding ResetPickerColorCommand}"
                    Content="重置为橙红" />
                <Button
                    Padding="14,6"
                    Command="{Binding RandomPickerColorCommand}"
                    Content="随机一个" />
            </StackPanel>

            <!--  ========== ② 配置选项 ==========  -->
            <cy:SectionHeader
                MainTitle="② 配置选项"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="文本格式 / 显隐 / 禁用" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="ColorTextFormat 切换前缀显示, DisplayColorText 控制文本是否露出, IsEnabled 进入禁用态。" />

            <cy:ColorPicker
                Width="240"
                HorizontalAlignment="Left"
                ColorTextFormat="{Binding TextFormat}"
                DisplayColorText="{Binding DisplayColorText}"
                IsEnabled="{Binding IsControlEnabled}"
                SelectedColor="{Binding ConfigColor, Mode=TwoWay}" />

            <Grid Margin="0,16,0,0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,16,8"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="文本格式" />
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    Orientation="Horizontal">
                    <RadioButton
                        Margin="0,0,16,0"
                        Command="{Binding SetHexFormatCommand}"
                        Content="HEX"
                        GroupName="TextFormat"
                        IsChecked="{Binding IsHexFormat, Mode=OneWay}" />
                    <RadioButton
                        Command="{Binding SetRgbFormatCommand}"
                        Content="RGB"
                        GroupName="TextFormat"
                        IsChecked="{Binding IsRgbFormat, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,16,8"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="显示文本" />
                <CheckBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    Content="DisplayColorText"
                    IsChecked="{Binding DisplayColorText}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Foreground.Caption}"
                    Text="启用控件" />
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Content="IsEnabled"
                    IsChecked="{Binding IsControlEnabled}" />
            </Grid>

            <!--  ========== ③ 独立面板 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 独立面板"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ColorSelector 直接内嵌, 无弹出框" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="不想要下拉, 想把完整面板嵌进侧边栏或 Drawer 里 — 直接用 ColorSelector。结构完全一致, 仅去掉了 Popup 包裹。" />

            <cy:ColorSelector HorizontalAlignment="Left" SelectedColor="{Binding PanelColor, Mode=TwoWay}" />

            <Border
                Margin="0,16,0,0"
                Padding="12,8"
                HorizontalAlignment="Left"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <TextBlock Style="{StaticResource ValueLabelStyle}">
                    <Run Text="PanelColor = " />
                    <Run
                        FontWeight="Bold"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding PanelColorHex, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <!--  ========== ④ 独立色板 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 独立色板"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ColorPalette 单独使用, 12×9 预设色" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="ColorPalette 也可以独立用 — 比如设置页里的主题色选择, 不需要完整选区。Mode=Preset 自动加载内置 12×9 色组。" />

            <cy:ColorPalette
                MinHeight="240"
                HorizontalAlignment="Stretch"
                Mode="Preset"
                SelectedColor="{Binding PaletteColor, Mode=TwoWay}" />

            <Border
                Margin="0,16,0,0"
                Padding="12,10"
                HorizontalAlignment="Left"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid Width="380">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Height="40"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding PaletteColor}" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ValueLabelStyle}">
                            <Run Text="PaletteColor = " />
                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="{Binding PaletteColorHex, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ========== ⑤ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="WinUI 3 风格的关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="WinUI 3 无圆角" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="所有 Border 直角, 全部色彩走 BasicTheme token, 不硬编码任何颜色"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="滑块拇指" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="6×全高 直角条 (像 Photoshop/Figma 的吸管轨), 取代圆形 Thumb"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="2D 选区指示器" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="14×14 双色环 (外黑 3px + 内白 1px), 任何底色都可见, 无 DropShadow"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="透明底" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="预览/Alpha 通道用 8×8 棋盘格 (Alternation.Light + Alternation.Invert), 半透明清晰可辨"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="状态优先级" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Hover → Border.Hover; Focus/Open → Border.Active; Error → Border.InputError; Disabled 在最后, 终态压过其他"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
