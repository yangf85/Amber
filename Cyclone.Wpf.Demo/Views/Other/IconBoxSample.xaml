                            </Border>
                            <Border
                                Margin="0,0,0,8"
                                Padding="12,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <cy:IconBox
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Content="{StaticResource Geom.Bell}"
