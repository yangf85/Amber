<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.IconBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="2400"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SectionNumberStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource Background.Highlighted}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionNumberTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="CodeBlockStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  Geometry 资源 - 几个常用矢量图标 (放 Resources 让 IconBox.Content 引用)  -->
        <PathGeometry x:Key="Geom.Menu" Figures="M3,7 L21,7 M3,12 L21,12 M3,17 L21,17" />
        <PathGeometry x:Key="Geom.Plus" Figures="M12,5 L12,19 M5,12 L19,12" />
        <PathGeometry x:Key="Geom.Search" Figures="M10,4 A6,6 0 1,1 10,16 A6,6 0 0,1 10,4 M14.5,14.5 L20,20" />
        <PathGeometry x:Key="Geom.Heart" Figures="M12,21 L4,13 C2,11 2,7 5,5 C8,3 11,6 12,8 C13,6 16,3 19,5 C22,7 22,11 20,13 Z" />
        <PathGeometry x:Key="Geom.Settings" Figures="M12,8 A4,4 0 1,1 8,12 A4,4 0 0,1 12,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
        <PathGeometry x:Key="Geom.Download" Figures="M12,4 L12,16 M7,11 L12,16 L17,11 M4,20 L20,20" />
        <PathGeometry x:Key="Geom.Bell" Figures="M12,3 C8,3 6,6 6,10 L6,14 L4,17 L20,17 L18,14 L18,10 C18,6 16,3 12,3 M10,20 A2,2 0 0,0 14,20" />
        <PathGeometry x:Key="Geom.User" Figures="M12,4 A4,4 0 1,1 12,12 A4,4 0 0,1 12,4 M4,21 C4,16 8,14 12,14 C16,14 20,16 20,21" />
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ 顶部 Header ============  -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <cy:IconBox
                            Width="32"
                            Height="32"
                            Content="{StaticResource Geom.Heart}"
                            Foreground="White" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="IconBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="White"
                                    Text="WPF 控件" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="统一图标控件——自动根据 Content 类型分发渲染。Geometry → 矢量 Path、ImageSource → 位图 Image、string → 字体图标 Glyph。默认 16×16,通过 Width/Height/FontSize 控制大小,Foreground 控制颜色。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ============ 主体两列 ============  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ===== 左列 =====  -->
                <StackPanel Grid.Column="0">

                    <!--  ① 矢量 Path  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="矢量 Path" Subtitle="Content = Geometry,可任意缩放 + 跟随 Foreground 改色">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="1" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="把 PathGeometry 放在 Resources 里复用,直接用 Content 引用。Path 的 Fill 自动跟随 IconBox.Foreground。" />

                            <UniformGrid
                                Margin="0,0,0,16"
                                Columns="8"
                                Rows="1">
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.Menu}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Menu" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.Plus}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Plus" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.Search}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Search" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.Heart}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Heart" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.Settings}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Settings" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.Download}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Download" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.Bell}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Bell" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="24"
                                        Height="24"
                                        Content="{StaticResource Geom.User}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="User" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="任意大小 — Path 矢量缩放无损" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <cy:IconBox
                                    Width="16"
                                    Height="16"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{StaticResource Geom.Heart}" />
                                <cy:IconBox
                                    Width="24"
                                    Height="24"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{StaticResource Geom.Heart}" />
                                <cy:IconBox
                                    Width="36"
                                    Height="36"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{StaticResource Geom.Heart}" />
                                <cy:IconBox
                                    Width="56"
                                    Height="56"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{StaticResource Geom.Heart}" />
                                <cy:IconBox
                                    Width="80"
                                    Height="80"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{StaticResource Geom.Heart}" />
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ② 颜色控制  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="颜色控制" Subtitle="Foreground 决定图标颜色">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="2" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Geometry 和字体图标自动跟随 Foreground。默认 Icon.Foreground.Default 灰色,可改主题 token 或硬编码颜色。" />

                            <UniformGrid Columns="6" Rows="1">
                                <StackPanel>
                                    <cy:IconBox
                                        Width="32"
                                        Height="32"
                                        Content="{StaticResource Geom.Heart}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Default" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="32"
                                        Height="32"
                                        Content="{StaticResource Geom.Heart}"
                                        Foreground="{DynamicResource Background.Selected}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Selected" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="32"
                                        Height="32"
                                        Content="{StaticResource Geom.Heart}"
                                        Foreground="{DynamicResource Background.Success}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Success" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="32"
                                        Height="32"
                                        Content="{StaticResource Geom.Heart}"
                                        Foreground="{DynamicResource Background.Warning}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Warning" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="32"
                                        Height="32"
                                        Content="{StaticResource Geom.Heart}"
                                        Foreground="{DynamicResource Background.Error}" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Error" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Width="32"
                                        Height="32"
                                        Content="{StaticResource Geom.Heart}"
                                        Foreground="#9C27B0" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Custom" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </cy:Card>

                    <!--  ③ 字体图标 (Segoe Fluent Icons)  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="字体图标 (Glyph)" Subtitle="Content = string,通过 FontFamily 选字体">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="3" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="Win10/11 自带 Segoe Fluent Icons 字体,Content 设字符代码即得图标。FontSize 控制大小,Foreground 控制颜色。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,0,0,16"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="字符代码参考:Microsoft Docs &quot;Segoe Fluent Icons font&quot; 列表"
                                TextWrapping="Wrap" />

                            <UniformGrid Columns="8" Rows="1">
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE700;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="E700" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE721;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Search" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE713;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Settings" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE74D;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Delete" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE74E;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Save" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE72E;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Lock" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE74A;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Up" />
                                </StackPanel>
                                <StackPanel>
                                    <cy:IconBox
                                        Content="&#xE74B;"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="24" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Down" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </cy:Card>
                </StackPanel>

                <!--  ===== 右列 =====  -->
                <StackPanel Grid.Column="2">

                    <!--  ④ 实战:按钮中  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="组合 — 按钮里使用" Subtitle="替代 Path 显式声明">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="4" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="原本要写 StackPanel + Path 才能做 图标 + 文本 按钮,有 IconBox 后可以共用 Geometry 资源,代码更简洁。" />

                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <Button Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <cy:IconBox
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Content="{StaticResource Geom.Plus}" />
                                        <TextBlock VerticalAlignment="Center" Text="新建" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Style="{DynamicResource Button.Style.Primary}">
                                    <StackPanel Orientation="Horizontal">
                                        <cy:IconBox
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Content="{StaticResource Geom.Download}"
                                            Foreground="White" />
                                        <TextBlock VerticalAlignment="Center" Text="下载" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="14,8"
                                    Style="{DynamicResource Button.Style.Subtle}">
                                    <StackPanel Orientation="Horizontal">
                                        <cy:IconBox
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Content="{StaticResource Geom.Settings}" />
                                        <TextBlock VerticalAlignment="Center" Text="设置" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="纯图标按钮" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{DynamicResource Button.Style.Icon}" ToolTip="菜单">
                                    <cy:IconBox
                                        Width="16"
                                        Height="16"
                                        Content="{StaticResource Geom.Menu}" />
                                </Button>
                                <Button
                                    Margin="4,0,0,0"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="搜索">
                                    <cy:IconBox
                                        Width="16"
                                        Height="16"
                                        Content="{StaticResource Geom.Search}" />
                                </Button>
                                <Button
                                    Margin="4,0,0,0"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="通知">
                                    <cy:IconBox
                                        Width="16"
                                        Height="16"
                                        Content="{StaticResource Geom.Bell}" />
                                </Button>
                                <Button
                                    Margin="4,0,0,0"
                                    Style="{DynamicResource Button.Style.Icon}"
                                    ToolTip="用户">
                                    <cy:IconBox
                                        Width="16"
                                        Height="16"
                                        Content="{StaticResource Geom.User}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑤ 实战:列表项前缀  -->
                    <cy:Card Margin="0,0,0,20">
                        <cy:Card.Header>
                            <cy:CardHeader Title="组合 — 列表项前缀">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="5" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="设置项 / 导航菜单常用——图标 + 标题 + 描述,IconBox 占据固定列宽。" />

                            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="14,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <cy:IconBox
                                            Grid.Column="0"
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            Content="{StaticResource Geom.User}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Text="账户" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource Foreground.Caption}"
                                                Text="管理用户信息和登录方式" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Border.Default}" />
                                    <Grid Margin="14,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <cy:IconBox
                                            Grid.Column="0"
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            Content="{StaticResource Geom.Bell}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Text="通知" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource Foreground.Caption}"
                                                Text="桌面通知和邮件订阅" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{DynamicResource Border.Default}" />
                                    <Grid Margin="14,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <cy:IconBox
                                            Grid.Column="0"
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Left"
                                            Content="{StaticResource Geom.Settings}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Text="高级设置" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource Foreground.Caption}"
                                                Text="网络、性能、隐私等" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </cy:Card>

                    <!--  ⑥ 实战:状态信息  -->
                    <cy:Card>
                        <cy:Card.Header>
                            <cy:CardHeader Title="组合 — 状态信息提示">
                                <cy:CardHeader.Icon>
                                    <Border Style="{StaticResource SectionNumberStyle}">
                                        <TextBlock Style="{StaticResource SectionNumberTextStyle}" Text="6" />
                                    </Border>
                                </cy:CardHeader.Icon>
                            </cy:CardHeader>
                        </cy:Card.Header>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="不同状态用不同 Foreground,同一个 Geometry 复用。" />

                            <Border
                                Margin="0,0,0,8"
                                Padding="12,10"
                                Background="{DynamicResource Background.Header}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
