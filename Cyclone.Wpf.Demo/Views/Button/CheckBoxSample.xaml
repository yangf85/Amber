<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.CheckBoxSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:CheckBoxViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <!--  统一段头样式: 左对齐, 显示副标题和分隔线, 段间距 36px  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  本页 CheckBox 默认行距, 让 IsChecked 三态视觉舒服  -->
        <Style x:Key="DemoCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <!--  ✓ 图标, 跟 CheckBox 的勾选语义一致  -->
                        <Path
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 4 12 L 10 18 L 20 6"
                            Stretch="None"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="3" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="CheckBox" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="复选框 — 支持两态 (Checked / Unchecked) 和三态 (含 Indeterminate)。Checked 时 Box 主色实心 + 白色 ✓ stroke。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础勾选 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础勾选"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="两态 IsChecked 双向绑定 bool 属性" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="最常见场景 — 注册/设置表单里的勾选项。IsChecked 是 DP, TwoWay 直接绑 bool。Hover 时边框变主色淡边, Checked 时整个 Box 主色实心 + 白色勾。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="注册表单" />
            <StackPanel HorizontalAlignment="Left">
                <CheckBox
                    Content="同意服务条款和隐私政策"
                    IsChecked="{Binding AcceptTerms, Mode=TwoWay}"
                    Style="{StaticResource DemoCheckBoxStyle}" />
                <CheckBox
                    Content="订阅产品更新邮件"
                    IsChecked="{Binding SubscribeNewsletter, Mode=TwoWay}"
                    Style="{StaticResource DemoCheckBoxStyle}" />
                <CheckBox
                    Content="记住我的登录状态"
                    IsChecked="{Binding RememberMe, Mode=TwoWay}"
                    Style="{StaticResource DemoCheckBoxStyle}" />
            </StackPanel>

            <Border
                Margin="0,16,0,0"
                Padding="12,10"
                HorizontalAlignment="Left"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel Width="380">
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="AcceptTerms         = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding AcceptTerms, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource ValueLabelStyle}">
                        <Run Text="SubscribeNewsletter = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding SubscribeNewsletter, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource ValueLabelStyle}">
                        <Run Text="RememberMe          = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding RememberMe, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  ========== ② 禁用与富内容 ==========  -->
            <cy:SectionHeader
                MainTitle="② 禁用与富内容"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsEnabled / Content 任意 UIElement / 无文字纯 Box" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="CheckBox 继承自 ContentControl, Content 不限文本 — 塞 StackPanel 可做双行说明项;省略 Content 只显示 Box, 适合表头/数据网格。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="禁用态(两态 + 三态)" />
            <StackPanel
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <CheckBox
                    Margin="0,0,16,0"
                    Content="勾选(禁用)"
                    IsChecked="True"
                    IsEnabled="False" />
                <CheckBox
                    Margin="0,0,16,0"
                    Content="未勾(禁用)"
                    IsEnabled="False" />
                <CheckBox
                    Content="三态(禁用)"
                    IsChecked="{x:Null}"
                    IsEnabled="False"
                    IsThreeState="True" />
            </StackPanel>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="富内容(StackPanel)" />
            <CheckBox
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                IsChecked="True">
                <StackPanel>
                    <TextBlock FontWeight="Medium" Text="高级模式" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="开启后显示更多调试选项和实验性功能" />
                </StackPanel>
            </CheckBox>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="无文字(只显示 Box)" />
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <CheckBox Margin="0,0,8,0" />
                <CheckBox Margin="0,0,8,0" IsChecked="True" />
                <CheckBox IsChecked="{x:Null}" IsThreeState="True" />
            </StackPanel>

            <!--  ========== ③ 三态父子联动 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 三态父子联动"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsThreeState 经典场景: 全选 / 部分选 / 未选" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="父 CheckBox 用 IsThreeState=True, 根据子项状态自动显示: 全选 (✓) / 部分选 (横线) / 未选 (空)。子→父 由 ViewModel 重算, 父→子 一键全选/取消。" />

            <Border
                Padding="12,8"
                HorizontalAlignment="Left"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <CheckBox
                    FontWeight="Medium"
                    IsChecked="{Binding ParentChecked, Mode=TwoWay}"
                    IsThreeState="True">
                    <TextBlock>
                        <Run Text="任务清单 — 已完成" />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding CheckedCount, Mode=OneWay}" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    </TextBlock>
                </CheckBox>
            </Border>

            <ItemsControl Margin="20,12,0,0" ItemsSource="{Binding Todos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TodoItem}">
                        <CheckBox
                            Margin="0,0,0,6"
                            Content="{Binding Title}"
                            IsChecked="{Binding IsDone, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="14,6"
                    Command="{Binding CheckAllCommand}"
                    Content="全选" />
                <Button
                    Padding="14,6"
                    Command="{Binding UncheckAllCommand}"
                    Content="全不选" />
            </StackPanel>

            <!--  ========== ④ 键盘焦点 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 键盘焦点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Tab 切换 + Space 切换勾选状态" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="先点一下任意 CheckBox 让控件获得焦点, 再用 Tab 在三个之间切换 — Box 外圈出现 2px focus ring。按 Space 切换勾选状态。" />

            <StackPanel HorizontalAlignment="Left">
                <CheckBox Margin="0,0,0,8" Content="选项 A" />
                <CheckBox Margin="0,0,0,8" Content="选项 B" />
                <CheckBox Content="选项 C" />
            </StackPanel>

            <!--  ========== ⑤ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="WinUI 3 风格下的 CheckBox 关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="实心 Box" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Checked 时 Box 整个变主色实心 + 白色 ✓ stroke, 视觉对比强烈, 远距识别清晰"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="三态完整" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Indeterminate 用横线代替勾, 同样主色实心背景, 跟 Checked 视觉权重对等, 不做半透明降级"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="焦点 ring" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="键盘焦点态显示 2px 外圈 ring (Border.Active), 鼠标焦点不显示, 满足键盘用户的可访问性反馈"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="富内容容器" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ContentControl 本质, Content 槽支持任意 UIElement — 双行说明项 / 图标 + 文字 / 嵌套 Panel 都直接塞"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="状态优先级" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Hover → Border.Hover; Focus → Border.Active; Checked/Indeterminate → Background.Highlighted; Disabled 在最后, 终态压过其他"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
