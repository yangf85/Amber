<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.ToggleButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:ToggleButtonViewModel}}"
    d:DesignHeight="2400"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  预览文字根据 ToggleButton 状态动态样式  -->
        <Style x:Key="PreviewTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBold}" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsItalic}" Value="True">
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnderline}" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Grid
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border BorderBrush="{DynamicResource Text.Invert}" BorderThickness="2.5" />
                            <Border Margin="6" Background="{DynamicResource Text.Invert}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="ToggleButton" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="切换按钮 — 独立 on/off 状态。Checked 时整个按钮主色实心 + 白字, 跟 CheckBox / RadioButton 选中态视觉对齐。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 富文本工具栏 ==========  -->
            <cy:SectionHeader
                MainTitle="① 富文本工具栏"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="经典 B / I / U 切换按钮组" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="ToggleButton 经典用法 — 独立 on/off 状态。每个按钮的 IsChecked 双向绑定到 ViewModel, 下方预览文字 DataTrigger 实时响应。" />

            <Border
                Margin="0,0,0,12"
                Padding="4"
                HorizontalAlignment="Left"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton
                        Width="36"
                        Height="32"
                        Margin="2"
                        IsChecked="{Binding IsBold, Mode=TwoWay}"
                        ToolTip="加粗 (Ctrl+B)">
                        <TextBlock FontWeight="Bold" Text="B" />
                    </ToggleButton>
                    <ToggleButton
                        Width="36"
                        Height="32"
                        Margin="2"
                        IsChecked="{Binding IsItalic, Mode=TwoWay}"
                        ToolTip="斜体 (Ctrl+I)">
                        <TextBlock FontStyle="Italic" Text="I" />
                    </ToggleButton>
                    <ToggleButton
                        Width="36"
                        Height="32"
                        Margin="2"
                        IsChecked="{Binding IsUnderline, Mode=TwoWay}"
                        ToolTip="下划线 (Ctrl+U)">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border
                Padding="20,16"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <TextBlock Style="{StaticResource PreviewTextStyle}" Text="The quick brown fox jumps over the lazy dog 中文预览" />
            </Border>

            <!--  ========== ② 设置开关 ==========  -->
            <cy:SectionHeader
                MainTitle="② 设置开关"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="独立 on/off 配文字 Label" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="ToggleButton 也可以放在设置页 — 每个独立切换。状态用 IsChecked 表达, Checked 时整个按钮主色实心。按钮文本用 DataTrigger 切换显示。" />

            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="开启桌面通知" />
                    <ToggleButton
                        Grid.Column="1"
                        Padding="14,4"
                        IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="已关闭" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationsEnabled}" Value="True">
                                            <Setter Property="Text" Value="已开启" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="深色模式" />
                    <ToggleButton
                        Grid.Column="1"
                        Padding="14,4"
                        Content="切换"
                        IsChecked="{Binding DarkMode, Mode=TwoWay}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="自动保存草稿" />
                    <ToggleButton
                        Grid.Column="1"
                        Padding="14,4"
                        Content="自动"
                        IsChecked="{Binding AutoSave, Mode=TwoWay}" />
                </Grid>
            </StackPanel>

            <!--  ========== ③ 视图切换器 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 视图切换器"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="RadioButton + ToggleButton 样式做分段控件" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="ToggleButton 也可以用 GroupName 实现互斥, 但语义上还是用 RadioButton 更合适 — 这里给 RadioButton 套 ToggleButton.Style.Basic 样式, 视觉是分段控件, 语义是互斥单选。" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="视图模式" />
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <RadioButton
                    Padding="20,6"
                    Content="网格"
                    GroupName="View"
                    IsChecked="True"
                    Style="{DynamicResource ToggleButton.Style.Basic}" />
                <RadioButton
                    Padding="20,6"
                    Content="列表"
                    GroupName="View"
                    Style="{DynamicResource ToggleButton.Style.Basic}" />
                <RadioButton
                    Padding="20,6"
                    Content="时间线"
                    GroupName="View"
                    Style="{DynamicResource ToggleButton.Style.Basic}" />
            </StackPanel>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="排序方向" />
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    Padding="20,6"
                    Content="↑ 升序"
                    GroupName="Sort"
                    IsChecked="True"
                    Style="{DynamicResource ToggleButton.Style.Basic}" />
                <RadioButton
                    Padding="20,6"
                    Content="↓ 降序"
                    GroupName="Sort"
                    Style="{DynamicResource ToggleButton.Style.Basic}" />
            </StackPanel>

            <!--  ========== ④ 禁用与键盘 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 禁用与键盘"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Disabled / Tab 切换 / Space 切换状态" />

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="禁用态" />
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <ToggleButton
                    Margin="0,0,8,0"
                    Padding="14,4"
                    Content="关 (禁用)"
                    IsEnabled="False" />
                <ToggleButton
                    Padding="14,4"
                    Content="开 (禁用)"
                    IsChecked="True"
                    IsEnabled="False" />
            </StackPanel>

            <TextBlock Style="{StaticResource DemoItemTitleStyle}" Text="键盘交互(Tab 切换, Space 切换状态)" />
            <StackPanel Orientation="Horizontal">
                <ToggleButton
                    Margin="0,0,8,0"
                    Padding="14,4"
                    Content="按钮 A" />
                <ToggleButton
                    Margin="0,0,8,0"
                    Padding="14,4"
                    Content="按钮 B" />
                <ToggleButton Padding="14,4" Content="按钮 C" />
            </StackPanel>

            <!--  ========== ⑤ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="WinUI 3 风格下的 ToggleButton 关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="实心 Checked" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Checked 时主色实心 + 白字, 跟 CheckBox / Pagination 选中态视觉对齐"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Hover 反馈" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Unchecked Hover 边框变主色淡边; Checked Hover 背景变 Highlighted 深色, 两态都有可点击暗示"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="DataTrigger 动态 Content" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="开关型 ToggleButton 用 DataTrigger 切换显示文本(已关闭/已开启), 比 ContentTemplate 写一个完整模板更轻"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="vs RadioButton" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ToggleButton 独立 on/off, RadioButton 互斥分组。视图切换器要互斥用 RadioButton + ToggleButton 样式, 语义和视觉分离"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
