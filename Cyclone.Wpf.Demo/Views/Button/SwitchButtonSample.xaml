<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SwitchButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type={x:Type local:SwitchButtonViewModel}}"
    d:DesignHeight="2800"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  主题切换按钮  -->
        <Style x:Key="ThemeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>

        <!--  Card 5 设置项 DataTemplate  -->
        <DataTemplate x:Key="SettingItemTemplate" DataType="{x:Type local:SettingItem}">
            <Border
                Padding="0,14"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Background.Highlighted}"
                        CornerRadius="999">
                        <Path
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{Binding IconData}"
                            Fill="{DynamicResource Text.Invert}"
                            Stretch="Uniform" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,16,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="{Binding Name}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <cy:SwitchButton
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsOn, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M17 6H7c-3.31 0-6 2.69-6 6s2.69 6 6 6h10c3.31 0 6-2.69 6-6s-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"
                            Fill="{DynamicResource Text.Invert}"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="SwitchButton" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="滑动开关 — 继承 ToggleButton, 二态切换 + 滑块缓动动画。轨道宽高、滑块尺寸、各状态颜色、动画时长均可自定义。模板内置阴影 + 焦点视觉。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础切换 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础切换"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsChecked TwoWay binding, 联动其他控件 IsEnabled" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="最简单的用法 — SwitchButton 内放 Content 作为标签, IsChecked 双向绑定到 ViewModel。下面演示 &quot;允许编辑&quot; 开关控制 &quot;自动保存&quot; 开关的 IsEnabled。" />

            <StackPanel HorizontalAlignment="Left">
                <cy:SwitchButton
                    Margin="0,0,0,12"
                    Content="允许编辑(控制下面开关的 IsEnabled)"
                    IsChecked="{Binding IsAllowEdit, Mode=TwoWay}" />
                <cy:SwitchButton
                    Content="自动保存草稿"
                    IsChecked="{Binding IsAutoSave, Mode=TwoWay}"
                    IsEnabled="{Binding IsAllowEdit}" />
            </StackPanel>

            <Border
                Margin="0,16,0,0"
                Padding="14,12"
                HorizontalAlignment="Left"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel Width="380">
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="IsAllowEdit = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding IsAllowEdit, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource ValueLabelStyle}">
                        <Run Text="IsAutoSave  = " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding IsAutoSave, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  ========== ② 多种尺寸 ==========  -->
            <cy:SectionHeader
                MainTitle="② 多种尺寸"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="TrackWidth / TrackHeight / ThumbSize / Radius 组合" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="3 个尺寸 DP 配合 TrackCornerRadius / ThumbCornerRadius 决定控件外观。修改 layout 属性时 thumb 会立即重定位(不带动画), 避免视觉抖动。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="小(30 × 18 / 14)" />
                    <cy:SwitchButton
                        HorizontalAlignment="Center"
                        IsChecked="True"
                        ThumbCornerRadius="7"
                        ThumbMargin="2"
                        ThumbSize="14"
                        TrackCornerRadius="9"
                        TrackHeight="18"
                        TrackWidth="30" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="中(默认 40 × 22 / 16)" />
                    <cy:SwitchButton HorizontalAlignment="Center" IsChecked="True" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="大(60 × 32 / 26)" />
                    <cy:SwitchButton
                        HorizontalAlignment="Center"
                        IsChecked="True"
                        ThumbCornerRadius="13"
                        ThumbMargin="3"
                        ThumbSize="26"
                        TrackCornerRadius="16"
                        TrackHeight="32"
                        TrackWidth="60" />
                </StackPanel>
            </Grid>

            <!--  ========== ③ 自定义颜色主题 ==========  -->
            <cy:SectionHeader
                MainTitle="③ 自定义颜色主题"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="CheckedBackground / UncheckedBackground / ThumbBackground" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="点按钮切换不同风格。三个 Brush DP 完整覆盖控件视觉。点开关本身也可看到状态切换效果。" />

            <WrapPanel Margin="0,0,0,16">
                <Button
                    Background="#FF4B4B"
                    Command="{Binding ApplyDefaultThemeCommand}"
                    Content="默认(红)"
                    Style="{StaticResource ThemeButtonStyle}" />
                <Button
                    Background="#34C759"
                    Command="{Binding ApplyIosThemeCommand}"
                    Content="iOS(绿)"
                    Style="{StaticResource ThemeButtonStyle}" />
                <Button
                    Background="#673AB7"
                    Command="{Binding ApplyMaterialThemeCommand}"
                    Content="Material(紫)"
                    Style="{StaticResource ThemeButtonStyle}" />
                <Button
                    Background="#00BCD4"
                    Command="{Binding ApplyDarkThemeCommand}"
                    Content="暗色(青)"
                    Style="{StaticResource ThemeButtonStyle}" />
            </WrapPanel>

            <StackPanel HorizontalAlignment="Center">
                <cy:SwitchButton
                    HorizontalAlignment="Center"
                    CheckedBackground="{Binding Card3CheckedBg}"
                    Content="点击试试切换效果"
                    IsChecked="{Binding Card3IsChecked, Mode=TwoWay}"
                    ThumbBackground="{Binding Card3ThumbBg}"
                    ThumbCornerRadius="13"
                    ThumbMargin="3"
                    ThumbSize="26"
                    TrackCornerRadius="16"
                    TrackHeight="32"
                    TrackWidth="60"
                    UncheckedBackground="{Binding Card3UncheckedBg}" />
            </StackPanel>

            <!--  ========== ④ 动画时长对比 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 动画时长对比"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="AnimationDuration(0 / 100 / 200 / 500ms)" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="点 同步切换 同时翻转 4 个 SwitchButton — 一眼看出不同 AnimationDuration 的视觉差异。0ms 等价于无动画立即跳转。" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="0ms(无动画)" />
                    <cy:SwitchButton
                        HorizontalAlignment="Center"
                        AnimationDuration="0:0:0"
                        IsChecked="{Binding Card4Switch0, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="100ms(快)" />
                    <cy:SwitchButton
                        HorizontalAlignment="Center"
                        AnimationDuration="0:0:0.1"
                        IsChecked="{Binding Card4Switch100, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="200ms(默认)" />
                    <cy:SwitchButton
                        HorizontalAlignment="Center"
                        AnimationDuration="0:0:0.2"
                        IsChecked="{Binding Card4Switch200, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="500ms(慢)" />
                    <cy:SwitchButton
                        HorizontalAlignment="Center"
                        AnimationDuration="0:0:0.5"
                        IsChecked="{Binding Card4Switch500, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Button
                Padding="20,8"
                HorizontalAlignment="Center"
                Command="{Binding Card4ToggleAllCommand}"
                Content="同步切换 4 个" />

            <!--  ========== ⑤ 综合应用 — 设置面板 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 综合应用 — 设置面板"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ItemsControl + DataTemplate 批量绑定" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="模拟系统设置面板: 每行图标 + 名称 + 描述 + SwitchButton。ItemsControl 绑定 ObservableCollection&lt;SettingItem&gt;, DataTemplate 内嵌 SwitchButton 双向绑定到 IsOn 字段。" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <ItemsControl ItemTemplate="{StaticResource SettingItemTemplate}" ItemsSource="{Binding Settings}" />
            </Border>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="布局 / 颜色 / 动画 — 12 个核心 DP" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="成员" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="IsChecked" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="bool?" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="开关状态(继承自 ToggleButton)。已锁定 IsThreeState 默认 false — 只有 true / false。" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="TrackWidth" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="轨道宽度(默认 50)。决定 thumb 滑动范围。" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="TrackHeight" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="轨道高度(默认 26)。" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="ThumbSize" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="滑块尺寸(正方形, 默认 22)。建议略小于 TrackHeight 以避免溢出。" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="ThumbMargin" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Thickness" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="滑块与轨道边缘的间距(默认 2)。Left + Right 影响滑块的有效移动距离。" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="TrackCornerRadius" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="CornerRadius" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="轨道圆角(默认 13)。设为 TrackHeight/2 实现胶囊形状。" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="ThumbCornerRadius" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="CornerRadius" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="滑块圆角(默认 11)。设为 ThumbSize/2 实现圆形 thumb。" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="UncheckedBackground" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Brush" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="未选中时的轨道颜色(默认浅灰 #CCCCCC)。" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="CheckedBackground" />
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Brush" />
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="选中时的轨道颜色(默认红 #FF4B4B)。" />

                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="ThumbBackground" />
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Brush" />
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="滑块颜色(默认 White)。Hover / Pressed 时由 trigger 自动覆盖。" />

                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="AnimationDuration" />
                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Duration" />
                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="切换动画时长(默认 200ms)。设 0:0:0 等价于无动画立即切换。" />
                </Grid>
            </Border>

            <!--  ========== ⑦ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="WinUI 3 风格下的 SwitchButton 关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="二态锁定" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="IsThreeState 默认锁 false — switch 控件本质二态, 避免 IsChecked=null 时 thumb 卡住不动"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Animation 优先级" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="layout 改时 thumb 立即重定位前会先 BeginAnimation(prop, null) 清除已有动画 — 否则 active animation 会让 SetValue 无效"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="布局自动化" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="不强制 set 控件 MinWidth/Height — 尺寸由模板自然决定, user 可自由约束控件大小"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="焦点视觉" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="自定义 FocusVisualStyle 仅围绕 track 而非整个控件(包括 Content 文字), 更精致"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
