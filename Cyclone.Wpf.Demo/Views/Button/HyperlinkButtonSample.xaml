<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.HyperlinkButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type={x:Type local:HyperlinkButtonViewModel}}"
    d:DesignHeight="3000"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                            Fill="{DynamicResource Text.Invert}"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="HyperlinkButton" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="超链接按钮 — 继承自 ButtonBase。点击后用系统默认浏览器打开 URL, 仅允许 http / https / mailto 三种 scheme。同时支持 Click 事件 / Command 自定义处理。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="NavigateUri + DisplayText" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="最简场景: DisplayText 是显示文本, NavigateUri 是点击后打开的 URL。Hover 时鼠标变手型 + 颜色加深, 按下时颜色再加深, disabled 时灰色无下划线。Tooltip 自动显示完整 URL。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <cy:HyperlinkButton
                        Margin="0,0,0,8"
                        DisplayText="访问 Anthropic 官网"
                        NavigateUri="https://www.anthropic.com" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,8"
                        DisplayText="给我们发邮件"
                        NavigateUri="mailto:contact@example.com" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,8"
                        DisplayText="GitHub 仓库 (anthropics)"
                        NavigateUri="https://github.com/anthropics" />
                    <cy:HyperlinkButton
                        DisplayText="Disabled 链接(无下划线 + 灰色)"
                        IsEnabled="False"
                        NavigateUri="https://example.com" />
                </StackPanel>
            </Border>

            <!--  ========== ② Click 事件 / Command ==========  -->
            <cy:SectionHeader
                MainTitle="② Click 事件 / Command"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="自定义处理点击行为(继承 ButtonBase 的能力)" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="HyperlinkButton 继承自 ButtonBase — 自动获得 Click 事件 + Command 能力。可以在跳转前做 telemetry、确认弹窗、数据校验等。Command 和默认浏览器跳转同时触发 (OnClick 先 raise Click + 触发 Command, 再调 OpenUrl)。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="Click 事件(不设 NavigateUri, 仅触发事件)" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,12"
                        Click="OnLinkClicked"
                        DisplayText="自定义跳转 #1" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,16"
                        Click="OnLinkClicked"
                        DisplayText="自定义跳转 #2 (内部页面)" />

                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="Command(绑定到 VM, 参数 = 文档名)" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,8"
                        Command="{Binding OnDocLinkCommand}"
                        CommandParameter="user-guide"
                        DisplayText="用户指南 (Command + 浏览器)"
                        NavigateUri="https://docs.example.com/user-guide" />
                    <cy:HyperlinkButton
                        Command="{Binding OnDocLinkCommand}"
                        CommandParameter="api-reference"
                        DisplayText="API 参考 (Command + 浏览器)"
                        NavigateUri="https://docs.example.com/api" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,12,0,0"
                Padding="14,12"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Style="{StaticResource ValueLabelStyle}">
                        <Run Text="Command 累计触发: " />
                        <Run
                            FontWeight="Bold"
                            Foreground="{DynamicResource Foreground.Link}"
                            Text="{Binding CommandClickCount, Mode=OneWay}" />
                        <Run Text=" 次" />
                    </TextBlock>
                    <TextBlock
                        Margin="0,8,0,6"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="点击日志(最近 5 条):" />
                    <ItemsControl ItemsSource="{Binding ClickLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,2"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{DynamicResource Foreground.Default}"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  ========== ③ Scheme 白名单 ==========  -->
            <cy:SectionHeader
                MainTitle="③ URI Scheme 白名单"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="安全机制 — 仅允许 http / https / mailto, 其他静默拒绝" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="为防止 NavigateUri 被绑定到不可信数据源后触发危险协议(如 file:/// 打开本地文件、ms-msdt: 利用已知 Windows 漏洞), 控件用白名单严格过滤 scheme。被拒绝时静默 trace warning, 浏览器不会启动。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="✅ 白名单内(点击会真打开):" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,6"
                        Click="OnSchemeLinkClicked"
                        DisplayText="https://example.com (HTTPS)"
                        NavigateUri="https://example.com" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,6"
                        Click="OnSchemeLinkClicked"
                        DisplayText="http://example.com (HTTP)"
                        NavigateUri="http://example.com" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,16"
                        Click="OnSchemeLinkClicked"
                        DisplayText="mailto:user@example.com (邮件)"
                        NavigateUri="mailto:user@example.com" />

                    <TextBlock
                        Margin="0,0,0,12"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="❌ 白名单外(点击会被拒绝):" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,6"
                        Click="OnSchemeLinkClicked"
                        DisplayText="file:///C:/Windows (本地文件)"
                        NavigateUri="file:///C:/Windows" />
                    <cy:HyperlinkButton
                        Margin="0,0,0,6"
                        Click="OnSchemeLinkClicked"
                        DisplayText="ftp://example.com (FTP)"
                        NavigateUri="ftp://example.com" />
                    <cy:HyperlinkButton
                        Click="OnSchemeLinkClicked"
                        DisplayText="steam://run/123 (自定义协议)"
                        NavigateUri="steam://run/123" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,12,0,0"
                Padding="14,12"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontFamily="Consolas"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Scheme 检查日志(最近 5 条):" />
                    <ItemsControl ItemsSource="{Binding SchemeLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,3"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{DynamicResource Foreground.Default}"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  ========== ④ 样式定制 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 样式定制"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Foreground / FontSize / FontWeight 都可单独覆盖" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="HyperlinkButton 默认是蓝色下划线。Foreground / FontSize / FontWeight / FontStyle 可单独覆盖。注意: 覆盖 Foreground 后 hover 仍走 Trigger 颜色(Link.Hover), 完全自定义 hover 行为需要改 ControlTemplate。" />

            <Border
                Padding="20"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="不同颜色:" />
                        <cy:HyperlinkButton
                            Margin="0,0,0,6"
                            DisplayText="默认蓝色 (Link.Default)"
                            NavigateUri="https://example.com" />
                        <cy:HyperlinkButton
                            Margin="0,0,0,6"
                            DisplayText="红色(自定义警示色)"
                            Foreground="#D32F2F"
                            NavigateUri="https://example.com" />
                        <cy:HyperlinkButton
                            Margin="0,0,0,6"
                            DisplayText="紫色(品牌色)"
                            Foreground="#673AB7"
                            NavigateUri="https://example.com" />
                        <cy:HyperlinkButton
                            DisplayText="绿色(成功色)"
                            Foreground="#388E3C"
                            NavigateUri="https://example.com" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            Margin="0,0,0,8"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="不同字号 / 字重:" />
                        <cy:HyperlinkButton
                            Margin="0,0,0,6"
                            DisplayText="小字 11px"
                            FontSize="11"
                            NavigateUri="https://example.com" />
                        <cy:HyperlinkButton
                            Margin="0,0,0,6"
                            DisplayText="默认 13px"
                            NavigateUri="https://example.com" />
                        <cy:HyperlinkButton
                            Margin="0,0,0,6"
                            DisplayText="加粗 + 大字"
                            FontSize="16"
                            FontWeight="Bold"
                            NavigateUri="https://example.com" />
                        <cy:HyperlinkButton
                            DisplayText="斜体 + 中字"
                            FontSize="14"
                            FontStyle="Italic"
                            NavigateUri="https://example.com" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ========== ⑤ 综合实战 — “关于” 页面 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ 综合实战 — &quot;关于&quot;页面"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="模拟应用 About 页面, 多链接组合排版" />

            <Border
                Padding="40,32"
                Background="{DynamicResource Background.Container}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel>
                    <!--  Logo + Title  -->
                    <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                        <Border
                            Width="48"
                            Height="48"
                            Background="{DynamicResource Background.Info}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Text.Invert}"
                                Text="A" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="Awesome App" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="v1.4.2 · 2026-05-09" />
                        </StackPanel>
                    </StackPanel>

                    <!--  说明文字 + 内嵌链接  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="项目信息:" />
                    <WrapPanel Margin="0,0,0,16">
                        <TextBlock VerticalAlignment="Center" Text="本应用基于 " />
                        <cy:HyperlinkButton DisplayText="MIT 许可证" NavigateUri="https://opensource.org/licenses/MIT" />
                        <TextBlock VerticalAlignment="Center" Text=" 开源, 使用 " />
                        <cy:HyperlinkButton DisplayText=".NET 8" NavigateUri="https://dotnet.microsoft.com" />
                        <TextBlock VerticalAlignment="Center" Text=" 和 " />
                        <cy:HyperlinkButton DisplayText="Cyclone.Wpf" NavigateUri="https://github.com/anthropics" />
                        <TextBlock VerticalAlignment="Center" Text=" 控件库构建。" />
                    </WrapPanel>

                    <Border
                        Height="1"
                        Margin="0,8,0,16"
                        Background="{DynamicResource Border.Default}" />

                    <!--  外部资源  -->
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="资源链接:" />
                    <WrapPanel Margin="0,0,0,16">
                        <cy:HyperlinkButton
                            Margin="0,0,20,8"
                            DisplayText="📦 GitHub 仓库"
                            NavigateUri="https://github.com/anthropics" />
                        <cy:HyperlinkButton
                            Margin="0,0,20,8"
                            DisplayText="📚 在线文档"
                            NavigateUri="https://docs.example.com" />
                        <cy:HyperlinkButton
                            Margin="0,0,20,8"
                            DisplayText="🐛 报告问题"
                            NavigateUri="https://github.com/anthropics/issues" />
                        <cy:HyperlinkButton
                            Margin="0,0,0,8"
                            DisplayText="✉️ 联系我们"
                            NavigateUri="mailto:support@example.com" />
                    </WrapPanel>

                    <Border
                        Height="1"
                        Margin="0,8,0,16"
                        Background="{DynamicResource Border.Default}" />

                    <!--  法律  -->
                    <WrapPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="© 2026 Awesome Inc · " />
                        <cy:HyperlinkButton
                            DisplayText="隐私政策"
                            FontSize="11"
                            NavigateUri="https://example.com/privacy" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text=" · " />
                        <cy:HyperlinkButton
                            DisplayText="服务条款"
                            FontSize="11"
                            NavigateUri="https://example.com/terms" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text=" · " />
                        <cy:HyperlinkButton
                            DisplayText="开源声明"
                            FontSize="11"
                            NavigateUri="https://example.com/oss-licenses" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  ========== ⑥ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="NavigateUri / DisplayText / Click / Command" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="成员" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="NavigateUri" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="Uri" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="点击时打开的 URL。必须是绝对 URI 且 scheme 在白名单内(http / https / mailto)。null 时仅 Click 事件触发, 不打开浏览器。" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="DisplayText" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="string" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="显示的链接文本(一般跟 NavigateUri 不同, 如 &quot;点这里&quot; 链接到 https://...)。" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Click" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="RoutedEvent" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="点击时触发(继承自 ButtonBase)。先 raise Click 事件 / 触发 Command, 然后调用默认 OpenUrl。" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Command" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="ICommand" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="点击时执行的命令(继承自 ButtonBase)。Command 与默认 OpenUrl 同时触发 — 典型用途: 跳转前 telemetry / 数据校验。" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="CommandParameter" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="object" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="传给 Command 的参数。常用于区分多个链接(如文档名 / 跳转源等)。" />
                </Grid>
            </Border>

            <!--  ========== ⑦ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="WinUI 3 风格下的 HyperlinkButton 关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="继承 ButtonBase" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="自动获得 Click 事件 / Command / 键盘 Space-Enter 触发 — 比包嵌式 Button 更标准, tab 焦点行为正确"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Scheme 白名单" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="仅允许 http / https / mailto — 避免 file:// / ms-msdt: 等危险协议被 shell 直接执行。被拒时静默 trace warning"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="ToolTip 防 null 报错" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ToolTip 直接 binding NavigateUri(WPF 自动 ToString)。NavigateUri=null 时 Style.Trigger 把 ToolTip 设 null 不显示"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="Command 不替代 OpenUrl" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Command 跟默认 OpenUrl 同时触发, 互不影响。想完全自定义跳转(不打开浏览器), 不设 NavigateUri 即可"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
