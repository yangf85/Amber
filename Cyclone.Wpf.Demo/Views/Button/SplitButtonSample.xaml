<UserControl
    x:Class="Cyclone.Wpf.Demo.Views.SplitButtonSample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cy="https://www.cyclone/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Cyclone.Wpf.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type={x:Type local:SplitButtonViewModel}}"
    d:DesignHeight="3200"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  ========== 与 ColorPickerSample / ComboBoxSample 对齐的版式样式 ==========  -->
        <Style x:Key="ChapterHeaderStyle" TargetType="{x:Type cy:SectionHeader}">
            <Setter Property="Margin" Value="0,36,0,0" />
            <Setter Property="MainTitleHorizontalAlignment" Value="Left" />
            <Setter Property="MainTitleFontSize" Value="20" />
            <Setter Property="MainTitleFontWeight" Value="SemiBold" />
            <Setter Property="MainTitleForeground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="SubTitleHorizontalAlignment" Value="Left" />
            <Setter Property="SubTitleVisibility" Value="Visible" />
            <Setter Property="SubTitleFontSize" Value="13" />
            <Setter Property="SubTitleForeground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="SubTitleMargin" Value="0,4,0,0" />
            <Setter Property="SeparatorVisibility" Value="Visible" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="SeparatorMargin" Value="0,14,0,18" />
        </Style>

        <Style x:Key="DemoItemTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValueLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Echo / 状态显示框  -->
        <Style x:Key="ResultBoxStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource Background.Header}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!--  API 表样式  -->
        <Style x:Key="PropTableHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="PropTableCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Default}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="PropTableNameStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Link}" />
        </Style>
        <Style
            x:Key="PropTableTypeStyle"
            BasedOn="{StaticResource PropTableCellStyle}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground.Caption}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Background.Global}" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="920"
            Margin="40,32"
            HorizontalAlignment="Stretch">

            <!--  ========== Page Header ==========  -->
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="56"
                        Height="56"
                        Background="{DynamicResource Background.Info}">
                        <Path
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M3,5 L14,5 M3,5 L3,15 M14,5 L14,15 M3,15 L14,15 M17,9 L21,9 L19,13 Z"
                            Stroke="{DynamicResource Text.Invert}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="32"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Foreground.Default}"
                                Text="SplitButton" />
                            <Border
                                Margin="12,4,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Background.Info}">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Text.Invert}"
                                    Text="WinUI 3 无圆角" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="分割按钮 — 左侧主按钮执行默认动作, 右侧箭头展开菜单。主按钮和每个菜单项各自独立的 Command, 点击菜单项后 popup 自动关闭并冒泡 ItemClick 路由事件。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ========== 全局回显 ==========  -->
            <Border
                Margin="0,16,0,0"
                Padding="14,10"
                Background="{DynamicResource Background.Header}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="最后执行: " />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="{Binding LastAction}" />
                </StackPanel>
            </Border>

            <!--  ========== ① 基础用法 ==========  -->
            <cy:SectionHeader
                MainTitle="① 基础用法"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Label / Command / 菜单项 各自独立绑定" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="点 &quot;保存&quot; 文字执行主按钮命令, 点右侧箭头展开下拉菜单, 每项命令独立绑定。下方 Echo 显示最近一次执行的命令。" />

            <StackPanel Orientation="Horizontal">
                <cy:SplitButton
                    MinWidth="120"
                    Command="{Binding SaveCommand}"
                    Label="保存">
                    <cy:SplitButtonItem Command="{Binding SaveAsPdfCommand}" Content="另存为 PDF" />
                    <cy:SplitButtonItem Command="{Binding SaveAsWordCommand}" Content="另存为 Word" />
                    <cy:SplitButtonItem Command="{Binding SaveAsHtmlCommand}" Content="另存为 HTML" />
                    <cy:SplitButtonItem Command="{Binding SaveAsMarkdownCommand}" Content="另存为 Markdown" />
                </cy:SplitButton>
            </StackPanel>

            <!--  ========== ② 带图标的菜单项 ==========  -->
            <cy:SectionHeader
                MainTitle="② 带图标的菜单项"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="SplitButtonItem.Icon 接受任意 UIElement" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="SplitButtonItem.Icon 通常放 Path / IconBox 等图标元素, Icon 与 Content 自动横向布局。" />

            <StackPanel Orientation="Horizontal">
                <cy:SplitButton
                    MinWidth="120"
                    Command="{Binding NewFileCommand}"
                    Label="新建">
                    <cy:SplitButtonItem Command="{Binding NewFileCommand}" Content="文件">
                        <cy:SplitButtonItem.Icon>
                            <Path
                                Width="14"
                                Height="14"
                                Data="M5,3 L14,3 L19,8 L19,21 L5,21 Z M14,3 L14,8 L19,8"
                                Stroke="{DynamicResource Foreground.Link}"
                                StrokeThickness="1.5" />
                        </cy:SplitButtonItem.Icon>
                    </cy:SplitButtonItem>
                    <cy:SplitButtonItem Command="{Binding NewFolderCommand}" Content="文件夹">
                        <cy:SplitButtonItem.Icon>
                            <Path
                                Width="14"
                                Height="14"
                                Data="M3,7 L9,7 L11,5 L21,5 L21,19 L3,19 Z"
                                Stroke="{DynamicResource Foreground.Warning}"
                                StrokeThickness="1.5" />
                        </cy:SplitButtonItem.Icon>
                    </cy:SplitButtonItem>
                    <cy:SplitButtonItem Command="{Binding NewProjectCommand}" Content="项目">
                        <cy:SplitButtonItem.Icon>
                            <Path
                                Width="14"
                                Height="14"
                                Data="M3,3 L21,3 L21,21 L3,21 Z M3,9 L21,9 M9,9 L9,21"
                                Stroke="{DynamicResource Foreground.Success}"
                                StrokeThickness="1.5" />
                        </cy:SplitButtonItem.Icon>
                    </cy:SplitButtonItem>
                </cy:SplitButton>
            </StackPanel>

            <!--  ========== ③ ItemsSource 数据驱动 ==========  -->
            <cy:SectionHeader
                MainTitle="③ ItemsSource 数据驱动"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="ItemContainerStyle 把每个容器 Command 绑到自己那项 VM 的 ExecuteCommand" />

            <Grid DataContext="{Binding ExportPanel}">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource CaptionStyle}"
                        Text="子项 VM 列表里每项都有 [RelayCommand] private void Execute(), 生成的属性都叫 ExecuteCommand。通过 ItemContainerStyle 把容器 Command 绑到 DataContext.ExecuteCommand — WPF 让每个容器各自指向自己那项的实例, 点击谁执行谁。第 3 项 (HTML 网页) 默认 IsAvailable=false, 可观察 CanExecute 各自独立。" />

                    <StackPanel Orientation="Horizontal">
                        <cy:SplitButton
                            MinWidth="160"
                            Command="{Binding Formats[0].ExecuteCommand}"
                            ItemsSource="{Binding Formats}">
                            <cy:SplitButton.Label>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="导出" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Opacity="0.7"
                                        Text="(默认 PDF)" />
                                </StackPanel>
                            </cy:SplitButton.Label>
                            <cy:SplitButton.ItemContainerStyle>
                                <Style TargetType="{x:Type cy:SplitButtonItem}">
                                    <Setter Property="Command" Value="{Binding ExecuteCommand}" />
                                </Style>
                            </cy:SplitButton.ItemContainerStyle>
                            <cy:SplitButton.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Opacity="0.6"
                                            Text="{Binding Extension}" />
                                    </StackPanel>
                                </DataTemplate>
                            </cy:SplitButton.ItemTemplate>
                        </cy:SplitButton>

                        <Button
                            Margin="12,0,0,0"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleHtmlAvailabilityCommand}"
                            Content="切换 HTML 可用性" />
                    </StackPanel>

                    <Border Style="{StaticResource ResultBoxStyle}">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource Foreground.Caption}"
                                Text="子项 VM 各自的回显 (LastResult):" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Foreground.Link}"
                                Text="{Binding LastResult}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!--  ========== ④ 路由事件 ==========  -->
            <cy:SectionHeader
                MainTitle="④ 路由事件"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="Click / ItemClick / Opened / Closed" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="不绑 Command 也行 — SplitButton 暴露 Click 路由事件(主按钮), ItemClick 路由事件(任一菜单项)。OriginalSource 可拿到具体的 SplitButtonItem。" />

            <StackPanel Orientation="Horizontal">
                <cy:SplitButton
                    MinWidth="120"
                    Click="OnPlainClick"
                    ItemClick="OnPlainItemClick"
                    Label="操作">
                    <cy:SplitButtonItem Content="复制" />
                    <cy:SplitButtonItem Content="剪切" />
                    <cy:SplitButtonItem Content="粘贴" />
                    <cy:SplitButtonItem Content="全选" />
                </cy:SplitButton>
            </StackPanel>

            <Border Style="{StaticResource ResultBoxStyle}">
                <UniformGrid Columns="2">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}">
                        <Run Foreground="{DynamicResource Foreground.Link}" Text="Click" />
                        <Run Text="     主按钮被点击" />
                    </TextBlock>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}">
                        <Run Foreground="{DynamicResource Foreground.Link}" Text="ItemClick" />
                        <Run Text=" 任一菜单项被点击" />
                    </TextBlock>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}">
                        <Run Foreground="{DynamicResource Foreground.Link}" Text="Opened" />
                        <Run Text="    popup 展开" />
                    </TextBlock>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource Foreground.Caption}">
                        <Run Foreground="{DynamicResource Foreground.Link}" Text="Closed" />
                        <Run Text="    popup 关闭" />
                    </TextBlock>
                </UniformGrid>
            </Border>

            <!--  ========== ⑤ Disabled 与键盘 ==========  -->
            <cy:SectionHeader
                MainTitle="⑤ Disabled 与键盘"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="IsEnabled / Tab / Enter+Space / F4+Alt↓ / Esc" />

            <TextBlock
                Style="{StaticResource CaptionStyle}"
                Text="主按钮 Command.CanExecute=false 时自动 disabled; 整个 SplitButton 也可手动 IsEnabled=false。" />

            <StackPanel Orientation="Horizontal">
                <cy:SplitButton
                    MinWidth="120"
                    Margin="0,0,12,0"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsMainEnabled}"
                    Label="保存">
                    <cy:SplitButtonItem Command="{Binding SaveAsPdfCommand}" Content="另存为 PDF" />
                    <cy:SplitButtonItem Command="{Binding SaveAsWordCommand}" Content="另存为 Word" />
                </cy:SplitButton>

                <CheckBox
                    VerticalAlignment="Center"
                    Content="启用 SplitButton"
                    IsChecked="{Binding IsMainEnabled}" />
            </StackPanel>

            <Border Style="{StaticResource ResultBoxStyle}">
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Default}"
                        Text="键盘交互" />
                    <UniformGrid Margin="0,8,0,0" Columns="2">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Tab" />
                            <Run Text="           在主按钮 / 箭头之间切换焦点" />
                        </TextBlock>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Enter / Space" />
                            <Run Text=" 触发当前焦点元素" />
                        </TextBlock>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="F4 / Alt+↓" />
                            <Run Text="    切换下拉" />
                        </TextBlock>
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}">
                            <Run Foreground="{DynamicResource Foreground.Link}" Text="Esc" />
                            <Run Text="           关闭下拉" />
                        </TextBlock>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!--  ========== ⑥ 常见使用场景 ==========  -->
            <cy:SectionHeader
                MainTitle="⑥ 常见使用场景"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="保存 / 导出 / 新建 / 行级操作" />

            <UniformGrid Columns="2" Rows="2">

                <cy:Card Margin="0,0,8,8">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M5,3 L19,3 L19,21 L5,21 Z M5,8 L19,8 M9,12 L15,12 M9,16 L13,16"
                            Stroke="{DynamicResource Foreground.Link}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.5" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="保存 / 另存为" />
                        <cy:SplitButton
                            MinWidth="120"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Left"
                            Command="{Binding SaveCommand}"
                            Label="保存">
                            <cy:SplitButtonItem Command="{Binding SaveAsPdfCommand}" Content="另存为 PDF" />
                            <cy:SplitButtonItem Command="{Binding SaveAsWordCommand}" Content="另存为 Word" />
                            <cy:SplitButtonItem Command="{Binding SaveAsHtmlCommand}" Content="另存为 HTML" />
                        </cy:SplitButton>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="文档编辑器最常见模式"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </cy:Card>

                <cy:Card Margin="8,0,0,8">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,18 L20,18 L20,21 L4,21 Z"
                            Stroke="{DynamicResource Foreground.Success}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.5" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="导出格式" />
                        <cy:SplitButton
                            MinWidth="120"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Left"
                            Command="{Binding ExportPngCommand}"
                            Label="导出 PNG">
                            <cy:SplitButtonItem Command="{Binding ExportPngCommand}" Content="PNG (位图)" />
                            <cy:SplitButtonItem Command="{Binding ExportSvgCommand}" Content="SVG (矢量)" />
                            <cy:SplitButtonItem Command="{Binding ExportJsonCommand}" Content="JSON (数据)" />
                        </cy:SplitButton>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="设计工具、数据可视化"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </cy:Card>

                <cy:Card Margin="0,8,8,0">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M5,12 L19,12 M12,5 L12,19"
                            Stroke="{DynamicResource Foreground.Warning}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="新建" />
                        <cy:SplitButton
                            MinWidth="120"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Left"
                            Command="{Binding NewFileCommand}"
                            Label="新建">
                            <cy:SplitButtonItem Command="{Binding NewFileCommand}" Content="文件" />
                            <cy:SplitButtonItem Command="{Binding NewFolderCommand}" Content="文件夹" />
                            <cy:SplitButtonItem Command="{Binding NewProjectCommand}" Content="项目" />
                        </cy:SplitButton>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="资源管理器、IDE"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </cy:Card>

                <cy:Card Margin="8,8,0,0">
                    <StackPanel>
                        <Path
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            Data="M5,8 L19,8 M5,12 L19,12 M5,16 L19,16"
                            Stroke="#8B5CF6"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <TextBlock
                            Margin="0,8,0,4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Foreground.Default}"
                            Text="行级操作" />
                        <cy:SplitButton
                            MinWidth="120"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Left"
                            Command="{Binding RenameCommand}"
                            Label="重命名">
                            <cy:SplitButtonItem Command="{Binding RenameCommand}" Content="重命名" />
                            <cy:SplitButtonItem Command="{Binding DuplicateCommand}" Content="复制副本" />
                            <cy:SplitButtonItem Command="{Binding DeleteCommand}" Content="删除" />
                        </cy:SplitButton>
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource Foreground.Caption}"
                            Text="DataGrid 行级菜单"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </cy:Card>
            </UniformGrid>

            <!--  ========== ⑦ 主要 API ==========  -->
            <cy:SectionHeader
                MainTitle="⑦ 主要 API"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="SplitButton / SplitButtonItem 核心属性 + 路由事件" />

            <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Background="{DynamicResource Background.Header}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="属性 / 事件" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="类型" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource PropTableHeaderStyle}"
                        Text="说明" />
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Border.Default}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Label / LabelTemplate" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="object / DataTemplate" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="主按钮显示的内容。可以是字符串、图标 + 文字、任意 UIElement。" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Command / CommandParameter" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="ICommand / object" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="主按钮命令。CanExecute=false 时主按钮自动 disabled。下拉项有自己的 Command。" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="IsOpen" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="bool (TwoWay)" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="下拉是否展开。可双向绑定。Popup 自关时同步回此值。" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Placement" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="PlacementMode" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="popup 弹出位置。默认 Bottom。常用 Top / Right / Left / MousePoint。" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="MaxDropDownHeight" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="double" />
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="下拉最大高度。超过出现滚动条。默认屏幕高度的一半。" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="ItemsSource / Items" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="ItemsControl 自带" />
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="菜单项数据源。可直接放 SplitButtonItem, 也可绑数据 + ItemContainerStyle 桥接 Command。" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Click (路由事件)" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="RoutedEventHandler" />
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="主按钮被点击时触发。OriginalSource = SplitButton 自身。和 Command 可同时使用。" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="ItemClick (路由事件)" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="RoutedEventHandler" />
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="任一菜单项被点击时触发。OriginalSource = 被点击的 SplitButtonItem。" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="Opened / Closed (路由事件)" />
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="RoutedEventHandler" />
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="popup 展开 / 关闭时触发。" />

                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="SplitButtonItem.Command" />
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="ICommand (来自 ButtonBase)" />
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="每个菜单项可绑定独立命令。点击后执行 Command 并自动关闭 popup。" />

                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="SplitButtonItem.Icon" />
                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="object" />
                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="菜单项左侧图标。可以是字符串、Path、IconBox 或任意 UIElement。" />

                    <TextBlock
                        Grid.Row="12"
                        Grid.Column="0"
                        Style="{StaticResource PropTableNameStyle}"
                        Text="SplitButtonItem.Click" />
                    <TextBlock
                        Grid.Row="12"
                        Grid.Column="1"
                        Style="{StaticResource PropTableTypeStyle}"
                        Text="RoutedEventHandler" />
                    <TextBlock
                        Grid.Row="12"
                        Grid.Column="2"
                        Style="{StaticResource PropTableCellStyle}"
                        Text="ButtonBase 自带的 Click 事件。会冒泡, 但和 SplitButton.Click 是不同的 RoutedEvent。" />
                </Grid>
            </Border>

            <!--  ========== ⑧ 设计要点 ==========  -->
            <cy:SectionHeader
                MainTitle="⑧ 设计要点"
                Style="{StaticResource ChapterHeaderStyle}"
                SubTitle="跟 Button / DropDownButton 的边界 + 关键决策" />

            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="不是 Selector" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="继承 ItemsControl, 没有 &quot;选中&quot; 语义。点击菜单项 = 执行动作, 不会被记忆。要 &quot;选中&quot; 用 ComboBox / ListBox"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="独立 Command" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="主按钮 + 每项各绑各的 Command, 不需要 ItemClickCommand 这种 hack — 也支持 CanExecute 各自独立判定"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="数据驱动" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="ItemContainerStyle 把容器 Command 绑到 DataContext.ExecuteCommand, WPF 让每个容器各自指向自己那项"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="IsOpen 双向同步" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Popup.IsOpen ↔ ToggleButton.IsChecked ↔ SplitButton.IsOpen, 任一处变化全闭环"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="路由事件冒泡" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Click / ItemClick / Opened / Closed 都是 Bubble, 父容器可统一拦截做 telemetry"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Foreground.Link}"
                        Text="vs Button / DropDownButton" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Foreground.Caption}"
                        Text="Button 只一个动作; DropDownButton 多个动作选一个、无默认; SplitButton 一个主动作 + 一组次要变体, 主动作占 90% 频率"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
